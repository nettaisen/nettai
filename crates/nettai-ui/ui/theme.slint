// The look, in one place (docs/design/app-ui.md §4): the colors, the type and the metrics every screen uses.
//
// Lengths are in units of the 1280 by 800 reference window. The app sets the window's scale so that one `px` in
// these files is one unit (`scale.rs`), so nothing here multiplies by a scale.

import "../fonts/chakra-petch/ChakraPetch-Medium.ttf";
import "../fonts/chakra-petch/ChakraPetch-SemiBold.ttf";
import "../fonts/chakra-petch/ChakraPetch-Bold.ttf";
import "../fonts/corporate-logo/Corporate-Logo-Bold-ver3.otf";
import "../../nettai-render/fonts/mplus1code/MPLUS1Code-VariableFont_wght.ttf";
import "../../nettai-render/fonts/murecho/Murecho-VariableFont_wght.ttf";

// What a backdrop's pattern is drawn of (the ground: shell.slint's `Backdrop`).
export enum PatternKind {
    // A field of hexagons, stroked.
    hexagons,
    // Lines at 30 degrees each way across the window.
    isometric-grid,
    // Three layers of dots, white and the pattern's color, with a streak across them from the pattern's color
    // into the main action's.
    starfield,
}

// A look: the colors everything is drawn in and the backdrop's pattern. Each game states its own (its content's
// look.toml), and the app sets the selected game's (`look.rs`). This one's values are the app's own look, which a
// game whose content states none is drawn in.
export struct Look {
    // The ground, top to bottom, and the glow at its top right (its color and its opacity).
    ground-top: color,
    ground-bottom: color,
    ground-glow: color,
    // Surfaces.
    panel: color,
    raised: color,
    line: color,
    inset: color,
    // Text.
    text: color,
    muted: color,
    dim: color,
    // The cursor, the active pane's title, the chosen row's bar; the main action and the text on it.
    cursor: color,
    action: color,
    action-ink: color,
    // The ground's pattern, its color, and the opacity its marks are drawn at.
    pattern: PatternKind,
    pattern-color: color,
    pattern-strength: float,
}

export global Theme {
    // The selected game's look, and the one before it: as the game changes the colors cross-fade from `was` to
    // `look` while `fade` goes from 0 to 1 (the app moves it, over `settle`, as the new ground sweeps in).
    in property <Look> look: {
        ground-top: #0a1330,
        ground-bottom: #050916,
        ground-glow: #286eff47,
        panel: #0c1836,
        raised: #13254d,
        line: #27508f,
        inset: #040813,
        text: #eaf3ff,
        muted: #8ea8d4,
        dim: #55698f,
        cursor: #66e0ff,
        action: #ffb62e,
        action-ink: #1b1100,
        pattern: PatternKind.hexagons,
        pattern-color: #62b4ff,
        pattern-strength: 0.078,
    };
    in property <Look> was: root.look;
    in property <float> fade: 1;
    pure function blend(new: color, old: color) -> color {
        return root.fade >= 1 ? new : new.mix(old, root.fade);
    }

    // The ground, top to bottom. (Its glow and its pattern are each ground's own: `Backdrop`.)
    out property <color> ground-top: root.blend(root.look.ground-top, root.was.ground-top);
    out property <color> ground-bottom: root.blend(root.look.ground-bottom, root.was.ground-bottom);
    // Surfaces.
    out property <color> panel: root.blend(root.look.panel, root.was.panel);
    out property <color> raised: root.blend(root.look.raised, root.was.raised);
    out property <color> raised-hover: root.raised.brighter(0.33);
    out property <color> line: root.blend(root.look.line, root.was.line);
    out property <color> inset: root.blend(root.look.inset, root.was.inset);
    // The header's and the footer's bar, and the shade under a dialog: the ground's foot, darker.
    out property <color> bar: root.ground-bottom.darker(0.47).with-alpha(0.72);
    out property <color> shade: root.ground-bottom.darker(0.4).with-alpha(0.8);
    // Text.
    out property <color> text: root.blend(root.look.text, root.was.text);
    out property <color> muted: root.blend(root.look.muted, root.was.muted);
    out property <color> dim: root.blend(root.look.dim, root.was.dim);
    // The cursor, the active pane's title, the chosen row's bar; its glow; the chosen row's tint and a hovered
    // one's.
    out property <color> cursor: root.blend(root.look.cursor, root.was.cursor);
    out property <color> glow: root.cursor.with-alpha(0.4);
    out property <color> tint: root.cursor.with-alpha(0.1);
    out property <color> tint-hover: root.cursor.with-alpha(0.05);
    // (The cursor's color with nothing of it: what its gradients fade to.)
    out property <color> clear: root.cursor.with-alpha(0);
    // The main action.
    out property <color> action: root.blend(root.look.action, root.was.action);
    out property <color> action-ink: root.blend(root.look.action-ink, root.was.action-ink);
    // The two sides.
    out property <color> p1: #ff5d50;
    out property <color> p2: #4a93ff;
    out property <color> p1-tint: #ff5d5029;
    out property <color> p2-tint: #4a93ff2e;
    // Good; an error, or a reason something can't be done.
    out property <color> good: #45e0a0;
    out property <color> bad: #ff9272;
    // What a build holds.
    out property <color> bug: #b497ff;
    out property <color> mega: #6cc4ff;
    out property <color> giga: #ff7eb6;
    out property <color> reg: #ff5c82;
    out property <color> tag: #7fe36c;
    out property <color> code: #ffb62e;
    out property <color> command-line: #0e3550;
    out property <color> out-of-bounds: root.muted.with-alpha(0.2);
    out property <color> out-of-bounds-edge: root.muted.with-alpha(0.6);
    // A NaviCust piece: the dark of a plus part's cross and of the hatching over a piece out of bounds, the line
    // round a placed piece, and the outline of the piece in hand.
    out property <color> piece-mark: root.inset.with-alpha(0.5);
    out property <color> piece-edge: #000000;
    out property <color> piece-held: #ffffff;

    // Type. Headings, buttons and labels are Chakra Petch; a language it has no letters for (`cjk`, set by the
    // app with the language) has them in Corporate Logo at 700, whatever the game: squared kana, closer to Chakra
    // Petch's. Everything else is Murecho. Codes, numbers and times are M PLUS 1 Code, whose digits are one width.
    in property <bool> cjk;
    out property <string> display: cjk ? "Corporate Logo ver3" : "Chakra Petch";
    // The display face's weights: its bold (a title, the main action) and its semibold (a label, a button). Corporate
    // Logo is bundled at 700 alone.
    out property <int> display-bold: 700;
    out property <int> display-semibold: cjk ? 700 : 600;
    out property <string> body: "Murecho";
    out property <string> mono: "M PLUS 1 Code";
    // A label's capitals are tracked 0.18em; a script set solid nearly not.
    out property <length> label-tracking: cjk ? 0.4px : 2px;
    out property <length> button-tracking: cjk ? 0.3px : 1.3px;
    out property <length> title-tracking: cjk ? 0.6px : 2.8px;
    // The main menu's words, the type's largest step, as a fighting game's title screen has them (48, a phone's 32:
    // the longest, the pseudo-locale's REPLAYS, fits the 416 column's 384 with 15 to spare), tracked 0.075em.
    out property <length> menu-word: phone ? 32px : 48px;
    out property <length> menu-tracking: cjk ? 1px : phone ? 2.4px : 3.6px;

    // The app runs in a browser (nettai-web): no Steam, no direct links, the browser's own dialogs.
    in property <bool> web;

    // Metrics. `phone` is the upright-phone layout (the app sets it when the window is taller than wide): one
    // column, no footer, everything tapped at least 44 tall.
    in property <bool> phone;
    out property <length> margin: phone ? 16px : 32px;
    out property <length> header: phone ? 56px : 64px;
    out property <length> footer: phone ? 0px : 44px;
    out property <length> control: 40px;
    out property <length> row: 44px;
    out property <length> chip-row: 26px;
    // A row of the build editor's lists (the folder's library, the NaviCust's programs, the patch cards', the auto
    // battle data's, the Navi tab's forms): a chip's row, a phone's 40 to be tapped; `list-gap` apart (a
    // `ListView`'s own gap).
    out property <length> list-row: phone ? 40px : chip-row;
    out property <length> list-gap: 2px;
    // A thing's name on such a row, and wherever the editor names one beside them (the Party tab's navis in its picker
    // and its partners' heads): one size and weight (in `body`), so that none drifts from the others. An Empty is
    // `row-name-size` at the regular weight.
    out property <length> row-name-size: phone ? 14px : 12px;
    out property <int> row-name-weight: 600;

    // Motion (docs/design/app-ui.md §4, "Motion"; docs/app.md §10). Everything moves, briefly, and nothing
    // waits on it; motion is offsets, opacity and overlays, never a size. These are the only durations there
    // are: a screen uses the components, which use these. `motion` off (the player's Reduce motion, and the
    // screenshot pass) makes every one of them a cut, and stops what moves by itself (the field's drift, the
    // cursor's breathing, the main action's sheen).
    in property <bool> motion: true;
    // A control: the cursor's glide, a press, a value sliding in its box, a row's bar.
    out property <duration> quick: motion ? 110ms : 0ms;
    out property <duration> brisk: motion ? 150ms : 0ms;
    // A panel, a dialog, a menu, a screen arriving; a screen leaving. (A change of game's sweep and its colors'
    // cross-fade take `settle` too.)
    out property <duration> settle: motion ? 200ms : 0ms;
    out property <duration> leave: motion ? 120ms : 0ms;
    // The two set pieces: entering a battle (the jack-in), a result.
    out property <duration> set-piece: motion ? 480ms : 0ms;
    // What Reduce motion keeps of the jack-in: a short fade (`Pulse`'s `calm`). The screenshot pass (`still`)
    // keeps nothing of it: there every clock is at its end.
    in property <bool> still;
    out property <duration> calm-fade: still ? 0ms : 160ms;
    // How far apart the parts of a screen arrive.
    out property <duration> stagger: 30ms;
    // The way the screen shown was reached: Back's arrival runs the other way.
    in property <bool> back;

    // The screenshot pass asks every label whether its text fits (`Audit.clipped`).
    in property <bool> audit;
}

// The language shown's own rules, which the app answers (`lang::I18n`). Words in capitals (a button's, a heading's, a
// label's): the catalogs hold them as they are written in a sentence, and `I18n.upper(@tr("Export"))` sets them in
// capitals by the language's rules (a Turkish i is İ). Things listed on a line: `I18n.join([a, b])` puts them one after
// the other by the language's own separator ("A, B, C"; Japanese's "A、B、C"; the user: "you should also join items by
// locale-aware separator in the ui"). No caller passes a language: both read `language`, which the app counts up each
// time a language is chosen (after giving its new rules here), so everything set in capitals or listed is set again by
// the new rules, the app's own words as well as the `@tr` ones (the user: "fix the turkish issue": a name the app gave,
// never given again, kept the old language's capitals; then "instead of Caps.language and List reading it maybe you
// should have I18n.upper and I18n.join").
export global I18n {
    in property <int> language;
    pure callback uppercased(string) -> string;
    pure callback joined([string]) -> string;
    // (Each reads `language`, so that a language chosen sets what it made again.)
    public pure function upper(text: string) -> string {
        return root.language >= 0 ? root.uppercased(text) : text;
    }
    public pure function join(items: [string]) -> string {
        return root.language >= 0 ? root.joined(items) : "";
    }
}

// The screenshot pass's check that no label is cut: a label whose text doesn't fit says so here while
// `Theme.audit` is on.
export global Audit {
    callback clipped(string);
}
