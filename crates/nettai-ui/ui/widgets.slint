// The components every screen is built from (docs/design/app-ui.md §4 and §5).
//
// Two things hold for all of them. A control never sizes itself by what it shows at the moment: a value has a
// box of a set width and is cut with an ellipsis. And a control does nothing by itself: it has a name (`nav`),
// and a click, an arrow or an edit goes to the app with that name (nav.slint), where the screen's Rust module
// decides.
//
// Build cost (docs/app.md §14): a component used with nothing inside it is compiled once and shared by its uses;
// one used with children inside it (`Panel { ... }`) is copied into each, and every `if` or `for` is a component
// of its own. Sharing pays only for a component with much in it used in several places: one used in one place,
// or a small one in a few, is copied in (its use given a bare child). So the pieces here with much in them are
// leaves, a container holds what must be inside it and places a leaf for the rest (`Scroller`), and a part shown
// or hidden is `visible`, not `if`.
//
// Motion (docs/app.md §10): each control moves by itself (a press flashes, a value slides in its box, a chosen
// row's bar slides to the next), with the theme's durations. A screen writes no animation to get that.

import { Theme, Audit } from "theme.slint";
import { Nav, NavKind, Focusable } from "nav.slint";
import { Tween, Pulse } from "motion.slint";

// ---- Shapes ---------------------------------------------------------------------------------------------

// A rectangle with one line around it and its bottom right corner cut at 45 degrees, the line following the
// cut: 12 on a panel, 18 on a dialog or a menu, 9 on a button.
export component Cut inherits Path {
    in property <length> cut: 12px;
    in property <brush> background: Theme.panel;
    in property <brush> line: Theme.line;
    // (The path is drawn inside the line's half width: its box is the element's less the line.)
    property <float> w: max(1, (self.width - 1px) / 1px);
    property <float> h: max(1, (self.height - 1px) / 1px);
    property <float> c: self.cut / 1px;
    fill: root.background;
    stroke: root.line;
    stroke-width: 1px;
    viewbox-width: root.w;
    viewbox-height: root.h;
    MoveTo {
        x: 0;
        y: 0;
    }

    LineTo {
        x: root.w;
        y: 0;
    }

    LineTo {
        x: root.w;
        y: root.h - root.c;
    }

    LineTo {
        x: root.w - root.c;
        y: root.h;
    }

    LineTo {
        x: 0;
        y: root.h;
    }

    Close { }
}

// The arrows of a stepper and a select, drawn (no font has to have them).
export component ArrowLeft inherits Path {
    width: 5px;
    height: 8px;
    fill: Theme.cursor;
    commands: "M 5 0 L 0 4 L 5 8 Z";
}

export component ArrowRight inherits Path {
    width: 5px;
    height: 8px;
    fill: Theme.cursor;
    commands: "M 0 0 L 5 4 L 0 8 Z";
}

export component ArrowDown inherits Path {
    width: 8px;
    height: 5px;
    fill: Theme.muted;
    commands: "M 0 0 L 8 0 L 4 5 Z";
}

// Back's chevron.
export component Chevron inherits Path {
    width: 5px;
    height: 9px;
    stroke: Theme.muted;
    stroke-width: 1.5px;
    commands: "M 4.5 0.5 L 0.5 4.5 L 4.5 8.5";
}

// ---- Text -----------------------------------------------------------------------------------------------

// A label: 11, capitals (the catalog's text is written so), tracked.
export component Label inherits Text {
    property <bool> over: Theme.audit && self.preferred-width > self.width + 0.5px;
    color: Theme.muted;
    font-family: Theme.display;
    font-size: 11px;
    font-weight: Theme.display-semibold;
    letter-spacing: Theme.label-tracking;
    vertical-alignment: center;
    overflow: elide;
    changed over => {
        if over {
            Audit.clipped(self.text);
        }
    }
}

// A line that says what its label can't (what a setting changes, what happens next): 13, muted, wrapped.
export component Note inherits Text {
    property <bool> over: Theme.audit && self.preferred-height > self.height + 0.5px;
    color: Theme.muted;
    font-family: Theme.body;
    font-size: 13px;
    vertical-alignment: center;
    wrap: word-wrap;
    changed over => {
        if over {
            Audit.clipped(self.text);
        }
    }
}

// A reserved line for a message: 16 tall whether it says anything or not, in the error red. What it says fades
// in.
export component Message inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.bad;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    height: 16px;
    Text {
        x: 0;
        width: parent.width;
        text: root.text;
        color: root.tone;
        font-family: Theme.body;
        font-size: 12px;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        overflow: elide;
        opacity: root.text == "" ? 0 : 1;
        animate opacity {
            duration: Theme.brisk;
            easing: ease-out;
        }
    }
}

// A name or a value the app gives (a player, a build): one line, cut with an ellipsis.
export component Value inherits Text {
    color: Theme.text;
    font-family: Theme.body;
    font-size: 14px;
    font-weight: 600;
    vertical-alignment: center;
    overflow: elide;
}

// A code, a number, a time: fixed-width digits.
export component Mono inherits Text {
    color: Theme.text;
    font-family: Theme.mono;
    font-size: 13px;
    font-weight: 700;
    vertical-alignment: center;
    overflow: elide;
}

// A dialog's or a menu's heading.
export component Heading inherits Text {
    property <bool> over: Theme.audit && self.preferred-width > self.width + 0.5px;
    color: Theme.text;
    font-family: Theme.display;
    font-size: 20px;
    font-weight: Theme.display-bold;
    letter-spacing: Theme.title-tracking * 0.7;
    vertical-alignment: center;
    overflow: elide;
    changed over => {
        if over {
            Audit.clipped(self.text);
        }
    }
}

// A tag: a version, TRAINING.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 22px;
    // (No text, no tag: it takes no room.)
    width: root.text == "" ? 0px : label.preferred-width + 16px;
    Rectangle {
        border-width: root.text == "" ? 0px : 1px;
        border-color: root.tone;
    }

    label := Text {
        text: root.text;
        color: root.tone;
        font-family: Theme.display;
        font-size: 11px;
        font-weight: Theme.display-bold;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---- Controls -------------------------------------------------------------------------------------------

export enum ButtonKind {
    normal,
    // The main action: amber.
    main,
    // A quieter one: no fill.
    ghost,
}

// A button, 40 tall, as wide as its text and at least 120 (give it a `width` where it should be another: its
// text is cut to it). `enabled` off is the unavailable look, and the focus passes it by. A press flashes its
// fill and dips it 1; the main action has a slow sheen.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> nav;
    in property <int> nav-index;
    in property <ButtonKind> kind;
    in property <bool> enabled: true;
    // Its text in the error red (DELETE, LEAVE MATCH).
    in property <bool> danger;
    // 52 tall (START TRAINING).
    in property <bool> big;
    out property <bool> focused: hit.focused;
    // As wide as its text asks (what it is where no `width` is given it: a layout that gives it another on a
    // phone alone reads this for the desktop's).
    out property <length> natural-width: max(120px, label.preferred-width + 32px);
    property <bool> over: Theme.audit && label.preferred-width > label.width + 0.5px;
    property <brush> fill-main: hit.has-hover ? Theme.action.brighter(12%) : Theme.action;
    property <brush> fill-ghost: hit.has-hover && root.enabled ? Theme.tint : transparent;
    property <brush> fill-normal: hit.has-hover ? Theme.raised-hover : Theme.raised;
    // A press: the pointer going down on it, or Enter while the cursor is on it.
    property <int> presses;
    property <int> key-press: Nav.press-seq;
    property <bool> down: hit.pressed;
    property <length> dip: press.v > 0.4 ? 1px : 0px;
    // The main action's sheen: a band of light across it every few seconds.
    property <float> sheen: Theme.motion && root.kind == ButtonKind.main && root.enabled ? clamp(mod(animation-tick(), 3.6s) / 0.9s, 0, 1) : 0;
    height: root.big ? 52px : 40px;
    width: root.natural-width;
    press := Pulse {
        seq: root.presses;
    }

    Cut {
        y: root.dip;
        cut: 9px;
        background: !root.enabled || root.kind == ButtonKind.ghost ? root.fill-ghost : (root.kind == ButtonKind.main ? root.fill-main : root.fill-normal);
        line: !root.enabled ? Theme.dim : (root.kind == ButtonKind.main ? Theme.action : Theme.line);
    }

    // (The sheen is kept off the cut corner, where it fades to nothing anyway.)
    Rectangle {
        x: 1px;
        y: 1px + root.dip;
        width: parent.width - 11px;
        height: parent.height - 2px;
        clip: true;
        Rectangle {
            x: root.sheen * (parent.width + 48px) - 48px;
            width: 48px;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff 50%, #ffffff00 100%);
            opacity: 0.32 * sin(root.sheen * 180deg);
        }
    }

    Cut {
        y: root.dip;
        cut: 9px;
        background: #ffffff;
        line: transparent;
        opacity: press.v * 0.38;
    }

    label := Text {
        x: 16px;
        y: root.dip;
        width: parent.width - 32px;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.dim : root.kind == ButtonKind.main ? Theme.action-ink : root.danger ? Theme.bad : Theme.text;
        font-family: Theme.display;
        font-size: root.big ? 16px : 13px;
        font-weight: root.kind == ButtonKind.main ? Theme.display-bold : Theme.display-semibold;
        letter-spacing: Theme.button-tracking;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
        enabled: root.enabled;
    }

    changed over => {
        if over {
            Audit.clipped(root.text);
        }
    }
    changed key-press => {
        if hit.focused {
            root.presses += 1;
        }
    }
    changed down => {
        if root.down {
            root.presses += 1;
        }
    }
}

// A value between two arrows: Left and Right change it at once. The value's box has one width
// (`value-width`), so the arrows stay where they are whatever it says. `locked` shows the value alone, in the
// same place (the game's name where the game can't change). A new value slides in within the box, the way the
// arrow pressed points, as the old one slides out. Where the row it is in is what is focused (a `Focusable` of
// the row's own, of this name: a menu's rows), `focusable` is off: its arrows still step it.
export component Stepper inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> value;
    in property <length> value-width: 84px;
    // Fixed-width digits (a number).
    in property <bool> numeric;
    // The header's game: larger, in the display face.
    in property <bool> title;
    in property <bool> locked;
    in property <bool> enabled: true;
    in property <bool> focusable: true;
    out property <bool> focused: hit.focused;
    // The value before this one, and the way it left.
    property <string> last;
    property <string> old;
    property <int> dir: 1;
    property <int> changes;
    property <string> family: root.numeric ? Theme.mono : (root.title ? Theme.display : Theme.body);
    property <length> face: root.title ? 16px : 14px;
    property <int> weight: root.title ? Theme.display-bold : 700;
    property <length> spacing: root.title ? 0.6px : 0px;
    // A value too long for its box is drawn smaller to fit (in half pixels, the width taken as going with the
    // size), down to `smallest`; past that, at the floor on two lines if the box's height holds them; past that,
    // cut with an ellipsis, which the screenshot pass is told of. Each is measured once a value (the texts'
    // preferred sizes), not each frame.
    property <length> smallest: 11px;
    property <length> size: measured.preferred-width <= root.value-width + 0.5px ? root.face : max(root.smallest, floor(root.face * (root.value-width / measured.preferred-width) / 0.5px) * 0.5px);
    property <bool> one-line: at-size.preferred-width <= root.value-width + 0.5px;
    property <bool> two-lines: !root.one-line && wrapped.preferred-height <= root.height;
    out property <bool> cut: !root.one-line && !root.two-lines;
    // (The value before, as it was drawn: it slides out so.)
    property <length> old-size: root.face;
    property <bool> old-two-lines;
    height: 36px;
    width: root.value-width + 72px;
    horizontal-stretch: 0;
    measured := Text {
        visible: false;
        text: root.value;
        font-family: root.family;
        font-size: root.face;
        font-weight: root.weight;
        letter-spacing: root.spacing;
    }

    at-size := Text {
        visible: false;
        text: root.value;
        font-family: root.family;
        font-size: root.size;
        font-weight: root.weight;
        letter-spacing: root.spacing;
    }

    wrapped := Text {
        visible: false;
        width: root.value-width;
        text: root.value;
        font-family: root.family;
        font-size: root.smallest;
        font-weight: root.weight;
        letter-spacing: root.spacing;
        wrap: word-wrap;
    }

    slide := Tween {
        seq: root.changes;
        duration: Theme.brisk;
    }

    hit := Focusable {
        nav: root.focusable ? root.nav : "";
        nav-index: root.nav-index;
        kind: NavKind.stepper;
        enabled: root.enabled && !root.locked && root.focusable;
    }

    Rectangle {
        x: 0;
        width: 32px;
        visible: !root.locked;
        border-width: 1px;
        border-color: Theme.line;
        background: left.pressed ? Theme.line : left.has-hover ? Theme.tint : transparent;
        ArrowLeft { }

        left := TouchArea {
            enabled: root.enabled;
            clicked => {
                Nav.point(root.nav, root.nav-index);
                Nav.step(root.nav, root.nav-index, -1);
            }
        }
    }

    Rectangle {
        x: 36px;
        width: root.value-width;
        clip: true;
        Text {
            x: (1 - slide.t) * root.dir * 18px;
            width: parent.width;
            text: root.value;
            color: root.enabled ? Theme.text : Theme.dim;
            font-family: root.family;
            font-size: root.two-lines ? root.smallest : root.size;
            font-weight: root.weight;
            letter-spacing: root.spacing;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: root.two-lines ? word-wrap : no-wrap;
            overflow: elide;
            opacity: slide.t;
        }

        Text {
            x: -slide.t * root.dir * 18px;
            width: parent.width;
            text: slide.linear < 1 ? root.old : "";
            color: root.enabled ? Theme.text : Theme.dim;
            font-family: root.family;
            font-size: root.old-two-lines ? root.smallest : root.old-size;
            font-weight: root.weight;
            letter-spacing: root.spacing;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: root.old-two-lines ? word-wrap : no-wrap;
            overflow: elide;
            opacity: 1 - slide.t;
        }
    }

    Rectangle {
        x: root.value-width + 40px;
        width: 32px;
        visible: !root.locked;
        border-width: 1px;
        border-color: Theme.line;
        background: right.pressed ? Theme.line : right.has-hover ? Theme.tint : transparent;
        ArrowRight { }

        right := TouchArea {
            enabled: root.enabled;
            clicked => {
                Nav.point(root.nav, root.nav-index);
                Nav.step(root.nav, root.nav-index, 1);
            }
        }
    }

    property <length> last-size: root.face;
    property <bool> last-two-lines;
    // (The screenshot pass's check: a value cut even at the floor.)
    property <bool> over: Theme.audit && root.cut;
    init => {
        root.last = root.value;
        root.last-size = root.size;
        root.last-two-lines = root.two-lines;
    }
    changed value => {
        root.old = root.last;
        root.old-size = root.last-size;
        root.old-two-lines = root.last-two-lines;
        root.last = root.value;
        root.last-size = root.size;
        root.last-two-lines = root.two-lines;
        root.dir = Nav.step-dir;
        root.changes += 1;
    }
    changed over => {
        if over {
            Audit.clipped(root.value);
        }
    }
}

// One of two: off and on, sharp and original. Left and Right choose, Enter takes the other. The chosen half's
// tint and underline slide across to the other.
export component Seg inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> first;
    in property <string> second;
    // 0 the first, 1 the second.
    in property <int> chosen;
    // Off: it can't be changed now (the focus passes it by), and says so by its look.
    in property <bool> enabled: true;
    out property <bool> focused: hit.focused;
    property <length> first-width: max(44px, a.preferred-width + 24px);
    property <length> second-width: max(44px, b.preferred-width + 24px);
    height: 36px;
    width: root.first-width + root.second-width + 1px;
    horizontal-stretch: 0;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: Theme.line;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
        kind: NavKind.stepper;
        enabled: root.enabled;
    }

    // What marks the chosen half.
    Rectangle {
        x: root.chosen == 0 ? 0px : root.first-width + 1px;
        width: root.chosen == 0 ? root.first-width : root.second-width;
        background: root.enabled ? Theme.tint : transparent;
        animate x, width {
            duration: Theme.brisk;
            easing: ease-out;
        }
        Rectangle {
            y: parent.height - 2px;
            height: 2px;
            background: root.enabled ? Theme.cursor : Theme.dim;
        }
    }

    a := Text {
        x: 0;
        width: root.first-width;
        text: root.first;
        color: root.chosen == 0 ? (root.enabled ? Theme.cursor : Theme.muted) : (root.enabled ? Theme.muted : Theme.dim);
        font-family: Theme.display;
        font-size: 13px;
        font-weight: Theme.display-bold;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color {
            duration: Theme.brisk;
        }
    }

    TouchArea {
        x: 0;
        width: root.first-width;
        enabled: root.enabled;
        clicked => {
            Nav.point(root.nav, root.nav-index);
            Nav.choose(root.nav, root.nav-index, 0);
        }
    }

    Rectangle {
        x: root.first-width;
        width: 1px;
        background: Theme.line;
    }

    b := Text {
        x: root.first-width + 1px;
        width: root.second-width;
        text: root.second;
        color: root.chosen == 1 ? (root.enabled ? Theme.cursor : Theme.muted) : (root.enabled ? Theme.muted : Theme.dim);
        font-family: Theme.display;
        font-size: 13px;
        font-weight: Theme.display-bold;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color {
            duration: Theme.brisk;
        }
    }

    TouchArea {
        x: root.first-width + 1px;
        width: root.second-width;
        enabled: root.enabled;
        clicked => {
            Nav.point(root.nav, root.nav-index);
            Nav.choose(root.nav, root.nav-index, 1);
        }
    }
}

// A level from 0 to `maximum`: Left and Right step it, a click or a drag sets it. Its number has a box of its
// own, so the bar keeps its length.
export component Slider inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <int> value;
    in property <int> maximum: 100;
    out property <bool> focused: hit.focused;
    property <length> track: self.width - 48px;
    property <length> filled: root.track * clamp(root.value / root.maximum, 0, 1);
    height: 40px;
    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
        kind: NavKind.stepper;
    }

    Rectangle {
        x: 0;
        y: 18px;
        width: root.track;
        height: 4px;
        background: Theme.raised;
    }

    Rectangle {
        x: 0;
        y: 18px;
        width: root.filled;
        height: 4px;
        background: Theme.cursor;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.glow;
    }

    Rectangle {
        x: root.filled - 4px;
        y: 10px;
        width: 8px;
        height: 20px;
        background: Theme.text;
    }

    Mono {
        x: root.track + 12px;
        width: 36px;
        text: root.value;
        horizontal-alignment: right;
    }

    drag := TouchArea {
        x: 0;
        width: root.track;
        function set() {
            Nav.choose(root.nav, root.nav-index, round(clamp(self.mouse-x / self.width, 0, 1) * root.maximum));
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                Nav.point(root.nav, root.nav-index);
                set();
            }
        }
        moved => {
            if self.pressed {
                set();
            }
        }
    }
}

// A box with its value and an arrow: Left and Right step through its choices, Enter opens them as a list. Where
// the row it is in is what is focused (a `Focusable` of the row's own), `focusable` is off.
export component Select inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> focusable: true;
    out property <bool> focused: hit.focused;
    height: 40px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: hit.has-hover ? Theme.muted : Theme.line;
    }

    Value {
        x: 12px;
        width: parent.width - 44px;
        text: root.value;
        color: root.enabled ? Theme.text : Theme.dim;
        font-weight: 400;
    }

    ArrowDown {
        x: parent.width - 20px;
    }

    hit := Focusable {
        nav: root.focusable ? root.nav : "";
        nav-index: root.nav-index;
        kind: NavKind.stepper;
        enabled: root.enabled && root.focusable;
    }
}

// A text field (rules 7 and 8). The arrows walk past it; Enter or a typed letter starts editing; while it is
// edited Left and Right move the caret, Enter confirms, Esc restores the text it had, Up or Down confirm and
// move on. Its text is cut at the inner padding (12) and scrolls to keep the caret in view.
//
// `text` is the app's: the screen's Rust module gets each change (`edit`) and sets it, so what the field holds
// is what the app kept (a name cut to its length, a code in capitals).
export component Field inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> text;
    in property <string> placeholder;
    // Its line in the error red (the reason is in the reserved line by it).
    in property <bool> error;
    // A code: fixed-width, larger, tracked.
    in property <bool> code;
    in property <bool> enabled: true;
    out property <bool> focused: hit.focused;
    out property <bool> editing: hit.focused && Nav.editing;
    property <int> seq: Nav.edit-seq;
    property <length> scroll;
    height: 40px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: root.editing ? Theme.cursor : root.error ? Theme.bad : hit.has-hover ? Theme.muted : Theme.line;
        drop-shadow-blur: root.editing ? 10px : 0px;
        drop-shadow-color: root.editing ? Theme.glow : transparent;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
        kind: NavKind.field;
        enabled: root.enabled;
    }

    // What it holds, while it isn't edited.
    Text {
        x: 12px;
        width: parent.width - 24px;
        visible: !root.editing;
        text: root.text == "" ? root.placeholder : root.text;
        color: root.text == "" || !root.enabled ? Theme.dim : Theme.text;
        font-family: root.code ? Theme.mono : Theme.body;
        font-size: root.code ? 16px : 14px;
        font-weight: root.code ? 700 : 400;
        letter-spacing: root.code ? 1.3px : 0px;
        vertical-alignment: center;
        overflow: elide;
    }

    // The edit itself: clipped at the padding, moved to keep the caret in view.
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        clip: true;
        input := TextInput {
            x: min(0px, max(parent.width - self.width, root.scroll));
            width: max(parent.width, self.preferred-width + 2px);
            visible: root.editing;
            enabled: root.editing;
            color: Theme.text;
            font-family: root.code ? Theme.mono : Theme.body;
            font-size: root.code ? 16px : 14px;
            font-weight: root.code ? 700 : 400;
            letter-spacing: root.code ? 1.3px : 0px;
            vertical-alignment: center;
            single-line: true;
            text-cursor-width: 2px;
            selection-background-color: Theme.line;
            selection-foreground-color: Theme.text;
            edited => {
                Nav.edited(root.nav, root.nav-index, self.text);
            }
            accepted => {
                Nav.edit-done(root.nav, root.nav-index, self.text);
            }
            cursor-position-changed(at) => {
                if at.x + root.scroll < 0px {
                    root.scroll = -at.x;
                } else if at.x + root.scroll > parent.width - 2px {
                    root.scroll = parent.width - 2px - at.x;
                }
            }
        }
    }

    // An edit begins: with the letter typed, or with the text as it is, all selected.
    changed seq => {
        if hit.focused && Nav.editing {
            Nav.edit-began(root.nav, root.nav-index, root.text);
            root.scroll = 0px;
            input.text = Nav.edit-seed == "" ? root.text : Nav.edit-seed;
            input.focus();
            if Nav.edit-seed == "" {
                input.select-all();
            } else {
                input.set-selection-offsets(100000, 100000);
            }
        }
    }
    // It ends: the keys go back to the app.
    changed editing => {
        if !root.editing {
            input.clear-focus();
        }
    }
    // The app kept another text than was typed (cut, or in capitals): the field holds what was kept.
    changed text => {
        if root.editing && input.text != root.text {
            input.text = root.text;
            input.set-selection-offsets(100000, 100000);
        }
    }
}

// ---- Rows -----------------------------------------------------------------------------------------------

// What marks the chosen row of a list: a tint and a bar at its left. A list shows one of these for its chosen
// row and slides it to the next (`ListView` does, for its `chosen`; a short list of `Row`s places one itself:
// `Marker { y: chosen * pitch; height: Theme.row; animate y { duration: Theme.quick; easing: ease-out; } }`).
export component Marker inherits Rectangle {
    Rectangle {
        background: @linear-gradient(90deg, Theme.tint 0%, Theme.clear 85%);
    }

    Rectangle {
        x: 0;
        width: 2px;
        background: Theme.cursor;
    }
}

// A row's own back: lit under the pointer, and marked where the row is the chosen one and no `Marker` slides
// over its list.
export component RowBack inherits Rectangle {
    in property <bool> chosen;
    in property <bool> hover;
    Rectangle {
        background: root.chosen ? @linear-gradient(90deg, Theme.tint 0%, Theme.clear 85%) : root.hover ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
    }

    Rectangle {
        x: 0;
        width: 2px;
        background: root.chosen ? Theme.cursor : transparent;
    }
}

// A row's clicks, where the rows are a `ListView`'s (the list is what is focusable, not each row).
export component RowTouch inherits TouchArea {
    in property <string> nav;
    in property <int> nav-index;
    // A right click on it removes what it holds, as Del does (`Nav.choose("remove", ...)` after the focus comes).
    in property <bool> removable;
    clicked => {
        Nav.activate(nav, nav-index);
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            Nav.point(nav, nav-index);
            if root.removable && e.button == PointerEventButton.right {
                Nav.choose("remove", nav-index, 0);
            }
        }
    }
}

// A list row of one text, 44 tall: a row of a short list, each focusable by itself (`nav-index` its place).
export component Row inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> text;
    in property <bool> chosen;
    out property <bool> focused: hit.focused;
    height: Theme.row;
    RowBack {
        chosen: root.chosen;
        hover: hit.has-hover;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Value {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
    }
}

// An item of a menu: the main menu's (`big`: 72 tall, 36) and a menu overlay's (48 tall). The one the cursor or
// the pointer is on is lit: its bar grows and its tint sweeps in from the left.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> nav;
    in property <int> nav-index;
    in property <bool> big;
    in property <bool> danger;
    out property <bool> on: Nav.shown ? hit.focused : hit.has-hover;
    property <bool> over: Theme.audit && label.preferred-width > label.width + 0.5px;
    height: !root.big ? 48px : (Theme.phone ? 68px : 72px);
    Rectangle {
        x: 0;
        width: root.on ? parent.width : 0px;
        background: @linear-gradient(90deg, Theme.tint 0%, Theme.clear 100%);
        opacity: root.on ? 1 : 0;
        animate width, opacity {
            duration: Theme.brisk;
            easing: ease-out;
        }
    }

    Rectangle {
        x: 0;
        width: 3px;
        height: root.on ? parent.height : 0px;
        background: Theme.cursor;
        animate height {
            duration: Theme.quick;
            easing: ease-out;
        }
    }

    label := Text {
        x: root.big && !Theme.phone ? 24px : 16px;
        width: parent.width - self.x - 8px;
        text: root.text;
        color: root.danger ? Theme.bad : (root.on || !root.big ? Theme.text : Theme.muted);
        font-family: Theme.display;
        font-size: !root.big ? 14px : (Theme.phone ? 26px : 36px);
        font-weight: Theme.display-bold;
        letter-spacing: !root.big ? 0.9px : (Theme.cjk ? 1px : 2.9px);
        vertical-alignment: center;
        overflow: elide;
        animate color {
            duration: Theme.quick;
        }
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
    }

    changed over => {
        if over {
            Audit.clipped(root.text);
        }
    }
}

// A row of a menu overlay: a label and a value between arrows (the training menu's).
export component OptionRow inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> label;
    in property <string> value;
    in property <length> value-width: 170px;
    height: Theme.row;
    Value {
        x: 12px;
        width: parent.width - root.value-width - 104px;
        text: root.label;
    }

    Stepper {
        x: parent.width - self.width - 8px;
        nav: root.nav;
        nav-index: root.nav-index;
        value: root.value;
        value-width: root.value-width;
    }
}

// ---- Frames ---------------------------------------------------------------------------------------------

// A tab of a `TabBar`: its word, whether it can be gone to (one that can't stays in its place, greyed), and
// whether something in it is wrong (a mark in the error red by its word).
export struct Tab {
    text: string,
    enabled: bool,
    flagged: bool,
}

// One tab.
component TabItem inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <Tab> tab;
    in property <bool> chosen;
    property <bool> over: Theme.audit && label.preferred-width > label.width + 0.5px;
    height: 40px;
    width: label.preferred-width + (Theme.phone ? 20px : 32px);
    label := Text {
        text: root.tab.text;
        color: !root.tab.enabled ? Theme.dim : (root.chosen ? Theme.text : Theme.muted);
        font-family: Theme.display;
        font-size: Theme.phone ? 11px : 13px;
        font-weight: Theme.display-bold;
        letter-spacing: Theme.cjk ? 0.3px : (Theme.phone ? 0.6px : 1px);
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color {
            duration: Theme.brisk;
        }
    }

    // (Something in the tab is wrong: a mark at its word's upper right.)
    Rectangle {
        x: parent.width - (Theme.phone ? 9px : 13px);
        y: 9px;
        width: 5px;
        height: 5px;
        background: root.tab.flagged && root.tab.enabled ? Theme.bad : transparent;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
        enabled: root.tab.enabled;
    }

    changed over => {
        if over {
            Audit.clipped(root.tab.text);
        }
    }
}

// A row of tabs over what they switch (a build's editor): the chosen one's underline slides to the next. Each
// tab is a control (`nav`, its index its place); the screen switches on `activate`, and on the shoulders. Where
// the tabs are wider than the bar (five of them on a phone, or four in a long language), the bar is a window on
// them, which moves to keep the chosen tab whole and in its middle: no tab's word is ever cut, and the one
// before and the one after show enough to be tapped.
export component TabBar inherits Rectangle {
    in property <string> nav;
    in property <[Tab]> tabs;
    in property <int> chosen;
    // Where the chosen tab is: the underline's place.
    property <length> under-x;
    property <length> under-width;
    // How far the tabs are moved to the left.
    property <length> shift: clamp(root.under-x + root.under-width / 2 - self.width / 2, 0px, max(0px, row.preferred-width - self.width));
    height: 40px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        clip: true;
        Rectangle {
            x: -root.shift;
            width: max(root.width, row.preferred-width);
            animate x {
                duration: Theme.brisk;
                easing: ease-out;
            }
            row := HorizontalLayout {
                alignment: start;
                spacing: Theme.phone ? 0px : 4px;
                for tab[i] in root.tabs: TabItem {
                    property <int> picked: root.chosen;
                    function say() {
                        if i == root.chosen {
                            root.under-x = self.x;
                            root.under-width = self.width;
                        }
                    }
                    nav: root.nav;
                    nav-index: i;
                    tab: tab;
                    chosen: i == root.chosen;
                    init => {
                        say();
                    }
                    changed picked => {
                        say();
                    }
                    changed x => {
                        say();
                    }
                    changed width => {
                        say();
                    }

                    Rectangle { }  // (Copied in: docs/app.md §14.)
                }
            }

            Rectangle {
                x: root.under-x;
                y: parent.height - 3px;
                width: root.under-width;
                height: 3px;
                background: Theme.cursor;
                animate x, width {
                    duration: Theme.brisk;
                    easing: ease-out;
                }
            }
        }

        // Where there are more tabs past an end of the window, that end fades: a tab's word there is on its way
        // out, not cut by an edge.
        Rectangle {
            x: 0px;
            width: 36px;
            height: parent.height - 1px;
            y: 0px;
            visible: root.shift > 0px;
            background: @linear-gradient(90deg, Theme.ground-top 0%, Theme.ground-top.with-alpha(0) 100%);
        }

        Rectangle {
            x: parent.width - self.width;
            width: 36px;
            height: parent.height - 1px;
            y: 0px;
            visible: root.shift < row.preferred-width - root.width;
            background: @linear-gradient(90deg, Theme.ground-top.with-alpha(0) 0%, Theme.ground-top 100%);
        }
    }
}

// A panel's back: the cut corner, the line, and the short cyan accent at its top left, which draws from the
// left as the panel arrives. `side` gives it a player's color along its top in place of the accent (1 or 2).
export component PanelBack inherits Rectangle {
    in property <length> cut: 12px;
    in property <bool> accent: true;
    in property <int> side;
    in property <brush> fill: Theme.panel;
    draw := Tween {
        delay: 60ms;
        duration: Theme.settle;
    }

    Cut {
        cut: root.cut;
        background: root.fill;
    }

    Rectangle {
        y: 1px;
        height: 70%;
        visible: root.side != 0;
        background: root.side == 1 ? @linear-gradient(180deg, Theme.p1-tint 0%, transparent 100%) : @linear-gradient(180deg, Theme.p2-tint 0%, transparent 100%);
    }

    Rectangle {
        x: 0;
        y: 0;
        width: (root.side != 0 ? parent.width : 72px) * draw.t;
        height: 2px;
        visible: root.accent || root.side != 0;
        background: root.side == 1 ? Theme.p1 : root.side == 2 ? Theme.p2 : @linear-gradient(90deg, Theme.cursor 0%, Theme.clear 100%);
    }
}

// What a build holds sits in one of these (rule 11); the list to pick from beside it has no frame.
export component Panel inherits Rectangle {
    in property <length> cut: 12px;
    in property <bool> accent: true;
    in property <int> side;
    PanelBack {
        cut: root.cut;
        accent: root.accent;
        side: root.side;
    }

    @children
}

// A line across.
export component Rule inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// A group's title over its line (a settings group, a menu's section). It sits nearer its own group than the
// one above: 8 of room over it, but for a page's first.
export component GroupTitle inherits Rectangle {
    in property <string> text;
    in property <bool> first;
    property <length> lead: root.first ? 0px : 8px;
    height: 22px + root.lead;
    Label {
        x: 0;
        y: root.lead;
        width: parent.width;
        height: 20px;
        text: root.text;
    }

    Rule {
        y: parent.height - 1px;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}

// A progress bar: 4 tall, its fill lit, filling smoothly under a highlight that moves along it.
export component Bar inherits Rectangle {
    // 0 to 1.
    in property <float> value;
    property <float> sweep: Theme.motion && root.value < 1 ? mod(animation-tick(), 1.1s) / 1.1s : 0;
    height: 4px;
    Rectangle {
        background: Theme.raised;
    }

    fill := Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        background: Theme.cursor;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.glow;
        clip: true;
        animate width {
            duration: Theme.brisk;
            easing: ease-out;
        }
        Rectangle {
            x: root.sweep * (parent.width + 56px) - 56px;
            width: 56px;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffffc0 50%, #ffffff00 100%);
            visible: Theme.motion && root.value < 1;
        }
    }
}

// The connection's four bars: how many are lit (0 to 4), green, then amber, then red as the link worsens.
export component Bars inherits Rectangle {
    in property <int> level: 4;
    property <color> tone: root.level >= 3 ? Theme.good : root.level == 2 ? Theme.action : Theme.bad;
    width: 22px;
    height: 14px;
    Rectangle {
        x: 0;
        y: 9px;
        width: 4px;
        height: 5px;
        background: root.level >= 1 ? root.tone : Theme.dim;
    }

    Rectangle {
        x: 6px;
        y: 6px;
        width: 4px;
        height: 8px;
        background: root.level >= 2 ? root.tone : Theme.dim;
    }

    Rectangle {
        x: 12px;
        y: 3px;
        width: 4px;
        height: 11px;
        background: root.level >= 3 ? root.tone : Theme.dim;
    }

    Rectangle {
        x: 18px;
        y: 0;
        width: 4px;
        height: 14px;
        background: root.level >= 4 ? root.tone : Theme.dim;
    }
}

// ---- Scrolling ------------------------------------------------------------------------------------------

// The scrollbar's thumb, in the 12 reserved at a scrolling thing's right whether or not it shows.
component Thumb inherits Rectangle {
    in property <length> view;
    in property <length> content;
    in property <length> scroll;
    width: 4px;
    Rectangle {
        x: 0;
        y: root.content > 0 ? parent.height * root.scroll / root.content : 0px;
        height: root.content > 0 ? parent.height * root.view / root.content : 0px;
        visible: root.content > root.view + 0.5px;
        background: Theme.line;
    }
}

// What a scrolling page or a list does besides holding what it scrolls, in one leaf of its own (each container
// is copied into every use, as everything with something put inside it is; this is compiled once): it is
// registered for the focus and tells the app where it is, it scrolls what the app asks for into view smoothly,
// it works out which of a list's rows are in view, and it draws a list's chosen mark and the scrollbar's thumb.
// The container places it over its whole box, behind the flickable, and links the flickable's `content-y` to
// its own. (The mark is drawn behind the rows as it was inside the flickable: in a clip of the flickable's box,
// where the flickable puts what it scrolls.)
component Scroller inherits Rectangle {
    in property <string> nav;
    // A list (the app is told its rows), or else a page.
    in property <bool> list;
    // A list's rows: how many, their pitch and their height; and the row marked, or -1.
    in property <int> count;
    in property <length> pitch;
    in property <length> row-height;
    in property <int> chosen: -1;
    // How tall what is scrolled is, as the container says it.
    in property <length> content;
    // The flickable's own, linked both ways: a drag moves it, a reveal sets it.
    in-out property <length> content-y;
    // The flickable's width (12 at the right are the scrollbar's, whether or not it shows) and its content's
    // height (never less than the view).
    out property <length> view-width: self.width - 12px;
    out property <length> content-height: max(self.height, root.content);
    out property <length> scroll: -root.content-y;
    // Where what is scrolled is put from where the flickable has it, while a reveal slides it there.
    out property <length> offset: root.slid * (1 - slide.t);
    // The first row to make, and how many: those in view, and those a slide under way passes.
    out property <int> first: max(0, floor(min(root.scroll, root.scroll - root.offset) / root.pitch));
    out property <int> shown: max(0, min(root.count - root.first, ceil((self.height + abs(root.offset)) / root.pitch) + 1));
    // The row the focus is on, or -1.
    out property <int> focused-row: Nav.id == root.nav ? Nav.index : -1;
    property <int> seq: Nav.reveal-seq;
    property <[int]> token;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    property <length> slid;
    property <int> slides;
    function place() {
        if root.list {
            Nav.page(root.nav, root.ax, root.ay, root.view-width, self.height, root.content-height, root.scroll);
            Nav.list(root.nav, root.count, root.pitch, root.row-height, root.scroll, root.view-width);
        } else {
            Nav.page(root.nav, root.ax, root.ay, root.view-width, self.height, root.content, root.scroll);
        }
    }
    slide := Tween {
        seq: root.slides;
        duration: Theme.brisk;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.view-width;
        height: root.height;
        clip: true;
        Rectangle {
            x: 0;
            y: root.content-y + root.offset;
            width: root.view-width;
            height: root.content-height;
            Marker {
                x: 0;
                y: max(0, root.chosen) * root.pitch;
                height: root.row-height;
                visible: root.chosen >= 0 && root.chosen < root.count;
                animate y {
                    duration: Theme.quick;
                    easing: ease-out;
                }

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }
    }

    Thumb {
        x: parent.width - 4px;
        view: root.height;
        content: root.content-height;
        scroll: root.scroll - root.offset;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    init => {
        token = Nav.register(root.nav, 0, root.list ? NavKind.list : NavKind.page);
        place();
    }
    changed ax => {
        place();
    }
    changed ay => {
        place();
    }
    changed width => {
        place();
    }
    changed height => {
        place();
    }
    changed count => {
        if root.list {
            place();
        }
    }
    changed scroll => {
        if root.list {
            place();
        }
        Nav.scrolled();
    }
    changed seq => {
        if Nav.reveal-id == root.nav {
            root.slid = root.content-y;
            root.content-y = clamp(root.content-y - Nav.reveal-dy, min(0px, self.height - root.content-height), 0px);
            root.slid = clamp(root.slid - root.content-y, -self.height, self.height);
            root.slides += 1;
        }
    }
}

// A page that scrolls (the settings). The controls it holds have its name as their prefix (`set.name` on the
// page `set.`): the app scrolls the focused one into view, and passes by those out of view when the focus comes
// from outside. Put what it holds inside it, `view-width` wide, and say how tall that is. A scroll the app asks
// for is smooth: the page is put where it goes at once, and what it holds slides there.
export component ScrollPage inherits Rectangle {
    in property <string> nav;
    in property <length> content-height;
    out property <length> view-width: flick.width;
    out property <length> scroll: scroller.scroll;
    scroller := Scroller {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        nav: root.nav;
        content: root.content-height;
        content-y <=> flick.content-y;
    }

    flick := Flickable {
        x: 0;
        y: 0;
        width: scroller.view-width;
        content-width: self.width;
        content-height: scroller.content-height;
        Rectangle {
            y: scroller.offset;
            @children
        }
    }
}

// A list of rows of one height (rule 9), of any length: only the rows in view exist. The list is what is
// focused (`Nav.id` its name, `Nav.index` the row), Up and Down go through its rows, and the focused row is
// scrolled into view, smoothly. `chosen` is the row marked (the build shown beside the list): its bar and tint
// slide to the next. Its rows are the screen's own, laid out by what the list says:
//
//     list := ListView { nav: "builds"; count: View.rows.length; row-height: 52px; chosen: View.chosen; }
//     // inside it:
//     for slot in list.shown: BuildRow {
//         property <int> at: list.first + slot;
//         y: self.at * list.pitch;  width: list.row-width;
//         build: View.rows[self.at];
//         nav: "builds";  nav-index: self.at;
//     }
//
// A row holds its own `RowTouch` (as `BuildRow` and the folder's rows do). A row used in one list is copied into
// it (its use is given a bare child); one in several lists (`BuildRow`) is shared (docs/app.md §14). What the
// list does besides holding its rows is a `Scroller`, compiled once.
export component ListView inherits Rectangle {
    in property <string> nav;
    in property <int> count;
    in property <length> row-height: Theme.row;
    in property <length> gap: 2px;
    // The row marked, or -1.
    in property <int> chosen: -1;
    // A mouse's drag scrolls it (a touch's always does).
    in property <bool> mouse-pan: true;
    out property <length> pitch: root.row-height + root.gap;
    out property <length> scroll: scroller.scroll;
    out property <int> first: scroller.first;
    out property <int> shown: scroller.shown;
    out property <length> row-width: flick.width;
    out property <int> focused-row: scroller.focused-row;
    scroller := Scroller {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        nav: root.nav;
        list: true;
        count: root.count;
        pitch: root.pitch;
        row-height: root.row-height;
        chosen: root.chosen;
        content: root.count * root.pitch - root.gap;
        content-y <=> flick.content-y;
    }

    flick := Flickable {
        x: 0;
        y: 0;
        width: scroller.view-width;
        content-width: self.width;
        content-height: scroller.content-height;
        mouse-drag-pan-enabled: root.mouse-pan;
        Rectangle {
            y: scroller.offset;
            @children
        }
    }
}
