// What every screen sits in: the state the app shows (`Shell`), the header and the footer, the page a menu
// screen is laid out on, the ground behind it, the cursor over it, and the dialog and the list of choices that
// open over a screen.

import { Theme, Audit } from "theme.slint";
import { Nav, NavKind, Focusable } from "nav.slint";
import { Cut, Label, Note, Value, Mono, Heading, Button, ButtonKind, Stepper, Chevron, RowBack } from "widgets.slint";

// The screens a player goes between. Loading, the two cards before a battle and the battle are states of the
// shell over them (`Shell.loading`, `Shell.versus`, `Shell.battle`).
export enum Screen {
    menu,
    play,
    training,
    builds,
    replays,
    settings,
}

// What a battle on screen is, which says whose menu Start opens.
export enum BattleKind {
    none,
    training,
    online,
    replay,
}

// A pad's button in a key hint.
export enum PadButton {
    none,
    // The D-pad or the stick.
    move,
    south,
    east,
    west,
    north,
    shoulders,
    start,
    select,
}

// A key hint: the key's cap (and a second one), the pad's button, and what they do.
export struct Hint {
    key: string,
    key2: string,
    pad: PadButton,
    text: string,
}

export struct DialogButton {
    text: string,
    kind: ButtonKind,
    danger: bool,
}

// A side's card on the screen before a battle: who (YOU, OPPONENT, DUMMY), their name, and what they bring. An
// opponent's online says their name alone.
export struct VersusCard {
    role: string,
    name: string,
    build: string,
    version: string,
    navi: string,
    progress: float,
}

export global Shell {
    in property <Screen> screen;

    // The selected game: its name as shown (EXE6), and whether the header offers to change it. A screen locks
    // it where the game can't change (inside a build, the lobby, a replay): the name stays, without its arrows.
    in property <string> game;
    in property <bool> game-locked;
    // The footer's status where a screen has none of its own: the player's name.
    in property <string> player;
    in property <string> version;

    // The selected game isn't loaded: the bar, in place of the screen.
    in property <bool> loading;
    in property <float> loading-progress;
    // No game can be played, and where a pack is looked for.
    in property <bool> no-games;
    in property <string> packs-folder;

    // The two cards before a battle.
    in property <bool> versus;
    in property <VersusCard> versus-left;
    in property <VersusCard> versus-right;

    // The battle running, and whether its picture fills the window (else its screen shows it in a `Picture`
    // of its own). `battle-menu` is nettai's menu over it (Start or Esc).
    in property <BattleKind> battle;
    in property <bool> battle-full;
    in property <bool> battle-menu;
    // The connection's corner: shown online; its bars (0 to 4), the round trip in ms, and the seconds the link
    // has been down while it is (-1: it is up).
    in property <bool> connection-shown;
    in property <int> connection-level;
    in property <int> connection-ping;
    in property <int> connection-down: -1;

    // The battle's picture (one texture, written in place), and its size as drawn: a whole multiple of 240 by
    // 160 display pixels. A screen shows it with a `Picture`, which says how much room it has.
    in property <image> picture;
    in property <length> picture-width;
    in property <length> picture-height;
    in-out property <length> picture-room-width;
    in-out property <length> picture-room-height;

    // A dialog over the screen.
    in property <bool> dialog;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <[DialogButton]> dialog-buttons;

    // A select's choices, open under it (on a phone, a sheet from the bottom).
    in property <bool> picker;
    in property <[string]> picker-options;
    in property <int> picker-chosen;
    in property <length> picker-x;
    in property <length> picker-y;
    in property <length> picker-width;

    // The keys bound to L and R, for the hints (the menus' previous and next).
    in property <string> key-l: "A";
    in property <string> key-r: "S";
    // The ground's hexagons, as a path over the window in units.
    in property <string> hexagons;
    // The on-screen pad's buttons (a phone, in battle): a GBA button's bit, pressed or let go.
    callback touch(int, bool);
}

// What can go wrong, as the player reads it (docs/design/app-ui.md §7; the app's `UserError`). The code's own
// words for it go to the log file, never here.
export enum ErrorKind {
    server-unreachable,
    no-such-match,
    match-full,
    version-mismatch,
    build-unusable,
    connection-lost,
    replay-version,
    wrong-game-save,
    other,
}

export global Errors {
    // The whole of it on one line: a field's reserved line, a row's end. `detail` is the rule a build breaks
    // (a sentence of the catalogs), or the game a save was to be of.
    public pure function line(kind: ErrorKind, detail: string) -> string {
        if kind == ErrorKind.server-unreachable {
            return @tr("Can't reach the server. Check your connection.");
        }
        if kind == ErrorKind.no-such-match {
            return @tr("No match with that code.");
        }
        if kind == ErrorKind.match-full {
            return @tr("That match is full.");
        }
        if kind == ErrorKind.version-mismatch {
            return @tr("Your opponent has a different version of nettai. You both need the latest.");
        }
        if kind == ErrorKind.build-unusable {
            return @tr("This build can't be used: {}.", detail);
        }
        if kind == ErrorKind.connection-lost {
            return @tr("Connection lost. The match has ended.");
        }
        if kind == ErrorKind.replay-version {
            return @tr("This replay is from a different version and can't be played.");
        }
        if kind == ErrorKind.wrong-game-save {
            return @tr("Not an {} save.", detail);
        }
        return @tr("Something went wrong. Details are in the log file.");
    }
    // A dialog's title for it, and its message under the title.
    public pure function title(kind: ErrorKind, detail: string) -> string {
        if kind == ErrorKind.server-unreachable {
            return @tr("Can't reach the server");
        }
        if kind == ErrorKind.no-such-match {
            return @tr("No match with that code");
        }
        if kind == ErrorKind.match-full {
            return @tr("That match is full");
        }
        if kind == ErrorKind.version-mismatch {
            return @tr("Different versions");
        }
        if kind == ErrorKind.build-unusable {
            return @tr("This build can't be used");
        }
        if kind == ErrorKind.connection-lost {
            return @tr("Connection lost");
        }
        if kind == ErrorKind.replay-version {
            return @tr("Different version");
        }
        if kind == ErrorKind.wrong-game-save {
            return @tr("Not an {} save", detail);
        }
        return @tr("Something went wrong");
    }
    public pure function body(kind: ErrorKind, detail: string) -> string {
        if kind == ErrorKind.server-unreachable {
            return @tr("Check your connection.");
        }
        if kind == ErrorKind.no-such-match {
            return "";
        }
        if kind == ErrorKind.match-full {
            return "";
        }
        if kind == ErrorKind.version-mismatch {
            return @tr("Your opponent has a different version of nettai. You both need the latest.");
        }
        if kind == ErrorKind.build-unusable {
            return @tr("{}.", detail);
        }
        if kind == ErrorKind.connection-lost {
            return @tr("The match has ended.");
        }
        if kind == ErrorKind.replay-version {
            return @tr("This replay is from a different version and can't be played.");
        }
        if kind == ErrorKind.wrong-game-save {
            return "";
        }
        return @tr("Details are in the log file.");
    }
    // What closes a dialog that only says something.
    public pure function ok() -> string {
        return @tr("OK");
    }
}

// ---- The ground and the cursor -------------------------------------------------------------------------

// Dark navy, top to bottom, under a faint blue glow from the top right and the hexagon field.
export component Backdrop {
    Rectangle {
        background: @linear-gradient(180deg, Theme.ground-top 0%, Theme.ground-bottom 100%);
    }

    Rectangle {
        x: parent.width * 0.88 - self.width / 2;
        y: parent.height * -0.1 - self.height / 2;
        width: parent.width * 1.7;
        height: self.width;
        background: @radial-gradient(circle, Theme.ground-glow 0%, transparent 62%);
    }

    Path {
        commands: Shell.hexagons;
        stroke: Theme.hexagons;
        stroke-width: 1px;
        viewbox-width: parent.width / 1px;
        viewbox-height: parent.height / 1px;
        clip: true;
    }
}

// One corner of the cursor: two arms, 10 long and 2 thick, lit.
component Corner {
    in property <bool> right;
    in property <bool> bottom;
    width: 10px;
    height: 10px;
    Rectangle {
        x: 0;
        y: root.bottom ? 8px : 0px;
        height: 2px;
        background: Theme.cursor;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.glow;
    }

    Rectangle {
        x: root.right ? 8px : 0px;
        y: 0;
        width: 2px;
        background: Theme.cursor;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.glow;
    }
}

// The cursor: four corner brackets, 5 outside the focused control. One object that slides from control to
// control, drawn over the layout: it takes no space, and nothing under it changes size. It shows only while a
// keyboard or a pad is the last thing used.
export component Cursor {
    Corner {
        x: 0;
        y: 0;
    }

    Corner {
        x: parent.width - 10px;
        y: 0;
        right: true;
    }

    Corner {
        x: 0;
        y: parent.height - 10px;
        bottom: true;
    }

    Corner {
        x: parent.width - 10px;
        y: parent.height - 10px;
        right: true;
        bottom: true;
    }
}

// ---- The header and the footer -------------------------------------------------------------------------

// The header, the same on every menu screen: Back, naming where it goes; the screen's title with a cyan bar
// before it; at the right the game, between its arrows where it can change. The main menu has the logo in
// Back's and the title's place (`logo`); a screen with no game to choose (the settings) leaves it out.
export component Header {
    in property <string> title;
    in property <string> back;
    in property <bool> logo;
    in property <bool> game: true;
    property <length> pad: Theme.margin;
    property <length> back-width: Theme.phone ? 32px : back-text.preferred-width + 37px;
    property <bool> over: Theme.audit && (title-text.preferred-width > title-text.width + 0.5px);
    height: Theme.header;
    Rectangle {
        background: Theme.bar;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    // The logo.
    Text {
        x: root.pad;
        visible: root.logo;
        text: "nettai";
        color: Theme.text;
        font-family: "Chakra Petch";
        font-size: Theme.phone ? 22px : 26px;
        font-weight: 700;
        letter-spacing: 1px;
        vertical-alignment: center;
    }

    // Back.
    Rectangle {
        x: root.pad;
        width: root.back-width;
        height: 30px;
        visible: !root.logo;
        border-width: 1px;
        border-color: Theme.line;
        background: back-hit.pressed ? Theme.line : (back-hit.has-hover ? Theme.tint : transparent);
        Chevron {
            x: Theme.phone ? 13px : 12px;
        }

        back-text := Text {
            x: 25px;
            visible: !Theme.phone;
            text: root.back;
            color: Theme.muted;
            font-family: Theme.display;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: Theme.cjk ? 0.3px : 1px;
            vertical-alignment: center;
        }

        back-hit := Focusable {
            nav: root.logo ? "" : "back";
        }
    }

    // The title.
    Rectangle {
        x: root.pad + root.back-width + (Theme.phone ? 12px : 16px);
        width: 3px;
        height: 23px;
        visible: !root.logo;
        background: Theme.cursor;
    }

    title-text := Text {
        x: root.pad + root.back-width + (Theme.phone ? 27px : 31px);
        width: parent.width - self.x - root.pad - (root.game ? 172px : 0px);
        visible: !root.logo;
        text: root.title;
        color: Theme.text;
        font-family: Theme.display;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: Theme.title-tracking;
        vertical-alignment: center;
        overflow: elide;
    }

    // The game.
    Stepper {
        x: parent.width - root.pad - self.width;
        visible: root.game;
        nav: root.game ? "game" : "";
        value: Shell.game;
        title: true;
        locked: Shell.game-locked;
    }

    changed over => {
        if over {
            Audit.clipped(root.title);
        }
    }
}

// A key's cap. (With no text it is nothing, and takes no room: `visible` on a component's own root would copy
// the component into every user.)
component KeyCap {
    in property <string> text;
    height: 22px;
    width: root.text == "" ? 0px : max(22px, cap.preferred-width + 12px);
    Rectangle {
        border-width: root.text == "" ? 0px : 1px;
        border-color: Theme.line;
        border-radius: 2px;
    }

    Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: max(0px, parent.width - 2px);
        height: 1px;
        background: Theme.line;
    }

    cap := Text {
        text: root.text;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A pad's face button, by its place: the four as a diamond, the one meant filled.
component FaceButton {
    in property <PadButton> button;
    width: 20px;
    height: 20px;
    Rectangle {
        x: 7px;
        y: 0px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.muted;
        background: root.button == PadButton.north ? Theme.text : transparent;
    }

    Rectangle {
        x: 0px;
        y: 7px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.muted;
        background: root.button == PadButton.west ? Theme.text : transparent;
    }

    Rectangle {
        x: 14px;
        y: 7px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.muted;
        background: root.button == PadButton.east ? Theme.text : transparent;
    }

    Rectangle {
        x: 7px;
        y: 14px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.muted;
        background: root.button == PadButton.south ? Theme.text : transparent;
    }
}

// The D-pad.
component Dpad {
    width: 18px;
    height: 18px;
    Rectangle {
        x: 6px;
        width: 6px;
        border-radius: 1px;
        background: Theme.muted;
    }

    Rectangle {
        y: 6px;
        height: 6px;
        border-radius: 1px;
        background: Theme.muted;
    }
}

// One hint: the key's caps or the pad's button, by what was last used, and what it does. (Its parts are all
// there and sized to nothing where they don't show: an `if` each would be a component each.)
component HintView {
    in property <Hint> hint;
    property <bool> face: root.hint.pad == PadButton.south || root.hint.pad == PadButton.east || root.hint.pad == PadButton.west || root.hint.pad == PadButton.north;
    property <string> pad-cap: root.hint.pad == PadButton.start ? "START" : (root.hint.pad == PadButton.select ? "SELECT" : (root.hint.pad == PadButton.shoulders ? "L" : ""));
    property <length> glyph: Nav.pad && (root.face || root.hint.pad == PadButton.move) ? 25px : 0px;
    property <bool> over: Theme.audit && label.preferred-width > label.width + 0.5px;
    property <bool> shown: Nav.pad ? root.hint.pad != PadButton.none : root.hint.key != "";
    width: root.shown ? label.x + label.preferred-width : 0px;
    FaceButton {
        x: 0;
        visible: root.shown && Nav.pad && root.face;
        button: root.hint.pad;
    }

    Dpad {
        x: 1px;
        visible: root.shown && Nav.pad && root.hint.pad == PadButton.move;
    }

    first := KeyCap {
        x: root.glyph;
        text: !root.shown ? "" : (Nav.pad ? root.pad-cap : root.hint.key);
    }

    second := KeyCap {
        x: first.x + first.width + (self.width > 0 ? 5px : 0px);
        text: !root.shown ? "" : (Nav.pad ? (root.hint.pad == PadButton.shoulders ? "R" : "") : root.hint.key2);
    }

    label := Text {
        x: second.x + second.width + (second.x + second.width > root.glyph ? 5px : 0px);
        width: self.preferred-width;
        text: root.shown ? root.hint.text : "";
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
    }

    changed over => {
        if over {
            Audit.clipped(root.hint.text);
        }
    }
}

// The footer, the same on every menu screen: the key hints at the left, one short status at the right. A phone
// has none.
export component Footer {
    in property <[Hint]> hints;
    in property <string> status;
    height: Theme.footer;
    Rectangle {
        visible: !Theme.phone;
        background: Theme.bar;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            spacing: 24px;
            alignment: start;
            for hint in root.hints: HintView {
                hint: hint;
            }
        }

        Text {
            x: parent.width - 32px - self.width;
            width: 280px;
            text: root.status;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A menu screen: the header, the footer, and between them the body, inside the page margins. What a screen puts
// inside a `Page` is laid out in the body.
export component Page {
    in property <string> title;
    in property <string> back;
    in property <bool> logo;
    in property <bool> game: true;
    in property <[Hint]> hints;
    in property <string> status: Shell.player;
    out property <length> body-width: body.width;
    out property <length> body-height: body.height;
    Header {
        y: 0;
        title: root.title;
        back: root.back;
        logo: root.logo;
        game: root.game;
    }

    body := Rectangle {
        x: Theme.margin;
        y: Theme.header + (Theme.phone ? 16px : 24px);
        width: parent.width - 2 * Theme.margin;
        height: parent.height - Theme.header - Theme.footer - (Theme.phone ? 32px : 48px);
        @children
    }

    Footer {
        y: parent.height - self.height;
        hints: root.hints;
        status: root.status;
    }
}

// ---- The battle's picture -------------------------------------------------------------------------------

// The battle's picture, in the middle of the room it is given: the largest whole multiple of 240 by 160 display
// pixels that fits (the app sizes it: `Shell.picture-width`). The box keeps its size whatever the multiple, so
// nothing beside it moves. One is shown at a time.
export component Picture {
    in property <brush> ground: #000000;
    Rectangle {
        background: root.ground;
    }

    Image {
        width: Shell.picture-width;
        height: Shell.picture-height;
        source: Shell.picture;
        image-rendering: pixelated;
    }

    init => {
        Shell.picture-room-width = self.width;
        Shell.picture-room-height = self.height;
    }
    changed width => {
        Shell.picture-room-width = self.width;
    }
    changed height => {
        Shell.picture-room-height = self.height;
    }
}

// ---- Over the screen ------------------------------------------------------------------------------------

// A dialog: a failure that ends what the player was doing, or a question asked once. The screen behind it is
// shaded and out of the keys' reach.
export component DialogLayer {
    property <length> box-width: min(root.width - 32px, 460px);
    property <length> box-height: 24px + 26px + 12px + message.height + 24px + 40px + 24px;
    Rectangle {
        background: Theme.shade;
        TouchArea { }
    }

    Rectangle {
        width: root.box-width;
        height: root.box-height;
        Cut {
            cut: 18px;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 72px;
            height: 2px;
            background: @linear-gradient(90deg, Theme.cursor 0%, Theme.clear 100%);
        }

        Heading {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: 26px;
            text: Shell.dialog-title;
        }

        message := Text {
            x: 24px;
            y: 62px;
            width: parent.width - 48px;
            height: self.preferred-height;
            text: Shell.dialog-message;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 14px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            x: 24px;
            y: parent.height - 64px;
            width: parent.width - 48px;
            height: 40px;
            spacing: 12px;
            alignment: end;
            for button[i] in Shell.dialog-buttons: Button {
                nav: "dialog.button";
                nav-index: i;
                text: button.text;
                kind: button.kind;
                danger: button.danger;
            }
        }
    }
}

// A choice of a select's list.
component PickRow {
    in property <string> text;
    in property <int> nav-index;
    in property <bool> chosen;
    height: Theme.row;
    RowBack {
        chosen: root.chosen;
        hover: hit.has-hover;
    }

    Value {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        font-weight: 400;
    }

    hit := Focusable {
        nav: "pick.option";
        nav-index: root.nav-index;
    }
}

// A select's choices: a list under it, or on a phone a sheet from the bottom.
export component PickerLayer {
    property <length> list-height: Shell.picker-options.length * Theme.row + 2px;
    TouchArea {
        clicked => {
            Nav.activate("pick.close", 0);
        }
    }

    Rectangle {
        background: Theme.phone ? Theme.shade : transparent;
    }

    Rectangle {
        x: Theme.phone ? 0px : Shell.picker-x;
        y: Theme.phone ? parent.height - self.height : Shell.picker-y;
        width: Theme.phone ? parent.width : Shell.picker-width;
        height: root.list-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000a0;
        for option[i] in Shell.picker-options: PickRow {
            x: 1px;
            y: 1px + i * Theme.row;
            width: parent.width - 2px;
            text: option;
            nav-index: i;
            chosen: i == Shell.picker-chosen;
        }
    }
}
