// Practice (docs/design/app-ui.md §6): you against a dummy set up from a menu while practicing. Its Rust half
// is src/screens/practice.rs.
//
// Practice has no screen of its own: PLAY's PRACTICE goes straight into its battle, which fills the window. Three
// things are here. The practice menu (`PracticeMenu`): Start or Esc in a practice battle (and open as one of
// Practice's own starts), the battle held behind it; its rows are a model the Rust half makes, so a row is added
// there and worded here (`PracticeView.label` and `value`). The input display (`PracticeInputs`): both sides'
// buttons, lit as they are held, in a corner of the picture. And the dummy that fights getting ready
// (`PracticeGettingReady`), in the corner netplay's connection takes.

import { Theme, Audit, I18n } from "../theme.slint";
import { NavKind, Focusable } from "../nav.slint";
import { Shell } from "../shell.slint";
import { Button, ButtonKind, Select, Stepper, MenuItem, GroupTitle, Label, ScrollPage, Mono, Bar } from "../widgets.slint";
import { MenuOverlay } from "battle.slint";
import { InputDisplay } from "../inputs.slint";

// What a row of the practice menu is.
export enum PracticeOption {
    // A row another screen added (Copy invite code): its text is the row's own.
    added,
    // The groups' titles (the user: "having an "arena" field under "arena" is so weird"): the dummy's, the
    // stage's (where the battle is, and its music), the battle's options and the input display.
    dummy,
    stage,
    options,
    // The dummy's build: one of the game's builds that can be played (the row's text is its name), the player's
    // own at first. A select of them, in a session of Practice's own.
    dummys-build,
    // EDIT under it: a button in the controls' column, which opens the dummy's build in Builds' editor.
    edit-dummy,
    // A label and a value between arrows.
    action,
    // How well the dummy fights: under the Action while it is Fights.
    level,
    // Their values are the content's arenas and backgrounds after Random: the row's text is the one chosen (an
    // arena's place, "12 / 47"; a background's name; none: Random).
    arena,
    background,
    // The battle's music (the player's one pick for the visit): the row's text is its name.
    music,
    // The headings of the rows of two columns under them: YOU and DUMMY, over the player's column and the dummy's.
    columns,
    // Rows of two columns, the player's value and the dummy's side by side (the user: "settings that are
    // player/dummy are in a 2 column view rather than sequentially"). Each side's HP refilling or not.
    hp,
    // Each side's navi held in an emotion of the game's (the user: "add a setting for mood", then "instead of mood
    // it should be emotion"): Normal, as the game goes, then the game's own (a side's text is its name, the
    // content's words: Full Synchro and Angry, then BN4's and BN5's Worried and Evil, BN6's Tired and Very tired).
    emotion,
    custom-gauge,
    chip-draw,
    input-display,
    // Netplay's input delay, in frames (the one setting: changed here, it is changed for netplay too).
    input-delay,
}

// A row of the practice menu: what it is, the value it has (its place among the row's values), and for a row
// another screen added, its text; for Arena and Background, the chosen one's picture (none: Random, or not drawn
// yet). A row of two columns' `value` and `text` are the player's side's, `dummys-value` and `dummys-text` the
// dummy's.
export struct PracticeRow {
    option: PracticeOption,
    value: int,
    text: string,
    picture: image,
    dummys-value: int,
    dummys-text: string,
}

// The dummy that fights getting ready: shown while its chips' fingerprints are being made (the first time a
// folder's chips are met, a few seconds), `made` of the `asked` (src/screens/practice.rs, `watch_ai`).
export struct GettingReady {
    shown: bool,
    made: int,
    asked: int,
}

// What Practice shows: src/screens/practice.rs sets these. (A struct or an enum a property here uses reaches
// Rust by that use: nothing is added to app.slint for it.)
export global PracticeView {
    // ---- A session.
    // The two builds' names, as the menu's line under its title says them.
    in property <string> session-yours;
    in property <string> session-dummys;
    // The menu's rows, and whether it has EXIT (a session Practice started itself, or one another screen gave its
    // own, `exit-word`: Play's CANCEL INVITE).
    in property <[PracticeRow]> rows;
    in property <bool> leave;
    in property <string> exit-word;
    // The input display: shown, and the buttons each side holds (the GBA's bits).
    in property <bool> inputs;
    in property <int> held-yours;
    in property <int> held-dummys;
    // The dummy that fights getting ready.
    in property <GettingReady> getting-ready;
    // The dummy's Action offers Fights (the app built with its `ai` feature): its values are Stands still, Moves
    // around, Fights and A second pad; without it, Stands still, Moves around and A second pad.
    in property <bool> fights;

    // ---- What the Rust half says in words.
    // Who the two sides are: the two cards before a battle, and the menu's two columns' headings.
    out property <string> you: I18n.upper(@tr("You"));
    out property <string> dummy: I18n.upper(@tr("Dummy"));
    // The first of the Arena and Background rows' values: each round's place picked from the seed, as a match's
    // is.
    out property <string> random: @tr("Random");
    // The line beside MENU on a phone.
    pure public function round-note(round: int) -> string {
        return @tr("Practice · Round {}", round);
    }

    // ---- The menu's words: a row's label (a group's title, in capitals), and what its value says.
    pure public function label(option: PracticeOption) -> string {
        if option == PracticeOption.dummy {
            return I18n.upper(@tr("Dummy"));
        }
        if option == PracticeOption.stage {
            return I18n.upper(@tr("Stage"));
        }
        if option == PracticeOption.options {
            return I18n.upper(@tr("Options"));
        }
        if option == PracticeOption.dummys-build {
            return @tr("Dummy's build");
        }
        if option == PracticeOption.action {
            return @tr("Action");
        }
        if option == PracticeOption.level {
            return @tr("Level");
        }
        if option == PracticeOption.arena {
            return @tr("Arena");
        }
        if option == PracticeOption.background {
            return @tr("Background");
        }
        if option == PracticeOption.music {
            return @tr("Music");
        }
        if option == PracticeOption.hp {
            return @tr("HP");
        }
        if option == PracticeOption.emotion {
            return @tr("Emotion");
        }
        if option == PracticeOption.custom-gauge {
            return @tr("Custom gauge");
        }
        if option == PracticeOption.chip-draw {
            return @tr("Chip draw");
        }
        if option == PracticeOption.input-display {
            return @tr("Input display");
        }
        if option == PracticeOption.input-delay {
            return @tr("Input delay");
        }
        return "";
    }
    pure public function value(option: PracticeOption, value: int) -> string {
        if option == PracticeOption.action {
            return value == 0 ? @tr("Stands still") : (value == 1 ? @tr("Moves around") : (value == 2 && PracticeView.fights ? @tr("Fights") : @tr("A second pad")));
        }
        if option == PracticeOption.level {
            return value == 0 ? @tr("level" => "Easy") : (value == 1 ? @tr("level" => "Normal") : @tr("level" => "Hard"));
        }
        if option == PracticeOption.hp {
            return value == 0 ? @tr("Normal") : @tr("Refills");
        }
        if option == PracticeOption.custom-gauge {
            return value == 0 ? @tr("Normal") : @tr("Always full");
        }
        // (Its other values are the sides' texts: the game's emotions.)
        if option == PracticeOption.emotion {
            return @tr("Normal");
        }
        if option == PracticeOption.chip-draw {
            return value == 0 ? @tr("Shuffled") : @tr("Folder order");
        }
        if option == PracticeOption.input-display {
            return value == 0 ? @tr("Off") : @tr("On");
        }
        // (Frames, a bare number as Settings and the lobby say it.)
        if option == PracticeOption.input-delay {
            return "\{value}";
        }
        // (Any other of their values is the row's text: a name of the content's.)
        if option == PracticeOption.arena || option == PracticeOption.background {
            return PracticeView.random;
        }
        return "";
    }
}

// ---- The practice menu ------------------------------------------------------------------------------------

// A row of the practice menu, whatever it is: a group's title; a label and a value between arrows, the row
// focused as a whole (on a phone the label is over the arrows), or for the Dummy's build, Arena, Background and
// Music the value in a box that opens the values (Arena's and Background's a grid of their pictures, the chosen
// one's before its name); a row of two columns (HP, Emotion), a label and two values between arrows, the
// player's and the dummy's, each focused alone, under a row of their headings (YOU, DUMMY) as Settings' controls
// are under KEY and PAD; EDIT, a button under the Dummy's build in the controls' column; or a row another screen
// added. Its controls are 40 tall (36 on a phone), its steppers, selects and EDIT one column's width so they line
// up (the user's "option 1", docs/design/app-ui.md §2.44), a row of two columns' two narrower steppers ending
// where they do; the row is bare, 52 tall. (One component under the menu's one `for`: its parts are all there,
// and those the row isn't don't show.)
component MenuRow inherits Rectangle {
    in property <PracticeRow> entry;
    in property <int> index;
    property <bool> added: root.entry.option == PracticeOption.added;
    property <bool> title: root.entry.option == PracticeOption.dummy || root.entry.option == PracticeOption.stage || root.entry.option == PracticeOption.options;
    property <bool> columns: root.entry.option == PracticeOption.columns;
    property <bool> edit: root.entry.option == PracticeOption.edit-dummy;
    property <bool> option: !root.added && !root.title && !root.columns && !root.edit;
    property <bool> paired: root.entry.option == PracticeOption.hp || root.entry.option == PracticeOption.emotion;
    property <bool> pictured: root.entry.option == PracticeOption.arena || root.entry.option == PracticeOption.background;
    property <bool> select: root.pictured || root.entry.option == PracticeOption.music || root.entry.option == PracticeOption.dummys-build;
    property <string> label: PracticeView.label(root.entry.option);
    property <string> value: root.option && root.entry.text != "" ? root.entry.text : PracticeView.value(root.entry.option, root.entry.value);
    property <string> dummys-value: root.entry.dummys-text != "" ? root.entry.dummys-text : PracticeView.value(root.entry.option, root.entry.dummys-value);
    // The value's box: sized for the longest value in the longest language (a longer one the stepper fits to it,
    // and tells the pass if it can't); the stepper and the select are as wide as it and their arrows (`box`), and
    // 40 tall (36 on a phone).
    property <length> value-width: Theme.phone ? root.width - 72px : 196px;
    property <length> box: root.value-width + 72px;
    // A row of two columns' steppers, each as wide as its value's box (room for the longest of the two rows'
    // values, Full Synchro and フルシンクロ) and its arrows (`pair`), 20 apart, the dummy's ending where the other
    // rows' controls do; on a phone each half the row.
    property <length> pair-value-width: Theme.phone ? (root.width - 20px) / 2 - 72px : 92px;
    property <length> pair: root.pair-value-width + 72px;
    property <length> yours-x: Theme.phone ? 0px : root.width - 2 * root.pair - 28px;
    property <length> dummys-x: root.yours-x + root.pair + 20px;
    property <length> control: Theme.phone ? 36px : 40px;
    property <bool> over: Theme.audit && root.option && name.preferred-width > name.width + 0.5px;
    height: root.title ? head.height : root.added ? 48px : root.edit ? root.control + 12px : root.columns ? 20px : (Theme.phone ? 64px : 52px);
    head := GroupTitle {
        x: 0;
        y: 0;
        visible: root.title;
        text: root.title ? root.label : "";
        first: root.index == 0;
    }

    // (The headings, each over its column's stepper.)
    Label {
        x: root.yours-x;
        y: 0;
        width: root.pair;
        height: parent.height;
        text: root.columns ? PracticeView.you : "";
        horizontal-alignment: center;
    }

    Label {
        x: root.dummys-x;
        y: 0;
        width: root.pair;
        height: parent.height;
        text: root.columns ? PracticeView.dummy : "";
        horizontal-alignment: center;
    }

    MenuItem {
        x: 0;
        y: 0;
        visible: root.added;
        nav: root.added ? "menu.rows.added" : "";
        nav-index: root.index;
        text: root.entry.text;
    }

    // (The dummy's build in Builds' editor: its Back comes back to the battle, the menu open.)
    Button {
        x: Theme.phone ? 0px : parent.width - root.box - 8px;
        y: 0;
        width: root.box;
        height: root.control;
        visible: root.edit;
        enabled: root.edit;
        nav: root.edit ? "menu.rows.option" : "";
        nav-index: root.index;
        text: I18n.upper(@tr("Edit"));
        kind: ButtonKind.ghost;
    }

    Rectangle {
        visible: root.option;
        // (The pointer's tint, on what a click there takes: the row, or a column of a row of two.)
        Rectangle {
            x: hit.x;
            y: 0;
            width: hit.width;
            background: hit.has-hover ? Theme.tint : transparent;
        }

        Rectangle {
            x: dummys.x;
            y: 0;
            width: dummys.width;
            background: dummys.has-hover ? Theme.tint : transparent;
        }

        // The row; in a row of two columns the player's column, the label and the first stepper, and the dummy's
        // the rest, each a control of its own (Left and Right go between the two, Up and Down along each column),
        // 4 past its stepper towards the other, where the cursor's arrows have room. (Begun at the row's edge, the
        // player's has nothing to its left: else Left would find the buttons under the rows.)
        hit := Focusable {
            x: 0;
            y: 0;
            width: root.paired ? root.yours-x + root.pair + 4px : parent.width;
            height: parent.height;
            nav: root.option ? "menu.rows.option" : "";
            nav-index: root.index;
            // (A row that opens its list is a select's: Enter opens it. Another is a setting: Enter takes it.)
            kind: root.select ? NavKind.button : NavKind.stepper;
            enabled: root.option;
        }

        dummys := Focusable {
            x: root.dummys-x - 4px;
            y: 0;
            width: root.paired ? parent.width - self.x : 0px;
            height: parent.height;
            nav: root.paired ? "menu.rows.dummys" : "";
            nav-index: root.index;
            kind: NavKind.stepper;
            enabled: root.paired;
        }

        name := Text {
            x: 12px;
            y: 0;
            width: Theme.phone ? parent.width - 24px : root.paired ? root.yours-x - 24px : parent.width - root.value-width - 104px;
            height: Theme.phone ? 24px : parent.height;
            text: root.option ? root.label : "";
            color: Theme.text;
            font-family: Theme.body;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }

        Stepper {
            x: root.paired ? root.yours-x : Theme.phone ? 0px : parent.width - root.box - 8px;
            y: Theme.phone ? 26px : (parent.height - self.height) / 2;
            height: root.control;
            visible: !root.select;
            nav: root.select ? "" : "menu.rows.option";
            nav-index: root.index;
            value: root.value;
            value-width: root.paired ? root.pair-value-width : root.value-width;
            focusable: false;
        }

        Stepper {
            x: root.dummys-x;
            y: Theme.phone ? 26px : (parent.height - self.height) / 2;
            height: root.control;
            visible: root.paired;
            nav: root.paired ? "menu.rows.dummys" : "";
            nav-index: root.index;
            value: root.dummys-value;
            value-width: root.pair-value-width;
            focusable: false;
        }

        Select {
            x: Theme.phone ? 0px : parent.width - root.box - 8px;
            y: Theme.phone ? 26px : (parent.height - self.height) / 2;
            width: root.box;
            height: root.control;
            visible: root.select;
            nav: root.select ? "menu.rows.option" : "";
            nav-index: root.index;
            value: root.value;
            focusable: false;
            pictured: root.pictured;
            picture: root.entry.picture;
            random: root.pictured && root.entry.text == "";
        }

    }

    changed over => {
        if over {
            Audit.clipped(root.label);
        }
    }
}

// The practice menu: Start or Esc in a practice battle. The battle is paused behind it, the dummy in view at the right.
export component PracticeMenu inherits MenuOverlay {
    // RESUME and RESTART side by side, and under them EXIT, the way out of a session Practice started itself, as
    // wide as the two; on a phone one over the other.
    property <length> button-width: Theme.phone ? root.inner-width : (root.inner-width - 8px) / 2;
    property <length> buttons-height: Theme.phone ? (PracticeView.leave ? 136px : 88px) : (PracticeView.leave ? 88px : 40px);
    property <length> buttons-y: root.inner-height - root.buttons-height;
    title: I18n.upper(@tr("Practice"));
    note: @tr("{} vs {}", PracticeView.session-yours, PracticeView.session-dummys);
    side: true;
    // (The rows scroll where they don't all fit, as on a phone: the page's bar is in the panel's margin, so the
    // rows are the panel's width either way.)
    rows := ScrollPage {
        x: 0;
        y: 0;
        width: root.inner-width + 12px;
        height: root.buttons-y - 8px;
        nav: "menu.rows";
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: rows.view-width;
            alignment: start;
            spacing: 4px;
            for row[i] in PracticeView.rows: MenuRow {
                entry: row;
                index: i;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }
    }

    Button {
        x: 0;
        y: root.buttons-y;
        width: root.button-width;
        nav: "menu.resume";
        text: I18n.upper(@tr("Resume"));
        kind: ButtonKind.main;
    }

    Button {
        x: Theme.phone ? 0px : root.button-width + 8px;
        y: root.buttons-y + (Theme.phone ? 48px : 0px);
        width: root.button-width;
        nav: "menu.restart";
        text: I18n.upper(@tr("Restart"));
    }

    // (Back to Play: docs/design/app-ui.md §2.57.)
    Button {
        x: 0;
        y: root.buttons-y + (Theme.phone ? 96px : 48px);
        width: root.inner-width;
        visible: PracticeView.leave;
        enabled: PracticeView.leave;
        nav: "menu.exit";
        text: PracticeView.exit-word != "" ? PracticeView.exit-word : I18n.upper(@tr("Exit"));
        kind: ButtonKind.ghost;
    }
}

// ---- The input display ------------------------------------------------------------------------------------

// The input display: the player's buttons over the dummy's, in the picture's top right corner, under the line
// the battle's own text takes there (its top eighth); on a phone, where the picture is small, under MENU. It is
// over the battle and under the menu, and takes no clicks.
export component PracticeInputs inherits Rectangle {
    InputDisplay {
        visible: PracticeView.inputs;
        x: Theme.phone ? Theme.margin : Shell.picture-room-x + Shell.picture-x + Shell.picture-width - self.width - 12px;
        y: Theme.phone ? Shell.picture-room-y + Shell.picture-room-height + 68px : Shell.picture-room-y + Shell.picture-y + Shell.picture-height / 8 + 8px;
        held-top: PracticeView.held-yours;
        held-bottom: PracticeView.held-dummys;
    }
}

// ---- The dummy getting ready ------------------------------------------------------------------------------

// The dummy that fights getting ready, while its chips' fingerprints are being made: "Getting ready" and how many
// are made of those asked for, a line along the box's foot filling as they are made. It is the box of netplay's
// connection in its corner (battle.slint's `Connection`, placed as `BattleScreen` places it), which practice leaves
// free: 30 tall, on the shade with a line round it, as wide as the longest language needs. Over the battle and under
// the menu; it takes no clicks.
export component PracticeGettingReady inherits Rectangle {
    property <GettingReady> ready: PracticeView.getting-ready;
    // (The picture's height as `BattleScreen` has it: on a phone the window's top, two thirds of its width at most.)
    property <length> picture-height: Theme.phone ? min(self.height, self.width * 2 / 3) : self.height;
    Rectangle {
        // (One width while the count goes on: room for the words and the count at its widest, all asked made.)
        width: max(132px, words.preferred-width + widest.preferred-width + 8px + 24px);
        height: 30px;
        x: parent.width - self.width - (Theme.phone ? Theme.margin : 56px);
        y: (Theme.phone ? root.picture-height : parent.height) - self.height - 16px;
        background: Theme.shade;
        border-width: 1px;
        border-color: Theme.line;
        widest := Mono {
            x: 0;
            y: 0;
            visible: false;
            text: "\{root.ready.asked}/\{root.ready.asked}";
        }

        words := Text {
            x: 12px;
            y: 0;
            height: parent.height;
            text: @tr("Getting ready");
            color: Theme.text;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Mono {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            height: parent.height;
            text: "\{root.ready.made}/\{root.ready.asked}";
            horizontal-alignment: right;
        }

        // (Inside the box's line, along its foot.)
        Bar {
            x: 1px;
            y: parent.height - 1px - self.height;
            width: parent.width - 2px;
            height: 2px;
            value: root.ready.asked > 0 ? root.ready.made / root.ready.asked : 0;
        }
    }
}
