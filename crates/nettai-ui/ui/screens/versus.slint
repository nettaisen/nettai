// Before a battle (docs/design/app-ui.md §6, "Loading"): the two players' cards facing each other, each with
// its own bar. Everything the match can use is loaded before its first frame; online the match starts when both
// bars are full. An opponent's card online carries their name alone.

import { Theme, I18n } from "../theme.slint";
import { Shell, VersusCard } from "../shell.slint";
import { Label, Value, Mono, Pill, Bar, PanelBack } from "../widgets.slint";
import { Tween } from "../motion.slint";

component Card inherits Rectangle {
    in property <VersusCard> card;
    in property <int> side;
    property <length> pad: Theme.phone ? 16px : 24px;
    PanelBack {
        side: root.side;
        accent: false;
    }

    Label {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: root.card.role;
    }

    Value {
        x: root.pad;
        y: root.pad + 22px;
        width: parent.width - 2 * root.pad;
        height: 36px;
        text: root.card.name;
        font-size: 28px;
        font-weight: 900;
    }

    HorizontalLayout {
        x: root.pad;
        y: root.pad + 66px;
        width: parent.width - 2 * root.pad;
        height: 22px;
        alignment: start;
        Value {
            text: root.card.build;
            font-size: 16px;
        }
    }

    Value {
        x: root.pad;
        y: root.pad + 95px;
        width: parent.width - 2 * root.pad;
        height: 16px;
        text: root.card.navi;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 400;
    }

    Bar {
        x: root.pad;
        y: parent.height - root.pad - 10px;
        width: parent.width - 2 * root.pad - 56px;
        value: root.card.progress;
    }

    Mono {
        x: parent.width - root.pad - 44px;
        y: parent.height - root.pad - 16px;
        width: 44px;
        height: 16px;
        text: "\{round(clamp(root.card.progress, 0, 1) * 100)}%";
        horizontal-alignment: right;
    }
}

export component VersusScreen inherits Rectangle {
    // Side by side, VS between; on a phone one over the other.
    property <length> card-width: Theme.phone ? self.width - 2 * Theme.margin : min(440px, (self.width - 80px - 2 * Theme.margin) / 2);
    property <length> card-height: Theme.phone ? 176px : 220px;
    property <length> middle: Theme.phone ? 48px : 80px;
    property <length> top: Theme.phone ? (self.height - 2 * self.card-height - self.middle - 32px) / 2 : (self.height - self.card-height - 32px) / 2;
    // The two cards slide in from their sides, and then VS stamps between them.
    cards := Tween { }

    stamp := Tween {
        delay: 140ms;
        duration: Theme.brisk;
    }

    Card {
        x: (Theme.phone ? Theme.margin : (parent.width - root.middle) / 2 - root.card-width) - (1 - cards.t) * 56px;
        y: root.top;
        opacity: cards.t;
        width: root.card-width;
        height: root.card-height;
        card: Shell.versus-left;
        side: 1;
    }

    Text {
        x: Theme.phone ? 0px : (parent.width - root.middle) / 2;
        y: Theme.phone ? root.top + root.card-height : root.top;
        width: Theme.phone ? parent.width : root.middle;
        height: Theme.phone ? root.middle : root.card-height;
        text: @tr("VS");
        color: Theme.dim;
        font-family: Theme.display;
        font-size: 28px;
        font-weight: Theme.display-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: stamp.linear;
        transform-scale: 1 + (1 - stamp.t) * 1.1;
    }

    Card {
        opacity: cards.t;
        x: (Theme.phone ? Theme.margin : (parent.width + root.middle) / 2) + (1 - cards.t) * 56px;
        y: Theme.phone ? root.top + root.card-height + root.middle : root.top;
        width: root.card-width;
        height: root.card-height;
        card: Shell.versus-right;
        side: 2;
    }

    Label {
        y: (Theme.phone ? root.top + 2 * root.card-height + root.middle : root.top + root.card-height) + 16px;
        height: 16px;
        text: I18n.upper(@tr("Loading"));
        horizontal-alignment: center;
    }
}
