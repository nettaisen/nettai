// Builds (docs/design/app-ui.md §6): the player's builds of the selected game, and a build's editor.
//
// The list: NEW BUILD and IMPORT SAVE… over the builds; beside them the chosen build's overview (build.slint's,
// which other screens show too), with EDIT, DUPLICATE, RENAME and, apart, DELETE. On a phone the list is the
// page, and a build's overview and its buttons are a page of their own behind it.
//
// The editor: the build's name, its version's tag (the version's switch) and whether it is ready in the header; a
// tab bar; and under it the tab chosen. Each tab is one file in builds/ (its view, the global its Rust module sets,
// and its component, which is given its place here) and one Rust module in src/screens/builds/; docs/app.md §8 says
// how a tab is added and what it is given. Its Rust half is src/screens/builds/mod.rs.

import { Theme } from "../theme.slint";
import { Nav, NavKind, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, Hint, DialogFrame } from "../shell.slint";
import { Button, ButtonKind, Field, Label, Note, Message, ListView, TabBar, Tab, Rule, ScrollPage } from "../widgets.slint";
import { Arrive, Tween } from "../motion.slint";
import { VersionTag, BuildEntry, BuildSheet, BuildRow, BuildOverview } from "../build.slint";
import { NaviView, NaviTab } from "builds/navi.slint";
import { FolderView, FolderTab, FolderOverlay } from "builds/folder.slint";
import { NavicustView, NavicustTab } from "builds/navicust.slint";
import { PatchCardsView, PatchCardsTab, PatchCardsOverlay } from "builds/patch_cards.slint";
import { AutoBattleView, AutoBattleTab, AutoBattleOverlay } from "builds/auto_battle.slint";

// Each tab's view reaches the app through here (app.slint exports what this file does).
export { NaviView, FolderView, NavicustView, PatchCardsView, AutoBattleView }

// What of the screen shows.
export enum BuildsPage {
    // The builds, and the chosen one's overview.
    list,
    // A phone's: the chosen build's overview and its buttons.
    sheet,
    // A build's editor.
    editor,
}

// The editor's tabs, in the bar's order. A game has those its builds have something for (auto battle data:
// some games').
export enum EditorTab {
    navi,
    folder,
    navicust,
    patch-cards,
    auto-battle,
}

// A dialog of the screen's own: a new build's name and version, a build's new name.
export enum BuildsDialog {
    none,
    new-build,
    rename,
}

// What Builds shows: src/screens/builds/mod.rs sets these.
export global BuildsView {
    in property <BuildsPage> page;
    // Back goes to Practice, which opened the screen (its list, or the editor it opened a build in): the header
    // says so.
    in property <bool> to-practice;
    // ---- The list.
    in property <[BuildEntry]> builds;
    // The build whose overview shows (-1: none), and the overview.
    in property <int> chosen: -1;
    in property <BuildSheet> sheet;
    // Whether the chosen build reads as one (one that doesn't can only be deleted).
    in property <bool> readable;
    // What the last import made, where that is worth saying.
    in property <string> message;
    // ---- The screen's dialogs.
    in property <BuildsDialog> dialog;
    in property <string> dialog-name;
    // The game's versions, in its own order, and the one chosen; what a version sets, in the game's words.
    in property <[VersionTag]> versions;
    in property <int> dialog-version;
    in property <string> version-sets;
    // ---- The editor.
    in property <string> name;
    in property <VersionTag> version;
    // "✓ Ready to play", or how many problems.
    in property <string> state;
    in property <bool> state-good;
    in property <[Tab]> tabs;
    // The tab chosen: its place in the bar, and which it is. `tab-way` is the way it was reached (-1 from the
    // right): its body arrives from that side.
    in property <int> tab;
    in property <EditorTab> shown;
    in property <int> tab-way: 1;
    // ---- Words the app asks for.
    out property <[string]> tab-names: [@tr("NAVI"), @tr("FOLDER"), @tr("NAVICUST"), @tr("PATCH CARDS"), @tr("AUTO BATTLE")];
    out property <string> new-name: @tr("New build");
    out property <string> cancel: @tr("CANCEL");
    out property <string> delete: @tr("DELETE");
    out property <string> save-files: @tr("Save files");
    public pure function delete-title(name: string) -> string {
        return @tr("Delete {}?", name);
    }
}

// The two versions a new build is one of: Left and Right choose, a click takes one.
component VersionChoice inherits Rectangle {
    in property <[VersionTag]> versions;
    in property <int> chosen;
    property <length> box: (self.width - (root.versions.length - 1) * 12px) / max(1, root.versions.length);
    height: 64px;
    for version[i] in root.versions: Rectangle {
        x: i * (root.box + 12px);
        width: root.box;
        background: Theme.inset;
        border-width: i == root.chosen ? 2px : 1px;
        border-color: i == root.chosen ? Theme.cursor : Theme.line;
        Text {
            text: version.text;
            color: version.tone;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: Theme.display-bold;
            letter-spacing: 0.6px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            clicked => {
                Nav.point("name.version", 0);
                Nav.choose("name.version", 0, i);
            }
        }
    }

    Focusable {
        nav: "name.version";
        kind: NavKind.stepper;
        // (Its halves take the clicks.)
        z: -1;
    }
}

// The editor's body: the tab chosen, arriving from the way it was reached each time it changes. A tab is here by
// its `if`, which holds the tab alone: one clock moves the five (an `Arrive` around each tab was copied into
// each `if`).
component EditorBody inherits Rectangle {
    property <EditorTab> shown: BuildsView.shown;
    property <int> seq;
    changed shown => {
        root.seq += 1;
    }
    tw := Tween {
        seq: root.seq;
    }

    Rectangle {
        x: (1 - tw.t) * BuildsView.tab-way * 24px;
        opacity: tw.t;
        if BuildsView.shown == EditorTab.navi: NaviTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.folder: FolderTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.navicust: NavicustTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.patch-cards: PatchCardsTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.auto-battle: AutoBattleTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }
}

export component BuildsScreen inherits Page {
    property <bool> editing: BuildsView.page == BuildsPage.editor;
    property <[Hint]> list-hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Edit") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Delete") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
    // The list's column, and the overview's beside it.
    property <length> list-width: Theme.phone ? self.body-width : 400px;
    property <length> side-x: root.list-width + 24px;
    property <length> side-width: self.body-width - root.side-x;
    property <length> list-y: Theme.phone ? 96px : 52px;
    // The tab bar's place, and the tab's under it (the bar is flush under the header).
    property <length> bar-y: Theme.phone ? -8px : -16px;
    property <length> tab-y: Theme.phone ? 44px : 40px;
    property <length> tab-height: self.body-height - root.tab-y + (Theme.phone ? 0px : 8px);
    title: BuildsView.page == BuildsPage.list ? @tr("BUILDS") : BuildsView.name;
    back: BuildsView.to-practice ? @tr("PRACTICE") : BuildsView.page == BuildsPage.list ? @tr("MENU") : @tr("BUILDS");
    // (A phone's header has the build's tag where the game is.)
    game: !(Theme.phone && root.editing);
    property <VersionTag> no-tag;
    tag: root.editing ? BuildsView.version : root.no-tag;
    // (The editor's tag is the build's version's select: docs/design/app-ui.md §2.42, §2.44.)
    tag-nav: "version";
    property <[Hint]> version-hints: [
        { key: "↑↓", pad: PadButton.move, text: @tr("Move") },
        { key: "←→", text: @tr("Switch version") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose version") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    state: root.editing ? BuildsView.state : "";
    state-good: BuildsView.state-good;
    hints: !root.editing ? root.list-hints : Nav.id == "version" ? root.version-hints : (BuildsView.shown == EditorTab.navi ? NaviView.hints : BuildsView.shown == EditorTab.folder ? FolderView.hints : BuildsView.shown == EditorTab.navicust ? NavicustView.hints : BuildsView.shown == EditorTab.patch-cards ? PatchCardsView.hints : AutoBattleView.hints);
    status: !root.editing ? @tr("{n} build" | "{n} builds" % BuildsView.builds.length) : (BuildsView.shown == EditorTab.navi ? NaviView.status : BuildsView.shown == EditorTab.folder ? FolderView.status : BuildsView.shown == EditorTab.navicust ? NavicustView.status : BuildsView.shown == EditorTab.patch-cards ? PatchCardsView.status : AutoBattleView.status);

    // ---- The list.
    if BuildsView.page == BuildsPage.list: Arrive {
        order: 0;
        new := Button {
            x: 0;
            y: 0;
            width: Theme.phone ? root.list-width : self.natural-width;
            nav: "new";
            text: @tr("NEW BUILD");
            kind: ButtonKind.main;
        }

        Button {
            x: Theme.phone ? 0px : new.width + 12px;
            y: Theme.phone ? 48px : 0px;
            width: Theme.phone ? root.list-width : self.natural-width;
            nav: "import";
            text: @tr("IMPORT SAVE…");
        }

        list := ListView {
            x: 0;
            y: root.list-y;
            width: root.list-width;
            height: root.body-height - root.list-y - 28px;
            nav: "builds";
            count: BuildsView.builds.length;
            row-height: 52px;
            chosen: BuildsView.chosen;
            for slot in list.shown: BuildRow {
                property <int> at: list.first + slot;
                y: self.at * list.pitch;
                width: list.row-width;
                build: BuildsView.builds[self.at];
                nav: "builds";
                nav-index: self.at;
            }
        }

        Message {
            x: 0;
            y: root.body-height - 16px;
            width: root.list-width;
            text: BuildsView.message;
            tone: Theme.muted;
        }
    }

    if BuildsView.page == BuildsPage.list && !Theme.phone: Arrive {
        order: 1;
        BuildOverview {
            x: root.side-x;
            y: 0;
            width: root.side-width;
            height: self.sheet-height;
            visible: BuildsView.chosen >= 0 && BuildsView.readable;
            build: BuildsView.sheet;
        }

        edit := Button {
            x: root.side-x;
            y: 552px;
            nav: "edit";
            text: @tr("EDIT");
            enabled: BuildsView.chosen >= 0 && BuildsView.readable;
        }

        duplicate := Button {
            x: edit.x + edit.width + 12px;
            y: 552px;
            nav: "duplicate";
            text: @tr("DUPLICATE");
            enabled: BuildsView.chosen >= 0 && BuildsView.readable;
        }

        Button {
            x: duplicate.x + duplicate.width + 12px;
            y: 552px;
            nav: "rename";
            text: @tr("RENAME");
            enabled: BuildsView.chosen >= 0 && BuildsView.readable;
        }

        Button {
            x: root.body-width - self.width;
            y: 552px;
            nav: "delete";
            text: @tr("DELETE");
            kind: ButtonKind.ghost;
            danger: true;
            enabled: BuildsView.chosen >= 0;
        }
    }

    // ---- A phone's page of one build: its buttons, then its overview, scrolled.
    if BuildsView.page == BuildsPage.sheet: Arrive {
        order: 0;
        page := ScrollPage {
            width: root.body-width;
            nav: "one.";
            content-height: 96px + 12px + sheet.sheet-height;
            Button {
                x: 0;
                y: 0;
                width: (page.view-width - 12px) / 2;
                nav: "one.edit";
                text: @tr("EDIT");
                kind: ButtonKind.main;
                enabled: BuildsView.readable;
            }

            Button {
                x: (page.view-width + 12px) / 2;
                y: 0;
                width: (page.view-width - 12px) / 2;
                nav: "one.duplicate";
                text: @tr("DUPLICATE");
                enabled: BuildsView.readable;
            }

            Button {
                x: 0;
                y: 48px;
                width: (page.view-width - 12px) / 2;
                nav: "one.rename";
                text: @tr("RENAME");
                enabled: BuildsView.readable;
            }

            Button {
                x: (page.view-width + 12px) / 2;
                y: 48px;
                width: (page.view-width - 12px) / 2;
                nav: "one.delete";
                text: @tr("DELETE");
                kind: ButtonKind.ghost;
                danger: true;
            }

            sheet := BuildOverview {
                x: 0;
                y: 108px;
                width: page.view-width;
                height: self.sheet-height;
                visible: BuildsView.readable;
                build: BuildsView.sheet;
            }
        }
    }

    // ---- The editor: the tab bar, flush under the header, and the tab chosen.
    if root.editing: Rectangle {
        Rule {
            x: -Theme.margin;
            y: root.bar-y + 39px;
            width: root.body-width + 2 * Theme.margin;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        TabBar {
            x: Theme.phone ? -8px : 0px;
            y: root.bar-y;
            width: root.body-width + (Theme.phone ? 16px : 0px);
            nav: "tab";
            tabs: BuildsView.tabs;
            chosen: BuildsView.tab;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        EditorBody {
            x: 0;
            y: root.tab-y;
            width: root.body-width;
            height: root.tab-height;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }
}

// A new build's name and version, or a build's new name. Its controls' names begin with `name.`.
component NameDialog inherits DialogFrame {
    property <bool> versions: BuildsView.dialog == BuildsDialog.new-build;
    property <length> buttons-y: root.versions ? 226px : 78px;
    title: root.versions ? @tr("NEW BUILD") : @tr("RENAME");
    content-height: root.buttons-y + 40px;
    Label {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: 14px;
        text: @tr("NAME");
    }

    Field {
        x: 0;
        y: 22px;
        width: root.inner-width;
        nav: "name.name";
        text: BuildsView.dialog-name;
    }

    Label {
        x: 0;
        y: 78px;
        width: root.inner-width;
        height: 14px;
        visible: root.versions;
        text: @tr("VERSION");
    }

    if root.versions: VersionChoice {
        x: 0;
        y: 100px;
        width: root.inner-width;
        versions: BuildsView.versions;
        chosen: BuildsView.dialog-version;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Note {
        x: 0;
        y: 172px;
        width: root.inner-width;
        height: 38px;
        visible: root.versions;
        text: @tr("{} It can be switched later in the editor.", BuildsView.version-sets);
    }

    confirm := Button {
        x: root.inner-width - self.width;
        y: root.buttons-y;
        nav: "name.confirm";
        text: root.versions ? @tr("CREATE BUILD") : @tr("RENAME");
        kind: ButtonKind.main;
        enabled: BuildsView.dialog-name != "";
    }

    Button {
        x: confirm.x - 12px - self.width;
        y: root.buttons-y;
        nav: "name.cancel";
        text: @tr("CANCEL");
        kind: ButtonKind.ghost;
    }
}

// What opens over Builds: its dialogs, and on a phone the Folder's, the Patch cards' and the Auto battle tab's
// sheets. It covers the whole window, over the screen and under the shell's own dialogs; empty, it takes no clicks.
export component BuildsOverlay inherits Rectangle {
    if BuildsView.dialog != BuildsDialog.none: NameDialog {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if BuildsView.page == BuildsPage.editor && BuildsView.shown == EditorTab.folder && FolderView.sheet: FolderOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if BuildsView.page == BuildsPage.editor && BuildsView.shown == EditorTab.patch-cards && PatchCardsView.sheet: PatchCardsOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if BuildsView.page == BuildsPage.editor && BuildsView.shown == EditorTab.auto-battle && AutoBattleView.sheet: AutoBattleOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}
