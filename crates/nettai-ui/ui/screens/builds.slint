// Builds (docs/design/app-ui.md §6): the player's builds of the selected game, and the editor. Not built yet:
// the screen is here with its header and Back. Its Rust half is src/screens/builds.rs.

import { Theme } from "../theme.slint";
import { Shell, Page, PadButton } from "../shell.slint";

// What Builds shows: src/screens/builds.rs sets these. (A struct or an enum a property here uses reaches Rust
// by that use: nothing is added to app.slint for it.)
export global BuildsView { }

export component BuildsScreen inherits Page {
    title: @tr("BUILDS");
    back: @tr("MENU");
    hints: [
        { key: "Esc", pad: PadButton.east, text: @tr("Back") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
}
