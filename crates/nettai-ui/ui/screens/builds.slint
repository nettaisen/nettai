// Builds (docs/design/app-ui.md §6): a build's editor, opened from Play (its EDIT) or Practice (its EDIT). The
// builds themselves, + NEW BUILD (and its FROM A SAVE FILE…), and the chosen build's overview with EDIT and its
// menu of DUPLICATE, RENAME and DELETE are Play's (play.slint).
//
// The editor: the build's name, its version's tag (the version's switch) and whether it is ready in the header; a
// tab bar; and under it the tab chosen. Each tab is one file in builds/ (its view, the global its Rust module sets,
// and its component, which is given its place here) and one Rust module in src/screens/builds/; docs/app.md §8 says
// how a tab is added and what it is given. Its Rust half is src/screens/builds/mod.rs.

import { Theme } from "../theme.slint";
import { Nav } from "../nav.slint";
import { Shell, Page, PadButton, Hint } from "../shell.slint";
import { TabBar, Tab, Rule, Label, Select, Button } from "../widgets.slint";
import { Tween } from "../motion.slint";
import { VersionTag } from "../build.slint";
import { NaviView, NaviTab } from "builds/navi.slint";
import { FolderView, FolderTab, FolderOverlay } from "builds/folder.slint";
import { NavicustView, NavicustTab } from "builds/navicust.slint";
import { PatchCardsView, PatchCardsTab, PatchCardsOverlay } from "builds/patch_cards.slint";
import { AutoBattleView, AutoBattleTab, AutoBattleOverlay } from "builds/auto_battle.slint";

// Each tab's view reaches the app through here (app.slint exports what this file does).
export { NaviView, FolderView, NavicustView, PatchCardsView, AutoBattleView }

// The editor's tabs, in the bar's order. A game has those its builds have something for (auto battle data:
// some games').
export enum EditorTab {
    navi,
    folder,
    navicust,
    patch-cards,
    auto-battle,
}

// What Builds shows: src/screens/builds/mod.rs sets these.
export global BuildsView {
    // Back goes to Practice, which opened the editor; else to Play: the header says so.
    in property <bool> to-practice;
    in property <string> name;
    // The ruleset the player plays by, by its name: the build is marked against it.
    in property <string> ruleset;
    // "✓ Ready to play", or how many problems.
    in property <string> state;
    in property <bool> state-good;
    in property <[Tab]> tabs;
    // The tab chosen: its place in the bar, and which it is. `tab-way` is the way it was reached (-1 from the
    // right): its body arrives from that side.
    in property <int> tab;
    in property <EditorTab> shown;
    in property <int> tab-way: 1;
    // ---- Words the app asks for.
    out property <[string]> tab-names: [@tr("NAVI"), @tr("FOLDER"), @tr("NAVICUST"), @tr("PATCH CARDS"), @tr("AUTO BATTLE")];
}

// The editor's body: the tab chosen, arriving from the way it was reached each time it changes. A tab is here by
// its `if`, which holds the tab alone: one clock moves the five (an `Arrive` around each tab was copied into
// each `if`).
component EditorBody inherits Rectangle {
    property <EditorTab> shown: BuildsView.shown;
    property <int> seq;
    changed shown => {
        root.seq += 1;
    }
    tw := Tween {
        seq: root.seq;
    }

    Rectangle {
        x: (1 - tw.t) * BuildsView.tab-way * 24px;
        opacity: tw.t;
        if BuildsView.shown == EditorTab.navi: NaviTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.folder: FolderTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.navicust: NavicustTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.patch-cards: PatchCardsTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
        if BuildsView.shown == EditorTab.auto-battle: AutoBattleTab {
            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }
}

export component BuildsScreen inherits Page {
    // The tab bar's place, and the tab's under it (the bar is flush under the header).
    property <length> bar-y: Theme.phone ? -8px : -16px;
    property <length> tab-y: Theme.phone ? 44px : 40px;
    property <length> tab-height: self.body-height - root.tab-y + (Theme.phone ? 0px : 8px);
    title: BuildsView.name;
    back: BuildsView.to-practice ? @tr("PRACTICE") : @tr("PLAY");
    // (A phone's header leaves the game out. A build has no version: docs/design/versions.md §3.3.)
    game: !Theme.phone;
    state: BuildsView.state;
    state-good: BuildsView.state-good;
    hints: BuildsView.shown == EditorTab.navi ? NaviView.hints : BuildsView.shown == EditorTab.folder ? FolderView.hints : BuildsView.shown == EditorTab.navicust ? NavicustView.hints : BuildsView.shown == EditorTab.patch-cards ? PatchCardsView.hints : AutoBattleView.hints;
    status: BuildsView.shown == EditorTab.navi ? NaviView.status : BuildsView.shown == EditorTab.folder ? FolderView.status : BuildsView.shown == EditorTab.navicust ? NavicustView.status : BuildsView.shown == EditorTab.patch-cards ? PatchCardsView.status : AutoBattleView.status;

    // The tab bar, flush under the header, and the tab chosen.
    Rule {
        x: -Theme.margin;
        y: root.bar-y + 39px;
        width: root.body-width + 2 * Theme.margin;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // (At the bar's right end on a desktop, the ruleset the player plays by, and EDIT: its page. A phone has them at
    // the top of the Navi tab.)
    property <length> ruleset-width: Theme.phone ? 0px : ruleset-label.width + 12px + 176px + 8px + rules-edit.width + 16px;
    TabBar {
        x: Theme.phone ? -8px : 0px;
        y: root.bar-y;
        width: root.body-width + (Theme.phone ? 16px : 0px) - root.ruleset-width;
        nav: "tab";
        tabs: BuildsView.tabs;
        chosen: BuildsView.tab;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    ruleset-label := Label {
        x: root.body-width - root.ruleset-width + 16px;
        y: root.bar-y;
        width: self.preferred-width;
        height: 36px;
        visible: !Theme.phone;
        text: @tr("RULESET");
    }

    Select {
        x: ruleset-label.x + ruleset-label.width + 12px;
        y: root.bar-y;
        width: 176px;
        height: 36px;
        visible: !Theme.phone;
        focusable: !Theme.phone;
        nav: "ruleset";
        value: BuildsView.ruleset;
    }

    rules-edit := Button {
        x: root.body-width - self.width;
        y: root.bar-y;
        width: self.natural-width;
        height: 36px;
        visible: !Theme.phone;
        nav: Theme.phone ? "" : "ruleset-edit";
        text: @tr("EDIT");
    }

    EditorBody {
        x: 0;
        y: root.tab-y;
        width: root.body-width;
        height: root.tab-height;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}

// What opens over the editor: on a phone the Folder's, the Patch cards' and the Auto battle tab's sheets. It covers
// the whole window, over the screen and under the shell's own dialogs; empty, it takes no clicks.
export component BuildsOverlay inherits Rectangle {
    if BuildsView.shown == EditorTab.folder && FolderView.sheet: FolderOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if BuildsView.shown == EditorTab.patch-cards && PatchCardsView.sheet: PatchCardsOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if BuildsView.shown == EditorTab.auto-battle && AutoBattleView.sheet: AutoBattleOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}
