// The Party tab of a build's editor, in a game whose setup takes a party (EXE5's party battle, EXE5 DS's: docs/design/
// exe5ds-map.md §4): the navi's partners, each with the programs filling its PartyCust gauge (§4.10). Its layout is the
// one the user chose (the verification workspace's docs/nettai-ui/party/chosen/party-tab-D9r.png, D9r.body.html), built
// as the Folder and Patch cards tabs are:
//
// - the strip across the top describes what is under the cursor (or the pointer): a program (its name, its blocks and
//   whether they fit the marked partner's gauge, what it does, its kind) or a navi (its version; its HP, buster attack
//   and charge, its own chip's damage, what its programs add to them; its element and its gauge);
// - under it the navis to pick from, a row a version (the builds data's groups, each under its name in its color), a
//   chip each (its face, its name, its place in the party where it is in): raised and outlined in the cursor's color
//   where it is in, muted where the party is full, dim where the build's ruleset holds it back. Enter or a click puts
//   it in (at the party's end) or takes it out;
// - at the left, framed, PARTY, its counts in its head as the folder's are (Partners, Navi changes) and CLEAR at its
//   end; in it a section a partner, its head (its face, name and HP, its gauge and the blocks used of it) and its
//   programs as a list's rows (none: Empty), and a head saying Empty for each place the party has no partner in, as
//   the Patch cards tab's empty slots are. The partner the library adds to, the last one the cursor was in, has its
//   head marked as a list's chosen row is (the bar and the tint);
// - at the right the library, an open list: each program's blocks, its name (or why it won't go in, in the error red,
//   the row greyed), its cost; what it does is the strip's. Enter adds it to the marked partner's.
//
// A program's blocks are in a column as wide as the most a program of the collection fills (`most-blocks`), its name
// after it at the same place in every row; the strip's are as small as that many take in the face's box.
//
// A program is dragged from the library into a partner's list, in a list to another place or into the other partner's,
// and onto the library to take it out, as the Patch cards tab's cards are: the partner it is over is marked, a gap opens
// where it would go in its list (the section a row taller), or the dragged row says why it can't. A partner's head is
// dragged onto another's to take its place (a gap over the other's head), a chip in the party onto another's to trade.
//
// On a phone, which has no strip, the chips wrap three to a row under their team's name, PARTY is the tab's width, and a
// button under it opens the library as a sheet (`PartyOverlay`). Its Rust half is src/screens/builds/party.rs.

import { Theme, Caps } from "../../theme.slint";
import { Nav, Focusable, Drag } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { PanelBack, Label, Button, ListView, RowTouch, ScrollPage, ProblemNote, Refusal, WordButton } from "../../widgets.slint";
import { Tween, Shake } from "../../motion.slint";
import { VersionTag, VersionMark, StatLine } from "../../build.slint";
import { DropGap, RemoveTarget, CountBox } from "folder.slint";

// A navi to pick, as its chip shows it: its face and name; `place`, its place in the party (1, 2; 0: not in); `full`,
// the party has no room for it; `held`, the build's ruleset holds it back.
export struct PartyChip {
    face: image,
    name: string,
    place: int,
    full: bool,
    held: bool,
}

// A version's row of chips: its name in its color (the builds data's group's), and its navis.
export struct PartyTeam {
    name: string,
    tone: color,
    chips: [PartyChip],
    // The place of its first chip among all the teams' (their focus order).
    first: int,
}

// A program in a list: its name, a note beside it (a partner's held back by the build's ruleset: `bad`, "Not allowed")
// or why it won't go in (`why`, the row greyed), its blocks in its color, its cost. What it does is the strip's. `bad`:
// a problem is about it.
export struct PartyRow {
    name: string,
    note: string,
    why: string,
    blocks: int,
    tone: color,
    bad: bool,
}

// A partner's section of PARTY: its face, name and HP (its programs' bonus in); its gauge, each block's color and the
// run of its program (`runs`: block i is of the run-th program, the empty blocks one run after them); its programs.
// `bad`: a problem is about it.
export struct PartyPanel {
    face: image,
    name: string,
    hp: string,
    used: int,
    gauge: int,
    tones: [color],
    runs: [int],
    bad: bool,
    rows: [PartyRow],
}

// What the strip describes, as the Folder tab's strip lays a chip out: a navi (its face) or a program (its blocks), its
// name (a navi's with its version's mark), a line of what it is (`description`: what a program does; a navi's stats in
// its place), its facts (a navi's element first); why it can't go in (`problem`, a refusal) or what the build's
// problems have against it (`fault`).
export struct PartyDetail {
    there: bool,
    face: image,
    name: string,
    version: VersionTag,
    blocks: int,
    tone: color,
    description: string,
    // A navi's stats (HP, Attack, Charge: their labels the strip's; a stat of the rules' own with its own), what its
    // programs added in cyan, as the Navi tab says them; and its element's icon.
    stats: [StatLine],
    element: image,
    facts: [string],
    problem: string,
    fault: string,
}

// What the tab shows: src/screens/builds/party.rs sets these.
export global PartyView {
    out property <[Hint]> hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Add") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Remove") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    out property <string> status: self.marked ? self.free-word(self.free) : "";
    in property <PartyDetail> detail;
    // PARTY's counts: the partners against the most there may be, the round's navi changes.
    in property <int> partners;
    in property <int> room;
    in property <int> changes;
    in property <[PartyTeam]> teams;
    in property <[PartyPanel]> panels;
    // The partner the library adds to (its place in `panels`; `marked` off: there is none), and its gauge's blocks free.
    in property <int> target;
    in property <bool> marked;
    in property <int> free;
    in property <[PartyRow]> rows;
    // What the game's rules have against the party: a phone's line in PARTY's head.
    in property <string> problems;
    // The most blocks a program of the collection fills: the blocks' column of a program's row is as wide as that.
    in property <int> most-blocks: 1;
    // Why the program dragged can't go into the list of the partner it is over (empty: it can, or it is over none):
    // said in the dragged row, and no gap opens.
    in property <string> drag-why;
    // A library's row that was refused, counted: it shakes.
    in property <int> refused: -1;
    in property <int> refused-seq;
    // The cursor is in the library: its title is lit, PARTY's isn't.
    in property <bool> in-library;
    // On a phone: the library's sheet is open.
    in property <bool> sheet;
    // ---- Words the app asks for.
    // CLEAR's question (docs/design/app-ui.md §2.71).
    out property <string> clear-question: @tr("Clear the party?");
    public pure function free-word(n: int) -> string {
        return @tr("{n} block free" | "{n} blocks free" % n);
    }
    public pure function blocks-word(n: int) -> string {
        return @tr("{n} block" | "{n} blocks" % n);
    }
    public pure function fits-word(n: int) -> string {
        return @tr("Fits: {n} block free" | "Fits: {n} blocks free" % n);
    }
    // (A partner's HP as the strip and the build overview's rows say it.)
    public pure function hp-word(hp: int) -> string {
        return @tr("HP {}", hp);
    }
    public pure function gauge-word(n: int) -> string {
        return @tr("Gauge {n} block" | "Gauge {n} blocks" % n);
    }
    public pure function needs-blocks(n: int) -> string {
        return @tr("Needs {n} block" | "Needs {n} blocks" % n);
    }
}

// A gauge (or a program's blocks): a fixed run of `count` equal slots, `size` square, its width the count's alone. The
// first `filled` are filled, each in its program's color (`tones`, else `tone`), a program's slots touching as one
// piece and a line inside the run between two programs (`runs`: each slot's program); the rest outlined slots. (Past the
// count nothing more is drawn: the used and total beside it say so, in the error red.)
component Blocks inherits Rectangle {
    in property <int> count;
    in property <int> filled;
    in property <[color]> tones;
    in property <[int]> runs;
    in property <color> tone: Theme.cursor;
    in property <length> size: 10px;
    width: root.count * root.size;
    height: root.size;
    for i in root.count: Rectangle {
        property <bool> full: i < root.filled;
        // (The first slot of a program after another: a line at its left edge.)
        property <bool> starts: i > 0 && i < root.runs.length && root.runs[i - 1] != root.runs[i];
        x: i * root.size;
        y: 0;
        width: root.size;
        height: root.size;
        background: self.full ? (i < root.tones.length ? root.tones[i] : root.tone) : transparent;
        border-width: self.full ? 0px : 1px;
        border-color: Theme.dim;
        Rectangle {
            x: 0;
            width: 1px;
            visible: parent.full && parent.starts;
            background: Theme.piece-edge;
        }
    }
}

// A navi's chip, a control: its face, its name, its place in the party (1, 2) where it is in.
component ChipView inherits Rectangle {
    in property <PartyChip> chip;
    in property <int> nav-index;
    // The copy dragged under the pointer: no control of its own.
    in property <bool> lifted;
    property <bool> in: root.chip.place > 0;
    opacity: !root.lifted && Drag.on && Drag.list == "chip" && Drag.from == root.nav-index ? 0.35 : 1;
    Rectangle {
        background: root.in ? Theme.raised : Theme.panel;
        border-width: 1px;
        border-color: root.in ? Theme.cursor : Theme.line;
    }

    Image {
        x: 6px;
        y: (parent.height - 16px) / 2;
        width: 32px;
        height: 16px;
        source: root.chip.face;
        image-rendering: pixelated;
        opacity: root.chip.held ? 0.35 : 1;
    }

    Text {
        x: 46px;
        width: max(0px, parent.width - self.x - (root.in ? 8px + 16px + 8px : 8px));
        text: root.chip.name;
        color: root.chip.held ? Theme.dim : root.chip.full && !root.in ? Theme.muted : Theme.text;
        // (A navi's name as the editor's rows have names.)
        font-family: Theme.body;
        font-size: Theme.phone ? 15px : 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 8px - self.width;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        visible: root.in;
        background: Theme.cursor;
        Text {
            text: root.chip.place;
            color: Theme.action-ink;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // (Another chip of the party dragged onto it: they would trade places.)
    DropGap {
        visible: !root.lifted && Drag.on && Drag.list == "chip" && Drag.to == root.nav-index;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    if !root.lifted: Focusable {
        nav: "chip";
        nav-index: root.nav-index;
        describes: true;
        // (One in the party is dragged onto another to trade places with it, and a right click takes it out.)
        drag: root.in ? "chip" : "";
        removable: root.in;
    }
}

// What a program's row shows (the one dragged, under the pointer, too): its blocks, in a column as wide as the most a
// program fills (its name at the same place in every row), its name, why it won't go in (or, held back, that it isn't
// allowed), its cost.
component ProgramLine inherits Rectangle {
    in property <PartyRow> row-data;
    Blocks {
        x: 12px;
        y: (parent.height - self.height) / 2;
        count: root.row-data.blocks;
        filled: root.row-data.blocks;
        tone: root.row-data.tone;
        opacity: root.row-data.why != "" ? 0.4 : 1;
    }

    property <length> name-x: 12px + max(1, PartyView.most-blocks) * 10px + 10px;
    property <bool> said: root.row-data.note != "" || root.row-data.why != "";
    Text {
        x: root.name-x;
        width: max(0px, (root.said ? 110px : parent.width - root.name-x - 40px));
        text: root.row-data.name;
        color: root.row-data.why != "" ? Theme.dim : root.row-data.bad ? Theme.bad : Theme.text;
        font-family: Theme.body;
        font-size: Theme.phone ? 15px : 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.name-x + 110px + 10px;
        width: max(0px, parent.width - self.x - 40px);
        visible: root.said;
        text: root.row-data.why != "" ? root.row-data.why : root.row-data.note;
        color: root.row-data.why != "" || root.row-data.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 12px - self.width;
        width: 24px;
        text: root.row-data.blocks;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line.with-alpha(0.45);
    }
}

// A program's row in a list: shifted (`dy`) while another is dragged, gone while it is the one dragged.
component RowView inherits Rectangle {
    in property <PartyRow> row-data;
    in property <string> nav;
    in property <int> nav-index;
    in property <bool> removable;
    in property <bool> draggable;
    in property <length> dx;
    in property <length> dy;
    in property <bool> gone;
    Rectangle {
        y: root.dy;
        opacity: root.gone ? 0 : 1;
        animate y {
            duration: Drag.on ? Theme.quick : 0ms;
            easing: ease-out;
        }
        Rectangle {
            background: touch.has-hover && !Drag.on ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
        }

        ProgramLine {
            x: root.dx;
            row-data: root.row-data;
        }
    }

    touch := RowTouch {
        nav: root.nav;
        nav-index: root.nav-index;
        removable: root.removable;
        drag: root.draggable ? root.nav : "";
        describes: true;
    }
}

// A list of programs: a partner's (`removable`, its rows shifting to leave a gap where one dragged would land) or the
// library's.
component RowsList inherits Rectangle {
    in property <[PartyRow]> rows;
    in property <string> nav;
    in property <bool> removable;
    in property <bool> draggable;
    in property <bool> scrolls;
    property <length> pitch: Theme.phone ? 44px : 30px;
    // (A row of this list dragged in it, or one from elsewhere landing in it: where it would land.)
    property <bool> mine: Drag.on && Drag.into == root.nav && Drag.to >= 0;
    property <bool> moving: root.mine && Drag.list == root.nav;
    property <bool> filling: root.mine && Drag.list != root.nav;
    pure function shown(i: int) -> int {
        return root.filling ? (i >= Drag.to ? i + 1 : i) : !root.moving ? i : i == Drag.from ? Drag.to : (Drag.from < i && i <= Drag.to) ? i - 1 : (Drag.to <= i && i < Drag.from) ? i + 1 : i;
    }
    shake := Shake {
        seq: PartyView.refused-seq;
    }

    list := ListView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        nav: root.nav;
        count: root.rows.length;
        row-height: root.pitch - 2px;
        gap: 2px;
        chosen: self.focused-row;
        // (A drag on a row moves its program: the wheel scrolls.)
        mouse-pan: !root.draggable;
        for slot in list.shown: RowView {
            property <int> at: list.first + slot;
            y: self.at * list.pitch;
            width: list.row-width;
            height: list.row-height;
            row-data: root.rows[self.at];
            nav: root.nav;
            nav-index: self.at;
            removable: root.removable;
            draggable: root.draggable;
            dx: !root.removable && self.at == PartyView.refused ? shake.dx : 0px;
            dy: (root.shown(self.at) - self.at) * list.pitch;
            gone: Drag.on && Drag.list == root.nav && self.at == Drag.from && !Drag.removing;
        }
    }

    // (Where a program dragged in from elsewhere would go.)
    DropGap {
        x: 0;
        y: Drag.to * root.pitch - list.scroll;
        width: list.row-width;
        height: root.pitch - 2px;
        visible: root.filling;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // (A partner's list with no program: Empty, as the Patch cards tab's empty slot says it.)
    if root.removable && root.rows.length == 0 && !root.filling: Rectangle {
        x: 0;
        y: 0;
        height: root.pitch - 2px;
        Text {
            x: 12px + max(1, PartyView.most-blocks) * 10px + 10px;
            text: @tr("Empty");
            color: Theme.dim;
            font-family: Theme.body;
            font-size: Theme.phone ? 15px : 14px;
            vertical-alignment: center;
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line.with-alpha(0.45);
        }
    }
}

// A partner's head in PARTY: its face, its name and HP, its gauge and the blocks used of it (the one dragged, under the
// pointer, too).
component PartnerHead inherits Rectangle {
    in property <PartyPanel> panel;
    Image {
        x: 12px;
        y: (root.height - 16px) / 2;
        width: 32px;
        height: 16px;
        source: root.panel.face;
        image-rendering: pixelated;
    }

    HorizontalLayout {
        x: 12px + 32px + 12px;
        y: 0;
        width: max(0px, gauge.x - 16px - self.x);
        height: root.height;
        spacing: 8px;
        alignment: start;
        Text {
            text: root.panel.name;
            color: root.panel.bad ? Theme.bad : Theme.text;
            // (A navi's name as the editor's rows have names.)
            font-family: Theme.body;
            font-size: Theme.phone ? 15px : 14px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.panel.hp;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // (The gauge in a column of its own, at the same place for each partner whatever its size: as wide as the largest,
    // ten slots, then its used and total, as wide as "10/10".)
    gauge := Blocks {
        x: used.x - 8px - 10 * 12px;
        y: (root.height - self.height) / 2;
        count: root.panel.gauge;
        filled: root.panel.used;
        tones: root.panel.tones;
        runs: root.panel.runs;
        size: 12px;
    }

    used := Text {
        x: root.width - 12px - self.width;
        y: 0;
        width: 44px;
        height: root.height;
        text: root.panel.used + "/" + root.panel.gauge;
        color: root.panel.used > root.panel.gauge ? Theme.bad : Theme.muted;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// A partner's section of PARTY: its head, a control (the cursor in it makes it the partner the library adds to;
// `target` marks it as a list's chosen row is; dragged, it takes another's place), and its programs' list under it.
component SectionView inherits Rectangle {
    in property <PartyPanel> panel;
    in property <int> place;
    in property <bool> target;
    property <length> head: 34px;
    // (Its head dragged: faint where it was; another's dragged over it: it would take its place.)
    opacity: Drag.on && Drag.list == "target" && Drag.from == root.place ? 0.35 : 1;
    Rectangle {
        x: 0;
        y: 0;
        height: root.head;
        background: Theme.raised;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }
    }

    // (The partner the library adds to: a list's chosen row's tint and bar.)
    Rectangle {
        x: 0;
        y: 0;
        height: root.head - 1px;
        visible: root.target;
        background: @linear-gradient(90deg, Theme.tint 0%, Theme.clear 100%);
        Rectangle {
            x: 0;
            width: 3px;
            background: Theme.cursor;
        }
    }

    PartnerHead {
        y: 0;
        height: root.head;
        panel: root.panel;
    }

    DropGap {
        y: 0;
        height: root.head;
        visible: Drag.on && Drag.list == "target" && Drag.to == root.place;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Focusable {
        x: 0;
        y: 0;
        height: root.head;
        nav: "target";
        nav-index: root.place;
        describes: true;
        drag: "target";
        removable: true;
    }

    // (Its list a row taller than its rows, the room a gap opens in while a program from elsewhere would go in: the
    // section grows over it then. Its height never follows `Drag`: the list's rows would be made anew, and the one held
    // by the pointer let go.)
    RowsList {
        x: 0;
        y: root.head;
        width: parent.width;
        height: (max(1, root.panel.rows.length) + 1) * (Theme.phone ? 44px : 30px);
        rows: root.panel.rows;
        nav: "installed" + root.place;
        removable: true;
        draggable: true;
    }
}

export component PartyTab inherits Rectangle {
    property <bool> phone: Theme.phone;
    property <length> top: -4px;
    property <length> strip: root.phone ? 0px : 104px;
    property <[string]> stat-labels: [@tr("HP"), @tr("Attack"), @tr("Charge")];
    // The picker under the strip: a row of chips a version (on a phone, the version's name over its chips, three to a row).
    property <length> picker-y: root.phone ? 0px : root.top + root.strip + 12px;
    property <length> chip-height: 30px;
    property <length> team-width: root.phone ? 0px : 120px;
    property <int> per-row: root.phone ? 3 : 6;
    // (The version's name in a column of its own, the pane gap after it before the first chip.)
    property <length> team-gap: root.phone ? 0px : 24px;
    property <length> chip-width: (root.width - root.team-width - root.team-gap - (root.per-row - 1) * 6px) / root.per-row;
    property <length> team-height: root.phone ? 16px + 2 * (root.chip-height + 6px) : root.chip-height + 6px;
    property <length> picker-height: PartyView.teams.length * root.team-height - 6px;
    // PARTY at the left (on a phone, the tab's width), the library at the right.
    property <length> pane-y: root.picker-y + root.picker-height + 12px;
    property <length> pane-width: root.phone ? root.width : 560px;
    property <length> head: root.phone ? 64px : 44px;
    property <length> pitch: root.phone ? 44px : 30px;
    // (A section grows by a row while a program from elsewhere would go into its list: the gap where it would.)
    pure function filling(i: int) -> bool {
        return Drag.on && Drag.to >= 0 && Drag.into == "installed" + i && Drag.list != "installed" + i;
    }
    // (A list with no program has its Empty row.)
    pure function section-height(i: int) -> length {
        return 34px + max(1, PartyView.panels[i].rows.length + (root.filling(i) ? 1 : 0)) * root.pitch;
    }
    property <length> partners-height: PartyView.panels.length == 0 ? 0px : root.section-height(0) + (PartyView.panels.length > 1 ? root.section-height(1) : 0px);
    // (The party's room past its partners: a head each, Empty, as the Patch cards tab's empty slots are.)
    property <int> empty-slots: max(0, PartyView.room - PartyView.panels.length);
    property <length> sections-height: root.partners-height + root.empty-slots * 34px;
    property <length> pane-height: root.head + root.sections-height + (root.sections-height == 0 ? 0px : 12px);
    // (What the page scrolls, and so the library's height, are as tall as PARTY with a row to spare, whether a drag
    // has grown a section or not: a list's rows are made anew whenever its height is asked again, and a row held by
    // the pointer would be let go. Nothing a list's height follows may read `Drag`.)
    property <length> resting-height: root.head + (PartyView.panels.length == 0 ? 0px : 34px + max(1, PartyView.panels[0].rows.length) * root.pitch) + (PartyView.panels.length > 1 ? 34px + max(1, PartyView.panels[1].rows.length) * root.pitch : 0px) + root.empty-slots * 34px + 12px + root.pitch;
    property <length> content-height: max(root.height, root.pane-y + root.resting-height + (root.phone ? 12px + 44px : 0px) + 12px);

    tab-page := ScrollPage {
        x: 0;
        y: 0;
        width: root.width + 12px;
        height: root.height;
        // (The strip's panel starts above the tab, under the tab bar: its line is drawn.)
        bleed: 5px;
        nav: "party-tab.";
        // (A drag on a program's row moves it: the wheel scrolls.)
        mouse-pan: false;
        content-height: root.content-height;
        // ---- The strip: the program or the navi under the cursor, as the Folder tab's lays a chip out.
        PanelBack {
            x: 0;
            y: root.top;
            height: root.strip;
            visible: !root.phone;
        }

        Image {
            x: 18px;
            y: root.top + 20px;
            width: 84px;
            height: 42px;
            visible: !root.phone && PartyView.detail.there && PartyView.detail.blocks == 0;
            source: PartyView.detail.face;
            image-rendering: pixelated;
        }

        // (As large as the face's box takes the most a program fills: 14 a block, or less.)
        Blocks {
            x: 18px;
            y: root.top + 22px;
            visible: !root.phone && PartyView.detail.blocks > 0;
            count: PartyView.detail.blocks;
            filled: PartyView.detail.blocks;
            tone: PartyView.detail.tone;
            size: min(14px, floor(84px / max(1, PartyView.most-blocks) / 1px) * 1px);
        }

        // (The name ends where the strip's top right, the refusal's and the problem's, begins.)
        HorizontalLayout {
            x: 120px;
            y: root.top + 19px;
            width: max(0px, root.width / 2 - 120px - 8px);
            height: 20px;
            visible: !root.phone;
            spacing: 6px;
            alignment: start;
            Text {
                text: PartyView.detail.name;
                color: Theme.text;
                font-family: Theme.body;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            VersionMark {
                y: 2px;
                tag: PartyView.detail.version;
            }
        }

        // (Why what was asked of what it describes wasn't done: the strip's refusal; else what the rules have against
        // it.)
        Refusal {
            x: root.width / 2;
            y: root.top + 19px;
            width: root.width / 2 - 16px;
            visible: !root.phone;
            text: PartyView.detail.problem;
            problem: PartyView.detail.fault;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Text {
            x: 120px;
            y: root.top + 43px;
            width: root.width - 136px;
            height: 18px;
            visible: !root.phone && PartyView.detail.stats.length == 0;
            text: PartyView.detail.description;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        // (A navi's stats in the description's place, each its label, its value and what was added.)
        HorizontalLayout {
            x: 120px;
            y: root.top + 43px;
            width: root.width - 136px;
            height: 18px;
            visible: !root.phone;
            spacing: 18px;
            alignment: start;
            for stat[i] in PartyView.detail.stats: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: stat.label != "" ? stat.label : i < root.stat-labels.length ? root.stat-labels[i] : "";
                    color: Theme.muted;
                    font-family: Theme.body;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: stat.value;
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                if stat.added != "": Text {
                    text: stat.added;
                    color: Theme.cursor;
                    font-family: Theme.mono;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            x: 120px;
            y: root.top + 69px;
            width: root.width - 136px;
            height: 16px;
            visible: !root.phone;
            spacing: 16px;
            alignment: start;
            if PartyView.detail.element.width > 0: Image {
                width: 16px;
                height: 16px;
                source: PartyView.detail.element;
                image-rendering: pixelated;
            }

            for fact in PartyView.detail.facts: Text {
                text: fact;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // ---- The navis to pick from: a row a version.
        for team[t] in PartyView.teams: Rectangle {
            x: 0;
            y: root.picker-y + t * root.team-height;
            width: root.width;
            height: root.team-height;
            Text {
                x: 0;
                y: 0;
                width: root.phone ? root.width : root.team-width;
                height: root.phone ? 16px : root.chip-height;
                text: Caps.of(team.name);
                color: team.tone;
                font-family: Theme.display;
                font-size: 11px;
                font-weight: Theme.display-bold;
                letter-spacing: Theme.label-tracking;
                vertical-alignment: center;
                overflow: elide;
            }

            for chip[k] in team.chips: ChipView {
                x: root.team-width + root.team-gap + mod(k, root.per-row) * (root.chip-width + 6px);
                y: (root.phone ? 16px : 0px) + floor(k / root.per-row) * (root.chip-height + 6px);
                width: root.chip-width;
                height: root.chip-height;
                chip: chip;
                nav-index: team.first + k;
            }

            // (A chip of this row dragged, under the pointer.)
            if Drag.on && Drag.list == "chip" && Drag.from >= team.first && Drag.from < team.first + team.chips.length: ChipView {
                x: Drag.x - parent.absolute-position.x - Drag.grab-x;
                y: Drag.y - parent.absolute-position.y - Drag.grab-y;
                width: root.chip-width;
                height: root.chip-height;
                chip: team.chips[Drag.from - team.first];
                nav-index: Drag.from;
                lifted: true;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: #00000090;
            }
        }

        // ---- PARTY, framed: its title, its counts and CLEAR in its head (on a phone, a box of them); its partners'
        // sections.
        PanelBack {
            x: 0;
            y: root.pane-y;
            width: root.pane-width;
            height: root.pane-height;
        }

        Label {
            x: 12px;
            y: root.pane-y;
            width: max(0px, partners-count.x - 12px - self.x);
            height: root.phone ? 32px : root.head;
            text: Caps.of(@tr("Party"));
            color: PartyView.in-library ? Theme.muted : Theme.cursor;
        }

        partners-count := CountBox {
            x: changes-count.x - 16px - self.width;
            y: root.pane-y + (root.phone ? 8px : 14px);
            label: @tr("Partners");
            value: PartyView.partners;
            suffix: "/\{PartyView.room}";
            value-width: 32px;
        }

        changes-count := CountBox {
            x: clear.x + clear.pad - 12px - self.width;
            y: partners-count.y;
            label: @tr("Navi changes");
            value: PartyView.changes;
            value-width: 16px;
        }

        // CLEAR (docs/design/app-ui.md §2.71): every partner taken out, its programs with it, asked first; dim where
        // there is none. At the head's right end, after the counts.
        clear := WordButton {
            x: root.pane-width - 12px + self.pad - self.width;
            y: partners-count.y - 2px;
            nav: "clear";
            text: Caps.of(@tr("Clear"));
            enabled: PartyView.partners > 0;
        }

        // (What the game's rules have against the party: a phone's line under its counts.)
        ProblemNote {
            x: 12px;
            y: root.pane-y + 36px;
            width: root.pane-width - 24px;
            visible: root.phone;
            text: PartyView.problems;
        }

        for panel[i] in PartyView.panels: SectionView {
            x: 1px;
            y: root.pane-y + root.head + (i == 0 ? 0px : root.section-height(0));
            width: root.pane-width - 2px;
            height: root.section-height(i);
            panel: panel;
            place: i;
            target: PartyView.marked && i == PartyView.target;
        }

        for k in root.empty-slots: Rectangle {
            x: 1px;
            y: root.pane-y + root.head + root.partners-height + k * 34px;
            width: root.pane-width - 2px;
            height: 34px;
            background: Theme.raised;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            Text {
                x: 12px + 32px + 12px;
                text: @tr("Empty");
                color: Theme.dim;
                font-family: Theme.body;
                font-size: Theme.phone ? 15px : 14px;
                vertical-alignment: center;
            }
        }

        // ---- The library, open beside it (a phone's, a sheet a button opens); a partner's program dragged over it is
        // taken out, let go there.
        if !root.phone: Rectangle {
            x: root.pane-width + 24px;
            y: root.pane-y;
            width: root.width - self.x;
            height: max(0px, root.content-height - self.y);
            Label {
                x: 0;
                y: 0;
                width: parent.width;
                height: 36px;
                text: Caps.of(@tr("Library"));
                color: PartyView.in-library ? Theme.cursor : Theme.muted;
            }

            library := RowsList {
                x: 0;
                y: 36px;
                width: parent.width;
                height: parent.height - self.y;
                rows: PartyView.rows;
                nav: "lib.rows";
                removable: false;
                draggable: PartyView.marked;
            }

            RemoveTarget {
                x: -8px;
                y: library.y - 8px;
                width: parent.width + 8px;
                height: library.height + 16px;
                shown: Drag.on && Drag.removing;
                text: Caps.of(@tr("Drop to remove"));

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        Button {
            x: 0;
            y: root.pane-y + root.pane-height + 12px;
            width: root.width;
            visible: root.phone && PartyView.marked;
            nav: root.phone && PartyView.marked ? "programs" : "";
            text: Caps.of(@tr("Library"));
        }

        // (The program dragged, under the pointer: raised, a line in the cursor's color, in the error color over the
        // library, where let go it is taken out; a library's one faint until it is over a partner.)
        Rectangle {
            x: Drag.x - root.absolute-position.x - Drag.grab-x;
            y: Drag.y - root.absolute-position.y - Drag.grab-y;
            width: root.pane-width;
            height: root.pitch - 2px;
            visible: Drag.on && (Drag.list == "lib.rows" || Drag.list == "installed0" || Drag.list == "installed1");
            opacity: Drag.list == "lib.rows" && Drag.to < 0 ? 0.7 : Drag.removing ? 0.6 : 1;
            background: Theme.raised;
            border-width: 1px;
            border-color: Drag.removing ? Theme.bad : Theme.cursor;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000090;
            property <PartyRow> held: Drag.list == "lib.rows" ? PartyView.rows[Drag.from] : Drag.list == "installed1" ? PartyView.panels[1].rows[Drag.from] : PartyView.panels[0].rows[Drag.from];
            // (Why it can't go in where it is.)
            ProgramLine {
                row-data: { name: parent.held.name, note: parent.held.note, why: PartyView.drag-why, blocks: parent.held.blocks, tone: parent.held.tone, bad: parent.held.bad };
            }
        }

        // (A partner's head dragged, under the pointer: raised, a line in the cursor's color.)
        if Drag.on && Drag.list == "target" && Drag.from >= 0 && Drag.from < PartyView.panels.length: Rectangle {
            x: Drag.x - root.absolute-position.x - Drag.grab-x;
            y: Drag.y - root.absolute-position.y - Drag.grab-y;
            width: root.pane-width - 2px;
            height: 34px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.cursor;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000090;
            PartnerHead {
                panel: PartyView.panels[Drag.from];
            }
        }
    }
}

// What the Party tab opens over the window: on a phone, the library as a sheet from the bottom. Its controls' names begin
// with `lib.`: while it is open the keys reach nothing else.
export component PartyOverlay inherits Rectangle {
    property <length> sheet-height: min(self.height - 72px, 660px);
    arrive := Tween { }

    Rectangle {
        background: Theme.shade;
        opacity: arrive.t;
        TouchArea {
            clicked => {
                Nav.activate("lib.close", 0);
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - root.sheet-height + (1 - arrive.t) * 24px;
        height: root.sheet-height;
        opacity: arrive.t;
        background: Theme.panel;
        TouchArea { }

        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        Label {
            x: 16px;
            y: 12px;
            width: parent.width / 2 - 16px;
            height: 28px;
            text: Caps.of(@tr("Library"));
            color: Theme.cursor;
        }

        RowsList {
            x: 16px;
            y: 48px;
            width: parent.width - 32px;
            height: parent.height - self.y - 8px;
            rows: PartyView.rows;
            nav: "lib.rows";
            removable: false;
            draggable: false;
        }
    }
}
