// The Party tab of a build's editor, in a game whose setup takes a party (EXE5's party battle, EXE5 DS's: docs/design/
// exe5ds-map.md §4): the navi's partners, each with the programs filling its PartyCust gauge (§4.10). Its layout is the
// one the user chose (the verification workspace's docs/nettai-ui/party/chosen/party-tab-D9.png, D9c.body.html): one
// screen, no steps and nothing opened over it.
//
// - At the top, the two teams' navis to pick from (the builds data's groups, each a row under its name in its color): a
//   chip per navi, its face, its name, and its place in the party (1, 2) where it is in; raised and outlined in the
//   cursor's color where it is in, muted where the party is full, dim where the build's ruleset holds it back. Enter or a
//   click puts it in or takes it out; the first put in is partner 1. Over them, PARTNERS, how many and the round's navi
//   changes, and at the right what the ruleset says of the versions.
// - Under them at the left, a framed panel for each partner: its head (its face, its place and name, its HP, its gauge
//   and the blocks used of it), its programs as a list's rows under it. The partner PROGRAMS installs into is the one
//   the cursor was last in: its head has a list's chosen row's bar and tint, its name the cursor's color. Del takes a
//   program out.
// - At the right, PROGRAMS, the library, an open list: each program's blocks in its color, its name and what it does (or
//   why it won't go in, in the error red, the row greyed), its cost; INTO and the partner's name at its head's right.
//   Enter installs.
//
// A program is dragged from PROGRAMS into a partner's list or onto its head, in a list to another place or into the
// other partner's, and onto the library to take it out, as the Patch cards tab's cards are.
//
// On a phone the chips wrap three to a row under their team's name, the partners stack under them, and a button under
// them opens PROGRAMS as a sheet (`PartyOverlay`). Its Rust half is src/screens/builds/party.rs.

import { Theme, Caps } from "../../theme.slint";
import { Nav, Focusable, Drag } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { PanelBack, Label, Button, ListView, RowTouch, ScrollPage, ProblemNote } from "../../widgets.slint";
import { Tween, Shake } from "../../motion.slint";
import { DropGap, RemoveTarget } from "folder.slint";

// A navi to pick, as its chip shows it: its face and name; `place`, its place in the party (1, 2; 0: not in); `full`,
// the party has no room for it; `held`, the build's ruleset holds it back.
export struct PartyChip {
    face: image,
    name: string,
    place: int,
    full: bool,
    held: bool,
}

// A team's row of chips: its name in its color (the builds data's group's), and its navis.
export struct PartyTeam {
    name: string,
    tone: color,
    chips: [PartyChip],
}

// A program in a list: its name, what it does (`effect`) or why it won't go in (`why`, the row greyed), its blocks in
// its color, its cost. `bad`: a problem is about it.
export struct PartyRow {
    name: string,
    effect: string,
    why: string,
    blocks: int,
    tone: color,
    bad: bool,
}

// A partner, as its panel shows it: its face, name and HP (its programs' bonus in); its gauge, each block's color and
// the run of its program (`runs`: block i is of the run-th program, the empty blocks one run after them); its programs.
// `bad`: a problem is about it.
export struct PartyPanel {
    face: image,
    name: string,
    hp: string,
    used: int,
    gauge: int,
    tones: [color],
    runs: [int],
    bad: bool,
    rows: [PartyRow],
}

// What the tab shows: src/screens/builds/party.rs sets these.
export global PartyView {
    out property <[Hint]> hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Add or take out · Install") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Remove") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    out property <string> status: self.target-name == "" ? "" : self.target-name + ": " + self.free-word(self.free);
    // PARTNERS' line: the partners, the most there may be, the round's navi changes; whether the ruleset holds a build to
    // one version.
    in property <int> partners;
    in property <int> room;
    in property <int> changes;
    in property <bool> one-version;
    in property <[PartyTeam]> teams;
    in property <[PartyPanel]> panels;
    // The partner PROGRAMS installs into (its place in `panels`), its name, and the blocks free of its gauge.
    in property <int> target;
    in property <string> target-name;
    in property <int> free;
    in property <[PartyRow]> rows;
    // What the game's rules have against the party: a phone's line.
    in property <string> problems;
    // A library's row that was refused, counted: it shakes.
    in property <int> refused: -1;
    in property <int> refused-seq;
    // On a phone: PROGRAMS' sheet is open.
    in property <bool> sheet;
    // ---- Words the app asks for.
    public pure function free-word(n: int) -> string {
        return @tr("{n} block free" | "{n} blocks free" % n);
    }
    // (A partner's HP as the build overview's rows say it.)
    public pure function hp-word(hp: int) -> string {
        return @tr("HP {}", hp);
    }
    public pure function needs-blocks(n: int) -> string {
        return @tr("Needs {}", n);
    }
}

// Program blocks, as the NaviCust tab draws its board's cells: flat in their colors (`tones`, else `tone`), the blocks of
// one program touching as one piece (a faint line between them), a gap between programs (`runs`: each block's
// program); the empty blocks after them outlined slots. Each block `size` square.
component Blocks inherits Rectangle {
    in property <int> count;
    in property <int> filled;
    in property <[color]> tones;
    in property <[int]> runs;
    in property <color> tone: Theme.cursor;
    in property <length> size: 10px;
    property <length> gap: 3px;
    property <int> shown: max(root.count, root.filled);
    width: root.shown * root.size + (root.shown == 0 ? 0 : (root.runs.length >= root.shown ? root.runs[root.shown - 1] : 0)) * root.gap;
    height: root.size;
    for i in root.shown: Rectangle {
        property <int> run: i < root.runs.length ? root.runs[i] : 0;
        property <bool> first: i == 0 || i >= root.runs.length || root.runs[i - 1] != self.run;
        x: i * root.size + self.run * root.gap;
        y: 0;
        width: root.size;
        height: root.size;
        background: i < root.filled ? (i < root.tones.length ? root.tones[i] : root.tone) : transparent;
        border-width: i < root.filled ? 0px : 1px;
        border-color: Theme.dim;
        // (Between two blocks of a program: a faint line.)
        Rectangle {
            x: 0;
            width: 1px;
            visible: i < root.filled && !parent.first;
            background: #00000059;
        }
    }
}

// A navi's chip, a control: its face, its name, its place in the party (1, 2) where it is in.
component ChipView inherits Rectangle {
    in property <PartyChip> chip;
    in property <int> nav-index;
    property <bool> in: root.chip.place > 0;
    Rectangle {
        background: root.in ? Theme.raised : Theme.panel;
        border-width: 1px;
        border-color: root.in ? Theme.cursor : Theme.line;
    }

    Image {
        x: 6px;
        y: (parent.height - 16px) / 2;
        width: 32px;
        height: 16px;
        source: root.chip.face;
        image-rendering: pixelated;
        opacity: root.chip.held ? 0.35 : 1;
    }

    Text {
        x: 46px;
        width: max(0px, parent.width - self.x - (root.in ? 8px + 16px + 8px : 8px));
        text: root.chip.name;
        color: root.chip.held ? Theme.dim : root.chip.full && !root.in ? Theme.muted : Theme.text;
        font-family: Theme.display;
        font-size: 13px;
        font-weight: Theme.display-semibold;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 8px - self.width;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        visible: root.in;
        background: Theme.cursor;
        Text {
            text: root.chip.place;
            color: Theme.action-ink;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Focusable {
        nav: "chip";
        nav-index: root.nav-index;
    }
}

// What a program's row shows (the one dragged, under the pointer, too).
component ProgramLine inherits Rectangle {
    in property <PartyRow> row-data;
    in property <bool> cost;
    Blocks {
        x: 12px;
        y: (parent.height - self.height) / 2;
        count: root.row-data.blocks;
        filled: root.row-data.blocks;
        tone: root.row-data.tone;
        opacity: root.row-data.why != "" ? 0.4 : 1;
    }

    name := Text {
        x: 12px + 56px + 10px;
        width: min(self.preferred-width, max(0px, parent.width - self.x - 40px));
        text: root.row-data.name;
        color: root.row-data.why != "" ? Theme.dim : root.row-data.bad ? Theme.bad : Theme.text;
        font-family: Theme.body;
        font-size: Theme.phone ? 15px : 14px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: name.x + name.width + 6px;
        width: max(0px, parent.width - self.x - 40px);
        text: root.row-data.why != "" ? root.row-data.why : root.row-data.effect;
        color: root.row-data.why != "" ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 12px - self.width;
        width: 24px;
        text: root.row-data.blocks;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line.with-alpha(0.45);
    }
}

// A program's row in a list: shifted (`dy`) while another is dragged, gone while it is the one dragged.
component RowView inherits Rectangle {
    in property <PartyRow> row-data;
    in property <string> nav;
    in property <int> nav-index;
    in property <bool> removable;
    in property <bool> draggable;
    in property <length> dx;
    in property <length> dy;
    in property <bool> gone;
    Rectangle {
        y: root.dy;
        opacity: root.gone ? 0 : 1;
        animate y {
            duration: Drag.on ? Theme.quick : 0ms;
            easing: ease-out;
        }
        Rectangle {
            background: touch.has-hover && !Drag.on ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
        }

        ProgramLine {
            x: root.dx;
            row-data: root.row-data;
        }
    }

    touch := RowTouch {
        nav: root.nav;
        nav-index: root.nav-index;
        removable: root.removable;
        drag: root.draggable ? root.nav : "";
    }
}

// A list of programs: a partner's (`removable`, its rows shifting to leave a gap where one dragged would land) or the
// library's.
component RowsList inherits Rectangle {
    in property <[PartyRow]> rows;
    in property <string> nav;
    in property <bool> removable;
    in property <bool> draggable;
    in property <bool> scrolls;
    property <length> pitch: Theme.phone ? 44px : 30px;
    // (A row of this list dragged in it, or one from elsewhere landing in it: where it would land.)
    property <bool> mine: Drag.on && Drag.into == root.nav && Drag.to >= 0;
    property <bool> moving: root.mine && Drag.list == root.nav;
    property <bool> filling: root.mine && Drag.list != root.nav;
    pure function shown(i: int) -> int {
        return root.filling ? (i >= Drag.to ? i + 1 : i) : !root.moving ? i : i == Drag.from ? Drag.to : (Drag.from < i && i <= Drag.to) ? i - 1 : (Drag.to <= i && i < Drag.from) ? i + 1 : i;
    }
    shake := Shake {
        seq: PartyView.refused-seq;
    }

    list := ListView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        nav: root.nav;
        count: root.rows.length;
        row-height: root.pitch - 2px;
        gap: 2px;
        chosen: self.focused-row;
        // (A drag on a row moves its program: the wheel scrolls.)
        mouse-pan: !root.draggable;
        for slot in list.shown: RowView {
            property <int> at: list.first + slot;
            y: self.at * list.pitch;
            width: list.row-width;
            height: list.row-height;
            row-data: root.rows[self.at];
            nav: root.nav;
            nav-index: self.at;
            removable: root.removable;
            draggable: root.draggable;
            dx: !root.removable && self.at == PartyView.refused ? shake.dx : 0px;
            dy: (root.shown(self.at) - self.at) * list.pitch;
            gone: Drag.on && Drag.list == root.nav && self.at == Drag.from && !Drag.removing;
        }
    }

    // (Where a program dragged in from elsewhere would go.)
    DropGap {
        x: 0;
        y: Drag.to * root.pitch - list.scroll;
        width: list.row-width;
        height: root.pitch - 2px;
        visible: root.filling;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}

// A partner's panel: its head, a control (the cursor in it makes it the partner PROGRAMS installs into; `target` lights
// it as a list's chosen row), and its programs' list under it.
component PanelView inherits Rectangle {
    in property <PartyPanel> panel;
    in property <int> place;
    in property <bool> target;
    property <length> head: 44px;
    PanelBack {
        accent: false;
    }

    // (The partner PROGRAMS installs into: a list's chosen row's tint and bar.)
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: root.head - 1px;
        visible: root.target;
        background: @linear-gradient(90deg, Theme.tint 0%, Theme.clear 100%);
        Rectangle {
            x: 0;
            width: 3px;
            background: Theme.cursor;
        }
    }

    Image {
        x: 12px;
        y: (root.head - 16px) / 2;
        width: 32px;
        height: 16px;
        source: root.panel.face;
        image-rendering: pixelated;
    }

    Label {
        x: 12px + 32px + 8px;
        y: 0;
        width: max(0px, hp.x - 12px - self.x);
        height: root.head;
        text: Caps.of(root.place + 1 + " · " + root.panel.name);
        color: root.panel.bad ? Theme.bad : root.target ? Theme.cursor : Theme.muted;
    }

    hp := HorizontalLayout {
        x: gauge.x - 12px - self.width;
        y: 0;
        height: root.head;
        spacing: 4px;
        Text {
            text: "HP";
            color: Theme.muted;
            font-family: Theme.display;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            text: root.panel.hp;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    gauge := Blocks {
        x: used.x - 8px - self.width;
        y: (root.head - self.height) / 2;
        count: root.panel.gauge;
        filled: root.panel.used;
        tones: root.panel.tones;
        runs: root.panel.runs;
        size: 12px;
    }

    used := Text {
        x: parent.width - 12px - self.width;
        y: 0;
        width: 36px;
        height: root.head;
        text: root.panel.used + "/" + root.panel.gauge;
        color: root.panel.used > root.panel.gauge ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        y: root.head - 1px;
        height: 1px;
        visible: root.panel.rows.length > 0;
        background: Theme.line.with-alpha(0.45);
    }

    Focusable {
        x: 0;
        y: 0;
        height: root.head;
        nav: "target";
        nav-index: root.place;
    }

    RowsList {
        x: 0;
        y: root.head;
        width: parent.width;
        height: root.panel.rows.length * (Theme.phone ? 44px : 30px);
        rows: root.panel.rows;
        nav: "installed" + root.place;
        removable: true;
        draggable: true;
    }
}

export component PartyTab inherits Rectangle {
    property <bool> phone: Theme.phone;
    // The picker: its line, then a row of chips a team (on a phone, the team's name over its chips, three to a row).
    property <length> line-height: 26px;
    property <length> chip-height: 30px;
    property <length> team-width: root.phone ? 0px : 120px;
    property <int> per-row: root.phone ? 3 : 6;
    property <length> chip-width: (root.width - root.team-width - root.per-row * 6px) / root.per-row;
    property <length> team-height: root.phone ? 16px + 2 * (root.chip-height + 6px) : root.chip-height + 6px;
    property <length> picker-height: root.line-height + PartyView.teams.length * root.team-height;
    // Under it: the partners at the left (on a phone, the whole width), PROGRAMS at the right.
    property <length> body-y: root.picker-height + 12px;
    property <length> left-width: root.phone ? root.width : 560px;
    property <length> pitch: root.phone ? 44px : 30px;
    property <length> panel-gap: 12px;
    pure function panel-height(i: int) -> length {
        return 44px + PartyView.panels[i].rows.length * root.pitch;
    }
    property <length> panels-height: PartyView.panels.length == 0 ? 0px : root.panel-height(0) + (PartyView.panels.length > 1 ? root.panel-gap + root.panel-height(1) : 0px);
    property <length> content-height: max(root.height, root.body-y + root.panels-height + (root.phone ? 12px + 44px : 0px) + 12px);

    tab-page := ScrollPage {
        x: 0;
        y: 0;
        width: root.width + 12px;
        height: root.height;
        nav: "party-tab.";
        // (A drag on a program's row moves it: the wheel scrolls.)
        mouse-pan: false;
        content-height: root.content-height;
        // ---- PARTNERS: how many, the round's navi changes, what a press does; at the right, the ruleset's versions.
        HorizontalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: 20px;
            spacing: 12px;
            Label {
                width: self.preferred-width;
                text: Caps.of(@tr("Partners"));
                color: Theme.cursor;
            }

            Text {
                text: PartyView.partners + "/" + PartyView.room;
                color: Theme.text;
                font-family: Theme.body;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "· " + @tr("Navi changes");
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 13px;
                vertical-alignment: center;
            }

            Text {
                text: PartyView.changes;
                color: Theme.text;
                font-family: Theme.body;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                visible: !root.phone;
                text: "· " + @tr("Enter adds or takes out");
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 13px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                visible: !root.phone;
                text: PartyView.one-version ? @tr("This ruleset: one version per build") : @tr("This ruleset: versions mixed");
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        // (What the game's rules have against the party: a phone's line, under the picker's.)
        ProblemNote {
            x: 0;
            y: root.picker-height - 4px;
            width: root.width;
            visible: root.phone;
            text: PartyView.problems;
        }

        for team[t] in PartyView.teams: Rectangle {
            property <int> before: t == 0 ? 0 : PartyView.teams[0].chips.length;
            x: 0;
            y: root.line-height + t * root.team-height;
            width: root.width;
            height: root.team-height;
            Text {
                x: 0;
                y: 0;
                width: root.phone ? root.width : root.team-width;
                height: root.phone ? 16px : root.chip-height;
                text: Caps.of(team.name);
                color: team.tone;
                font-family: Theme.display;
                font-size: 11px;
                font-weight: Theme.display-bold;
                letter-spacing: Theme.label-tracking;
                vertical-alignment: center;
                overflow: elide;
            }

            for chip[k] in team.chips: ChipView {
                x: root.team-width + mod(k, root.per-row) * (root.chip-width + 6px);
                y: (root.phone ? 16px : 0px) + floor(k / root.per-row) * (root.chip-height + 6px);
                width: root.chip-width;
                height: root.chip-height;
                chip: chip;
                nav-index: parent.before + k;
            }
        }

        // ---- The partners, each its panel, stacked.
        for panel[i] in PartyView.panels: PanelView {
            x: 0;
            y: root.body-y + (i == 0 ? 0px : root.panel-height(0) + root.panel-gap);
            width: root.left-width;
            height: root.panel-height(i);
            panel: panel;
            place: i;
            target: i == PartyView.target;
        }

        // ---- PROGRAMS, the library, open beside them (a phone's, a sheet a button opens); a partner's program dragged
        // over it is taken out, let go there.
        if !root.phone: Rectangle {
            x: root.left-width + 24px;
            y: root.body-y;
            width: root.width - self.x;
            height: max(0px, root.height - self.y);
            Label {
                x: 0;
                y: 0;
                width: parent.width / 2;
                height: 36px;
                text: Caps.of(@tr("Programs"));
                color: Nav.id == "lib.rows" ? Theme.cursor : Theme.muted;
            }

            Label {
                x: parent.width / 2;
                y: 0;
                width: parent.width / 2;
                height: 36px;
                horizontal-alignment: right;
                text: PartyView.target-name == "" ? "" : Caps.of(@tr("Into {}", PartyView.target-name));
            }

            library := RowsList {
                x: 0;
                y: 36px;
                width: parent.width;
                height: parent.height - self.y;
                rows: PartyView.rows;
                nav: "lib.rows";
                removable: false;
                draggable: PartyView.target-name != "";
            }

            RemoveTarget {
                x: -8px;
                y: library.y - 8px;
                width: parent.width + 8px;
                height: library.height + 16px;
                shown: Drag.on && Drag.removing;
                text: Caps.of(@tr("Drop to remove"));

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        Button {
            x: 0;
            y: root.body-y + root.panels-height + 12px;
            width: root.width;
            visible: root.phone && PartyView.target-name != "";
            nav: root.phone && PartyView.target-name != "" ? "programs" : "";
            text: Caps.of(@tr("Programs"));
        }

        // (The program dragged, under the pointer: raised, a line in the cursor's color, in the error color over the
        // library, where let go it is taken out; a library's one faint until it is over a partner.)
        Rectangle {
            x: Drag.x - root.absolute-position.x - Drag.grab-x;
            y: Drag.y - root.absolute-position.y - Drag.grab-y;
            width: root.left-width;
            height: root.pitch - 2px;
            visible: Drag.on && (Drag.list == "lib.rows" || Drag.list == "installed0" || Drag.list == "installed1");
            opacity: Drag.list == "lib.rows" && Drag.to < 0 ? 0.7 : Drag.removing ? 0.6 : 1;
            background: Theme.raised;
            border-width: 1px;
            border-color: Drag.removing ? Theme.bad : Theme.cursor;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000090;
            ProgramLine {
                row-data: Drag.list == "lib.rows" ? PartyView.rows[Drag.from] : Drag.list == "installed1" ? PartyView.panels[1].rows[Drag.from] : PartyView.panels[0].rows[Drag.from];
            }
        }
    }
}

// What the Party tab opens over the window: on a phone, PROGRAMS as a sheet from the bottom. Its controls' names begin
// with `lib.`: while it is open the keys reach nothing else.
export component PartyOverlay inherits Rectangle {
    property <length> sheet-height: min(self.height - 72px, 660px);
    arrive := Tween { }

    Rectangle {
        background: Theme.shade;
        opacity: arrive.t;
        TouchArea {
            clicked => {
                Nav.activate("lib.close", 0);
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - root.sheet-height + (1 - arrive.t) * 24px;
        height: root.sheet-height;
        opacity: arrive.t;
        background: Theme.panel;
        TouchArea { }

        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        Label {
            x: 16px;
            y: 12px;
            width: parent.width / 2 - 16px;
            height: 28px;
            text: Caps.of(@tr("Programs"));
            color: Theme.cursor;
        }

        Label {
            x: parent.width / 2;
            y: 12px;
            width: parent.width / 2 - 16px;
            height: 28px;
            horizontal-alignment: right;
            text: PartyView.target-name == "" ? "" : Caps.of(@tr("Into {}", PartyView.target-name));
        }

        RowsList {
            x: 16px;
            y: 48px;
            width: parent.width - 32px;
            height: parent.height - self.y - 8px;
            rows: PartyView.rows;
            nav: "lib.rows";
            removable: false;
            draggable: false;
        }
    }
}
