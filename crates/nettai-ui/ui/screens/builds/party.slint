// The Party tab of a build's editor, in a game whose setup takes a party (EXE5's party battle, EXE5 DS's: docs/design/
// exe5ds-map.md §4): the navi's partners, each with the programs filling its PartyCust gauge (§4.10). The layout is the
// user's: two partner cards across the top (each its face, name, HP with its programs' bonus, and its gauge), always
// there, an empty one "Add a partner"; the card focused is the partner whose PartyCust is below it: a header with its
// name and its gauge drawn large in its programs' colors, then two panes, INSTALLED (framed: the partner's programs,
// each with its blocks) and PROGRAMS (the library, open: each with its blocks and its cost; one that won't fit greyed,
// with why). Enter on a card opens the navis to pick from (the shell's list, a phone's sheet); Enter in PROGRAMS
// installs; Enter or Del in INSTALLED removes. The strip across the top describes what is under the cursor.
//
// On a phone the cards sit side by side small at the top, then the gauge, INSTALLED, and a button that opens PROGRAMS
// as a sheet (`PartyOverlay`). Its Rust half is src/screens/builds/party.rs.

import { Theme, Caps } from "../../theme.slint";
import { Nav, Focusable } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { PanelBack, Label, Button, ButtonKind, ListView, RowTouch, ScrollPage, Refusal, ProblemNote, WordButton } from "../../widgets.slint";
import { Tween, Shake } from "../../motion.slint";

// A partner's card: its face, name and HP (its programs' bonus in), the blocks its programs fill of its gauge, each
// in its program's color (a NaviCust program's colors: `crate::builds::grid::PALETTE`). `there` off: no partner yet.
// `bad`: a problem is about it.
export struct PartnerCard {
    there: bool,
    face: image,
    name: string,
    hp: string,
    used: int,
    gauge: int,
    tones: [color],
    bad: bool,
}

// A program in a pane: its name, its blocks in its color, its cost; in PROGRAMS a note (why it can't go in:
// `refused` greys it, `bad` puts the note in the error red).
export struct PartyRow {
    name: string,
    blocks: int,
    tone: color,
    note: string,
    refused: bool,
    bad: bool,
}

// What the strip describes: a navi's face, or a program's blocks; its name, its facts, the game's words for it, why it
// can't go in (`problem`, a refusal) or what the build's problems have against it (`fault`).
export struct PartyDetail {
    there: bool,
    face: image,
    name: string,
    blocks: int,
    tone: color,
    facts: string,
    text: string,
    problem: string,
    fault: string,
}

// What the tab shows: src/screens/builds/party.rs sets these.
export global PartyView {
    out property <[Hint]> hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: Nav.id == "lib.rows" ? @tr("Put in") : Nav.id == "installed" ? @tr("Remove") : @tr("Choose") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Remove") },
        { key: "X", pad: PadButton.none, text: @tr("Clear") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    out property <string> status: @tr("{n} partner" | "{n} partners" % self.partners);
    in property <int> partners;
    in property <PartyDetail> detail;
    // The two cards, and the one chosen: the partner whose PartyCust is shown.
    in property <[PartnerCard]> cards;
    in property <int> chosen;
    // The chosen partner's PartyCust: its title ("ProtoMan's PartyCust"; empty: no partner), its gauge, its programs
    // and the library.
    in property <string> title;
    in property <[PartyRow]> installed;
    in property <[PartyRow]> rows;
    // What the game's rules have against the party, a phone's line (a desktop's strip says them).
    in property <string> problems;
    // A library's row that was refused, counted: it shakes.
    in property <int> refused: -1;
    in property <int> refused-seq;
    // On a phone: the library's sheet is open.
    in property <bool> sheet;
    // ---- Words the app asks for.
    out property <string> clear-question: @tr("Clear the party?");
    out property <string> remove-word: Caps.of(@tr("Remove"));
    public pure function blocks-word(n: int) -> string {
        return @tr("{n} block" | "{n} blocks" % n);
    }
    public pure function hp-word(hp: int) -> string {
        return @tr("HP {}", hp);
    }
    public pure function needs-blocks(n: int) -> string {
        return @tr("Needs {n} block" | "Needs {n} blocks" % n);
    }
    public pure function in-party() -> string {
        return @tr("In the party");
    }
    public pure function partycust-of(navi: string) -> string {
        return @tr("{}'s PartyCust", navi);
    }
}

// A gauge of `count` blocks, the first `filled` filled, each in its program's color (`tones`, else `tone`; past the
// count: all in the error red), each block `size` wide.
component Blocks inherits Rectangle {
    in property <int> count;
    in property <int> filled;
    in property <[color]> tones;
    in property <color> tone: Theme.cursor;
    in property <length> size: 8px;
    width: root.count * (root.size + 2px);
    for i in root.count: Rectangle {
        x: i * (root.size + 2px);
        y: 0;
        width: root.size;
        height: root.height;
        background: root.filled > root.count ? Theme.bad : i < root.filled ? (i < root.tones.length ? root.tones[i] : root.tone) : Theme.inset;
        border-width: 1px;
        border-color: Theme.line;
    }
}

// A partner's card, a control: its face, name and HP, its gauge and the blocks used of it; empty, "Add a partner".
// `chosen` lights its line and its label (the partner whose PartyCust is below).
component CardView inherits Rectangle {
    in property <PartnerCard> card;
    in property <int> nav-index;
    in property <bool> chosen;
    PanelBack {
        accent: root.chosen;
    }

    Label {
        x: 12px;
        y: 4px;
        width: parent.width - 24px;
        height: 18px;
        text: Caps.of(@tr("Partner {}", root.nav-index + 1));
        color: root.chosen ? Theme.cursor : Theme.muted;
    }

    Image {
        x: 12px;
        y: 26px;
        width: Theme.phone ? 32px : 64px;
        height: Theme.phone ? 16px : 32px;
        visible: root.card.there;
        source: root.card.face;
        image-rendering: pixelated;
    }

    property <length> text-x: Theme.phone ? 52px : 88px;
    Text {
        x: root.card.there ? root.text-x : 12px;
        y: 24px;
        width: parent.width - self.x - 12px;
        height: 20px;
        text: root.card.there ? root.card.name : @tr("Add a partner");
        color: !root.card.there ? Theme.dim : root.card.bad ? Theme.bad : Theme.text;
        font-family: Theme.body;
        font-size: Theme.phone ? 13px : 15px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.text-x;
        y: 46px;
        width: 64px;
        height: 16px;
        visible: root.card.there && !Theme.phone;
        text: root.card.hp;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 12px;
        vertical-alignment: center;
    }

    gauge := Blocks {
        x: Theme.phone ? 12px : root.text-x + 72px;
        y: Theme.phone ? 48px : 49px;
        height: 10px;
        visible: root.card.there;
        count: root.card.gauge;
        filled: root.card.used;
        tones: root.card.tones;
        size: Theme.phone ? 6px : 8px;
    }

    Text {
        x: parent.width - 12px - self.width;
        y: Theme.phone ? 44px : 46px;
        width: 40px;
        height: 16px;
        visible: root.card.there;
        text: root.card.used + "/" + root.card.gauge;
        color: root.card.used > root.card.gauge ? Theme.bad : Theme.muted;
        font-family: Theme.mono;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Focusable {
        nav: "partner";
        nav-index: root.nav-index;
        describes: true;
    }
}

// A program in a pane: its blocks in its color, its name, a note, its cost.
component RowView inherits Rectangle {
    in property <PartyRow> row-data;
    in property <string> nav;
    in property <int> nav-index;
    in property <bool> removable;
    in property <length> dx;
    Rectangle {
        background: touch.has-hover ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
    }

    blocks := Blocks {
        x: 8px + root.dx;
        y: (parent.height - self.height) / 2;
        height: 10px;
        count: root.row-data.blocks;
        filled: root.row-data.blocks;
        tone: root.row-data.tone;
        opacity: root.row-data.refused ? 0.4 : 1;
    }

    property <length> name-x: 8px + 7 * 10px + 8px;
    property <length> note-width: Theme.phone ? 110px : 140px;
    Text {
        x: root.name-x + root.dx;
        width: max(0px, parent.width - root.name-x - root.note-width - 40px);
        text: root.row-data.name;
        color: root.row-data.refused ? Theme.dim : Theme.text;
        font-family: Theme.body;
        font-size: Theme.phone ? 14px : 13px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 40px - root.note-width + root.dx;
        width: root.note-width;
        text: root.row-data.note;
        color: root.row-data.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 32px;
        width: 24px;
        visible: !root.removable;
        text: root.row-data.blocks;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    touch := RowTouch {
        nav: root.nav;
        nav-index: root.nav-index;
        removable: root.removable;
        describes: true;
    }
}

// A pane's list: INSTALLED (`installed`) or PROGRAMS (the library, `lib.rows`).
component RowsPane inherits Rectangle {
    in property <[PartyRow]> rows;
    in property <string> nav;
    in property <bool> removable;
    shake := Shake {
        seq: PartyView.refused-seq;
    }

    list := ListView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        nav: root.nav;
        count: root.rows.length;
        row-height: Theme.phone ? 44px : 30px;
        chosen: self.focused-row;
        for slot in list.shown: RowView {
            property <int> at: list.first + slot;
            y: self.at * list.pitch;
            width: list.row-width;
            height: list.row-height;
            row-data: root.rows[self.at];
            nav: root.nav;
            nav-index: self.at;
            removable: root.removable;
            dx: !root.removable && self.at == PartyView.refused ? shake.dx : 0px;
        }
    }
}

export component PartyTab inherits Rectangle {
    property <length> top: -4px;
    property <length> strip: Theme.phone ? 0px : 104px;
    property <length> cards-y: Theme.phone ? 24px : root.top + root.strip + 12px;
    property <length> card-height: Theme.phone ? 68px : 84px;
    property <length> card-width: (self.width - 12px) / 2;
    property <length> head-y: root.cards-y + root.card-height + 16px;
    property <length> panes-y: root.head-y + 40px;
    property <length> pane-width: Theme.phone ? self.width : (self.width - 24px) / 2;
    property <length> panes-height: max(160px, self.height - root.panes-y - (Theme.phone ? 52px : 0px));
    property <bool> partner: PartyView.title != "";

    tab-page := ScrollPage {
        x: 0;
        y: 0;
        width: root.width + 12px;
        height: root.height;
        // (The strip's panel starts above the tab, under the tab bar: its line is drawn.)
        bleed: 5px;
        nav: "party-tab.";
        mouse-pan: false;
        content-height: max(root.height, root.panes-y + 160px);
        // ---- The strip: the partner or the program under the cursor.
        PanelBack {
            x: 0;
            y: root.top;
            height: root.strip;
            visible: !Theme.phone;
        }

        Image {
            x: 18px;
            y: root.top + 20px;
            width: 64px;
            height: 32px;
            visible: !Theme.phone && PartyView.detail.blocks == 0;
            source: PartyView.detail.face;
            image-rendering: pixelated;
        }

        Blocks {
            x: 18px;
            y: root.top + 25px;
            height: 10px;
            visible: !Theme.phone && PartyView.detail.blocks > 0;
            count: PartyView.detail.blocks;
            filled: PartyView.detail.blocks;
            tone: PartyView.detail.tone;
        }

        Text {
            x: 104px;
            y: root.top + 19px;
            width: parent.width / 2 - 104px;
            height: 20px;
            visible: !Theme.phone;
            text: PartyView.detail.name;
            color: Theme.text;
            font-family: Theme.body;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        Refusal {
            x: parent.width / 2;
            y: root.top + 19px;
            width: parent.width / 2 - 16px;
            visible: !Theme.phone;
            text: PartyView.detail.problem;
            problem: PartyView.detail.fault;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Text {
            x: 104px;
            y: root.top + 43px;
            width: parent.width - 120px;
            height: 18px;
            visible: !Theme.phone;
            text: PartyView.detail.facts;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 104px;
            y: root.top + 63px;
            width: parent.width - 120px;
            height: 34px;
            visible: !Theme.phone;
            text: PartyView.detail.text;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            wrap: word-wrap;
            overflow: elide;
        }

        // (What the game's rules have against the party: a phone's line over the cards, before CLEAR.)
        ProblemNote {
            x: 0px;
            y: 0px;
            width: max(0px, clear.x + clear.pad - 12px);
            visible: Theme.phone;
            text: PartyView.problems;
        }

        // ---- The two partners' cards.
        for card[i] in PartyView.cards: CardView {
            x: i * (root.card-width + 12px);
            y: root.cards-y;
            width: root.card-width;
            height: root.card-height;
            card: card;
            nav-index: i;
            chosen: i == PartyView.chosen;
        }

        // ---- The chosen partner's PartyCust: its title, its gauge large, CLEAR (every partner taken out, asked first).
        Label {
            x: 0;
            y: root.head-y;
            width: max(0px, head-gauge.x - 12px);
            height: 28px;
            text: root.partner ? Caps.of(PartyView.title) : "";
            color: Theme.cursor;
        }

        head-gauge := Blocks {
            x: clear.x + clear.pad - 16px - self.width - 48px;
            y: root.head-y + 6px;
            height: 16px;
            visible: root.partner;
            count: PartyView.cards[PartyView.chosen].gauge;
            filled: PartyView.cards[PartyView.chosen].used;
            tones: PartyView.cards[PartyView.chosen].tones;
            size: Theme.phone ? 10px : 14px;
        }

        Text {
            x: head-gauge.x + head-gauge.width + 8px;
            y: root.head-y;
            width: 40px;
            height: 28px;
            visible: root.partner;
            text: PartyView.cards[PartyView.chosen].used + "/" + PartyView.cards[PartyView.chosen].gauge;
            color: PartyView.cards[PartyView.chosen].used > PartyView.cards[PartyView.chosen].gauge ? Theme.bad : Theme.muted;
            font-family: Theme.mono;
            font-size: 13px;
            vertical-alignment: center;
        }

        clear := WordButton {
            x: root.width + self.pad - self.width;
            y: Theme.phone ? 0px : root.head-y + 2px;
            nav: "clear";
            text: Caps.of(@tr("Clear"));
            enabled: PartyView.partners > 0;
        }

        // INSTALLED, framed; PROGRAMS, open beside it (on a phone, a sheet a button opens).
        PanelBack {
            x: 0;
            y: root.panes-y;
            width: root.pane-width;
            height: root.panes-height;
            visible: root.partner;
        }

        Label {
            x: 12px;
            y: root.panes-y;
            width: root.pane-width - 24px;
            height: 36px;
            visible: root.partner;
            text: Caps.of(@tr("Installed"));
            color: Nav.id == "installed" ? Theme.cursor : Theme.muted;
        }

        RowsPane {
            x: 4px;
            y: root.panes-y + 36px;
            width: root.pane-width - 8px;
            height: root.panes-height - 44px;
            visible: root.partner;
            rows: PartyView.installed;
            nav: root.partner ? "installed" : "";
            removable: true;
        }

        Label {
            x: root.pane-width + 24px;
            y: root.panes-y;
            width: root.pane-width;
            height: 36px;
            visible: root.partner && !Theme.phone;
            text: Caps.of(@tr("Programs"));
            color: Nav.id == "lib.rows" ? Theme.cursor : Theme.muted;
        }

        RowsPane {
            x: root.pane-width + 24px;
            y: root.panes-y + 36px;
            width: root.pane-width;
            height: root.panes-height - 44px;
            visible: root.partner && !Theme.phone;
            rows: PartyView.rows;
            nav: root.partner && !Theme.phone ? "lib.rows" : "";
            removable: false;
        }

        Button {
            x: 0;
            y: root.panes-y + root.panes-height + 8px;
            width: root.width;
            visible: root.partner && Theme.phone;
            nav: root.partner && Theme.phone ? "programs" : "";
            text: Caps.of(@tr("Programs"));
        }
    }
}

// What the Party tab opens over the window: on a phone, PROGRAMS as a sheet from the bottom. Its controls' names
// begin with `lib.`: while it is open the keys reach nothing else.
export component PartyOverlay inherits Rectangle {
    property <length> sheet-height: min(self.height - 72px, 660px);
    arrive := Tween { }

    Rectangle {
        background: Theme.shade;
        opacity: arrive.t;
        TouchArea {
            clicked => {
                Nav.activate("lib.close", 0);
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - root.sheet-height + (1 - arrive.t) * 24px;
        height: root.sheet-height;
        opacity: arrive.t;
        background: Theme.panel;
        TouchArea { }

        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        Label {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: 28px;
            text: Caps.of(@tr("Programs"));
            color: Theme.cursor;
        }

        RowsPane {
            x: 16px;
            y: 48px;
            width: parent.width - 32px;
            height: parent.height - self.y - 8px;
            rows: PartyView.rows;
            nav: "lib.rows";
            removable: false;
        }
    }
}
