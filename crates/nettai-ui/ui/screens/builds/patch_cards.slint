// The Patch cards tab of a build's editor (docs/design/app-ui.md §6, "Patch cards"; §2 items 19, 20 and 63): the
// folder's shape. A strip across the top lays the card under the cursor (or the pointer) out, from either pane: its
// number, its name, its MB or its slot, why it can't go in (in the error red), and its lines in its card screen's two
// groups (a game whose cards have none: what it does, and the bugs it adds to or clears), a bug's purple. Under it,
// framed, what the build holds: its cards in their order (a game with slots: each slot by its name, with its card or
// Empty), each a row as the folder's entries are, its number, its name and its MB (its lines are the strip's: the
// user, "the name isn't very visible"); their count and MB in the header, and what they add up to at the foot. Beside
// it the library, an open list, with a search and a sort. No pictures (cards have none), and no on and off (nettai
// can't turn a card off). A card that can't go in stays, greyed, with why.
//
// On a phone the cards are one column under their counts, and the library opens as a sheet from the bottom
// (`PatchCardsOverlay`), with what a card's keys do as buttons. Its Rust half is src/screens/builds/patch_cards.rs.

import { Theme, Audit } from "../../theme.slint";
import { Nav, Focusable, Drag } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { Cut, PanelBack, Label, Field, Select, Button, ButtonKind, ListView, RowTouch, Refusal, ProblemNote, WordButton } from "../../widgets.slint";
import { Tween, Flash, Shake, Count } from "../../motion.slint";
import { LibraryHead, DropGap, RemoveTarget } from "folder.slint";
import { VersionTag, VersionMark } from "../../build.slint";

// One line a card writes, a bug's purple.
export struct CardLine {
    text: string,
    bug: bool,
}

// A card, as a row shows it: its number and name, its MB (none in a game without), the slot it belongs in (a game
// with slots); in the library, a note (it is in, or why it can't go in: `refused` greys the row, `bad` puts the note
// in the error red); in the build's, `bad` puts its name in the error red where a problem is about it
// (docs/design/app-ui.md §2.66). `there` off: a slot or a place with no card.
export struct CardRow {
    there: bool,
    number: string,
    name: string,
    megabytes: string,
    slot: string,
    note: string,
    refused: bool,
    bad: bool,
    // The version its variant is (Bass-Cross MegaMan's), or the card is one's own, marked after its name.
    version: VersionTag,
}

// The card under the cursor, for the strip: its number, name and facts (its MB, its slot), why it can't go in
// (`problem`, a refusal) or what the game's rules have against it (`fault`), and its lines in its two groups under
// their titles.
export struct CardDetail {
    there: bool,
    number: string,
    name: string,
    facts: string,
    problem: string,
    fault: string,
    first-title: string,
    first: [CardLine],
    second-title: string,
    second: [CardLine],
}

// What the build's cards hold: how many cards, their MB against the most (`budget`: the game's cards cost MB); in a
// game with slots (`slotted`), how many of its slots hold a card.
export struct CardCounts {
    cards: int,
    megabytes: int,
    limit: int,
    budget: bool,
    slotted: bool,
    filled: int,
    slots: int,
}

// What the tab shows: src/screens/builds/patch_cards.rs sets these.
export global PatchCardsView {
    out property <[Hint]> hints: self.counts.slotted ? self.slot-hints : self.list-hints;
    property <[Hint]> list-hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: self.on-installed ? @tr("Remove") : @tr("Add") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Remove") },
        { key: "[", key2: "]", pad: PadButton.north, text: @tr("Move up or down") },
        { key: "X", pad: PadButton.none, text: @tr("Clear") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    property <[Hint]> slot-hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: self.on-installed ? @tr("Remove") : @tr("Put in") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("verb" => "Empty") },
        { key: "X", pad: PadButton.none, text: @tr("Clear") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    out property <string> status: self.counts.slotted ? @tr("{n} slot free" | "{n} slots free" % (self.counts.slots - self.counts.filled)) : (self.counts.budget ? @tr("{} MB free", max(0, self.counts.limit - self.counts.megabytes)) : "");
    // The strip.
    in property <CardDetail> detail;
    // The build's cards (in a game with slots, its slots), the one the cursor was last on (the one a card from the
    // library goes in), and what they hold. That one has the chosen row's mark while the focus is on it or in the
    // library, the cursor shown or not (after a click the cursor is hidden, and the focus stays on the card
    // clicked: the mark is what shows it); -1, none marked.
    in property <[CardRow]> installed;
    in property <int> slot;
    out property <int> marked: (self.in-library || Nav.id == "card") ? self.slot : -1;
    in property <CardCounts> counts;
    // What the game's rules have against the cards (one of them, or all: "90 MB, the most is 80"), the first and "+n
    // more": said in a phone's header, after the counts (docs/design/app-ui.md §2.66; a desktop's strip says them of the
    // card it describes). A card a problem is about has its name red.
    in property <string> problems;
    // What the cards add up to: the numbers they change, what they give, their bugs.
    in property <string> together-numbers;
    in property <string> together-abilities;
    in property <string> together-bugs;
    // The installed row a card just went into, counted: it flashes.
    in property <int> landed;
    in property <int> landed-seq;
    // The library: its rows as sorted and searched, the sort (its place in `sorts`) and its direction.
    in property <[CardRow]> rows;
    in property <string> search;
    in property <int> sort;
    in property <bool> descending;
    out property <[string]> sorts: self.counts.slotted ? [@tr("Number"), @tr("Name"), @tr("Slot")] : [@tr("Number"), @tr("Name"), @tr("MB")];
    // The row that was refused, counted: it shakes.
    in property <int> refused: -1;
    in property <int> refused-seq;
    // The cursor is in the library: its title is lit, the cards' isn't.
    in property <bool> in-library;
    // The cursor is on a card of the library that is in: Confirm (and Del) take it out again.
    in property <bool> on-installed;
    // On a phone: the library's sheet is open.
    in property <bool> sheet;
    // ---- Words the app asks for: the strip's two groups where a game's cards have none of the card screen's,
    // and a card's own slot.
    out property <string> effects-title: @tr("EFFECTS");
    out property <string> bugs-title: @tr("BUGS");
    // CLEAR's question (docs/design/app-ui.md §2.71).
    out property <string> clear-question: @tr("Clear the patch cards?");
    public pure function slot-word(name: string) -> string {
        return @tr("Slot {}", name);
    }
}

// A slot's name in a box (EXE4's 0A to 0F).
component SlotName inherits Rectangle {
    in property <string> text;
    width: 34px;
    height: 18px;
    border-width: 1px;
    border-color: Theme.line;
    Text {
        text: root.text;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Where card `i` would be while one is dragged: at the place it shifts to (the dragged one where it would land). A
// library's card dragged in (`filling`) goes in at `to`, those from there on shifting down to leave it a gap; in a
// game with slots (`Drag.swap`), into its own slot, in place of what it holds, none shifting.
global CardDrag {
    out property <bool> on: Drag.on && Drag.list == "card";
    out property <bool> filling: Drag.on && Drag.list == "lib.rows";
    out property <int> to: self.on || self.filling ? Drag.to : -1;
    public pure function shown(i: int) -> int {
        return self.to < 0 ? i : self.filling ? (!Drag.swap && i >= self.to ? i + 1 : i) : i == Drag.from ? self.to : (Drag.from < i && i <= self.to) ? i - 1 : (self.to <= i && i < Drag.from) ? i + 1 : i;
    }
}

// One of the build's cards (or slots), a row as the folder's entries are: its slot's name, its number, its name with
// its version's mark, and its MB; Empty where it holds none. The pointer over it shows it in the strip. A drag takes its card to another place in the list, or onto the library (in a game with slots, the
// library alone: a card's slot is its own) (`dy`: where it is shifted to while another is dragged; the one dragged
// is drawn under the pointer, `gone` here). `lifted`: it is that one, drawn under the pointer.
component InstalledRowView inherits Rectangle {
    in property <CardRow> card;
    in property <int> nav-index;
    in property <bool> chosen;
    in property <bool> slotted;
    in property <length> dy;
    in property <bool> gone;
    in property <bool> lifted;
    // (Lifted over the library: let go, it is taken out. Its line is in the error color.)
    in property <bool> removing;
    property <length> lead: root.slotted ? 8px + 34px + 8px : 8px;
    // (The name's room, its MB after it. The version's mark follows the name: a square of its color where the two
    // don't fit.)
    property <length> name-room: max(0px, root.width - root.lead - 30px - 8px - 8px - 56px - 8px);
    // (Lifted: raised, a little larger, with a shadow and a line in the cursor's color.)
    Rectangle {
        visible: root.lifted;
        transform-scale: 1.03;
        background: Theme.raised;
        border-width: 1px;
        border-color: root.removing ? Theme.bad : Theme.cursor;
        animate border-color {
            duration: Theme.quick;
            easing: ease-out;
        }
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000090;
    }

    Rectangle {
        x: 0;
        y: root.dy;
        opacity: root.gone ? 0 : 1;
        animate y {
            duration: CardDrag.on || CardDrag.filling ? Theme.quick : 0ms;
            easing: ease-out;
        }

        Rectangle {
            background: root.chosen ? @linear-gradient(90deg, Theme.tint 0%, Theme.clear 85%) : touch.has-hover ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
        }

        Rectangle {
            x: 0;
            width: 2px;
            background: root.chosen ? Theme.cursor : transparent;
        }

        SlotName {
            x: 8px;
            y: (parent.height - self.height) / 2;
            visible: root.slotted;
            text: root.card.slot;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Text {
            x: root.lead;
            width: 30px;
            text: root.card.number;
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }

        name := Text {
            x: root.lead + 30px + 8px;
            width: max(0px, root.name-room - (version.width > 0 ? version.width + 6px : 0px));
            text: root.card.there ? root.card.name : @tr("Empty");
            color: !root.card.there ? Theme.dim : root.card.bad ? Theme.bad : Theme.text;
            font-family: Theme.body;
            font-size: Theme.phone ? 14px : 12px;
            font-weight: root.card.there ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        version := VersionMark {
            x: name.x + min(name.width, name.preferred-width) + 6px;
            y: name.y + (name.height - self.height) / 2;
            tag: root.card.version;
            short: name.preferred-width + 6px + self.natural-width > root.name-room;
        }

        Text {
            x: parent.width - 8px - 56px;
            width: 56px;
            text: root.card.megabytes;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    touch := RowTouch {
        nav: "card";
        nav-index: root.nav-index;
        drag: !root.card.there || root.nav-index < 0 ? "" : "card";
        removable: root.nav-index >= 0;
        describes: root.nav-index >= 0;
    }
}

// A card of the library: its number, its name with its version's mark, a note (it is in; or why it can't go in, in the
// error red, the row greyed), its MB or the slot it belongs in. `dx` shakes it. The pointer over it shows it in the
// strip.
component CardLibraryRowView inherits Rectangle {
    in property <CardRow> card;
    in property <int> nav-index;
    in property <length> dx;
    property <length> end-width: Theme.phone ? 0px : (PatchCardsView.counts.slotted ? 40px : 52px);
    property <length> end-x: self.width - 8px - root.end-width;
    property <length> note-width: Theme.phone ? 96px : 104px;
    property <length> note-x: root.end-x - (Theme.phone ? 0px : 8px) - root.note-width;
    // (The name's room, up to the note; the version's mark follows the name, a square of its color where the two don't
    // fit.)
    property <length> name-room: max(0px, root.note-x - 8px - (8px + 30px + 8px));
    Rectangle {
        background: touch.has-hover ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
    }

    Text {
        x: 8px + root.dx;
        width: 30px;
        text: root.card.number;
        color: Theme.dim;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 500;
        vertical-alignment: center;
    }

    name := Text {
        x: 8px + 30px + 8px + root.dx;
        width: max(0px, root.name-room - (version.width > 0 ? version.width + 6px : 0px));
        text: root.card.name;
        color: root.card.refused ? Theme.dim : Theme.text;
        font-family: Theme.body;
        font-size: Theme.phone ? 14px : 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    version := VersionMark {
        x: name.x + min(name.width, name.preferred-width) + 6px;
        y: (parent.height - self.height) / 2;
        tag: root.card.version;
        short: name.preferred-width + 6px + self.natural-width > root.name-room;
        opacity: root.card.refused ? 0.5 : 1;
    }

    Text {
        x: root.note-x + root.dx;
        width: root.note-width;
        text: root.card.note;
        color: root.card.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        font-weight: root.card.bad ? 500 : 400;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.end-x;
        width: root.end-width;
        visible: !Theme.phone;
        text: PatchCardsView.counts.slotted ? root.card.slot : root.card.megabytes;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 12px;
        font-weight: PatchCardsView.counts.slotted ? 700 : 500;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // (Dragged into the build's cards beside it, on a desktop: a phone's library is a sheet over them.)
    touch := RowTouch {
        nav: "lib.rows";
        nav-index: root.nav-index;
        removable: true;
        drag: Theme.phone ? "" : "lib.rows";
        describes: true;
    }
}

// The library: its title, the search field, the sort and its direction, and under them its rows. (A phone's sheet
// has no room for the two titles.)
component CardsLibraryPane inherits Rectangle {
    shake := Shake {
        seq: PatchCardsView.refused-seq;
    }

    LibraryHead {
        x: 0;
        y: 0;
        width: parent.width;
        in-library: PatchCardsView.in-library;
        search: PatchCardsView.search;
        placeholder: @tr("Search cards");
        sort: PatchCardsView.sorts[PatchCardsView.sort];
        descending: PatchCardsView.descending;
    }

    list := ListView {
        x: Theme.phone ? 0px : 4px;
        y: 52px;
        width: parent.width - self.x;
        height: parent.height - 52px;
        nav: "lib.rows";
        count: PatchCardsView.rows.length;
        row-height: Theme.list-row;
        chosen: self.focused-row;
        // (A mouse's drag on a row takes its card into the build's: the wheel scrolls.)
        mouse-pan: Theme.phone;
        for slot in list.shown: CardLibraryRowView {
            property <int> at: list.first + slot;
            y: self.at * list.pitch;
            width: list.row-width;
            height: list.row-height;
            card: PatchCardsView.rows[self.at];
            nav-index: self.at;
            dx: self.at == PatchCardsView.refused ? shake.dx : 0px;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }
}

// One of the build's counts: its word and its number, which ticks as it changes (in the error red past its limit).
component CountBox inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <string> suffix;
    in property <length> value-width;
    in property <bool> over;
    width: name.preferred-width + 4px + root.value-width;
    height: 16px;
    name := Text {
        x: 0;
        width: self.preferred-width;
        text: root.label;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
    }

    Count {
        x: name.preferred-width + 4px;
        width: root.value-width;
        value: root.value;
        suffix: root.suffix;
        color: root.over ? Theme.bad : Theme.text;
    }
}

// A group of the strip: its title, then its lines, one a row (as many as there is room for).
component GroupColumn inherits Rectangle {
    in property <string> title;
    in property <[CardLine]> lines;
    Label {
        x: 0;
        y: 0;
        width: parent.width;
        height: 14px;
        text: root.title;
    }

    Text {
        x: 0;
        y: 20px;
        width: parent.width;
        height: 17px;
        visible: root.title != "" && root.lines.length == 0;
        text: @tr("None");
        color: Theme.dim;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
    }

    for line[i] in root.lines: Text {
        x: 0;
        y: 20px + i * 17px;
        width: parent.width;
        height: 17px;
        text: line.text;
        color: line.bug ? Theme.bug : Theme.text;
        font-family: Theme.body;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

// What the cards add up to: the numbers, what they give, their bugs (purple), a line each.
component Together inherits Rectangle {
    property <[string]> parts: [PatchCardsView.together-numbers, PatchCardsView.together-abilities, PatchCardsView.together-bugs];
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }

    Label {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: 14px;
        text: @tr("TOGETHER");
    }

    for part[i] in root.parts: Text {
        x: 12px;
        y: 30px + i * 18px;
        width: parent.width - 24px;
        height: 18px;
        text: i == 0 && part == "" && root.parts[1] == "" && root.parts[2] == "" ? @tr("Nothing") : part;
        color: i == 2 ? Theme.bug : (part == "" ? Theme.dim : Theme.text);
        font-family: Theme.body;
        font-size: 12px;
        font-weight: part == "" ? 400 : 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component PatchCardsTab inherits Rectangle {
    // (As the folder's: the strip, the two panes and their gaps are the page's whole height.)
    property <length> top: -4px;
    property <length> pane-y: root.top + 104px + 12px;
    property <length> pane-width: 528px;
    property <length> pane-height: 482px;
    property <length> together-height: 30px + 3 * 18px + 8px;
    // A phone: the counts' box over the cards, and what they add up to under them.
    property <length> counts-height: 44px;
    // ---- The strip: the card under the cursor.
    PanelBack {
        x: 0;
        y: root.top;
        height: Theme.phone ? 0px : 104px;
        visible: !Theme.phone;
    }

    Text {
        x: 16px;
        y: root.top + 12px;
        width: 200px;
        height: 14px;
        visible: !Theme.phone;
        text: PatchCardsView.detail.number == "" ? "" : @tr("No. {}", PatchCardsView.detail.number);
        color: Theme.dim;
        font-family: Theme.mono;
        font-size: 11px;
        font-weight: 500;
        vertical-alignment: center;
    }

    Text {
        x: 16px;
        y: root.top + 28px;
        width: 224px;
        height: 22px;
        visible: !Theme.phone;
        text: PatchCardsView.detail.there ? PatchCardsView.detail.name : "";
        color: Theme.text;
        font-family: Theme.body;
        font-size: 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 16px;
        y: root.top + 54px;
        width: 224px;
        height: 16px;
        visible: !Theme.phone;
        text: PatchCardsView.detail.facts;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }


    // (The strip's right of the card's name: its two groups, and the place at the top right every tab's strip keeps for
    // a refusal or a problem, a third as wide as each, which the groups' lines end before, so neither runs into the
    // other whatever the language or the window's width.)
    property <length> group-width: (root.width - 256px - 16px - 2 * 24px) / 3;
    GroupColumn {
        x: 256px;
        y: root.top + 12px;
        width: root.group-width;
        height: 84px;
        visible: !Theme.phone && PatchCardsView.detail.there;
        title: Theme.phone ? "" : PatchCardsView.detail.first-title;
        lines: PatchCardsView.detail.first;
    }

    GroupColumn {
        x: 256px + root.group-width + 24px;
        y: root.top + 12px;
        width: root.group-width;
        height: 84px;
        visible: !Theme.phone && PatchCardsView.detail.there;
        title: Theme.phone ? "" : PatchCardsView.detail.second-title;
        lines: PatchCardsView.detail.second;
    }

    // (Why the card under the cursor can't go in, or why it wasn't put in: the strip's refusal, at its top right as
    // every tab's strip has it; else what the rules have against it.)
    Refusal {
        x: 256px + 2 * (root.group-width + 24px);
        y: root.top + 19px;
        width: root.group-width;
        visible: !Theme.phone;
        text: PatchCardsView.detail.problem;
        problem: PatchCardsView.detail.fault;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // ---- The build's cards, framed: the title and the counts, the cards, what they add up to.
    PanelBack {
        x: 0;
        y: Theme.phone ? 0px : root.pane-y;
        width: Theme.phone ? parent.width : root.pane-width;
        height: Theme.phone ? root.counts-height : root.pane-height;
        accent: !Theme.phone;
        fill: Theme.phone ? Theme.inset : Theme.panel;
    }

    cards-title := Label {
        x: 12px;
        y: root.pane-y;
        width: max(0px, counts.x - 12px - self.x);
        height: 44px;
        visible: !Theme.phone;
        text: @tr("PATCH CARDS");
        color: PatchCardsView.in-library ? Theme.muted : Theme.cursor;
    }

    // CLEAR (docs/design/app-ui.md §2.71; the user: "you should add clear for navicust/folder/patch cards/abd"): every
    // card taken out (in a game with slots, every slot emptied), asked first; dim where the build has none. At the
    // header's right end, after the counts; on a phone at the counts' box's.
    clear := WordButton {
        x: (Theme.phone ? parent.width : root.pane-width) - 12px + self.pad - self.width;
        y: counts.y;
        nav: "clear";
        text: @tr("CLEAR");
        enabled: PatchCardsView.counts.slotted ? PatchCardsView.counts.filled > 0 : PatchCardsView.counts.cards > 0;
    }

    // (What is wrong with the cards: on a phone's header, after the counts, before CLEAR.)
    ProblemNote {
        x: counts.x + counts.width + 16px;
        y: counts.y;
        width: max(0px, clear.x + clear.pad - 12px - self.x);
        visible: Theme.phone;
        text: PatchCardsView.problems;
    }

    counts := HorizontalLayout {
        x: Theme.phone ? 12px : clear.x + clear.pad - 12px - self.width;
        y: Theme.phone ? 14px : root.pane-y + 14px;
        width: self.preferred-width;
        height: 16px;
        spacing: 12px;
        CountBox {
            visible: !PatchCardsView.counts.slotted;
            label: @tr("Cards");
            value: PatchCardsView.counts.cards;
            value-width: 22px;
        }

        CountBox {
            visible: PatchCardsView.counts.budget;
            label: @tr("MB");
            value: PatchCardsView.counts.megabytes;
            suffix: "/\{PatchCardsView.counts.limit}";
            value-width: 46px;
            over: PatchCardsView.counts.megabytes > PatchCardsView.counts.limit;
        }

        CountBox {
            visible: PatchCardsView.counts.slotted;
            label: @tr("Slots");
            value: PatchCardsView.counts.filled;
            suffix: "/\{PatchCardsView.counts.slots}";
            value-width: 32px;
        }
    }

    cards := ListView {
        x: Theme.phone ? 0px : 4px;
        y: Theme.phone ? root.counts-height + 12px : root.pane-y + 44px;
        width: (Theme.phone ? parent.width : root.pane-width - 4px) - (Theme.phone ? 0px : 4px);
        height: Theme.phone ? parent.height - self.y - root.together-height : root.pane-height - 44px - root.together-height;
        nav: "card";
        count: PatchCardsView.installed.length;
        row-height: Theme.list-row;
        // (A mouse's drag on a card moves it: the wheel scrolls.)
        mouse-pan: false;
        for at in cards.shown: InstalledRowView {
            property <int> index: cards.first + at;
            y: self.index * cards.pitch;
            width: cards.row-width;
            height: cards.row-height;
            card: PatchCardsView.installed[self.index];
            nav-index: self.index;
            slotted: PatchCardsView.counts.slotted;
            chosen: self.index == PatchCardsView.marked;
            dy: (CardDrag.shown(self.index) - self.index) * cards.pitch;
            gone: CardDrag.on && self.index == Drag.from;
        }
    }

    // (The row a card went into, and where a card dragged would land, over the list where it is scrolled to.)
    Rectangle {
        x: cards.x;
        y: cards.y;
        width: cards.row-width;
        height: cards.height;
        clip: true;
        DropGap {
            x: 0;
            y: max(0, CardDrag.to) * cards.pitch - cards.scroll;
            width: parent.width;
            height: cards.row-height;
            visible: CardDrag.to >= 0;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Flash {
            y: PatchCardsView.landed * cards.pitch - cards.scroll;
            height: cards.row-height;
            seq: PatchCardsView.landed-seq;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }

    Together {
        x: 0;
        y: Theme.phone ? parent.height - root.together-height : root.pane-y + root.pane-height - root.together-height;
        width: Theme.phone ? parent.width : root.pane-width;
        height: root.together-height;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // ---- The library, open; a card dragged over it is taken out, let go there.
    if !Theme.phone: Rectangle {
        library := CardsLibraryPane {
            x: root.pane-width + 24px;
            y: root.pane-y;
            width: parent.width - self.x;
            height: 52px + 15 * (Theme.chip-row + 2px) - 2px;
        }

        RemoveTarget {
            x: library.x - 8px;
            y: library.y - 8px;
            width: library.width + 8px;
            height: library.height + 16px;
            shown: CardDrag.on && Drag.removing;
            text: @tr("DROP TO REMOVE");

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }

    // (The card being dragged, under the pointer, over everything; or a ghost of the library's card, in the shape of
    // the build's, faint until it is over the list. A library's row is wider: its ghost is held no farther in than its
    // middle.)
    InstalledRowView {
        x: Drag.x - root.absolute-position.x - (CardDrag.filling ? min(Drag.grab-x, self.width / 2) : Drag.grab-x);
        y: Drag.y - root.absolute-position.y - Drag.grab-y;
        width: cards.row-width;
        height: cards.row-height;
        visible: CardDrag.on || CardDrag.filling;
        card: CardDrag.filling ? PatchCardsView.rows[max(0, Drag.from)] : PatchCardsView.installed[max(0, Drag.from)];
        nav-index: -1;
        slotted: PatchCardsView.counts.slotted;
        lifted: true;
        chosen: !Drag.removing;
        removing: Drag.removing;
        opacity: Drag.removing ? 0.6 : CardDrag.filling && CardDrag.to < 0 ? 0.7 : 1;
        animate opacity {
            duration: Theme.quick;
            easing: ease-out;
        }
    }
}

// What the Patch cards tab opens over the window: on a phone, the library as a sheet from the bottom, for the card
// tapped. Over the library's rows, what a card's keys do on a desktop: taking it out, moving it up or down. Its
// controls' names begin with `lib.`: while it is open the keys reach nothing else.
export component PatchCardsOverlay inherits Rectangle {
    property <length> sheet-height: min(self.height - 72px, 660px);
    property <bool> slotted: PatchCardsView.counts.slotted;
    property <bool> there: PatchCardsView.installed[PatchCardsView.slot].there;
    arrive := Tween { }

    Rectangle {
        background: Theme.shade;
        opacity: arrive.t;
        TouchArea {
            clicked => {
                Nav.activate("lib.close", 0);
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - root.sheet-height + (1 - arrive.t) * 24px;
        height: root.sheet-height;
        opacity: arrive.t;
        background: Theme.panel;
        TouchArea { }

        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }

        // The card being changed, and what its keys do.
        InstalledRowView {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: Theme.list-row;
            card: PatchCardsView.installed[PatchCardsView.slot];
            nav-index: -1;
            slotted: root.slotted;
        }

        // (Moving it up or down, a list's alone, over taking it out.)
        Button {
            x: 16px;
            y: 56px;
            width: (parent.width - 44px) / 2;
            visible: !root.slotted;
            enabled: !root.slotted && root.there;
            nav: root.slotted ? "" : "lib.up";
            text: @tr("UP");
        }

        Button {
            x: 16px + (parent.width - 44px) / 2 + 12px;
            y: 56px;
            width: (parent.width - 44px) / 2;
            visible: !root.slotted;
            enabled: !root.slotted && root.there;
            nav: root.slotted ? "" : "lib.down";
            text: @tr("DOWN");
        }

        Button {
            x: 16px;
            y: root.slotted ? 56px : 104px;
            width: parent.width - 32px;
            enabled: root.there;
            nav: "lib.remove";
            text: root.slotted ? @tr("EMPTY") : @tr("REMOVE");
            kind: ButtonKind.ghost;
            danger: true;
        }

        CardsLibraryPane {
            x: 16px;
            y: (root.slotted ? 56px : 104px) + 40px + 12px;
            width: parent.width - 32px;
            height: parent.height - self.y - 8px;
        }
    }
}
