// The Navi tab of a build's editor (docs/design/app-ui.md §6, "Navi"): the game's navis as a grid of cards, and
// beside it the build's navi: the face its round starts with, its HP and its element, and for the game's own navi
// the build's other choices, each a stepper (Light or Dark). On a phone the panel is over the grid. Its Rust half
// is src/screens/builds/navi.rs.

import { Theme } from "../../theme.slint";
import { Focusable } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { Cut, PanelBack, Note, Stepper } from "../../widgets.slint";

// One of the game's navis: its name, its face, and whether it is the build's.
export struct NaviCard {
    name: string,
    face: image,
    chosen: bool,
}

// One of the build's choices: the preset it is on, by name; `offered` off where the build's navi has none of the
// choice (its stepper is left out, its room kept).
export struct NaviChoice {
    value: string,
    offered: bool,
}

// What the tab shows: src/screens/builds/navi.rs sets these.
export global NaviView {
    out property <[Hint]> hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: "Enter", pad: PadButton.south, text: @tr("Choose") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: "Esc", pad: PadButton.east, text: @tr("Back") },
    ];
    out property <string> status: @tr("{n} navi" | "{n} navis" % self.navis.length);
    in property <[NaviCard]> navis;
    // The build's navi: its name, the face its round starts with, its HP then, and its element's icon.
    in property <string> name;
    in property <image> face;
    in property <string> hp;
    in property <image> element;
    // The game's choices (none in a game without).
    in property <[NaviChoice]> choices;
    // The game's own navi's name: the one a NaviCust and patch cards are of.
    in property <string> own;
}

// A navi's card: its face over its name. The build's is lit.
component NaviCardView inherits Rectangle {
    in property <NaviCard> navi;
    in property <int> nav-index;
    property <length> pad: Theme.phone ? 8px : 12px;
    property <length> face-width: Theme.phone ? 64px : 96px;
    Cut {
        cut: 9px;
        background: root.navi.chosen ? Theme.raised : (hit.has-hover ? Theme.raised : Theme.panel);
        line: root.navi.chosen ? Theme.cursor : Theme.line;
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: root.pad + (parent.height - 2 * root.pad - 24px - self.height) / 2;
        width: root.face-width;
        height: root.face-width / 2;
        source: root.navi.face;
        image-rendering: pixelated;
    }

    Text {
        x: root.pad;
        y: parent.height - root.pad - 16px;
        width: parent.width - 2 * root.pad;
        height: 16px;
        text: root.navi.name;
        color: Theme.text;
        font-family: Theme.body;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := Focusable {
        nav: "navi";
        nav-index: root.nav-index;
    }
}

export component NaviTab inherits Rectangle {
    property <int> columns: Theme.phone ? 3 : 4;
    property <length> gap: Theme.phone ? 8px : 12px;
    // The build's navi's panel: beside the grid, or on a phone over it.
    property <length> panel-width: Theme.phone ? self.width : 360px;
    property <length> panel-height: Theme.phone ? 132px + NaviView.choices.length * 44px : self.height;
    property <length> panel-x: Theme.phone ? 0px : self.width - 360px;
    property <length> grid-y: Theme.phone ? root.panel-height + 12px : 0px;
    property <length> grid-width: Theme.phone ? self.width : self.width - 360px - 24px;
    property <length> card-width: (root.grid-width - (root.columns - 1) * root.gap) / root.columns;
    property <length> card-height: Theme.phone ? 84px : 140px;
    // Where the panel's facts are: under the face, or on a phone beside it.
    property <length> facts-x: root.panel-x + (Theme.phone ? 96px : 16px);
    property <length> facts-y: Theme.phone ? 16px : 80px;
    property <length> choices-y: Theme.phone ? 72px : root.facts-y + 84px;
    for navi[i] in NaviView.navis: NaviCardView {
        x: mod(i, root.columns) * (root.card-width + root.gap);
        y: root.grid-y + floor(i / root.columns) * (root.card-height + root.gap);
        width: root.card-width;
        height: root.card-height;
        navi: navi;
        nav-index: i;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    PanelBack {
        x: root.panel-x;
        y: 0;
        width: root.panel-width;
        height: root.panel-height;
    }

    Image {
        x: root.panel-x + 16px;
        y: 16px;
        width: Theme.phone ? 64px : 96px;
        height: self.width / 2;
        source: NaviView.face;
        image-rendering: pixelated;
    }

    Text {
        x: root.facts-x;
        y: root.facts-y;
        width: root.panel-x + root.panel-width - 16px - self.x;
        height: 20px;
        text: NaviView.name;
        color: Theme.text;
        font-family: Theme.body;
        font-size: 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.facts-x;
        y: root.facts-y + 28px;
        width: Theme.phone ? self.preferred-width : 110px;
        height: 16px;
        text: @tr("HP");
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
    }

    Text {
        x: root.facts-x + (Theme.phone ? 32px : 110px);
        y: root.facts-y + 28px;
        width: 64px;
        height: 16px;
        text: NaviView.hp;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }

    element-label := Text {
        x: root.facts-x + (Theme.phone ? 104px : 0px);
        y: root.facts-y + (Theme.phone ? 28px : 52px);
        width: Theme.phone ? self.preferred-width : 110px;
        height: 16px;
        text: @tr("Element");
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
    }

    Image {
        x: element-label.x + (Theme.phone ? element-label.width + 8px : 110px);
        y: element-label.y;
        width: 16px;
        height: 16px;
        source: NaviView.element;
        image-rendering: pixelated;
    }

    for choice[i] in NaviView.choices: Stepper {
        x: root.panel-x + 16px;
        y: root.choices-y + i * 44px;
        visible: choice.offered;
        enabled: choice.offered;
        nav: choice.offered ? "choice" : "";
        nav-index: i;
        value: choice.value;
        value-width: Theme.phone ? root.panel-width - 32px - 72px : 256px;
    }

    Note {
        x: root.panel-x + 16px;
        y: root.choices-y + NaviView.choices.length * 44px + (Theme.phone ? 0px : 4px);
        width: root.panel-width - 32px;
        height: Theme.phone ? 52px : 60px;
        text: @tr("NaviCust and patch cards are {} only.", NaviView.own);
        vertical-alignment: top;
    }
}
