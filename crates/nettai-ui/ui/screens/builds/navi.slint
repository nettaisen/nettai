// The Navi tab of a build's editor (docs/design/app-ui.md §6, "Navi"): a strip across the top, as every tab has, that
// describes the form under the cursor or the pointer, else the build's navi; under it the
// game's navis as a grid of cards, and beside them the build's navi: the face its round starts with, its HP and its
// element; under them the build's other choices, each a segmented control of its presets (LIGHT | DARK); then the
// selector of the forms the build has (docs/design/versions.md §2.1: EXE6's Beast form, then its Crosses; EXE4's and
// EXE5's souls; both versions' offered, each a row of the editor's lists, checked where it is the build's, under its
// version's head, a list's ALL and NONE at its heads' right end); then the note of what is the game's own navi's alone, right after whatever is over it. What is wrong
// with the build is said where it is (docs/design/app-ui.md §2.66): at the strip's top right, of what it describes; a
// fact's heading and a form a problem is about in the error red. On a phone there is no strip, the panel is over the
// grid, and what the game's rules have against a fact is on its heading's line, against the navi on its name's line.
// Its Rust half is src/screens/builds/navi.rs.

import { Theme } from "../../theme.slint";
import { Nav, NavKind, Focusable } from "../../nav.slint";
import { Shell, Hint, PadButton } from "../../shell.slint";
import { Cut, PanelBack, Note, Select, Button, ProblemNote, Refusal } from "../../widgets.slint";
import { VersionTag, VersionMark } from "../../build.slint";

// One of the game's navis: its name, its face, whether it is the build's, and whether the ruleset the player plays
// by doesn't allow it (docs/design/app-ui.md §2.59).
export struct NaviCard {
    name: string,
    face: image,
    chosen: bool,
    banned: bool,
}

// One of the build's choices the build's navi has: its presets by name, in capitals ("LIGHT", "DARK"), the one the
// build is on, and the choice's place among the game's (its focus key's index).
export struct NaviChoice {
    presets: [string],
    chosen: int,
    index: int,
}

// One of the forms the selector offers: its face, its name, whether the build has it, whether the build's problems are
// about it (`flagged`: the ruleset the player plays by doesn't allow it, or it is another version's under one version
// per build) and whether the ruleset doesn't allow it (`banned`, whether the build has it or not). Its place: its
// column and row among its fact's rows, and
// how many groups' heads are over it; `head`, the version's name over it where it is its group's first (the forms
// are grouped by version, in the groups' order; those of none last, under a head's room with no name).
export struct NaviForm {
    face: image,
    name: string,
    head: VersionTag,
    column: int,
    row: int,
    heads: int,
    chosen: bool,
    flagged: bool,
    banned: bool,
    // Its group's ALL and NONE, on its head, where it is its group's first in a list grouped by version (`set`, their
    // focus keys' index; -1, none), how many columns its head spans, and whether ALL would put a form in (`all`) and
    // NONE take one out (`none`).
    set: int,
    span: int,
    all: bool,
    none: bool,
}

// A fact of forms the build chooses: its name in capitals ("CROSSES"), how many it has of its room ("3/5"; none for
// the one form always chosen, EXE6's Beast form), whether it has problems (its heading in the error red) and what the
// game's rules have against it (a form of it, or the whole: `problem`, said on a phone's heading's line), its forms in the battle's order,
// both versions' (grouped by version), and its first's place among the selector's (the focus order's).
export struct NaviFormGroup {
    name: string,
    count: string,
    flagged: bool,
    problem: string,
    // How many columns its rows are in (each version's group a column of its own where each of two has one form, as
    // EXE6's Beast form's), how many rows its forms take, and how many heads of their groups over them.
    columns: int,
    rows: int,
    heads: int,
    forms: [NaviForm],
    at: int,
    // The list's ALL and NONE on its heading's line, where its forms aren't grouped by version (`set`; -1, none), and
    // whether each would do anything.
    set: int,
    all: bool,
    none: bool,
}

// What the strip describes: a form (its face, its name and its version's mark, its description where it has one, a
// Cross's; its element, and the fact it is of: `kind`), or the build's navi (the face its round starts with, its name,
// its element, the HP its round starts with), and what the build's problems have against it (`fault`:
// docs/design/app-ui.md §2.66).
export struct NaviDetail {
    there: bool,
    face: image,
    name: string,
    version: VersionTag,
    description: string,
    element: image,
    hp: string,
    kind: string,
    fault: string,
}

// What the tab shows: src/screens/builds/navi.rs sets these.
export global NaviView {
    out property <[Hint]> hints: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Tab") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
    ];
    out property <string> status: @tr("{n} navi" | "{n} navis" % self.navis.length);
    in property <[NaviCard]> navis;
    // The build's navi: its name, the face its round starts with, its HP then, and its element's icon.
    in property <string> name;
    in property <image> face;
    in property <string> hp;
    in property <image> element;
    // The selector: each fact of forms the build chooses (none of a list for a navi that doesn't change form).
    in property <[NaviFormGroup]> form-groups;
    // The ruleset the player plays by, by its name: on a phone its select is between the panel and the grid (a
    // desktop's is at the tab bar's right end).
    in property <string> ruleset;
    // What the game's rules have against the navi, or against the build where it is about no part a tab shows: on a
    // phone's navi's name's line (a desktop's strip says it).
    in property <string> problems;
    // The strip.
    in property <NaviDetail> detail;
    // The game's choices the build's navi has (none in a game without, or for a navi without).
    in property <[NaviChoice]> choices;
    // The game's own navi's name: the one a NaviCust and patch cards are of.
    in property <string> own;
}

// A navi's card: its face over its name. The build's is lit.
component NaviCardView inherits Rectangle {
    in property <NaviCard> navi;
    in property <int> nav-index;
    property <length> pad: Theme.phone ? 8px : 12px;
    property <length> face-width: Theme.phone ? 64px : 96px;
    Cut {
        cut: 9px;
        background: root.navi.chosen ? Theme.raised : (hit.has-hover ? Theme.raised : Theme.panel);
        line: root.navi.chosen ? Theme.cursor : Theme.line;
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: root.pad + (parent.height - 2 * root.pad - 24px - self.height) / 2;
        width: root.face-width;
        height: root.face-width / 2;
        source: root.navi.face;
        image-rendering: pixelated;
    }

    // (Not allowed by the ruleset: a line in the error red at its top, as a library's row says why at its end; the
    // build's navi, its name in the error red too, as an item of the build's with a problem.)
    Text {
        x: root.pad;
        y: root.pad - 4px;
        width: parent.width - 2 * root.pad;
        height: 16px;
        visible: root.navi.banned;
        text: @tr("Not allowed");
        color: Theme.bad;
        font-family: Theme.body;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.pad;
        y: parent.height - root.pad - 16px;
        width: parent.width - 2 * root.pad;
        height: 16px;
        text: root.navi.name;
        color: root.navi.banned ? (root.navi.chosen ? Theme.bad : Theme.dim) : Theme.text;
        font-family: Theme.body;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := Focusable {
        nav: "navi";
        nav-index: root.nav-index;
    }
}

// A form's row in the selector, as tall as the editor's lists' rows (`Theme.list-row`): a check mark (the build's or
// not), its face, its name; its name in the error red where the build's problems are about it, and "Not allowed" at
// its end in the error red where the ruleset holds it back, as an item and a library's row are marked on every tab
// (docs/design/app-ui.md §2.66). (It has no mark of its version: its group's head, in the version's color, says it.
// The user: "drop the selector's per-row tags".)
component FormRow inherits Rectangle {
    in property <NaviForm> form;
    in property <int> nav-index;
    property <length> face-height: Theme.phone ? 32px : 16px;
    Rectangle {
        background: hit.has-hover ? @linear-gradient(90deg, Theme.tint-hover 0%, Theme.clear 85%) : transparent;
    }

    Rectangle {
        x: 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        background: root.form.chosen ? Theme.cursor : Theme.inset;
        border-width: 1px;
        border-color: root.form.chosen ? Theme.cursor : Theme.line;
        Path {
            width: 10px;
            height: 8px;
            visible: root.form.chosen;
            stroke: Theme.action-ink;
            stroke-width: 2px;
            commands: "M 1 4 L 3.75 6.75 L 9 1.25";
        }
    }

    face := Image {
        x: 32px;
        y: (parent.height - self.height) / 2;
        width: 2 * root.face-height;
        height: root.face-height;
        source: root.form.face;
        image-rendering: pixelated;
        opacity: root.form.chosen ? 1 : 0.45;
    }

    Text {
        x: face.x + face.width + 8px;
        width: max(0px, root.width - self.x - 8px - (root.form.banned ? banned.width + 8px : 0px));
        text: root.form.name;
        color: root.form.flagged ? Theme.bad : root.form.chosen ? Theme.text : Theme.dim;
        font-family: Theme.body;
        font-size: Theme.phone ? 14px : 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    banned := Text {
        x: root.width - 8px - self.width;
        width: self.preferred-width;
        visible: root.form.banned;
        text: @tr("Not allowed");
        color: Theme.bad;
        font-family: Theme.body;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    hit := Focusable {
        nav: "form";
        nav-index: root.nav-index;
        describes: true;
    }
}

// A list of forms' ALL and NONE (docs/design/app-ui.md §2.69; the user: "the souls/crosses should be able to select
// all/none"): two words in the version heads' letters at the right end of the line they are on, a hairline between,
// each its own control (`forms-all`, `forms-none`, of `set`); muted, dim where it would do nothing, the cursor's color
// under the pointer. Each takes a little more than its line, a phone's more to be tapped, and nothing moves for it.
component FormPicks inherits Rectangle {
    in property <int> set: -1;
    in property <bool> all;
    in property <bool> none;
    property <length> reach: Theme.phone ? 6px : 2px;
    property <length> pad: 6px;
    height: 16px;
    width: all-word.preferred-width + none-word.preferred-width + 4 * root.pad + 1px;
    visible: root.set >= 0;
    all-word := Text {
        x: root.pad;
        width: self.preferred-width;
        text: @tr("ALL");
        color: all-hit.has-hover ? Theme.cursor : root.all ? Theme.muted : Theme.dim;
        font-family: Theme.display;
        font-size: 10px;
        font-weight: Theme.display-bold;
        letter-spacing: 0.8px;
        vertical-alignment: center;
    }

    Rectangle {
        x: all-word.preferred-width + 2 * root.pad;
        y: 3px;
        width: 1px;
        height: 10px;
        background: Theme.line;
    }

    none-word := Text {
        x: all-word.preferred-width + 3 * root.pad + 1px;
        width: self.preferred-width;
        text: @tr("NONE");
        color: none-hit.has-hover ? Theme.cursor : root.none ? Theme.muted : Theme.dim;
        font-family: Theme.display;
        font-size: 10px;
        font-weight: Theme.display-bold;
        letter-spacing: 0.8px;
        vertical-alignment: center;
    }

    all-hit := Focusable {
        x: 0;
        y: -root.reach;
        width: all-word.preferred-width + 2 * root.pad;
        height: 16px + 2 * root.reach;
        nav: root.set >= 0 ? "forms-all" : "";
        nav-index: root.set;
    }

    none-hit := Focusable {
        x: all-hit.width + 1px;
        y: -root.reach;
        width: none-word.preferred-width + 2 * root.pad;
        height: 16px + 2 * root.reach;
        nav: root.set >= 0 ? "forms-none" : "";
        nav-index: root.set;
    }
}

// A choice's segmented control, as the app's two-way one (`Seg`) but of as many presets as the choice has, and as
// tall as the editor's lists' rows (a phone's a tap's, `Theme.row`): each preset a segment as wide as its name, the
// build's tinted and underlined in the cursor's color. Left and Right step it, Enter takes the next, a click or a tap
// on a segment takes its preset (the user: "the light/dark switcher also takes up too much space").
component ChoiceSeg inherits Rectangle {
    in property <NaviChoice> choice;
    height: Theme.phone ? Theme.row : Theme.list-row;
    width: segments.preferred-width;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: Theme.line;
    }

    Focusable {
        nav: "choice";
        nav-index: root.choice.index;
        kind: NavKind.stepper;
    }

    segments := HorizontalLayout {
        for preset[i] in root.choice.presets: Rectangle {
            property <bool> chosen: i == root.choice.chosen;
            min-width: max(Theme.row, word.preferred-width + 24px);
            horizontal-stretch: 0;
            background: self.chosen ? Theme.tint : touch.has-hover ? Theme.tint-hover : transparent;
            // (The line between it and the one before.)
            Rectangle {
                x: 0;
                width: 1px;
                visible: i > 0;
                background: Theme.line;
            }

            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                visible: parent.chosen;
                background: Theme.cursor;
            }

            word := Text {
                text: preset;
                color: parent.chosen ? Theme.cursor : Theme.muted;
                font-family: Theme.display;
                font-size: 13px;
                font-weight: Theme.display-bold;
                letter-spacing: 0.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => {
                    Nav.point("choice", root.choice.index);
                    Nav.choose("choice", root.choice.index, i);
                }
            }
        }
    }
}

export component NaviTab inherits Rectangle {
    property <int> columns: Theme.phone ? 3 : 4;
    property <length> gap: Theme.phone ? 8px : 12px;
    // (On a desktop the tab starts 4 nearer the tab bar, as every tab with a strip does: the strip across the top of
    // the grid's side, 104 tall as theirs, the grid under it, and the panel beside both. A phone has no strip.)
    property <length> top: Theme.phone ? 0px : -4px;
    property <length> strip-height: Theme.phone ? 0px : 104px;
    // The build's navi's panel: beside the strip and the grid, or on a phone over the grid, as tall as what it shows.
    property <length> panel-width: Theme.phone ? self.width : 360px;
    property <length> panel-height: Theme.phone ? root.body-y + body.preferred-height + root.pad : self.height - root.top;
    property <length> panel-x: Theme.phone ? 0px : self.width - 360px;
    // (On a phone the ruleset's select is between the panel and the grid.)
    property <length> grid-y: Theme.phone ? root.panel-height + 12px + 52px : root.top + root.strip-height + 12px;
    property <length> grid-width: Theme.phone ? self.width : self.width - 360px - 24px;
    property <length> card-width: (root.grid-width - (root.columns - 1) * root.gap) / root.columns;
    // (A desktop's cards are 140 tall where the grid's rows leave them that, else as tall as its rows fit under the
    // strip: EXE5's thirteen navis are four rows.)
    property <int> card-rows: max(1, ceil(NaviView.navis.length / root.columns));
    property <length> card-height: Theme.phone ? 84px : min(140px, (self.height - root.grid-y - (root.card-rows - 1) * root.gap) / root.card-rows);
    // The panel's padding: 16 around what it shows, as the editor's strips and the NaviCust's effects have.
    property <length> pad: 16px;
    // Where the panel's facts are: beside the face; and under them, `pad` below, what else the panel shows.
    property <length> facts-x: root.panel-x + (Theme.phone ? 96px : 128px);
    property <length> facts-y: root.top + (Theme.phone ? 16px : 12px);
    property <length> body-y: root.top + (Theme.phone ? 76px : 96px);
    // Between the choices, the facts of forms and the note: room enough that each reads as its own.
    property <length> fact-gap: 20px;
    // The selector: each fact's name and count (and what is wrong with it) over its forms' rows, the editor's lists'
    // rows: one column on a desktop, two on a phone, or each version's group a column (the app places them: the
    // group's `columns`, the form's `column` and `row`), each version's under its name: a head 16 tall with
    // `head-lead` over it (from the fact's heading, or the group before) and `head-gap` under it.
    property <length> head-lead: 8px;
    property <length> head-gap: 4px;
    property <length> form-head: root.head-lead + 16px + root.head-gap;
    property <length> form-pitch: Theme.list-row + Theme.list-gap;
    property <string> note: @tr("NaviCust and patch cards are {} only.", NaviView.own);
    // ---- The strip: the form under the cursor (or the pointer), else the build's navi, as every tab's strip describes its item:
    // its face, its name and its version's mark, its description, its element and HP or its fact; at its top right
    // what the build's problems have against it (docs/design/app-ui.md §2.66).
    PanelBack {
        x: 0;
        y: root.top;
        width: root.grid-width;
        height: root.strip-height;
        visible: !Theme.phone;
    }

    Image {
        x: 12px;
        y: root.top + (root.strip-height - self.height) / 2;
        width: 96px;
        height: 48px;
        visible: !Theme.phone;
        source: NaviView.detail.face;
        image-rendering: pixelated;
    }

    HorizontalLayout {
        x: 120px;
        y: root.top + 19px;
        width: max(0px, root.grid-width / 2 - 120px - 8px);
        height: 20px;
        visible: !Theme.phone;
        spacing: 8px;
        alignment: start;
        Text {
            text: NaviView.detail.name;
            color: Theme.text;
            font-family: Theme.body;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            VersionMark {
                tag: NaviView.detail.version;
            }
        }
    }

    // (What the build's problems have against what it describes: the place every tab's strip has a refusal; the Navi
    // tab refuses nothing in words.)
    Refusal {
        x: root.grid-width / 2;
        y: root.top + 19px;
        width: root.grid-width / 2 - 16px;
        visible: !Theme.phone;
        problem: NaviView.detail.fault;
    }

    Text {
        x: 120px;
        y: root.top + 43px;
        width: max(0px, root.grid-width - 136px);
        height: 18px;
        visible: !Theme.phone;
        text: NaviView.detail.description;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: 120px;
        y: root.top + 69px;
        width: max(0px, root.grid-width - 136px);
        height: 16px;
        visible: !Theme.phone;
        spacing: 16px;
        alignment: start;
        Image {
            width: NaviView.detail.there ? 16px : 0px;
            height: 16px;
            source: NaviView.detail.element;
            image-rendering: pixelated;
        }

        if NaviView.detail.hp != "": HorizontalLayout {
            spacing: 6px;
            Text {
                text: @tr("HP");
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: NaviView.detail.hp;
                color: Theme.text;
                font-family: Theme.mono;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        if NaviView.detail.kind != "": Text {
            text: NaviView.detail.kind;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    for navi[i] in NaviView.navis: NaviCardView {
        x: mod(i, root.columns) * (root.card-width + root.gap);
        y: root.grid-y + floor(i / root.columns) * (root.card-height + root.gap);
        width: root.card-width;
        height: root.card-height;
        navi: navi;
        nav-index: i;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    PanelBack {
        x: root.panel-x;
        y: root.top;
        width: root.panel-width;
        height: root.panel-height;
    }

    Image {
        x: root.panel-x + root.pad;
        y: root.top + root.pad;
        width: Theme.phone ? 64px : 96px;
        height: self.width / 2;
        source: NaviView.face;
        image-rendering: pixelated;
    }

    // (The navi's name, and on a phone's line what the game's rules have against the navi: the name keeps half the line.)
    property <length> name-room: root.panel-x + root.panel-width - root.pad - root.facts-x;
    Text {
        x: root.facts-x;
        y: root.facts-y;
        width: !Theme.phone || NaviView.problems == "" ? root.name-room : min(self.preferred-width, root.name-room / 2);
        height: 20px;
        text: NaviView.name;
        color: Theme.text;
        font-family: Theme.body;
        font-size: 16px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    ProblemNote {
        x: root.facts-x + root.name-room / 2 + 8px;
        y: root.facts-y + 2px;
        width: root.name-room / 2 - 8px;
        visible: Theme.phone;
        text: NaviView.problems;
    }

    Text {
        x: root.facts-x;
        y: root.facts-y + 28px;
        width: Theme.phone ? self.preferred-width : 110px;
        height: 16px;
        text: @tr("HP");
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
    }

    Text {
        x: root.facts-x + (Theme.phone ? 32px : 110px);
        y: root.facts-y + 28px;
        width: 64px;
        height: 16px;
        text: NaviView.hp;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }

    element-label := Text {
        x: root.facts-x + (Theme.phone ? 104px : 0px);
        y: root.facts-y + (Theme.phone ? 28px : 52px);
        width: Theme.phone ? self.preferred-width : 110px;
        height: 16px;
        text: @tr("Element");
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
    }

    Image {
        x: element-label.x + (Theme.phone ? element-label.width + 8px : 110px);
        y: element-label.y;
        width: 16px;
        height: 16px;
        source: NaviView.element;
        image-rendering: pixelated;
    }

    // Under the navi's facts, one after the other with nothing reserved: the choices (the user: "the light/dark
    // switcher should be above the souls"), the selector's facts of forms, and the note.
    body := VerticalLayout {
        x: root.panel-x + root.pad;
        y: root.body-y;
        width: root.panel-width - 2 * root.pad;
        height: self.preferred-height;
        spacing: root.fact-gap;
        alignment: start;
        for choice in NaviView.choices: HorizontalLayout {
            alignment: start;
            ChoiceSeg {
                choice: choice;
            }
        }

        for group in NaviView.form-groups: Rectangle {
            // (Where its rows start: under its heading.)
            property <length> top: 16px;
            property <length> form-width: (self.width - (group.columns - 1) * 8px) / max(1, group.columns);
            height: self.top + group.heads * root.form-head + group.rows * root.form-pitch - Theme.list-gap;
            heading := Text {
                x: 0;
                y: 0;
                width: self.preferred-width;
                height: 16px;
                text: group.count == "" ? group.name : group.name + "  " + group.count;
                color: group.flagged ? Theme.bad : Theme.muted;
                font-family: Theme.body;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            // (A list whose forms aren't grouped by version: its ALL and NONE at its heading's right end.)
            whole := FormPicks {
                x: parent.width - self.width - 2px;
                y: 0;
                set: group.set;
                all: group.all;
                none: group.none;
            }

            // (A phone's: what the game's rules have against the fact, a form of it or the whole, on its heading's line.)
            ProblemNote {
                x: heading.width + 16px;
                y: 0;
                width: max(0px, (group.set >= 0 ? whole.x - 8px : parent.width) - self.x);
                visible: Theme.phone;
                text: group.problem;
            }

            // (Each version's group under its name, in its color; a list's ALL and NONE of the group at its head's right
            // end, the head as wide as the columns the group is in.)
            for form in group.forms: Rectangle {
                x: form.column * (parent.form-width + 8px);
                y: parent.top + (form.heads - 1) * root.form-head + root.head-lead + form.row * root.form-pitch;
                width: form.span * (parent.form-width + 8px) - 8px;
                height: 16px;
                Text {
                    x: 8px;
                    width: max(0px, (form.set >= 0 ? picks.x - 8px : parent.width - 8px) - self.x);
                    visible: form.head.text != "";
                    text: form.head.text;
                    color: form.head.tone;
                    font-family: Theme.display;
                    font-size: 10px;
                    font-weight: Theme.display-bold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                picks := FormPicks {
                    x: parent.width - self.width - 2px;
                    set: form.set;
                    all: form.all;
                    none: form.none;
                }
            }

            for form[j] in group.forms: FormRow {
                x: form.column * (parent.form-width + 8px);
                y: parent.top + form.heads * root.form-head + form.row * root.form-pitch;
                width: parent.form-width;
                height: Theme.list-row;
                form: form;
                nav-index: group.at + j;
            }
        }

        // (The note, as tall as its words: what is wrong with the forms is said in the strip, and on a phone on their
        // headings' lines, so nothing here moves when a problem appears.)
        Note {
            text: root.note;
            vertical-alignment: TextVerticalAlignment.top;
        }
    }

    // (On a phone, the ruleset the player plays by and EDIT, between the panel and the grid.)
    Select {
        x: 0;
        y: root.panel-height + 12px;
        width: root.width - 8px - phone-edit.width;
        height: 40px;
        visible: Theme.phone;
        focusable: Theme.phone;
        nav: "ruleset";
        value: NaviView.ruleset;
    }

    phone-edit := Button {
        x: root.width - self.width;
        y: root.panel-height + 12px;
        width: self.natural-width;
        visible: Theme.phone;
        nav: Theme.phone ? "ruleset-edit" : "";
        text: @tr("EDIT");
    }
}
