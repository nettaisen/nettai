// Play (docs/design/app-ui.md §6: "Play", "In an online match", "After a match"): online play. Its Rust half
// is src/screens/play.rs, which sets `PlayView` and hears the controls by their names.
//
// The screen has three parts, one shown at a time (`PlayView.part`): the player's builds (+ NEW BUILD over them,
// the chosen one's overview beside them with PRACTICE, EDIT and ⋯, its menu of DUPLICATE, RENAME and DELETE) with
// the ways to play it online under them (HOST: an invite; JOIN: an invite's code typed; DIRECT CONNECT: a direct
// connection's dialog); the wait for the other player, a practice battle beside the invite's code; and the lobby,
// for as long as the two players stay together. The two cards
// before a match and the match itself are the shell's (versus.slint, battle.slint); over the match are this
// file's menu (`MatchMenu`), the two builds shown while Tab is held (`MatchPeek`), and how the match went once its
// set is over (`MatchResult`).

import { Theme, Audit } from "../theme.slint";
import { Nav, NavKind, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, Hint, Picture, DialogFrame, FaceButton } from "../shell.slint";
import { Cut, Label, Note, Message, Value, Mono, Pill, Button, ButtonKind, Field, Stepper, Seg, Select, Slider, MenuItem, RowBack, RowTouch, ListView, PanelBack, Rule, Bars, ArrowDown, ScrollPage } from "../widgets.slint";
import { MenuOverlay } from "battle.slint";
import { Arrive, Tween, Pulse, Flash, Count } from "../motion.slint";
import { VersionTag, BuildEntry, BuildSheet, BuildRow, BuildOverview } from "../build.slint";

// The part of Play shown.
export enum PlayPart {
    // The builds, what is done with them, and the row that makes a link.
    builds,
    // An invite is out: its code, and a practice battle beside it.
    waiting,
    // The two players are together.
    lobby,
}

// A dialog of the builds' part: a new build's name and version, a build's new name.
export enum BuildDialog {
    none,
    new-build,
    rename,
}

// What the lobby's reserved line says.
export enum LobbyNote {
    none,
    // The other player is ready and this one isn't; the other way about.
    you,
    them,
    // The link is down and being made again (`PlayView.note-seconds` left).
    reconnecting,
    // This player's build can't be played as the match's settings stand (with Patch cards off, its cards
    // left out): READY is refused.
    unusable,
}

// How a match's set went for this player, for its result (`MatchResult`).
export enum MatchOutcome {
    won,
    lost,
    drawn,
}

// A page of the match menu.
export enum MatchPage {
    menu,
    yours,
    theirs,
    controls,
    settings,
}

// This player's build as the lobby's card names it (as the match's settings would play it): its name, its navi
// and its version's tag.
export struct PlayBuild {
    name: string,
    navi: string,
    version: VersionTag,
}

// An action of the battle with what is bound to it: a key's cap; a pad's face button, drawn by its place, or a
// button's cap.
export struct PlayControl {
    key: string,
    face: PadButton,
    pad: string,
}

// What Play shows: src/screens/play.rs sets these. (A struct or an enum a property here uses reaches Rust by
// that use: nothing is added to app.slint for it.)
export global PlayView {
    in property <PlayPart> part;

    // ---- The builds --------------------------------------------------------------------------------------
    // The selected game's builds, and the one chosen (the one a link brings and the one EDIT, DUPLICATE, RENAME
    // and DELETE act on): its row, and its overview. A build whose file doesn't read as one (not `readable`)
    // can only be deleted.
    in property <[BuildEntry]> builds;
    in property <int> chosen;
    in property <BuildEntry> build;
    in property <BuildSheet> sheet;
    in property <bool> readable;
    // A dialog for a build's name: a new build's, with its version, or the chosen build's new name. The game's
    // versions, in its own order, and the one chosen; what a version sets, in the game's words.
    in property <BuildDialog> dialog;
    in property <string> dialog-name;
    in property <[VersionTag]> versions;
    in property <int> dialog-version;
    in property <string> version-sets;
    // The code typed, as the app keeps it (capitals, in threes), and what the reserved line under the row says: a
    // problem, in the error red, or quietly that a link is being made or what an import made (`message-quiet`).
    in property <string> code;
    in property <string> message;
    in property <bool> message-quiet;

    // The code a box a character, where it can't be typed (a pad): open, and its six characters. `code-set` is
    // how many characters a code is written in.
    in property <bool> boxes;
    in property <[string]> box-characters;
    in property <int> code-set;

    // ---- A direct connection -----------------------------------------------------------------------------
    in property <bool> direct;
    // This machine's address, for the other player; the address typed.
    in property <string> host-address;
    in property <string> address;
    // What went wrong with hosting (in place of the line under the address), and with joining.
    in property <string> host-message;
    in property <string> join-message;
    in property <bool> join-quiet;
    // It counts the copies: what was copied flashes.
    in property <int> copied-seq;

    // ---- Waiting -----------------------------------------------------------------------------------------
    // What the other player needs: the invite's code in threes, or a direct host's address.
    in property <string> invite;
    in property <bool> invite-direct;

    // ---- The lobby ---------------------------------------------------------------------------------------
    in property <string> their-name;
    // The other player's lobby was heard: their card is there.
    in property <bool> their-present;
    in property <bool> ready;
    in property <bool> their-ready;
    // This player's card: the build as the match's settings would play it.
    in property <PlayBuild> card;
    // They count the times each turned ready: the mark stamps.
    in property <int> ready-seq;
    in property <int> their-ready-seq;
    // The match's settings, both players': the round wins its set is first to (1: a single battle; 2: the
    // original's triple battle, best of 3), the ruleset by its name (the host's to choose: `host`), and closed
    // builds.
    in property <int> first-to: 2;
    in property <string> ruleset;
    in property <bool> host;
    in property <bool> closed;
    // The player's own.
    in property <int> input-delay;
    // The connection: its bars (0 to 4) and the round trip in ms (-1: not measured).
    in property <int> bars;
    in property <int> ping: -1;
    in property <LobbyNote> note;
    in property <int> note-seconds;
    // What is wrong with the build, where the settings can't play it (`LobbyNote.unusable`): its sentence.
    in property <string> note-problem;
    // Why the match before ended, where it didn't end by itself (in the error red, in the note's place).
    in property <string> note-error;
    // The room's code, for the footer.
    in property <string> room;
    // Another build is being chosen.
    in property <bool> changing;

    // ---- In a match --------------------------------------------------------------------------------------
    in property <MatchPage> page;
    // How far a build's page in the match's menu is scrolled (as its `Flickable`'s `content-y`: 0 or less), and
    // how far it can be: the keys and the pad scroll it from the app (`Play::scroll`), the wheel and a drag here.
    in-out property <length> sheet-y;
    in-out property <length> sheet-span;
    in-out property <length> sheet-view;
    // The builds are shown (Tab, or Select on a pad, is held).
    in property <bool> peek;
    // The match's builds are closed: the other player's isn't shown.
    in property <bool> closed-match;
    // The two builds as the match plays them, each a player's panel.
    in property <BuildSheet> mine;
    in property <BuildSheet> theirs;
    in property <[PlayControl]> controls;
    in property <int> music;
    in property <int> effects;

    // ---- After a match -----------------------------------------------------------------------------------
    // The set is over: how it went for this player, over the picture until they go on (`MatchResult`). Its
    // facts: the round wins each side has, this player's first, and the match's time in hundredths of a second.
    in property <bool> result-shown;
    in property <MatchOutcome> outcome;
    in property <int> result-wins;
    in property <int> result-losses;
    in property <int> result-time;
    // A press settles it: everything at its end at once.
    in property <bool> result-settled;
    // For its sounds (the app's): it counts the numbers shown as they tick, and says when the last has come to
    // its value. The app puts them back as it shows a result.
    in-out property <int> result-ticks;
    in-out property <bool> result-done;

    // ---- Words the app needs -----------------------------------------------------------------------------
    out property <string> you: @tr("YOU");
    out property <string> opponent: @tr("OPPONENT");
    out property <string> back-to-play: @tr("BACK TO PLAY");
    // Esc in the lobby asks before the other player is left.
    out property <string> leave-question: @tr("Leave the lobby?");
    out property <string> cancel-word: @tr("CANCEL");
    out property <string> leave-word: @tr("LEAVE");
    out property <string> connecting: @tr("Connecting…");
    out property <string> new-name: @tr("New build");
    out property <string> delete-word: @tr("DELETE");
    // The build's menu (⋯, or a right click on its row), DELETE apart after them.
    out property <string> duplicate-word: @tr("DUPLICATE");
    out property <string> rename-word: @tr("RENAME");
    out property <string> save-files: @tr("Save files");
    public pure function delete-title(name: string) -> string {
        return @tr("Delete {}?", name);
    }
    // While the other player is waited for, the practice menu's EXIT (src/screens/play.rs's `train`), with an
    // invite out or this machine hosting directly; and a phone's one row at its top.
    public pure function wait-exit(direct: bool) -> string {
        return direct ? @tr("STOP HOSTING") : @tr("CANCEL INVITE");
    }
    out property <string> stop-practice: @tr("STOP PRACTICE");
}

// ---- The builds ------------------------------------------------------------------------------------------

// The chosen build in one box, on a phone: Left and Right step through the builds, Enter opens them as a sheet.
component BuildBox inherits Rectangle {
    in property <BuildEntry> build;
    in property <string> nav;
    in property <bool> enabled: true;
    height: 72px;
    PanelBack { }

    Value {
        x: 16px;
        y: 14px;
        width: parent.width - 68px - tag.width;
        height: 24px;
        text: root.build.name;
        font-size: 18px;
        font-weight: 900;
    }

    Text {
        x: 16px;
        y: 42px;
        width: parent.width - 68px - tag.width;
        height: 16px;
        text: root.build.status;
        color: root.build.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    tag := Pill {
        x: parent.width - 40px - self.width;
        y: (parent.height - self.height) / 2;
        text: root.build.version.text;
        tone: root.build.version.tone;
    }

    ArrowDown {
        x: parent.width - 24px;
    }

    Focusable {
        nav: root.nav;
        kind: NavKind.stepper;
        enabled: root.enabled;
    }
}

// One of the code's six boxes, for a pad: Up and Down go through its characters, Left and Right to the boxes
// beside it. (To the app's focus it is a list whose rows are all in one place, `count` of them: `Nav.index` is
// the character it is on.)
component CodeBox inherits Rectangle {
    in property <string> nav;
    in property <string> value;
    in property <int> count;
    property <[int]> token;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    function place() {
        Nav.page(root.nav, root.ax, root.ay, self.width, self.height, self.height, 0px);
        Nav.list(root.nav, root.count, 0px, self.height, 0px, self.width);
    }
    height: 64px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: Nav.id == root.nav ? Theme.cursor : Theme.line;
    }

    Path {
        y: 6px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 5 L 8 5 L 4 0 Z";
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 28px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Path {
        y: parent.height - 11px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 0 L 8 0 L 4 5 Z";
    }

    init => {
        root.token = Nav.register(root.nav, 0, NavKind.list);
        place();
    }
    changed ax => {
        place();
    }
    changed ay => {
        place();
    }
    changed count => {
        place();
    }
}

// The two versions a new build is one of: Left and Right choose, a click takes one.
component VersionChoice inherits Rectangle {
    in property <[VersionTag]> versions;
    in property <int> chosen;
    property <length> box: (self.width - (root.versions.length - 1) * 12px) / max(1, root.versions.length);
    height: 64px;
    for version[i] in root.versions: Rectangle {
        x: i * (root.box + 12px);
        width: root.box;
        background: Theme.inset;
        border-width: i == root.chosen ? 2px : 1px;
        border-color: i == root.chosen ? Theme.cursor : Theme.line;
        Text {
            text: version.text;
            color: version.tone;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: Theme.display-bold;
            letter-spacing: 0.6px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            clicked => {
                Nav.point("name.version", 0);
                Nav.choose("name.version", 0, i);
            }
        }
    }

    Focusable {
        nav: "name.version";
        kind: NavKind.stepper;
        // (Its halves take the clicks.)
        z: -1;
    }
}

// ---- The lobby -------------------------------------------------------------------------------------------

// A player's card in the lobby: who they are, what they bring (this player's own card alone says it), and
// whether they are ready, in a box that is there either way. The mark stamps as its player turns ready.
component LobbyCard inherits Rectangle {
    in property <string> role;
    in property <string> name;
    in property <PlayBuild> build;
    in property <int> side;
    in property <bool> ready;
    in property <int> ready-seq;
    property <length> pad: Theme.phone ? 16px : 24px;
    stamp := Pulse {
        seq: root.ready-seq;
        duration: Theme.settle;
    }

    PanelBack {
        side: root.side;
        accent: false;
    }

    Label {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: root.role;
    }

    Value {
        x: root.pad;
        y: root.pad + (Theme.phone ? 18px : 22px);
        width: parent.width - 2 * root.pad;
        height: Theme.phone ? 28px : 36px;
        text: root.name;
        font-size: Theme.phone ? 22px : 28px;
        font-weight: 900;
    }

    HorizontalLayout {
        x: root.pad;
        y: root.pad + (Theme.phone ? 52px : 66px);
        width: parent.width - 2 * root.pad - (Theme.phone ? mark.width + 12px : 0px);
        height: 22px;
        spacing: 8px;
        alignment: start;
        Value {
            text: root.build.name;
            font-size: Theme.phone ? 14px : 16px;
        }

        Pill {
            text: root.build.version.text;
            tone: root.build.version.tone;
        }
    }

    Value {
        x: root.pad;
        y: root.pad + (Theme.phone ? 78px : 95px);
        width: parent.width - 2 * root.pad - (Theme.phone ? mark.width + 12px : 0px);
        height: 16px;
        text: root.build.navi;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 400;
    }

    mark := Rectangle {
        x: parent.width - root.pad - self.width;
        y: parent.height - root.pad - self.height;
        width: 144px;
        height: 32px;
        transform-scale: 1 + stamp.v * 0.16;
        Rectangle {
            border-width: 1px;
            border-color: root.ready ? Theme.good : Theme.line;
        }

        Flash {
            seq: root.ready-seq;
            tone: Theme.good;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 8px;
            width: parent.width - 16px;
            text: root.ready ? @tr("READY") : @tr("NOT READY");
            color: root.ready ? Theme.good : Theme.muted;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

// The match's settings and the connection: one row, or on a phone a row each. First to, the Ruleset and Closed
// builds are the match's (both see them; the Ruleset the host alone chooses, with EDIT after it, and the joiner
// VIEWs it); the input delay is the player's own.
component LobbyFacts inherits Rectangle {
    // The one row: each setting's name over its control, a cell as wide as the wider of the two, so five fit
    // whatever the language. Where each cell starts, and the row's width.
    property <length> gap: 41px;
    property <length> x1: 24px;
    property <length> x2: self.x1 + max(first-to-label.width, first-to.width) + self.gap;
    property <length> x3: self.x2 + max(ruleset-label.width, ruleset.width + 8px + rules.width) + self.gap;
    property <length> x4: self.x3 + max(closed-label.width, closed.width) + self.gap;
    property <length> x5: self.x4 + max(delay-label.width, delay.width) + self.gap;
    out property <length> natural-width: self.x5 + max(ping-label.width, bars.width + 10px + ping.width) + 24px;
    // On a phone, a line each: the name, and the control at the right.
    property <length> line: 44px;
    // A name's place and a control's, in the row.
    property <length> name-y: 10px;
    property <length> name-height: 18px;
    property <length> control-y: 32px;
    property <length> control-height: 36px;
    property <brush> name-color: Theme.phone ? Theme.text : Theme.muted;
    height: Theme.phone ? 5 * self.line : 78px;
    PanelBack {
        visible: !Theme.phone;
        accent: false;
    }

    first-to-label := Value {
        x: Theme.phone ? 0px : root.x1;
        y: Theme.phone ? 0px : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("First to");
        color: root.name-color;
    }

    // (The round wins that take the set: "2" under First to; in Japanese, 2本先取.)
    first-to := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x1;
        y: Theme.phone ? (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.first-to";
        value: @tr("first to" => "{}", PlayView.first-to);
        value-width: 84px;
        numeric: true;
    }

    Rectangle {
        x: root.x2 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The Ruleset: the match's, by its name (docs/design/app-ui.md §2.59). The host's is a select of the game's
    // presets and their own, with EDIT, which opens its page; the joiner's can't be changed, and VIEW opens its
    // page to read.
    ruleset-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ruleset");
        color: root.name-color;
    }

    ruleset := Select {
        x: Theme.phone ? parent.width - rules.width - 8px - self.width : root.x2;
        y: Theme.phone ? root.line + (root.line - self.height) / 2 : root.control-y;
        width: 176px;
        height: 36px;
        nav: "lobby.ruleset";
        value: PlayView.ruleset;
        enabled: PlayView.host;
    }

    rules := Button {
        x: Theme.phone ? parent.width - self.width : root.x2 + ruleset.width + 8px;
        y: ruleset.y;
        width: self.natural-width;
        height: 36px;
        nav: "lobby.rules";
        text: PlayView.host ? @tr("EDIT") : @tr("ruleset" => "VIEW");
    }

    Rectangle {
        x: root.x3 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    closed-label := Value {
        x: Theme.phone ? 0px : root.x3;
        y: Theme.phone ? 2 * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Closed builds");
        color: root.name-color;
    }

    closed := Seg {
        x: Theme.phone ? parent.width - self.width : root.x3;
        y: Theme.phone ? 2 * root.line + (root.line - self.height) / 2 : root.control-y;
        nav: "lobby.closed";
        first: @tr("OFF");
        second: @tr("ON");
        chosen: PlayView.closed ? 1 : 0;
    }

    Rectangle {
        x: root.x4 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    delay-label := Value {
        x: Theme.phone ? 0px : root.x4;
        y: Theme.phone ? 3 * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Input delay");
        color: root.name-color;
    }

    delay := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x4;
        y: Theme.phone ? 3 * root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.delay";
        value: PlayView.input-delay;
        value-width: 48px;
        numeric: true;
    }

    Rectangle {
        x: root.x5 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The connection: its bars and the round trip, where a setting has its control.
    ping-label := Value {
        x: Theme.phone ? 0px : root.x5;
        y: Theme.phone ? 4 * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ping");
        color: root.name-color;
    }

    bars := Bars {
        x: Theme.phone ? parent.width - ping.width - 10px - self.width : root.x5;
        y: (Theme.phone ? 4 * root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2);
        level: PlayView.bars;
    }

    ping := Mono {
        x: Theme.phone ? parent.width - self.width : root.x5 + bars.width + 10px;
        y: Theme.phone ? 4 * root.line : root.control-y;
        width: 60px;
        height: Theme.phone ? root.line : root.control-height;
        horizontal-alignment: Theme.phone ? right : left;
        text: PlayView.ping < 0 ? "" : @tr("{} ms", PlayView.ping);
    }
}

// ---- The screen ------------------------------------------------------------------------------------------

export component PlayScreen inherits Page {
    property <[Hint]> hints-builds: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Delete") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
    property <[Hint]> hints-waiting: [
        { key: "Esc", pad: PadButton.start, text: @tr("Practice menu") },
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Fight") },
    ];
    property <[Hint]> hints-lobby: [
        { key: "↑↓", pad: PadButton.move, text: @tr("Move") },
        { key: "←→", text: @tr("Move or change") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Tab", pad: PadButton.shoulders, text: @tr("Next") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Leave") },
    ];
    // The builds' part, in three zones read in order (docs/design/app-ui.md §6, "Play"): the builds (+ NEW BUILD
    // over the list, the left column); the chosen build (its overview, the right column, with PRACTICE, EDIT and ⋯
    // in its header); and the ways to play it online, one row of controls under the overview (HOST, then JOIN's
    // field and JOIN, and DIRECT CONNECT at its right edge; the reserved line under them). On a phone one column
    // in the same order.
    property <length> list-width: 400px;
    property <length> side-x: root.list-width + 24px;
    property <length> side-width: self.body-width - root.side-x;
    // The row (the controls' height) and the reserved line under it at the body's foot; the list and the
    // overview grow down to 16 over the row (564 at the reference window: the wide sheet's 540 at least).
    property <length> message-y: Theme.phone ? 356px : self.body-height - 18px;
    property <length> row-y: Theme.phone ? 188px : root.message-y - 6px - 40px;
    property <length> sheet-height: max(540px, root.row-y - 16px);
    property <length> more-width: 40px;
    property <bool> none: PlayView.builds.length == 0;
    property <bool> usable: PlayView.chosen >= 0 && !root.none && PlayView.readable;
    // The waiting part: the picture, three times the battle's.
    property <length> picture-width: Theme.phone ? self.body-width : 720px;
    property <length> picture-height: self.picture-width * 2 / 3;
    property <length> wait-height: Theme.phone ? 198px : 480px;
    property <length> wait-top: Theme.phone ? 0px : (self.body-height - 480px) / 2;
    property <length> wait-x: Theme.phone ? 0px : 744px;
    property <length> wait-width: Theme.phone ? self.body-width : self.body-width - 744px;
    // The lobby: the two cards, the row of settings, the buttons, the line.
    property <length> card-width: Theme.phone ? self.body-width : 440px;
    property <length> card-height: Theme.phone ? 126px : 220px;
    property <length> lobby-top: Theme.phone ? 0px : (self.body-height - 426px) / 2;
    property <length> lobby-left: (self.body-width - 960px) / 2;
    property <length> facts-top: Theme.phone ? 2 * self.card-height + 20px : self.lobby-top + 244px;
    property <length> buttons-top: Theme.phone ? self.facts-top + 232px : self.lobby-top + 346px;
    title: PlayView.part == PlayPart.lobby ? @tr("LOBBY") : PlayView.part == PlayPart.builds ? @tr("PLAY") : Theme.phone ? @tr("WAITING") : @tr("WAITING FOR OPPONENT");
    back: PlayView.part == PlayPart.builds ? @tr("MENU") : @tr("PLAY");
    hints: PlayView.part == PlayPart.lobby ? root.hints-lobby : PlayView.part == PlayPart.waiting ? root.hints-waiting : root.hints-builds;
    status: PlayView.part == PlayPart.lobby && PlayView.room != "" ? PlayView.room : Shell.player;

    // ---- The builds, what is done with them, and the row that makes a link ----
    // (One conditional a part, and what differs on a phone by its place and by `visible`: each conditional is a
    // component of its own in what Slint generates. A control that isn't shown is unavailable, so the focus
    // passes it by.)
    if PlayView.part == PlayPart.builds: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        // The builds: + NEW BUILD (the main action while there is none), and the builds as a list (a right click
        // on a row opens its menu); on a phone the chosen one in a box, which opens them as a sheet.
        Arrive {
            order: 0;
            Button {
                x: 0;
                y: 0;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "new";
                text: @tr("+ NEW BUILD");
                kind: root.none ? ButtonKind.main : ButtonKind.normal;
            }

            list := ListView {
                x: 0;
                y: 52px;
                width: root.list-width;
                height: root.sheet-height - self.y;
                visible: !Theme.phone;
                nav: "builds";
                count: Theme.phone ? 0 : PlayView.builds.length;
                row-height: 52px;
                chosen: PlayView.chosen;
                for slot in list.shown: BuildRow {
                    property <int> at: list.first + slot;
                    x: 0;
                    y: self.at * list.pitch;
                    width: list.row-width;
                    height: list.row-height;
                    build: PlayView.builds[self.at];
                    nav: list.nav;
                    nav-index: self.at;
                    menu: true;
                }
            }

            BuildBox {
                x: 0;
                y: 52px;
                width: root.body-width;
                visible: Theme.phone && !root.none;
                enabled: Theme.phone && !root.none;
                nav: "build";
                build: PlayView.build;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        // The chosen build: its overview (the wide sheet) with PRACTICE, EDIT and ⋯ in its header's right; on a
        // phone, no overview, and the three in a row under the box. PRACTICE goes straight into a practice battle
        // with it; ⋯ opens the build's menu (DUPLICATE, RENAME and, apart, DELETE). A build whose file doesn't read
        // has an empty frame, PRACTICE and EDIT unavailable and only DELETE in its menu. With no build none of them
        // is there.
        Arrive {
            order: 1;
            PanelBack {
                x: root.side-x;
                y: 0;
                width: root.side-width;
                height: root.sheet-height;
                visible: !Theme.phone && !root.none && !root.usable;
            }

            BuildOverview {
                x: root.side-x;
                y: 0;
                // (On a phone it isn't shown, and is given the wide sheet's least width: its texts fit there.)
                width: Theme.phone ? 620px : root.side-width;
                height: Theme.phone ? self.sheet-height : root.sheet-height;
                visible: !Theme.phone && root.usable && PlayView.sheet.name != "";
                build: PlayView.sheet;
                tools: train.width + 8px + edit.width + 8px + root.more-width;
            }

            train := Button {
                x: Theme.phone ? 0px : edit.x - 8px - self.width;
                y: edit.y;
                visible: !root.none;
                nav: "practice";
                text: @tr("PRACTICE");
                enabled: root.usable;
            }

            edit := Button {
                x: Theme.phone ? train.width + 8px : more.x - 8px - self.width;
                y: Theme.phone ? 136px : 24px;
                width: Theme.phone ? root.body-width - train.width - 16px - root.more-width : self.natural-width;
                visible: !root.none;
                nav: "edit";
                text: @tr("EDIT");
                enabled: root.usable;
            }

            more := Button {
                x: Theme.phone ? root.body-width - self.width : root.body-width - 16px - self.width;
                y: edit.y;
                width: root.more-width;
                visible: !root.none;
                enabled: !root.none && PlayView.chosen >= 0;
                nav: "more";
                text: "";
            }

            // (Its ⋯, three dots over it.)
            Rectangle {
                x: more.x + 13px;
                y: more.y + 19px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }

            Rectangle {
                x: more.x + 19px;
                y: more.y + 19px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }

            Rectangle {
                x: more.x + 25px;
                y: more.y + 19px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }
        }

        // The ways to play it online, one row of the app's controls under the overview, at its left edge: HOST, the
        // main action's button while there is a build (what a player comes to PLAY for, the one that starts a
        // match by itself); then JOIN's field, for an invite's code, and JOIN; and at the overview's right edge
        // DIRECT CONNECT, a regular button, whose dialog hosts on this machine's address or joins one. On a phone
        // HOST is the column's width and 52 tall, the field and JOIN a row under it, and DIRECT CONNECT the
        // column's width under them. The line under them is there whether or not it says anything (with no build
        // they say there why they can't).
        Arrive {
            order: 2;
            host := Button {
                x: Theme.phone ? 0px : root.side-x;
                y: root.row-y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "invite";
                text: @tr("HOST");
                kind: root.none ? ButtonKind.normal : ButtonKind.main;
                big: Theme.phone;
            }

            code := Field {
                x: Theme.phone ? 0px : host.x + host.width + 24px;
                y: Theme.phone ? host.y + host.height + 12px : root.row-y;
                // (A code's six characters in threes, in the code's type; on a phone what JOIN leaves.)
                width: Theme.phone ? root.body-width - 8px - join.width : 208px;
                nav: "code";
                text: PlayView.code;
                placeholder: @tr("Invite code");
                code: true;
                error: PlayView.message != "" && !PlayView.message-quiet;
            }

            join := Button {
                x: code.x + code.width + 8px;
                y: code.y;
                nav: "join";
                text: @tr("JOIN");
            }

            Button {
                x: root.body-width - self.width;
                y: Theme.phone ? code.y + code.height + 12px : root.row-y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "direct";
                // (Less than HOST and JOIN: the user, "direct connect should be deemphasized".)
                kind: ButtonKind.text;
                text: @tr("DIRECT CONNECT");
            }

            Note {
                x: Theme.phone ? 0px : root.side-x;
                y: root.message-y;
                width: Theme.phone ? root.body-width : root.side-width;
                height: Theme.phone ? 40px : 18px;
                text: PlayView.message;
                color: PlayView.message-quiet ? Theme.muted : Theme.bad;
                font-size: 12px;
                wrap: Theme.phone ? word-wrap : no-wrap;
                overflow: elide;
            }
        }
    }

    // ---- Waiting for the other player: the invite's code, and a practice session beside it ----
    // (On a phone a battle has its pad only where it fills the window: there the session is asked for, under
    // the invite, and fills it.)
    if PlayView.part == PlayPart.waiting: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        Arrive {
            order: 0;
            Picture {
                x: 0;
                y: root.wait-top;
                width: root.picture-width;
                height: root.picture-height;
                visible: !Theme.phone;
                ground: Theme.inset;
            }

            Rectangle {
                x: 12px;
                y: root.wait-top + root.picture-height - 34px;
                width: practice.preferred-width + 16px;
                height: 22px;
                visible: !Theme.phone;
                background: Theme.shade;
                practice := Text {
                    text: @tr("PRACTICE");
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 11px;
                    font-weight: Theme.display-bold;
                    letter-spacing: Theme.label-tracking;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Arrive {
            order: 1;
            Rectangle {
                x: root.wait-x;
                y: root.wait-top;
                width: root.wait-width;
                height: root.wait-height;
                PanelBack { }

                Label {
                    x: 16px;
                    y: Theme.phone ? 12px : 16px;
                    width: parent.width - 32px;
                    height: 14px;
                    text: PlayView.invite-direct ? @tr("YOUR ADDRESS") : @tr("INVITE CODE");
                }

                Mono {
                    x: 16px;
                    y: Theme.phone ? 30px : 38px;
                    width: parent.width - 32px;
                    height: Theme.phone ? 48px : 64px;
                    text: PlayView.invite;
                    font-size: PlayView.invite-direct ? (Theme.phone ? 22px : 28px) : (Theme.phone ? 40px : 56px);
                    letter-spacing: PlayView.invite-direct ? 0px : 2.2px;
                }

                copy := Button {
                    x: 16px;
                    y: Theme.phone ? 88px : 114px;
                    nav: "wait.copy";
                    text: PlayView.invite-direct ? @tr("COPY ADDRESS") : @tr("COPY CODE");
                }

                Flash {
                    x: copy.x;
                    y: copy.y;
                    width: copy.width;
                    height: copy.height;
                    seq: PlayView.copied-seq;

                    Rectangle { }  // (Copied in: docs/app.md §14.)
                }

                Rule {
                    x: 16px;
                    y: 170px;
                    width: parent.width - 32px;
                    visible: !Theme.phone;

                    Rectangle { }  // (Copied in: docs/app.md §14.)
                }

                Rectangle {
                    x: 16px;
                    y: Theme.phone ? 145px : 191px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.cursor;
                    opacity: Theme.motion ? 0.35 + 0.65 * abs(sin(mod(animation-tick(), 2.2s) / 2.2s * 360deg)) : 1;
                }

                Value {
                    x: 34px;
                    y: Theme.phone ? 140px : 186px;
                    width: parent.width - 50px;
                    height: 20px;
                    text: @tr("Waiting for opponent");
                }

                Note {
                    x: 16px;
                    y: Theme.phone ? 164px : 212px;
                    width: parent.width - 32px;
                    height: 20px;
                    text: PlayView.invite-direct ? @tr("Send this address to your opponent.") : @tr("The lobby opens when they join.");
                }

                Button {
                    x: Theme.phone ? copy.x + copy.width + 8px : 16px;
                    y: Theme.phone ? 88px : parent.height - 56px;
                    nav: "wait.cancel";
                    text: @tr("CANCEL");
                    kind: ButtonKind.ghost;
                }
            }

            Button {
                x: 0;
                y: root.wait-height + 12px;
                width: root.body-width;
                visible: Theme.phone;
                enabled: Theme.phone;
                nav: "wait.train";
                text: @tr("PRACTICE");
            }
        }
    }

    // ---- The lobby ----
    if PlayView.part == PlayPart.lobby: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        // The other player's card slides in as they join.
        joined := Tween {
            held: !PlayView.their-present;
        }

        Arrive {
            order: 0;
            LobbyCard {
                x: Theme.phone ? 0px : root.lobby-left;
                y: root.lobby-top;
                width: root.card-width;
                height: root.card-height;
                role: PlayView.you;
                name: Shell.player;
                build: PlayView.card;
                side: 1;
                ready: PlayView.ready;
                ready-seq: PlayView.ready-seq;
            }

            Text {
                x: root.lobby-left + 440px;
                y: root.lobby-top;
                width: 80px;
                height: root.card-height;
                visible: !Theme.phone;
                text: @tr("VS");
                color: Theme.dim;
                font-family: Theme.display;
                font-size: 28px;
                font-weight: Theme.display-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: (1 - joined.t) * 56px;
            opacity: joined.t;
            visible: PlayView.their-present;
            LobbyCard {
                x: Theme.phone ? 0px : root.lobby-left + 520px;
                y: Theme.phone ? root.card-height + 8px : root.lobby-top;
                width: root.card-width;
                height: root.card-height;
                role: PlayView.opponent;
                name: PlayView.their-name;
                side: 2;
                ready: PlayView.their-ready;
                ready-seq: PlayView.their-ready-seq;
            }
        }

        Arrive {
            order: 1;
            LobbyFacts {
                x: Theme.phone ? 0px : (root.body-width - self.natural-width) / 2;
                y: root.facts-top;
                width: Theme.phone ? root.body-width : self.natural-width;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        Arrive {
            order: 2;
            ready := Button {
                x: Theme.phone ? 0px : (root.body-width - self.width - change.width - leave.width - 24px) / 2;
                y: root.buttons-top;
                width: Theme.phone ? root.body-width : 184px;
                nav: "lobby.ready";
                text: PlayView.ready ? @tr("NOT READY") : @tr("READY");
                kind: ButtonKind.main;
                big: Theme.phone;
            }

            change := Button {
                x: Theme.phone ? 0px : ready.x + ready.width + 12px;
                y: Theme.phone ? root.buttons-top + 60px : root.buttons-top;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "lobby.change";
                text: @tr("CHANGE BUILD");
            }

            leave := Button {
                x: Theme.phone ? 0px : change.x + change.width + 12px;
                y: Theme.phone ? change.y + 48px : change.y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "lobby.leave";
                text: @tr("LEAVE");
                kind: ButtonKind.ghost;
            }

            // The reserved line: who is waited for, that the link is being made again, or why the match before
            // ended.
            Message {
                x: 0;
                y: leave.y + (Theme.phone ? 52px : 64px);
                width: root.body-width;
                text: PlayView.note == LobbyNote.reconnecting ? @tr("Reconnecting {} s", PlayView.note-seconds) : PlayView.note == LobbyNote.unusable ? PlayView.note-problem : PlayView.note-error != "" ? PlayView.note-error : PlayView.note == LobbyNote.you ? @tr("Waiting for you to ready up.") : PlayView.note == LobbyNote.them ? @tr("Waiting for your opponent to ready up.") : "";
                tone: PlayView.note-error != "" || PlayView.note == LobbyNote.reconnecting || PlayView.note == LobbyNote.unusable ? Theme.bad : Theme.muted;
                horizontal-alignment: center;
            }
        }
    }
}

// ---- Over the match --------------------------------------------------------------------------------------

// The match menu: Start or Esc in an online match, in place of the game's own pause. The match keeps running
// behind it. Its pages are the menu itself, and what four of its items open: each player's build, the
// controls, the settings a player may want in a match.
export component MatchMenu inherits MenuOverlay {
    property <bool> their-item: !PlayView.closed-match;
    property <length> shift: root.their-item ? 48px : 0px;
    property <[string]> actions: [@tr("Up"), @tr("Down"), @tr("Left"), @tr("Right"), "A", "B", "L", "R", "START", "SELECT"];
    title: PlayView.page == MatchPage.yours ? @tr("YOUR BUILD") : PlayView.page == MatchPage.theirs ? @tr("THEIR BUILD") : PlayView.page == MatchPage.controls ? @tr("CONTROLS") : PlayView.page == MatchPage.settings ? @tr("SETTINGS") : @tr("MENU");
    note: PlayView.page == MatchPage.menu ? @tr("The match keeps running") : "";
    side: PlayView.page != MatchPage.menu;
    content-height: 240px + root.shift;
    if PlayView.page == MatchPage.menu: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        MenuItem {
            x: 0;
            y: 0;
            width: root.inner-width;
            nav: "menu.resume";
            text: @tr("BACK TO MATCH");
        }

        MenuItem {
            x: 0;
            y: 48px;
            width: root.inner-width;
            nav: "menu.yours";
            text: @tr("YOUR BUILD");
        }

        if root.their-item: MenuItem {
            x: 0;
            y: 96px;
            width: root.inner-width;
            nav: "menu.theirs";
            text: @tr("THEIR BUILD");
        }

        MenuItem {
            x: 0;
            y: 96px + root.shift;
            width: root.inner-width;
            nav: "menu.controls";
            text: @tr("CONTROLS");
        }

        MenuItem {
            x: 0;
            y: 144px + root.shift;
            width: root.inner-width;
            nav: "menu.settings";
            text: @tr("SETTINGS");
        }

        MenuItem {
            x: 0;
            y: 192px + root.shift;
            width: root.inner-width;
            nav: "menu.leave";
            text: @tr("LEAVE MATCH");
            danger: true;
        }
    }

    // A player's build, to stay until Back.
    if PlayView.page == MatchPage.yours || PlayView.page == MatchPage.theirs: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        // (The sheet is taller than the page: Up and Down, Page Up and Down, Home and End scroll it, as the
        // wheel and a drag do.)
        page := Flickable {
            x: 0;
            y: 0;
            width: root.inner-width;
            height: root.inner-height - 52px;
            content-width: self.width;
            content-height: max(self.height, sheet.sheet-height);
            content-y <=> PlayView.sheet-y;
            sheet := BuildOverview {
                x: 0;
                y: 0;
                width: page.width - 12px;
                height: self.sheet-height;
                build: PlayView.page == MatchPage.yours ? PlayView.mine : PlayView.theirs;
                side: PlayView.page == MatchPage.yours ? 1 : 2;
            }

            init => {
                PlayView.sheet-view = self.height;
                PlayView.sheet-span = max(0px, sheet.sheet-height - self.height);
            }
            changed height => {
                PlayView.sheet-view = self.height;
                PlayView.sheet-span = max(0px, sheet.sheet-height - self.height);
            }
        }

        // Where the page is, as a thumb along its right edge.
        Rectangle {
            x: root.inner-width - 4px;
            y: page.height * (-PlayView.sheet-y) / max(1px, sheet.sheet-height);
            width: 4px;
            height: page.height * page.height / max(1px, sheet.sheet-height);
            visible: sheet.sheet-height > page.height + 0.5px;
            background: Theme.line;
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: @tr("BACK");
        }
    }

    // What is bound to each of the battle's buttons.
    if PlayView.page == MatchPage.controls: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        Label {
            x: root.inner-width - 232px;
            y: 0;
            width: 110px;
            height: 20px;
            text: @tr("KEY");
        }

        Label {
            x: root.inner-width - 110px;
            y: 0;
            width: 110px;
            height: 20px;
            text: @tr("PAD");
        }

        for control[i] in PlayView.controls: Rectangle {
            x: 0;
            y: 24px + i * 34px;
            width: root.inner-width;
            height: 30px;
            Value {
                x: 0;
                width: parent.width - 244px;
                text: root.actions[i];
            }

            Mono {
                x: parent.width - 232px;
                width: 110px;
                text: control.key;
            }

            Mono {
                x: parent.width - 110px;
                width: 110px;
                text: control.face == PadButton.none ? control.pad : "";
            }

            FaceButton {
                x: parent.width - 110px;
                visible: control.face != PadButton.none;
                button: control.face;
            }
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: @tr("BACK");
        }
    }

    // The settings a player may want in a match: their input delay, and the sound's two levels.
    if PlayView.page == MatchPage.settings: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        Value {
            x: 0;
            y: 0;
            width: root.inner-width - 244px;
            height: 44px;
            text: @tr("Input delay");
        }

        Stepper {
            x: root.inner-width - self.width;
            y: 4px;
            nav: "menu.delay";
            value: PlayView.input-delay;
            value-width: 48px;
            numeric: true;
        }

        Value {
            x: 0;
            y: 48px;
            width: root.inner-width - 244px;
            height: 44px;
            text: @tr("Music");
        }

        Slider {
            x: root.inner-width - 232px;
            y: 50px;
            width: 232px;
            nav: "menu.music";
            value: PlayView.music;
        }

        Value {
            x: 0;
            y: 96px;
            width: root.inner-width - 244px;
            height: 44px;
            text: @tr("Sound effects");
        }

        Slider {
            x: root.inner-width - 232px;
            y: 98px;
            width: 232px;
            nav: "menu.effects";
            value: PlayView.effects;
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: @tr("BACK");
        }
    }
}

// Both builds, over the match while Tab (Select on a pad) is held: the player's on their side, the other
// player's on theirs; with closed builds, the player's own alone. It takes no clicks and no keys: the match
// goes on under it.
export component MatchPeek inherits Rectangle {
    // (On a phone a sheet is a column taller than the window: each is half of it, from the top, which has
    // the navi, its stats, abilities and bugs.)
    property <length> sheet-width: min(430px, self.width - 2 * Theme.margin);
    property <length> half: (self.height - 3 * Theme.margin) / 2;
    if PlayView.peek: Rectangle {
        Rectangle {
            x: Theme.margin;
            y: Theme.margin;
            width: root.sheet-width;
            height: Theme.phone ? root.half : mine.sheet-height;
            clip: Theme.phone;
            mine := BuildOverview {
                x: 0;
                y: 0;
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.mine;
                side: 1;
            }
        }

        Rectangle {
            x: Theme.phone ? Theme.margin : root.width - Theme.margin - root.sheet-width;
            y: Theme.phone ? 2 * Theme.margin + root.half : Theme.margin;
            width: root.sheet-width;
            height: Theme.phone ? root.half : theirs.sheet-height;
            clip: Theme.phone;
            visible: !PlayView.closed-match;
            theirs := BuildOverview {
                x: 0;
                y: 0;
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.theirs;
                side: 2;
            }
        }
    }
}

// How the match went (docs/design/app-ui.md §6, "After a match"; §2.49), over the picture once its set is over:
// the winner's half of the window floods with their side's color (the player's own, on the left, in player
// one's red; the other's in player two's blue), sweeping in from its outer edge; WIN or LOSE stamps in, centered
// on the player's own half; then the rounds' score and the match's time count up, one after another, each number
// in a box of one width. CONTINUE (Enter, the pad's A) settles it where it still moves, and then goes on to the
// lobby (the app's: `result.go`); it goes on by itself after a few seconds. With motion turned down it is there at
// once. On a phone the halves are the window's top (the player's) and bottom.
export component MatchResult inherits Rectangle {
    property <bool> won: PlayView.outcome == MatchOutcome.won;
    property <bool> lost: PlayView.outcome == MatchOutcome.lost;
    property <color> tone: root.won ? Theme.p1 : Theme.p2;
    property <length> half-width: Theme.phone ? self.width : self.width / 2;
    property <length> half-height: Theme.phone ? self.height / 2 : self.height;
    // The player's own half's middle: the word, and the numbers under it.
    property <length> mid-x: root.half-width / 2;
    property <length> mid-y: root.half-height / 2;
    property <length> stats-width: Theme.phone ? 300px : 360px;
    property <length> digits: Theme.phone ? 28px : 34px;
    // One after another, by the theme's table: the flood, the word, the score, then the time to the set piece's
    // end.
    flood := Tween {
        settled: PlayView.result-settled;
    }

    stamp := Tween {
        delay: Theme.quick;
        duration: Theme.brisk;
        settled: PlayView.result-settled;
    }

    // (It takes the clicks meant for the battle under it.)
    TouchArea { }

    // The picture under it, dimmed.
    Rectangle {
        background: Theme.ground-bottom.with-alpha(0.8);
    }

    // The winner's half, flooding in from its outer edge (the window's) toward the middle, a lit edge leading.
    Rectangle {
        x: Theme.phone || root.won ? 0px : root.half-width;
        y: !Theme.phone || root.won ? 0px : root.half-height;
        width: root.half-width;
        height: root.half-height;
        visible: root.won || root.lost;
        clip: true;
        Rectangle {
            property <float> way: root.won ? -1 : 1;
            x: Theme.phone ? 0px : (1 - flood.t) * root.half-width * self.way;
            y: !Theme.phone ? 0px : (1 - flood.t) * root.half-height * self.way;
            background: Theme.phone ? @linear-gradient(root.won ? 180deg : 0deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%) : @linear-gradient(root.won ? 90deg : 270deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%);
            Rectangle {
                x: Theme.phone || !root.won ? 0px : parent.width - 2px;
                y: !Theme.phone || !root.won ? 0px : parent.height - 2px;
                width: Theme.phone ? parent.width : 2px;
                height: Theme.phone ? 2px : parent.height;
                background: root.tone.brighter(0.4);
                drop-shadow-blur: 16px;
                drop-shadow-color: root.tone;
            }
        }
    }

    // WIN, LOSE or DRAW, stamped in on the player's own half.
    Text {
        property <bool> over: Theme.audit && self.preferred-width > self.width + 0.5px;
        x: Theme.margin;
        y: root.mid-y - (Theme.phone ? 100px : 140px);
        width: root.half-width - 2 * Theme.margin;
        height: Theme.phone ? 92px : 150px;
        text: root.won ? @tr("WIN") : root.lost ? @tr("LOSE") : @tr("DRAW");
        color: root.lost ? Theme.muted : Theme.text;
        font-family: Theme.display;
        font-size: Theme.phone ? 60px : 104px;
        font-weight: Theme.display-bold;
        letter-spacing: Theme.title-tracking * 2;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        opacity: stamp.linear;
        transform-scale: 1 + (1 - stamp.t) * 0.8;
        changed over => {
            if over {
                Audit.clipped(self.text);
            }
        }
    }

    // The rounds' score and the match's time, each label over its number.
    Rectangle {
        x: root.mid-x - root.stats-width / 2;
        y: root.mid-y + (Theme.phone ? 4px : 30px);
        width: root.stats-width;
        height: 64px;
        Label {
            x: 0;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: @tr("ROUNDS");
            horizontal-alignment: center;
        }

        // (Each side's wins in a box of two digits, the dash between them where it is.)
        Count {
            x: parent.width / 4 - 16px - self.width;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-wins;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: right;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Text {
            x: parent.width / 4 - 16px;
            y: 22px;
            width: 32px;
            height: 40px;
            text: "–";
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: root.digits;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Count {
            x: parent.width / 4 + 16px;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-losses;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: left;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Label {
            x: parent.width / 2 + 8px;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: @tr("TIME");
            horizontal-alignment: center;
        }

        time := Count {
            x: parent.width / 2 + 8px;
            y: 22px;
            width: parent.width / 2 - 8px;
            height: 40px;
            value: PlayView.result-time;
            clock: true;
            from-zero: true;
            delay: 2 * Theme.quick + Theme.brisk;
            duration: Theme.set-piece - 2 * Theme.quick - Theme.brisk;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: center;
            ticked => {
                PlayView.result-ticks += 1;
            }
            changed done => {
                if self.done {
                    PlayView.result-done = true;
                }
            }
        }
    }

    Button {
        x: Theme.phone ? Theme.margin : root.mid-x - self.width / 2;
        y: root.height - (Theme.phone ? Theme.margin : 48px) - self.height;
        width: Theme.phone ? root.width - 2 * Theme.margin : max(200px, self.natural-width);
        nav: "result.go";
        text: @tr("CONTINUE");
        kind: ButtonKind.main;
    }

    // (Where it is there at once, its last number is too.)
    init => {
        if time.done {
            PlayView.result-done = true;
        }
    }
}

// ---- Over the screen -------------------------------------------------------------------------------------

// A new build's name and version, or a build's new name. Its controls' names begin with `name.`. A new build's
// has under its buttons, below a line, the other way to start one: FROM A SAVE FILE…, which opens the system's
// file dialog (the build is made of the save, named for its file).
component NameDialog inherits DialogFrame {
    property <bool> versions: PlayView.dialog == BuildDialog.new-build;
    property <length> buttons-y: root.versions ? 226px : 78px;
    title: root.versions ? @tr("NEW BUILD") : @tr("RENAME");
    content-height: root.buttons-y + (root.versions ? 120px : 40px);
    Label {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: 14px;
        text: @tr("NAME");
    }

    Field {
        x: 0;
        y: 22px;
        width: root.inner-width;
        nav: "name.name";
        text: PlayView.dialog-name;
    }

    Label {
        x: 0;
        y: 78px;
        width: root.inner-width;
        height: 14px;
        visible: root.versions;
        text: @tr("VERSION");
    }

    if root.versions: VersionChoice {
        x: 0;
        y: 100px;
        width: root.inner-width;
        versions: PlayView.versions;
        chosen: PlayView.dialog-version;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Note {
        x: 0;
        y: 172px;
        width: root.inner-width;
        height: 38px;
        visible: root.versions;
        text: @tr("{} It can be switched later in the editor.", PlayView.version-sets);
    }

    confirm := Button {
        x: root.inner-width - self.width;
        y: root.buttons-y;
        nav: "name.confirm";
        text: root.versions ? @tr("CREATE BUILD") : @tr("RENAME");
        kind: ButtonKind.main;
        enabled: PlayView.dialog-name != "";
    }

    Button {
        x: confirm.x - 12px - self.width;
        y: root.buttons-y;
        nav: "name.cancel";
        text: @tr("CANCEL");
        kind: ButtonKind.ghost;
    }

    Rule {
        x: 0;
        y: root.buttons-y + 64px;
        width: root.inner-width;
        visible: root.versions;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Button {
        x: 0;
        y: root.buttons-y + 80px;
        visible: root.versions;
        enabled: root.versions;
        nav: "name.save";
        text: @tr("FROM A SAVE FILE…");
        kind: ButtonKind.ghost;
    }
}

// What opens over Play: a build's name, a direct connection's dialog, the code's boxes, and the lobby's list of
// builds to change to. It covers the whole window, over the screen and under the shell's own dialogs; empty, it
// takes no clicks.
export component PlayOverlay inherits Rectangle {
    if PlayView.dialog != BuildDialog.none: NameDialog {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }


    // A direct connection: host, with this machine's address to send; or join, by the host's address.
    if PlayView.direct: direct := DialogFrame {
        // (On a phone each button is under its box: an address needs the dialog's width.)
        property <length> under: Theme.phone ? 48px : 0px;
        title: @tr("Direct connection");
        content-height: 252px + 2 * self.under;
        Label {
            x: 0;
            y: 0;
            width: direct.inner-width;
            height: 14px;
            text: @tr("HOST");
        }

        // This machine's address: Enter copies it.
        Rectangle {
            x: 0;
            y: 22px;
            width: Theme.phone ? direct.inner-width : direct.inner-width - host.width - 8px;
            height: 40px;
            Rectangle {
                background: Theme.inset;
                border-width: 1px;
                border-color: copy.has-hover ? Theme.muted : Theme.line;
            }

            Mono {
                x: 12px;
                width: parent.width - 36px - word.width;
                text: PlayView.host-address;
            }

            word := Label {
                x: parent.width - 12px - self.width;
                width: self.preferred-width;
                text: @tr("COPY");
            }

            Flash {
                seq: PlayView.copied-seq;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }

            copy := Focusable {
                nav: "direct.copy";
            }
        }

        host := Button {
            x: direct.inner-width - self.width;
            y: 22px + direct.under;
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.host";
            text: @tr("HOST");
            kind: ButtonKind.main;
        }

        // One line: what to do with the address, or why this machine can't host.
        Note {
            x: 0;
            y: 67px + direct.under;
            width: direct.inner-width;
            height: 20px;
            text: PlayView.host-message != "" ? PlayView.host-message : @tr("Send this address to your opponent.");
            color: PlayView.host-message != "" ? Theme.bad : Theme.muted;
            wrap: no-wrap;
            overflow: elide;
        }

        Rule {
            x: 0;
            y: 100px + direct.under;
            width: direct.inner-width;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 0;
            y: 114px + direct.under;
            width: direct.inner-width;
            height: 14px;
            text: @tr("JOIN");
        }

        Field {
            x: 0;
            y: 136px + direct.under;
            width: Theme.phone ? direct.inner-width : direct.inner-width - connect.width - 8px;
            nav: "direct.address";
            text: PlayView.address;
            placeholder: @tr("address:port");
            error: PlayView.join-message != "" && !PlayView.join-quiet;
        }

        connect := Button {
            x: direct.inner-width - self.width;
            y: 136px + 2 * direct.under + (Theme.phone ? 18px : 0px);
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.connect";
            text: @tr("CONNECT");
        }

        Message {
            x: 0;
            y: 180px + direct.under;
            width: direct.inner-width;
            text: PlayView.join-message;
            tone: PlayView.join-quiet ? Theme.muted : Theme.bad;
        }

        Button {
            x: direct.inner-width - self.width;
            y: 212px + 2 * direct.under;
            nav: "direct.cancel";
            text: @tr("CANCEL");
            kind: ButtonKind.ghost;
        }
    }

    // The code a box a character, for a pad: Up and Down change a box's character, Enter goes to the next.
    if PlayView.boxes: boxes := DialogFrame {
        property <length> box: Theme.phone ? 40px : 52px;
        property <length> gap: Theme.phone ? 4px : 8px;
        property <length> left: (self.inner-width - 6 * self.box - 5 * self.gap - 2 * self.gap) / 2;
        title: @tr("Invite code");
        panel-width: 460px;
        content-height: 128px;
        for i in 6: CodeBox {
            // (In threes, as the code is said.)
            x: boxes.left + i * (boxes.box + boxes.gap) + (i >= 3 ? 2 * boxes.gap : 0px);
            y: 0;
            width: boxes.box;
            nav: "boxes.\{i}";
            value: PlayView.box-characters[i];
            count: PlayView.code-set;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Button {
            x: cancel.x - self.width - 12px;
            y: 88px;
            nav: "boxes.join";
            text: @tr("JOIN");
            kind: ButtonKind.main;
        }

        cancel := Button {
            x: boxes.inner-width - self.width;
            y: 88px;
            nav: "boxes.cancel";
            text: @tr("CANCEL");
            kind: ButtonKind.ghost;
        }
    }

    // Another build for the lobby: the player's builds of the game.
    if PlayView.changing: change := DialogFrame {
        title: @tr("Change build");
        panel-width: 460px;
        content-height: 322px;
        list := ListView {
            x: 0;
            y: 0;
            width: change.inner-width;
            height: 268px;
            nav: "change.builds";
            count: PlayView.builds.length;
            row-height: 52px;
            chosen: PlayView.chosen;
            for slot in list.shown: BuildRow {
                property <int> at: list.first + slot;
                x: 0;
                y: self.at * list.pitch;
                width: list.row-width;
                height: list.row-height;
                build: PlayView.builds[self.at];
                nav: list.nav;
                nav-index: self.at;
            }
        }

        Button {
            x: change.inner-width - self.width;
            y: 282px;
            nav: "change.cancel";
            text: @tr("CANCEL");
            kind: ButtonKind.ghost;
        }
    }
}
