// Play (docs/design/app-ui.md §6: "Play", "In an online match", "After a match"): online play. Its Rust half
// is src/screens/play.rs, which sets `PlayView` and hears the controls by their names.
//
// The screen has two parts, one shown at a time (`PlayView.part`): the player's builds (+ NEW BUILD over them,
// the chosen one's overview beside them with PRACTICE, EDIT and ⋯, its menu of DUPLICATE and DELETE) with
// the ways to play it online under them (HOST: an invite; JOIN: an invite's code typed; DIRECT CONNECT: a direct
// connection's dialog); and the lobby, from the moment an invite is out (or this machine hosts) for as long as the
// two players stay together: while the host waits for the other player (`PlayView.waiting`) the other player's
// place has the invite's code and a practice battle is in the player's own, and the match's settings are already
// the host's to set (the user: "the host should be able to change settings before the joiner joins. you should
// unify the interface somehow between the waiting and the lobby"). The two cards
// before a match and the match itself are the shell's (versus.slint, battle.slint); over the match are this
// file's menu (`MatchMenu`), the two builds shown while Tab is held (`MatchPeek`), and how the match went once its
// set is over (`MatchResult`).

import { Theme, Audit, Caps } from "../theme.slint";
import { Nav, NavKind, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, Hint, Picture, DialogFrame, FaceButton } from "../shell.slint";
import { Cut, Label, Note, Message, Value, Mono, Pill, Button, ButtonKind, Field, Stepper, Seg, Select, Slider, MenuItem, RowBack, RowTouch, ListView, PanelBack, Rule, Bars, ArrowDown, ProblemMark } from "../widgets.slint";
import { MenuOverlay } from "battle.slint";
import { SettingsView, BindBox } from "settings.slint";
import { Arrive, Tween, Pulse, Flash, Count } from "../motion.slint";
import { VersionTag, BuildEntry, BuildSheet, BuildRow, BuildOverview, RulesetNote } from "../build.slint";

// The part of Play shown.
export enum PlayPart {
    // The builds, what is done with them, and the row that makes a link.
    builds,
    // The lobby: an invite is out, or this machine hosts (`PlayView.waiting`), or the two players are together.
    lobby,
}

// A dialog of the builds' part: a new build's name and version.
export enum BuildDialog {
    none,
    new-build,
}

// What the lobby's reserved line says.
export enum LobbyNote {
    none,
    // The other player is ready and this one isn't; the other way about.
    you,
    them,
    // The link is down and being made again (`PlayView.note-seconds` left).
    reconnecting,
    // This player's build can't be played as the match's settings stand (with Patch cards off, its cards
    // left out): READY is refused.
    unusable,
}

// How a match's set went for this player, for its result (`MatchResult`).
export enum MatchOutcome {
    won,
    lost,
    drawn,
}

// A page of the match menu.
export enum MatchPage {
    menu,
    controls,
    settings,
}

// This player's build as the lobby's card names it (as the match's settings would play it): its name and its navi.
export struct PlayBuild {
    name: string,
    navi: string,
}

// An action of the battle with what is bound to it: a key's cap; a pad's face button, drawn by its place, or a
// button's cap.
export struct PlayControl {
    key: string,
    face: PadButton,
    pad: string,
}

// What Play shows: src/screens/play.rs sets these. (A struct or an enum a property here uses reaches Rust by
// that use: nothing is added to app.slint for it.)
export global PlayView {
    in property <PlayPart> part;

    // ---- The builds --------------------------------------------------------------------------------------
    // The selected game's builds, and the one chosen (the one a link brings and the one EDIT, DUPLICATE and
    // DELETE act on): its row, and its overview. A build whose file doesn't read as one (not `readable`)
    // can only be deleted.
    in property <[BuildEntry]> builds;
    in property <int> chosen;
    in property <BuildEntry> build;
    in property <BuildSheet> sheet;
    in property <bool> readable;
    // A dialog for a build's name: a new build's, with its version, or the chosen build's new name. The game's
    // versions, in its own order, and the one chosen; what a version sets, in the game's words.
    in property <BuildDialog> dialog;
    in property <string> dialog-name;
    in property <[VersionTag]> versions;
    in property <int> dialog-version;
    in property <string> version-sets;
    // The code typed, as the app keeps it (capitals, in threes), and what the reserved line under the row says: a
    // problem, in the error red, or quietly that a link is being made or what an import made (`message-quiet`).
    in property <string> code;
    in property <string> message;
    in property <bool> message-quiet;
    // What it says is why the chosen build can't be played (its problems, docs/design/app-ui.md §2.66): the problem's
    // mark before it, and the code's field isn't marked.
    in property <bool> message-problem;

    // The code a box a character, where it can't be typed (a pad): open, and its six characters. `code-set` is
    // how many characters a code is written in.
    in property <bool> boxes;
    in property <[string]> box-characters;
    in property <int> code-set;

    // ---- A direct connection -----------------------------------------------------------------------------
    in property <bool> direct;
    // This machine's address, for the other player; the address typed.
    in property <string> host-address;
    in property <string> address;
    // What went wrong with hosting (in place of the line under the address), and with joining.
    in property <string> host-message;
    in property <string> join-message;
    in property <bool> join-quiet;
    // It counts the copies: what was copied flashes.
    in property <int> copied-seq;

    // ---- Waiting -----------------------------------------------------------------------------------------
    // The lobby has nobody else yet: an invite is out, or this machine hosts. What the other player needs: the
    // invite's code in threes, or a direct host's address.
    in property <bool> waiting;
    in property <string> invite;
    in property <bool> invite-direct;

    // ---- The lobby ---------------------------------------------------------------------------------------
    in property <string> their-name;
    // The other player's lobby was heard: their card is there.
    in property <bool> their-present;
    in property <bool> ready;
    in property <bool> their-ready;
    // This player's card: the build as the match's settings would play it.
    in property <PlayBuild> card;
    // They count the times each turned ready: the mark stamps.
    in property <int> ready-seq;
    in property <int> their-ready-seq;
    // The match's settings, both players' and the host's alone to change (`host`; the joiner's controls are
    // unavailable): the round wins its set is first to (1: a single battle; 2: the original's triple battle,
    // best of 3), the ruleset by its name, open setups (each player may see the other's build in the match),
    // and the custom screen's time limit in seconds (0: none; nettai's own).
    in property <int> first-to: 2;
    in property <string> ruleset;
    in property <bool> host;
    in property <bool> open;
    in property <int> custom-time: 60;
    // The player's own, apart from the match's (the user: "the input delay and ping settings should probably be
    // displayed separately from the lobby settings, since those are client-local things").
    in property <int> input-delay;
    // The connection: its bars (0 to 4) and the round trip in ms (-1: not measured).
    in property <int> bars;
    in property <int> ping: -1;
    in property <LobbyNote> note;
    in property <int> note-seconds;
    // What is wrong with the build, where the settings can't play it (`LobbyNote.unusable`): its sentence.
    in property <string> note-problem;
    // Why the match before ended, where it didn't end by itself (in the error red, in the note's place).
    in property <string> note-error;
    // Another build is being chosen.
    in property <bool> changing;

    // ---- In a match --------------------------------------------------------------------------------------
    in property <MatchPage> page;
    // The builds are shown (Tab, or Select on a pad, is held).
    in property <bool> peek;
    // How far the builds shown are scrolled (0 or less: both by the same, each no further than its own end), how far
    // they can be (the longer's), and how tall the shorter's box is: the keys and the pad scroll them from the app
    // while the menu is open (`Play::scroll`), the wheel and a drag over them here.
    in-out property <length> peek-y;
    in-out property <length> peek-span;
    in-out property <length> peek-view;
    // The match's own controls as this player's bindings have them, for the match menu's footer: moving (the four
    // directions' keys), A, B, L and R (one hint where the pad's are the shoulders), showing the builds (Tab, the
    // pad's button bound to SELECT) and the menu (Esc, and the key and the pad's button bound to START).
    in property <[Hint]> match-keys;
    // The match's setups are open: the other player's build may be shown.
    in property <bool> open-match;
    // The two builds as the match plays them, each a player's panel.
    in property <BuildSheet> mine;
    in property <BuildSheet> theirs;
    in property <[PlayControl]> controls;
    in property <int> music;
    in property <int> effects;

    // ---- After a match -----------------------------------------------------------------------------------
    // The set is over: how it went for this player, over the picture until they go on (`MatchResult`). Its
    // facts: the round wins each side has, this player's first, and the match's time in hundredths of a second.
    in property <bool> result-shown;
    in property <MatchOutcome> outcome;
    in property <int> result-wins;
    in property <int> result-losses;
    in property <int> result-time;
    // A press settles it: everything at its end at once.
    in property <bool> result-settled;
    // For its sounds (the app's): it counts the numbers shown as they tick, and says when the last has come to
    // its value. The app puts them back as it shows a result.
    in-out property <int> result-ticks;
    in-out property <bool> result-done;

    // ---- Words the app needs -----------------------------------------------------------------------------
    out property <string> you: Caps.of(@tr("You"));
    out property <string> opponent: Caps.of(@tr("Opponent"));
    out property <string> back-to-play: Caps.of(@tr("Back to play"));
    // Esc in the lobby asks before the other player is left.
    out property <string> leave-question: @tr("Leave the lobby?");
    out property <string> cancel-word: Caps.of(@tr("Cancel"));
    out property <string> leave-word: Caps.of(@tr("Leave"));
    out property <string> connecting: @tr("Connecting…");
    // The match menu's footer's words (`match-keys`).
    out property <string> move-word: @tr("Move");
    out property <string> show-builds-word: @tr("Show builds");
    out property <string> menu-word: @tr("Menu");
    out property <string> new-name: @tr("New build");
    out property <string> delete-word: Caps.of(@tr("Delete"));
    // The build's menu (⋯, or a right click on its row), DELETE apart after them.
    out property <string> practice-word: Caps.of(@tr("Practice"));
    out property <string> duplicate-word: Caps.of(@tr("Duplicate"));
    out property <string> save-files: @tr("Save files");
    public pure function delete-title(name: string) -> string {
        return @tr("Delete {}?", name);
    }
    // While the other player is waited for, the practice menu's EXIT (src/screens/play.rs's `train`), with an
    // invite out or this machine hosting directly; and a phone's one row at its top.
    public pure function wait-exit(direct: bool) -> string {
        return direct ? Caps.of(@tr("Stop hosting")) : Caps.of(@tr("Cancel invite"));
    }
    out property <string> stop-practice: Caps.of(@tr("Stop practice"));
}

// ---- The builds ------------------------------------------------------------------------------------------

// The chosen build in one box, on a phone: Enter opens the builds as a sheet, a select's list (the arrows walk past it).
component BuildBox inherits Rectangle {
    in property <BuildEntry> build;
    in property <string> nav;
    in property <bool> enabled: true;
    height: 72px;
    PanelBack { }

    Value {
        x: 16px;
        y: 14px;
        width: parent.width - 68px;
        height: 24px;
        text: root.build.name;
        font-size: 18px;
        font-weight: 900;
    }

    Text {
        x: root.build.bad ? 25px : 16px;
        y: 42px;
        width: parent.width - 68px - (root.build.bad ? 9px : 0px) - (made-for.width > 0 ? made-for.width + 12px : 0px);
        height: 16px;
        text: root.build.status;
        color: root.build.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // (A build with problems: their mark before the words.)
    ProblemMark {
        x: 16px;
        y: 42px + 5.5px;
        visible: root.build.bad;
    }

    // (The ruleset it is made for, at the status line's right end.)
    made-for := RulesetNote {
        x: parent.width - 52px - self.width;
        y: 42px;
        build: root.build;
        room: parent.width - 68px;
    }

    ArrowDown {
        x: parent.width - 24px;
    }

    Focusable {
        nav: root.nav;
        kind: NavKind.button;
        enabled: root.enabled;
    }
}

// One of the code's six boxes, for a pad: Up and Down go through its characters, Left and Right to the boxes
// beside it. (To the app's focus it is a list whose rows are all in one place, `count` of them: `Nav.index` is
// the character it is on.)
component CodeBox inherits Rectangle {
    in property <string> nav;
    in property <string> value;
    in property <int> count;
    property <[int]> token;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    function place() {
        Nav.page(root.nav, root.ax, root.ay, self.width, self.height, self.height, 0px);
        Nav.list(root.nav, root.count, 0px, self.height, 0px, self.width);
    }
    height: 64px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: Nav.id == root.nav ? Theme.cursor : Theme.line;
    }

    Path {
        y: 6px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 5 L 8 5 L 4 0 Z";
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 28px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Path {
        y: parent.height - 11px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 0 L 8 0 L 4 5 Z";
    }

    init => {
        root.token = Nav.register(root.nav, 0, NavKind.list);
        place();
    }
    changed ax => {
        place();
    }
    changed ay => {
        place();
    }
    changed count => {
        place();
    }
}

// The versions a new build starts from: Left and Right choose, a click takes one. A control's height (the user: "the
// version selector in new build is really tall for no reason").
component VersionChoice inherits Rectangle {
    in property <[VersionTag]> versions;
    in property <int> chosen;
    property <length> box: (self.width - (root.versions.length - 1) * 12px) / max(1, root.versions.length);
    height: Theme.control;
    for version[i] in root.versions: Rectangle {
        x: i * (root.box + 12px);
        width: root.box;
        background: Theme.inset;
        border-width: i == root.chosen ? 2px : 1px;
        border-color: i == root.chosen ? Theme.cursor : Theme.line;
        Text {
            text: version.text;
            color: version.tone;
            font-family: Theme.display;
            font-size: 14px;
            font-weight: Theme.display-bold;
            letter-spacing: 0.6px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            clicked => {
                Nav.point("name.version", 0);
                Nav.choose("name.version", 0, i);
            }
        }
    }

    Focusable {
        nav: "name.version";
        kind: NavKind.stepper;
        // (Its halves take the clicks.)
        z: -1;
    }
}

// ---- The lobby -------------------------------------------------------------------------------------------

// A player's card in the lobby: who they are, what they bring (this player's own card alone says it), and
// whether they are ready, in a box that is there either way. The mark stamps as its player turns ready. (While
// the host waits for the other player there is nothing to be ready for: no mark, `marked` off.)
component LobbyCard inherits Rectangle {
    in property <string> role;
    in property <string> name;
    in property <PlayBuild> build;
    in property <int> side;
    in property <bool> ready;
    in property <int> ready-seq;
    in property <bool> marked: true;
    property <length> pad: Theme.phone ? 16px : 24px;
    stamp := Pulse {
        seq: root.ready-seq;
        duration: Theme.settle;
    }

    PanelBack {
        side: root.side;
        accent: false;
    }

    Label {
        x: root.pad;
        y: root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: root.role;
    }

    Value {
        x: root.pad;
        y: root.pad + (Theme.phone ? 18px : 22px);
        width: parent.width - 2 * root.pad;
        height: Theme.phone ? 28px : 36px;
        text: root.name;
        font-size: Theme.phone ? 22px : 28px;
        font-weight: 900;
    }

    HorizontalLayout {
        x: root.pad;
        y: root.pad + (Theme.phone ? 52px : 66px);
        width: parent.width - 2 * root.pad - (Theme.phone ? mark.width + 12px : 0px);
        height: 22px;
        spacing: 8px;
        alignment: start;
        Value {
            text: root.build.name;
            font-size: Theme.phone ? 14px : 16px;
        }
    }

    Value {
        x: root.pad;
        y: root.pad + (Theme.phone ? 78px : 95px);
        width: parent.width - 2 * root.pad - (Theme.phone ? mark.width + 12px : 0px);
        height: 16px;
        text: root.build.navi;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 400;
    }

    mark := Rectangle {
        x: parent.width - root.pad - self.width;
        y: parent.height - root.pad - self.height;
        width: 144px;
        height: 32px;
        visible: root.marked;
        transform-scale: 1 + stamp.v * 0.16;
        Rectangle {
            border-width: 1px;
            border-color: root.ready ? Theme.good : Theme.line;
        }

        Flash {
            seq: root.ready-seq;
            tone: Theme.good;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 8px;
            width: parent.width - 16px;
            text: root.ready ? Caps.of(@tr("Ready")) : Caps.of(@tr("Not ready"));
            color: root.ready ? Theme.good : Theme.muted;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

// The other player's place while the host waits for them: what they need to come (the invite's code, large, in
// fixed-width type and grouped in threes, or this machine's address), COPY CODE (COPY ADDRESS), which flashes as
// it copies, and that they are waited for. (On a phone, in a card's 126: the words beside COPY, the line under
// them left out.)
component WaitCard inherits Rectangle {
    property <length> pad: Theme.phone ? 16px : 24px;
    PanelBack {
        side: 2;
        accent: false;
    }

    Label {
        x: root.pad;
        y: Theme.phone ? 12px : root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: PlayView.invite-direct ? Caps.of(@tr("Your address")) : Caps.of(@tr("Invite code"));
    }

    Mono {
        x: root.pad;
        y: Theme.phone ? 28px : root.pad + 22px;
        width: parent.width - 2 * root.pad;
        height: Theme.phone ? 48px : 64px;
        text: PlayView.invite;
        font-size: PlayView.invite-direct ? (Theme.phone ? 22px : 28px) : (Theme.phone ? 40px : 56px);
        letter-spacing: PlayView.invite-direct ? 0px : 2.2px;
    }

    copy := Button {
        x: root.pad;
        y: Theme.phone ? 80px : root.pad + 98px;
        nav: "wait.copy";
        text: PlayView.invite-direct ? Caps.of(@tr("Copy address")) : Caps.of(@tr("Copy code"));
    }

    Flash {
        x: copy.x;
        y: copy.y;
        width: copy.width;
        height: copy.height;
        seq: PlayView.copied-seq;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Rule {
        x: root.pad;
        y: root.pad + 162px;
        width: parent.width - 2 * root.pad;
        visible: !Theme.phone;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // That the other player is waited for: a slow pulse and its words (on a phone beside COPY).
    property <length> waited-x: Theme.phone ? copy.x + copy.width + 16px : root.pad;
    property <length> waited-y: Theme.phone ? copy.y + (copy.height - 20px) / 2 : root.pad + 182px;
    Rectangle {
        x: root.waited-x;
        y: root.waited-y + 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.cursor;
        opacity: Theme.motion ? 0.35 + 0.65 * abs(sin(mod(animation-tick(), 2.2s) / 2.2s * 360deg)) : 1;
    }

    Value {
        x: root.waited-x + 18px;
        y: root.waited-y;
        width: parent.width - self.x - root.pad;
        height: 20px;
        text: @tr("Waiting for opponent");
    }

    Note {
        x: root.pad;
        y: root.pad + 208px;
        width: parent.width - 2 * root.pad;
        height: 20px;
        visible: !Theme.phone;
        text: PlayView.invite-direct ? @tr("Send this address to your opponent.") : @tr("The lobby opens when they join.");
    }
}

// The match's settings, the host's (the user: "only the host should be able to change rules"; both see them, the
// joiner's controls unavailable): one row, or on a phone a line each. First to, the Ruleset (with EDIT after it,
// the joiner's VIEW), Open setups and the Custom timer. What is each player's own, the input delay and the
// connection, is apart from them (`ConnectionFacts`).
component MatchFacts inherits Rectangle {
    // The one row: each setting's name over its control, a cell as wide as the wider of the two, so the cells fit
    // whatever the language. Where each cell starts, and the row's width.
    property <length> gap: 41px;
    property <length> x1: 24px;
    property <length> x2: self.x1 + max(first-to-label.width, first-to.width) + self.gap;
    property <length> x3: self.x2 + max(ruleset-label.width, ruleset.width + 8px + rules.width) + self.gap;
    property <length> x4: self.x3 + max(open-label.width, open.width) + self.gap;
    out property <length> natural-width: self.x4 + max(custom-time-label.width, custom-time.width) + 24px;
    // On a phone, a line each: the name, and the control at the right.
    property <length> line: 44px;
    // A name's place and a control's, in the row.
    property <length> name-y: 10px;
    property <length> name-height: 18px;
    property <length> control-y: 32px;
    property <length> control-height: 36px;
    property <brush> name-color: Theme.phone ? Theme.text : Theme.muted;
    height: Theme.phone ? 4 * self.line : 78px;
    PanelBack {
        visible: !Theme.phone;
        accent: false;
    }

    first-to-label := Value {
        x: Theme.phone ? 0px : root.x1;
        y: Theme.phone ? 0px : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("First to");
        color: root.name-color;
    }

    // (The round wins that take the set: "2" under First to; in Japanese, 2本先取.)
    first-to := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x1;
        y: Theme.phone ? (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.first-to";
        value: @tr("first to" => "{}", PlayView.first-to);
        value-width: 84px;
        numeric: true;
        enabled: PlayView.host;
    }

    Rectangle {
        x: root.x2 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The Ruleset: the match's, by its name (docs/design/app-ui.md §2.59). The host's is a select of the game's
    // presets and their own, with EDIT, which opens its page; the joiner's can't be changed, and VIEW opens its
    // page to read.
    ruleset-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ruleset");
        color: root.name-color;
    }

    ruleset := Select {
        x: Theme.phone ? parent.width - rules.width - 8px - self.width : root.x2;
        y: Theme.phone ? root.line + (root.line - self.height) / 2 : root.control-y;
        width: 176px;
        height: 36px;
        nav: "lobby.ruleset";
        value: PlayView.ruleset;
        enabled: PlayView.host;
    }

    rules := Button {
        x: Theme.phone ? parent.width - self.width : root.x2 + ruleset.width + 8px;
        y: ruleset.y;
        width: self.natural-width;
        // (As tall as the select beside it.)
        height: ruleset.height;
        compact: true;
        nav: "lobby.rules";
        text: PlayView.host ? Caps.of(@tr("Edit")) : Caps.of(@tr("ruleset" => "View"));
    }

    Rectangle {
        x: root.x3 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // Open setups: each player may see the other's build in the match; off in a new lobby (the user: "closed
    // setups should be open setups instead and it should be off by default").
    open-label := Value {
        x: Theme.phone ? 0px : root.x3;
        y: Theme.phone ? 2 * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Open setups");
        color: root.name-color;
    }

    open := Seg {
        x: Theme.phone ? parent.width - self.width : root.x3;
        y: Theme.phone ? 2 * root.line + (root.line - self.height) / 2 : root.control-y;
        nav: "lobby.open";
        first: Caps.of(@tr("Off"));
        second: Caps.of(@tr("On"));
        chosen: PlayView.open ? 1 : 0;
        enabled: PlayView.host;
    }

    Rectangle {
        x: root.x4 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The custom screen's time limit (nettai's own): its seconds, or ∞ for none, as the original's screen has none (the
    // user: "instead of Unlimited use the infinity sign for custom timer").
    custom-time-label := Value {
        x: Theme.phone ? 0px : root.x4;
        y: Theme.phone ? 3 * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Custom timer");
        color: root.name-color;
    }

    custom-time := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x4;
        y: Theme.phone ? 3 * root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.custom-time";
        value: PlayView.custom-time == 0 ? "∞" : @tr("custom timer" => "{}s", PlayView.custom-time);
        value-width: 84px;
        enabled: PlayView.host;
    }
}

// What is this player's own and not the match's, apart from the match's settings (the user: "the input delay and
// ping settings should probably be displayed separately from the lobby settings, since those are client-local
// things"): the input delay (the Settings' value, kept as it is changed; the other player never sees it) and the
// connection's bars and round trip (nothing while nobody has come). As `MatchFacts`: a row, or a line each.
component ConnectionFacts inherits Rectangle {
    property <length> gap: 41px;
    property <length> x1: 24px;
    property <length> x2: self.x1 + max(delay-label.width, delay.width) + self.gap;
    out property <length> natural-width: self.x2 + max(ping-label.width, bars.width + 10px + ping.width) + 24px;
    property <length> line: 44px;
    property <length> name-y: 10px;
    property <length> name-height: 18px;
    property <length> control-y: 32px;
    property <length> control-height: 36px;
    property <brush> name-color: Theme.phone ? Theme.text : Theme.muted;
    height: Theme.phone ? 2 * self.line : 78px;
    PanelBack {
        visible: !Theme.phone;
        accent: false;
    }

    delay-label := Value {
        x: Theme.phone ? 0px : root.x1;
        y: Theme.phone ? 0px : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Input delay");
        color: root.name-color;
    }

    delay := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x1;
        y: Theme.phone ? (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.delay";
        value: PlayView.input-delay;
        value-width: 48px;
        numeric: true;
    }

    Rectangle {
        x: root.x2 - 21px;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The connection: its bars and the round trip, where a setting has its control.
    ping-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ping");
        color: root.name-color;
    }

    bars := Bars {
        x: Theme.phone ? parent.width - ping.width - 10px - self.width : root.x2;
        y: (Theme.phone ? root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2);
        level: PlayView.bars;
    }

    ping := Mono {
        x: Theme.phone ? parent.width - self.width : root.x2 + bars.width + 10px;
        y: Theme.phone ? root.line : root.control-y;
        width: 60px;
        height: Theme.phone ? root.line : root.control-height;
        horizontal-alignment: Theme.phone ? right : left;
        text: PlayView.ping < 0 ? "" : @tr("{} ms", PlayView.ping);
    }
}

// ---- The screen ------------------------------------------------------------------------------------------

export component PlayScreen inherits Page {
    property <[Hint]> hints-builds: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Delete") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
    property <[Hint]> hints-waiting: [
        { key: "Esc", pad: PadButton.start, text: @tr("Practice menu") },
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Fight") },
    ];
    property <[Hint]> hints-lobby: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Tab", pad: PadButton.shoulders, text: @tr("Next") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Leave") },
    ];
    // The builds' part, in three zones read in order (docs/design/app-ui.md §6, "Play"): the builds (+ NEW BUILD
    // over the list, the left column); the chosen build (its overview, the right column, with PRACTICE, EDIT and ⋯
    // in its header); and the ways to play it online, one row of controls under the overview (HOST, then JOIN's
    // field and JOIN, and DIRECT CONNECT at its right edge; the reserved line under them). On a phone one column
    // in the same order.
    property <length> list-width: 400px;
    property <length> side-x: root.list-width + 24px;
    property <length> side-width: self.body-width - root.side-x;
    // The row (the controls' height) and the reserved line under it at the body's foot; the list and the
    // overview grow down to 16 over the row (564 at the reference window: the wide sheet's 540 at least).
    property <length> message-y: Theme.phone ? 356px : self.body-height - 18px;
    property <length> row-y: Theme.phone ? 188px : root.message-y - 6px - 40px;
    property <length> sheet-height: max(540px, root.row-y - 16px);
    property <length> more-width: 40px;
    property <bool> none: PlayView.builds.length == 0;
    property <bool> usable: PlayView.chosen >= 0 && !root.none && PlayView.readable;
    // The lobby (from the moment an invite is out): the two places, the settings, the buttons, the line. A
    // desktop's places are as tall as the wait's practice battle at twice the battle's size (480 by 320), 80
    // apart (VS between them); a phone's are cards, one over the other.
    property <length> place-width: Theme.phone ? self.body-width : 480px;
    property <length> place-height: Theme.phone ? 126px : 320px;
    property <length> lobby-top: Theme.phone ? 0px : (self.body-height - 548px) / 2;
    property <length> lobby-left: (self.body-width - 2 * self.place-width - 80px) / 2;
    property <length> their-x: Theme.phone ? 0px : self.lobby-left + self.place-width + 80px;
    property <length> their-y: Theme.phone ? self.place-height + 8px : self.lobby-top;
    property <length> facts-top: Theme.phone ? 2 * self.place-height + 20px : self.lobby-top + self.place-height + 24px;
    property <length> buttons-top: Theme.phone ? self.facts-top + 308px : self.facts-top + 124px;
    title: PlayView.part == PlayPart.lobby ? Caps.of(@tr("Lobby")) : Caps.of(@tr("Play"));
    back: PlayView.part == PlayPart.builds ? Caps.of(@tr("Menu")) : Caps.of(@tr("Play"));
    hints: PlayView.part == PlayPart.lobby ? (PlayView.waiting ? root.hints-waiting : root.hints-lobby) : root.hints-builds;
    // (The builds of the game while they show; the lobby and a match list nothing.)
    status: PlayView.part == PlayPart.builds ? @tr("{n} build" | "{n} builds" % PlayView.builds.length) : "";

    // ---- The builds, what is done with them, and the row that makes a link ----
    // (One conditional a part, and what differs on a phone by its place and by `visible`: each conditional is a
    // component of its own in what Slint generates. A control that isn't shown is unavailable, so the focus
    // passes it by.)
    if PlayView.part == PlayPart.builds: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        // The builds: + NEW BUILD (the main action while there is none), and the builds as a list (a right click
        // on a row opens its menu); on a phone the chosen one in a box, which opens them as a sheet.
        Arrive {
            order: 0;
            Button {
                x: 0;
                y: 0;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "new";
                text: Caps.of(@tr("+ New build"));
                kind: root.none ? ButtonKind.main : ButtonKind.normal;
            }

            list := ListView {
                x: 0;
                y: 52px;
                width: root.list-width;
                height: root.sheet-height - self.y;
                visible: !Theme.phone;
                nav: "builds";
                count: Theme.phone ? 0 : PlayView.builds.length;
                row-height: 52px;
                chosen: PlayView.chosen;
                for slot in list.shown: BuildRow {
                    property <int> at: list.first + slot;
                    x: 0;
                    y: self.at * list.pitch;
                    width: list.row-width;
                    height: list.row-height;
                    build: PlayView.builds[self.at];
                    nav: list.nav;
                    nav-index: self.at;
                    menu: true;
                }
            }

            BuildBox {
                x: 0;
                y: 52px;
                width: root.body-width;
                visible: Theme.phone && !root.none;
                enabled: Theme.phone && !root.none;
                nav: "build";
                build: PlayView.build;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        // The chosen build: its overview (the wide sheet) with EDIT and ⋯ in its header's right; on a phone, no
        // overview, and the two in a row under the box. ⋯ opens the build's menu (PRACTICE, DUPLICATE and, apart, DELETE). A
        // build whose file doesn't read has an empty frame, EDIT unavailable and only DELETE in its menu. With no build
        // neither is there. (PRACTICE is the editor's and the menu's: docs/design/app-ui.md §2.86, §2.88.)
        Arrive {
            order: 1;
            PanelBack {
                x: root.side-x;
                y: 0;
                width: root.side-width;
                height: root.sheet-height;
                visible: !Theme.phone && !root.none && !root.usable;
            }

            BuildOverview {
                x: root.side-x;
                y: 0;
                // (On a phone it isn't shown, and is given the wide sheet's least width: its texts fit there.)
                width: Theme.phone ? 620px : root.side-width;
                height: Theme.phone ? self.sheet-height : root.sheet-height;
                visible: !Theme.phone && root.usable && PlayView.sheet.name != "";
                build: PlayView.sheet;
                tools: edit.width + 8px + root.more-width;
            }

            edit := Button {
                x: Theme.phone ? 0px : more.x - 8px - self.width;
                y: Theme.phone ? 136px : 24px;
                width: Theme.phone ? root.body-width - 8px - root.more-width : self.natural-width;
                visible: !root.none;
                nav: "edit";
                text: Caps.of(@tr("Edit"));
                enabled: root.usable;
            }

            more := Button {
                x: Theme.phone ? root.body-width - self.width : root.body-width - 16px - self.width;
                y: edit.y;
                width: root.more-width;
                visible: !root.none;
                enabled: !root.none && PlayView.chosen >= 0;
                nav: "more";
                text: "";
            }

            // (Its ⋯, three dots over it.)
            Rectangle {
                x: more.x + more.width / 2 - 7.5px;
                y: more.y + (more.height - 3px) / 2 + 0.5px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }

            Rectangle {
                x: more.x + more.width / 2 - 1.5px;
                y: more.y + (more.height - 3px) / 2 + 0.5px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }

            Rectangle {
                x: more.x + more.width / 2 + 4.5px;
                y: more.y + (more.height - 3px) / 2 + 0.5px;
                width: 3px;
                height: 3px;
                visible: !root.none;
                background: more.enabled ? Theme.text : Theme.dim;
            }
        }

        // The ways to play it online, one row of the app's controls under the overview, at its left edge: HOST, the
        // main action's button while there is a build (what a player comes to PLAY for, the one that starts a
        // match by itself); then JOIN's field, for an invite's code, and JOIN; and at the overview's right edge
        // DIRECT CONNECT, a regular button, whose dialog hosts on this machine's address or joins one. On a phone
        // HOST is the column's width and 52 tall, the field and JOIN a row under it, and DIRECT CONNECT the
        // column's width under them. The line under them is there whether or not it says anything (with no build
        // they say there why they can't).
        Arrive {
            order: 2;
            host := Button {
                x: Theme.phone ? 0px : root.side-x;
                y: root.row-y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "invite";
                text: Caps.of(@tr("Host"));
                kind: root.none ? ButtonKind.normal : ButtonKind.main;
                big: Theme.phone;
            }

            code := Field {
                x: Theme.phone ? 0px : host.x + host.width + 24px;
                y: Theme.phone ? host.y + host.height + 12px : root.row-y;
                // (A code's six characters in threes, in the code's type; on a phone what JOIN leaves.)
                width: Theme.phone ? root.body-width - 8px - join.width : 208px;
                nav: "code";
                text: PlayView.code;
                placeholder: @tr("Invite code");
                code: true;
                error: PlayView.message != "" && !PlayView.message-quiet && !PlayView.message-problem;
            }

            join := Button {
                x: code.x + code.width + 8px;
                y: code.y;
                nav: "join";
                text: Caps.of(@tr("Join"));
            }

            // (A browser has no sockets of its own: links are WebRTC's alone, through the signaling server.)
            if !Theme.web: Button {
                x: root.body-width - self.width;
                y: Theme.phone ? code.y + code.height + 12px : root.row-y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "direct";
                // (Less than HOST and JOIN: the user, "direct connect should be deemphasized".)
                kind: ButtonKind.text;
                text: Caps.of(@tr("Direct connect"));
            }

            ProblemMark {
                x: Theme.phone ? 0px : root.side-x;
                y: root.message-y + (Theme.phone ? 6px : 6.5px);
                visible: PlayView.message-problem && PlayView.message != "";
            }

            Note {
                x: (Theme.phone ? 0px : root.side-x) + (PlayView.message-problem ? 9px : 0px);
                y: root.message-y;
                width: (Theme.phone ? root.body-width : root.side-width) - (PlayView.message-problem ? 9px : 0px);
                height: Theme.phone ? 40px : 18px;
                vertical-alignment: Theme.phone ? top : center;
                text: PlayView.message;
                color: PlayView.message-quiet ? Theme.muted : Theme.bad;
                font-size: 12px;
                wrap: Theme.phone ? word-wrap : no-wrap;
                overflow: elide;
            }
        }
    }

    // ---- The lobby: while the host waits for the other player, and with them ----
    // One layout from the moment an invite is out (or this machine hosts) for as long as the two players stay
    // together (the user: "you should unify the interface somehow between the waiting and the lobby"): the two
    // players' places side by side (on a phone one over the other), the match's settings and this player's own
    // apart beside them, the buttons, the reserved line. While the host waits, the other player's place has the
    // invite's code (`WaitCard`), the player's own the practice battle (on a phone their card, the battle asked for
    // with PRACTICE, filling the window), and the buttons are the way out alone; the match's settings are the
    // host's to set already (the user: "the host should be able to change settings before the joiner joins").
    if PlayView.part == PlayPart.lobby: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        // The other player's card slides in as they join.
        joined := Tween {
            held: !PlayView.their-present;
        }

        Arrive {
            order: 0;
            if !PlayView.waiting || Theme.phone: LobbyCard {
                x: Theme.phone ? 0px : root.lobby-left;
                y: root.lobby-top;
                width: root.place-width;
                height: root.place-height;
                role: PlayView.you;
                name: Shell.player;
                build: PlayView.card;
                side: 1;
                ready: PlayView.ready;
                ready-seq: PlayView.ready-seq;
                marked: !PlayView.waiting;
            }

            // The wait's practice battle, at twice the battle's size, in this player's place.
            if PlayView.waiting && !Theme.phone: Rectangle {
                x: root.lobby-left;
                y: root.lobby-top;
                width: root.place-width;
                height: root.place-height;
                Picture {
                    x: 0;
                    y: 0;
                    width: root.place-width;
                    height: root.place-height;
                    ground: Theme.inset;
                }

                Rectangle {
                    x: 12px;
                    y: parent.height - 34px;
                    width: practice.preferred-width + 16px;
                    height: 22px;
                    background: Theme.shade;
                    practice := Text {
                        text: Caps.of(@tr("Practice"));
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: 11px;
                        font-weight: Theme.display-bold;
                        letter-spacing: Theme.label-tracking;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                x: root.lobby-left + root.place-width;
                y: root.lobby-top;
                width: 80px;
                height: root.place-height;
                visible: !Theme.phone;
                text: @tr("VS");
                color: Theme.dim;
                font-family: Theme.display;
                font-size: 28px;
                font-weight: Theme.display-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if PlayView.waiting: WaitCard {
                x: root.their-x;
                y: root.their-y;
                width: root.place-width;
                height: root.place-height;
            }
        }

        Rectangle {
            x: (1 - joined.t) * 56px;
            opacity: joined.t;
            visible: PlayView.their-present;
            LobbyCard {
                x: root.their-x;
                y: root.their-y;
                width: root.place-width;
                height: root.place-height;
                role: PlayView.opponent;
                name: PlayView.their-name;
                side: 2;
                ready: PlayView.their-ready;
                ready-seq: PlayView.their-ready-seq;
            }
        }

        // The match's settings, and apart from them this player's own: each group named over it on a desktop;
        // on a phone a line each, the player's own under a name of their own.
        Arrive {
            order: 1;
            Label {
                x: match-facts.x;
                y: root.facts-top;
                width: match-facts.width;
                height: 14px;
                visible: !Theme.phone;
                text: Caps.of(@tr("Match settings"));
            }

            match-facts := MatchFacts {
                x: Theme.phone ? 0px : (root.body-width - self.natural-width - 24px - connection.natural-width) / 2;
                y: Theme.phone ? root.facts-top : root.facts-top + 22px;
                width: Theme.phone ? root.body-width : self.natural-width;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }

            Label {
                x: connection.x;
                y: Theme.phone ? match-facts.y + match-facts.height + 12px : root.facts-top;
                width: Theme.phone ? root.body-width : connection.width;
                height: 14px;
                text: Caps.of(@tr("Your connection"));
            }

            connection := ConnectionFacts {
                x: Theme.phone ? 0px : match-facts.x + match-facts.width + 24px;
                y: Theme.phone ? match-facts.y + match-facts.height + 32px : match-facts.y;
                width: Theme.phone ? root.body-width : self.natural-width;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        Arrive {
            order: 2;
            // With the other player: READY, CHANGE BUILD and LEAVE. (On a phone READY the column's width, the
            // other two half of it each under it.)
            ready := Button {
                x: Theme.phone ? 0px : (root.body-width - self.width - change.width - leave.width - 24px) / 2;
                y: root.buttons-top;
                width: Theme.phone ? root.body-width : 184px;
                visible: !PlayView.waiting;
                enabled: !PlayView.waiting;
                nav: "lobby.ready";
                text: PlayView.ready ? Caps.of(@tr("Not ready")) : Caps.of(@tr("Ready"));
                kind: ButtonKind.main;
                big: Theme.phone;
            }

            change := Button {
                x: Theme.phone ? 0px : ready.x + ready.width + 12px;
                y: Theme.phone ? root.buttons-top + 60px : root.buttons-top;
                width: Theme.phone ? (root.body-width - 8px) / 2 : self.natural-width;
                visible: !PlayView.waiting;
                enabled: !PlayView.waiting;
                nav: "lobby.change";
                text: Caps.of(@tr("Change build"));
            }

            leave := Button {
                x: Theme.phone ? change.width + 8px : change.x + change.width + 12px;
                y: change.y;
                width: Theme.phone ? (root.body-width - 8px) / 2 : self.natural-width;
                visible: !PlayView.waiting;
                enabled: !PlayView.waiting;
                nav: "lobby.leave";
                text: Caps.of(@tr("Leave"));
                kind: ButtonKind.ghost;
            }

            // While the host waits: the way out, CANCEL INVITE (STOP HOSTING), as the practice menu has it in
            // EXIT's place; on a phone PRACTICE before it, which starts the practice battle filling the window.
            Button {
                x: 0;
                y: root.buttons-top;
                width: root.body-width;
                visible: PlayView.waiting && Theme.phone;
                enabled: PlayView.waiting && Theme.phone;
                nav: "wait.train";
                text: Caps.of(@tr("Practice"));
                kind: ButtonKind.main;
                big: true;
            }

            Button {
                x: Theme.phone ? 0px : (root.body-width - self.width) / 2;
                y: Theme.phone ? root.buttons-top + 60px : root.buttons-top;
                width: Theme.phone ? root.body-width : self.natural-width;
                visible: PlayView.waiting;
                enabled: PlayView.waiting;
                nav: "wait.cancel";
                text: PlayView.wait-exit(PlayView.invite-direct);
                kind: ButtonKind.ghost;
            }

            // The reserved line: who is waited for, that the link is being made again, why the match before
            // ended, or what keeps this player's build from being played.
            Message {
                x: 0;
                y: root.buttons-top + (Theme.phone ? 112px : 64px);
                width: root.body-width;
                text: PlayView.note == LobbyNote.reconnecting ? @tr("Reconnecting {} s", PlayView.note-seconds) : PlayView.note == LobbyNote.unusable ? PlayView.note-problem : PlayView.note-error != "" ? PlayView.note-error : PlayView.note == LobbyNote.you ? @tr("Waiting for you to ready up.") : PlayView.note == LobbyNote.them ? @tr("Waiting for your opponent to ready up.") : "";
                tone: PlayView.note-error != "" || PlayView.note == LobbyNote.reconnecting || PlayView.note == LobbyNote.unusable ? Theme.bad : Theme.muted;
                mark: PlayView.note == LobbyNote.unusable;
                horizontal-alignment: center;
            }
        }
    }
}

// ---- Over the match --------------------------------------------------------------------------------------

// The match menu: Start or Esc in an online match, in place of the game's own pause. The match keeps running
// behind it. Its pages are the menu itself, and what two of its items open: the controls, the settings a player
// may want in a match. Its footer lists the match's own controls as this player's bindings have them (the user:
// "the menu footer should show in-game controls"), and Tab (Select on a pad) shows both builds over it as in the
// match.
export component MatchMenu inherits MenuOverlay {
    property <[string]> actions: [@tr("Up"), @tr("Down"), @tr("Left"), @tr("Right"), "A", "B", "L", "R", "START", "SELECT", @tr("Navi change left"), @tr("Navi change right")];
    title: PlayView.page == MatchPage.controls ? Caps.of(@tr("Controls")) : PlayView.page == MatchPage.settings ? Caps.of(@tr("Settings")) : Caps.of(@tr("Menu"));
    note: PlayView.page == MatchPage.menu ? @tr("The match keeps running") : "";
    side: PlayView.page != MatchPage.menu;
    content-height: 192px;
    hints: PlayView.match-keys;
    if PlayView.page == MatchPage.menu: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        MenuItem {
            x: 0;
            y: 0;
            width: root.inner-width;
            nav: "menu.resume";
            text: Caps.of(@tr("Back to match"));
        }

        MenuItem {
            x: 0;
            y: 48px;
            width: root.inner-width;
            nav: "menu.controls";
            text: Caps.of(@tr("Controls"));
        }

        MenuItem {
            x: 0;
            y: 96px;
            width: root.inner-width;
            nav: "menu.settings";
            text: Caps.of(@tr("Settings"));
        }

        MenuItem {
            x: 0;
            y: 144px;
            width: root.inner-width;
            nav: "menu.leave";
            text: Caps.of(@tr("Leave match"));
            danger: true;
        }
    }

    // What is bound to each of the battle's buttons, each to change as the Settings screen's controls change
    // (Enter on a box, then the key or the pad's button), and RESET CONTROLS beside Back. The match goes on under it
    // and plays by the bindings as they change.
    if PlayView.page == MatchPage.controls: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        Label {
            x: root.inner-width - 232px;
            y: 0;
            width: 110px;
            height: 20px;
            text: Caps.of(@tr("Key"));
        }

        Label {
            x: root.inner-width - 110px;
            y: 0;
            width: 110px;
            height: 20px;
            text: Caps.of(@tr("Pad"));
        }

        for action[i] in root.actions: Rectangle {
            x: 0;
            y: 24px + i * 44px;
            width: root.inner-width;
            height: 40px;
            Value {
                x: 0;
                width: parent.width - 244px;
                text: action;
            }

            BindBox {
                x: parent.width - 232px;
                width: 110px;
                nav: "menu.key";
                nav-index: i;
                value: SettingsView.keys[i];
                asking: SettingsView.asking-key == i;
                ask: @tr("Press a key");
            }

            BindBox {
                x: parent.width - 110px;
                width: 110px;
                nav: "menu.button";
                nav-index: i;
                value: SettingsView.buttons[i].text;
                face: SettingsView.buttons[i].face;
                asking: SettingsView.asking-button == i;
                ask: @tr("Press a button");
            }
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: Caps.of(@tr("Back"));
        }

        Button {
            x: root.inner-width - self.width;
            y: root.inner-height - 40px;
            nav: "menu.reset";
            text: Caps.of(@tr("Reset controls"));
        }
    }

    // The settings a player may want in a match, as the Settings screen has them: the language, the picture's size,
    // full screen, the battle graphics, the sound's two levels and their input delay. Each changes at once, the
    // match's picture and sound with it. On a phone each label is over its control.
    if PlayView.page == MatchPage.settings: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        property <length> pitch: Theme.phone ? 66px : 48px;
        // Where a row's control is, under its label on a phone.
        property <length> below: Theme.phone ? 20px : 0px;
        property <length> control-x: Theme.phone ? 0px : root.inner-width - 232px;
        property <length> control-width: Theme.phone ? root.inner-width : 232px;
        property <length> label-width: Theme.phone ? root.inner-width : root.inner-width - 244px;
        property <length> label-height: Theme.phone ? 20px : 44px;
        for label[i] in [@tr("Language"), @tr("Picture size"), @tr("Full screen"), @tr("Battle graphics"), @tr("Music"), @tr("Sound effects"), @tr("Input delay")]: Value {
            x: 0;
            y: i * parent.pitch;
            width: parent.label-width;
            height: parent.label-height;
            text: label;
        }

        Select {
            x: parent.control-x;
            y: parent.below + 2px;
            width: parent.control-width;
            nav: "menu.language";
            value: SettingsView.language;
        }

        Select {
            x: parent.control-x;
            y: parent.pitch + parent.below + 2px;
            width: parent.control-width;
            nav: "menu.picture";
            value: SettingsView.picture-size == "" ? SettingsView.largest : SettingsView.picture-size;
        }

        Seg {
            x: parent.control-x;
            y: 2 * parent.pitch + parent.below + 4px;
            nav: "menu.fullscreen";
            first: Caps.of(@tr("Off"));
            second: Caps.of(@tr("On"));
            chosen: SettingsView.full-screen ? 1 : 0;
        }

        Seg {
            x: parent.control-x;
            y: 3 * parent.pitch + parent.below + 4px;
            nav: "menu.graphics";
            first: Caps.of(@tr("Enhanced"));
            second: Caps.of(@tr("Original"));
            chosen: SettingsView.enhanced ? 0 : 1;
        }

        Slider {
            x: parent.control-x;
            y: 4 * parent.pitch + parent.below + 2px;
            width: parent.control-width;
            nav: "menu.music";
            value: PlayView.music;
        }

        Slider {
            x: parent.control-x;
            y: 5 * parent.pitch + parent.below + 2px;
            width: parent.control-width;
            nav: "menu.effects";
            value: PlayView.effects;
        }

        Stepper {
            x: Theme.phone ? 0px : root.inner-width - self.width;
            y: 6 * parent.pitch + parent.below + 4px;
            nav: "menu.delay";
            value: PlayView.input-delay;
            value-width: 48px;
            numeric: true;
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: Caps.of(@tr("Back"));
        }
    }
}

// The wheel and a drag over one of the builds over the match (`MatchPeek`): both scroll, by `PlayView.peek-y`.
component Scrub inherits TouchArea {
    property <length> held-at;
    scroll-event(e) => {
        PlayView.peek-y = clamp(PlayView.peek-y + e.delta-y, -PlayView.peek-span, 0px);
        return accept;
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            self.held-at = PlayView.peek-y;
        }
    }
    moved => {
        PlayView.peek-y = clamp(self.held-at + self.mouse-y - self.pressed-y, -PlayView.peek-span, 0px);
    }
}

// Both builds, over the match while Tab (Select on a pad) is held, and so over the match menu: the player's on their
// side, the other player's on theirs; where the setups aren't open, the player's own alone. Each is as tall as its
// abilities and bugs make it; where one is taller than its box (the window less the margins; on a phone half of it)
// they scroll together, by the wheel and a drag over them, and while the menu is open by the keys and the pad
// (`Play::scroll`). It takes no keys: the match goes on under it.
export component MatchPeek inherits Rectangle {
    property <length> sheet-width: min(430px, self.width - 2 * Theme.margin);
    // (Over the menu they leave its footer in view.)
    property <length> room: self.height - 2 * Theme.margin - (Shell.battle-menu ? Theme.footer : 0px);
    property <length> half: (root.room - Theme.margin) / 2;
    property <length> theirs-x: Theme.phone ? Theme.margin : self.width - Theme.margin - root.sheet-width;
    property <length> theirs-y: Theme.phone ? 2 * Theme.margin + root.half : Theme.margin;
    if PlayView.peek: Rectangle {
        property <length> mine-box: Theme.phone ? root.half : min(mine.sheet-height, root.room);
        property <length> theirs-box: Theme.phone ? root.half : min(theirs.sheet-height, root.room);
        property <length> mine-span: max(0px, mine.sheet-height - self.mine-box);
        property <length> theirs-span: PlayView.open-match ? max(0px, theirs.sheet-height - self.theirs-box) : 0px;
        property <length> span: max(self.mine-span, self.theirs-span);
        property <length> view: PlayView.open-match ? min(self.mine-box, self.theirs-box) : self.mine-box;
        init => {
            PlayView.peek-span = self.span;
            PlayView.peek-view = self.view;
        }
        changed span => {
            PlayView.peek-span = self.span;
            PlayView.peek-y = clamp(PlayView.peek-y, -self.span, 0px);
        }
        changed view => {
            PlayView.peek-view = self.view;
        }
        Rectangle {
            x: Theme.margin;
            y: Theme.margin;
            width: root.sheet-width;
            height: parent.mine-box;
            clip: true;
            mine := BuildOverview {
                x: 0;
                y: max(PlayView.peek-y, min(0px, parent.height - self.sheet-height));
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.mine;
                side: 1;
            }

            Scrub { }
        }

        Rectangle {
            x: root.theirs-x;
            y: root.theirs-y;
            width: root.sheet-width;
            height: parent.theirs-box;
            clip: true;
            visible: PlayView.open-match;
            theirs := BuildOverview {
                x: 0;
                y: max(PlayView.peek-y, min(0px, parent.height - self.sheet-height));
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.theirs;
                side: 2;
            }

            Scrub { }
        }

        // Where each is, as a thumb along its right edge.
        Rectangle {
            x: Theme.margin + root.sheet-width - 4px;
            y: Theme.margin + parent.mine-box * (-mine.y) / max(1px, mine.sheet-height);
            width: 4px;
            height: parent.mine-box * parent.mine-box / max(1px, mine.sheet-height);
            visible: parent.mine-span > 0.5px;
            background: Theme.line;
        }

        Rectangle {
            x: root.theirs-x + root.sheet-width - 4px;
            y: root.theirs-y + parent.theirs-box * (-theirs.y) / max(1px, theirs.sheet-height);
            width: 4px;
            height: parent.theirs-box * parent.theirs-box / max(1px, theirs.sheet-height);
            visible: parent.theirs-span > 0.5px && PlayView.open-match;
            background: Theme.line;
        }
    }
}

// How the match went (docs/design/app-ui.md §6, "After a match"; §2.49), over the picture once its set is over:
// the winner's half of the window floods with their side's color (the player's own, on the left, in player
// one's red; the other's in player two's blue), sweeping in from its outer edge; WIN or LOSE stamps in, centered
// on the player's own half; then the rounds' score and the match's time count up, one after another, each number
// in a box of one width. CONTINUE (Enter, the pad's A) settles it where it still moves, and then goes on to the
// lobby (the app's: `result.go`); it goes on by itself after a few seconds. With motion turned down it is there at
// once. On a phone the halves are the window's top (the player's) and bottom.
export component MatchResult inherits Rectangle {
    property <bool> won: PlayView.outcome == MatchOutcome.won;
    property <bool> lost: PlayView.outcome == MatchOutcome.lost;
    property <color> tone: root.won ? Theme.p1 : Theme.p2;
    property <length> half-width: Theme.phone ? self.width : self.width / 2;
    property <length> half-height: Theme.phone ? self.height / 2 : self.height;
    // The player's own half's middle: the word, and the numbers under it.
    property <length> mid-x: root.half-width / 2;
    property <length> mid-y: root.half-height / 2;
    property <length> stats-width: Theme.phone ? 300px : 360px;
    property <length> digits: Theme.phone ? 28px : 34px;
    // One after another, by the theme's table: the flood, the word, the score, then the time to the set piece's
    // end.
    flood := Tween {
        settled: PlayView.result-settled;
    }

    stamp := Tween {
        delay: Theme.quick;
        duration: Theme.brisk;
        settled: PlayView.result-settled;
    }

    // (It takes the clicks meant for the battle under it.)
    TouchArea { }

    // The picture under it, dimmed.
    Rectangle {
        background: Theme.ground-bottom.with-alpha(0.8);
    }

    // The winner's half, flooding in from its outer edge (the window's) toward the middle, a lit edge leading.
    Rectangle {
        x: Theme.phone || root.won ? 0px : root.half-width;
        y: !Theme.phone || root.won ? 0px : root.half-height;
        width: root.half-width;
        height: root.half-height;
        visible: root.won || root.lost;
        clip: true;
        Rectangle {
            property <float> way: root.won ? -1 : 1;
            x: Theme.phone ? 0px : (1 - flood.t) * root.half-width * self.way;
            y: !Theme.phone ? 0px : (1 - flood.t) * root.half-height * self.way;
            background: Theme.phone ? @linear-gradient(root.won ? 180deg : 0deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%) : @linear-gradient(root.won ? 90deg : 270deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%);
            Rectangle {
                x: Theme.phone || !root.won ? 0px : parent.width - 2px;
                y: !Theme.phone || !root.won ? 0px : parent.height - 2px;
                width: Theme.phone ? parent.width : 2px;
                height: Theme.phone ? 2px : parent.height;
                background: root.tone.brighter(0.4);
                drop-shadow-blur: 16px;
                drop-shadow-color: root.tone;
            }
        }
    }

    // WIN, LOSE or DRAW, stamped in on the player's own half.
    Text {
        property <bool> over: Theme.audit && self.preferred-width > self.width + 0.5px;
        x: Theme.margin;
        y: root.mid-y - (Theme.phone ? 100px : 140px);
        width: root.half-width - 2 * Theme.margin;
        height: Theme.phone ? 92px : 150px;
        text: root.won ? Caps.of(@tr("Win")) : root.lost ? Caps.of(@tr("Lose")) : Caps.of(@tr("Draw"));
        color: root.lost ? Theme.muted : Theme.text;
        font-family: Theme.display;
        font-size: Theme.phone ? 60px : 104px;
        font-weight: Theme.display-bold;
        letter-spacing: Theme.title-tracking * 2;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        opacity: stamp.linear;
        transform-scale: 1 + (1 - stamp.t) * 0.8;
        changed over => {
            if over {
                Audit.clipped(self.text);
            }
        }
    }

    // The rounds' score and the match's time, each label over its number.
    Rectangle {
        x: root.mid-x - root.stats-width / 2;
        y: root.mid-y + (Theme.phone ? 4px : 30px);
        width: root.stats-width;
        height: 64px;
        Label {
            x: 0;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: Caps.of(@tr("Rounds"));
            horizontal-alignment: center;
        }

        // (Each side's wins in a box of two digits, the dash between them where it is.)
        Count {
            x: parent.width / 4 - 16px - self.width;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-wins;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: right;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Text {
            x: parent.width / 4 - 16px;
            y: 22px;
            width: 32px;
            height: 40px;
            text: "–";
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: root.digits;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Count {
            x: parent.width / 4 + 16px;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-losses;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: left;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Label {
            x: parent.width / 2 + 8px;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: Caps.of(@tr("Time"));
            horizontal-alignment: center;
        }

        time := Count {
            x: parent.width / 2 + 8px;
            y: 22px;
            width: parent.width / 2 - 8px;
            height: 40px;
            value: PlayView.result-time;
            clock: true;
            from-zero: true;
            delay: 2 * Theme.quick + Theme.brisk;
            duration: Theme.set-piece - 2 * Theme.quick - Theme.brisk;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: center;
            ticked => {
                PlayView.result-ticks += 1;
            }
            changed done => {
                if self.done {
                    PlayView.result-done = true;
                }
            }
        }
    }

    Button {
        x: Theme.phone ? Theme.margin : root.mid-x - self.width / 2;
        y: root.height - (Theme.phone ? Theme.margin : 48px) - self.height;
        width: Theme.phone ? root.width - 2 * Theme.margin : max(200px, self.natural-width);
        nav: "result.go";
        text: Caps.of(@tr("Continue"));
        kind: ButtonKind.main;
    }

    // (Where it is there at once, its last number is too.)
    init => {
        if time.done {
            PlayView.result-done = true;
        }
    }
}

// ---- Over the screen -------------------------------------------------------------------------------------

// A new build's name and version. Its controls' names begin with `name.`. Under its buttons, below a line, is the
// other way to start one: FROM A SAVE FILE…, which opens the system's file dialog (the build is made of the save,
// named for its file). (A build is renamed in the editor, its header's name a field: docs/design/app-ui.md §2.74.)
component NameDialog inherits DialogFrame {
    // (Its name, its version and the version's note, each under its label, then the buttons.)
    property <length> version-y: 100px;
    property <length> note-y: root.version-y + Theme.control + 8px;
    property <length> buttons-y: root.note-y + 38px + 16px;
    title: Caps.of(@tr("title" => "New build"));
    content-height: root.buttons-y + 120px;
    Label {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: 14px;
        text: Caps.of(@tr("Name"));
    }

    Field {
        x: 0;
        y: 22px;
        width: root.inner-width;
        nav: "name.name";
        text: PlayView.dialog-name;
    }

    Label {
        x: 0;
        y: 78px;
        width: root.inner-width;
        height: 14px;
        text: Caps.of(@tr("Version"));
    }

    VersionChoice {
        x: 0;
        y: root.version-y;
        width: root.inner-width;
        versions: PlayView.versions;
        chosen: PlayView.dialog-version;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Note {
        x: 0;
        y: root.note-y;
        width: root.inner-width;
        height: 38px;
        text: @tr("{} They can be changed later in the editor.", PlayView.version-sets);
    }

    confirm := Button {
        x: root.inner-width - self.width;
        y: root.buttons-y;
        nav: "name.confirm";
        text: Caps.of(@tr("Create build"));
        kind: ButtonKind.main;
        enabled: PlayView.dialog-name != "";
    }

    Button {
        x: confirm.x - 12px - self.width;
        y: root.buttons-y;
        nav: "name.cancel";
        text: Caps.of(@tr("Cancel"));
        kind: ButtonKind.ghost;
    }

    Rule {
        x: 0;
        y: root.buttons-y + 64px;
        width: root.inner-width;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Button {
        x: 0;
        y: root.buttons-y + 80px;
        nav: "name.save";
        text: Caps.of(@tr("From a save file…"));
        kind: ButtonKind.ghost;
    }
}

// What opens over Play: a build's name, a direct connection's dialog, the code's boxes, and the lobby's list of
// builds to change to. It covers the whole window, over the screen and under the shell's own dialogs; empty, it
// takes no clicks.
export component PlayOverlay inherits Rectangle {
    if PlayView.dialog != BuildDialog.none: NameDialog {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }


    // A direct connection: host, with this machine's address to send; or join, by the host's address.
    if PlayView.direct: direct := DialogFrame {
        // (On a phone each button is under its box: an address needs the dialog's width.)
        property <length> under: Theme.phone ? 48px : 0px;
        title: @tr("Direct connection");
        content-height: 252px + 2 * self.under;
        Label {
            x: 0;
            y: 0;
            width: direct.inner-width;
            height: 14px;
            text: Caps.of(@tr("Host"));
        }

        // This machine's address: Enter copies it.
        Rectangle {
            x: 0;
            y: 22px;
            width: Theme.phone ? direct.inner-width : direct.inner-width - host.width - 8px;
            height: 40px;
            Rectangle {
                background: Theme.inset;
                border-width: 1px;
                border-color: copy.has-hover ? Theme.muted : Theme.line;
            }

            Mono {
                x: 12px;
                width: parent.width - 36px - word.width;
                text: PlayView.host-address;
            }

            word := Label {
                x: parent.width - 12px - self.width;
                width: self.preferred-width;
                text: Caps.of(@tr("Copy"));
            }

            Flash {
                seq: PlayView.copied-seq;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }

            copy := Focusable {
                nav: "direct.copy";
            }
        }

        host := Button {
            x: direct.inner-width - self.width;
            y: 22px + direct.under;
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.host";
            text: Caps.of(@tr("Host"));
            kind: ButtonKind.main;
        }

        // One line: what to do with the address, or why this machine can't host.
        Note {
            x: 0;
            y: 67px + direct.under;
            width: direct.inner-width;
            height: 20px;
            text: PlayView.host-message != "" ? PlayView.host-message : @tr("Send this address to your opponent.");
            color: PlayView.host-message != "" ? Theme.bad : Theme.muted;
            wrap: no-wrap;
            overflow: elide;
        }

        Rule {
            x: 0;
            y: 100px + direct.under;
            width: direct.inner-width;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 0;
            y: 114px + direct.under;
            width: direct.inner-width;
            height: 14px;
            text: Caps.of(@tr("Join"));
        }

        Field {
            x: 0;
            y: 136px + direct.under;
            width: Theme.phone ? direct.inner-width : direct.inner-width - connect.width - 8px;
            nav: "direct.address";
            text: PlayView.address;
            placeholder: @tr("address:port");
            error: PlayView.join-message != "" && !PlayView.join-quiet;
        }

        connect := Button {
            x: direct.inner-width - self.width;
            y: 136px + 2 * direct.under + (Theme.phone ? 18px : 0px);
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.connect";
            text: Caps.of(@tr("Connect"));
        }

        Message {
            x: 0;
            y: 180px + direct.under;
            width: direct.inner-width;
            text: PlayView.join-message;
            tone: PlayView.join-quiet ? Theme.muted : Theme.bad;
        }

        Button {
            x: direct.inner-width - self.width;
            y: 212px + 2 * direct.under;
            nav: "direct.cancel";
            text: Caps.of(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }

    // The code a box a character, for a pad: Up and Down change a box's character, Enter goes to the next.
    if PlayView.boxes: boxes := DialogFrame {
        property <length> box: Theme.phone ? 40px : 52px;
        property <length> gap: Theme.phone ? 4px : 8px;
        property <length> left: (self.inner-width - 6 * self.box - 5 * self.gap - 2 * self.gap) / 2;
        title: @tr("Invite code");
        panel-width: 460px;
        content-height: 128px;
        for i in 6: CodeBox {
            // (In threes, as the code is said.)
            x: boxes.left + i * (boxes.box + boxes.gap) + (i >= 3 ? 2 * boxes.gap : 0px);
            y: 0;
            width: boxes.box;
            nav: "boxes.\{i}";
            value: PlayView.box-characters[i];
            count: PlayView.code-set;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Button {
            x: cancel.x - self.width - 12px;
            y: 88px;
            nav: "boxes.join";
            text: Caps.of(@tr("Join"));
            kind: ButtonKind.main;
        }

        cancel := Button {
            x: boxes.inner-width - self.width;
            y: 88px;
            nav: "boxes.cancel";
            text: Caps.of(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }

    // Another build for the lobby: the player's builds of the game.
    if PlayView.changing: change := DialogFrame {
        title: @tr("Change build");
        panel-width: 460px;
        content-height: 322px;
        list := ListView {
            x: 0;
            y: 0;
            width: change.inner-width;
            height: 268px;
            nav: "change.builds";
            count: PlayView.builds.length;
            row-height: 52px;
            chosen: PlayView.chosen;
            for slot in list.shown: BuildRow {
                property <int> at: list.first + slot;
                x: 0;
                y: self.at * list.pitch;
                width: list.row-width;
                height: list.row-height;
                build: PlayView.builds[self.at];
                nav: list.nav;
                nav-index: self.at;
            }
        }

        Button {
            x: change.inner-width - self.width;
            y: 282px;
            nav: "change.cancel";
            text: Caps.of(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }
}
