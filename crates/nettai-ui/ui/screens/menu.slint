// The main menu (docs/design/app-ui.md §6): PLAY, PRACTICE and REPLAYS, each the word alone; below a line,
// Settings, About and Exit, smaller; beside them the demo reel, a battle of the selected game playing itself in a
// box that keeps its size. On a phone the reel is above the items.

import { Theme } from "../theme.slint";
import { Nav, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, Picture } from "../shell.slint";
import { MenuItem, Value, Rule } from "../widgets.slint";
import { Arrive, Tween } from "../motion.slint";

// What the main menu shows: src/screens/menu.rs sets these.
export global MenuView {
    // The reel is playing a battle (its DEMO mark shows).
    in property <bool> playing;
    // It counts the reel's battles: each fades in.
    in property <int> reel-seq;
}

// Settings, About and Exit: less than the three above them.
component MinorItem inherits Rectangle {
    in property <string> text;
    in property <string> nav;
    height: 32px;
    width: label.preferred-width + 16px;
    label := Text {
        text: root.text;
        color: (Nav.shown ? hit.focused : hit.has-hover) ? Theme.text : Theme.muted;
        font-family: Theme.body;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    hit := Focusable {
        nav: root.nav;
    }
}

export component MenuScreen inherits Page {
    // (The items' column and the reel are each centered in the body's height.)
    property <length> column: Theme.phone ? self.body-width : 416px;
    property <length> reel-width: Theme.phone ? self.body-width : 720px;
    property <length> reel-height: self.reel-width * 2 / 3;
    property <length> item: Theme.phone ? 68px : 72px;
    // The three words, 8 apart, and under them the line (16 below) and the smaller items (35 below, 32 tall), all
    // centered together.
    property <length> items-height: 3 * self.item + 2 * 8px;
    property <length> items-top: Theme.phone ? self.reel-height + 12px : (self.body-height - self.items-height - 61px) / 2;
    property <length> reel-top: Theme.phone ? 0px : (self.body-height - self.reel-height) / 2;
    logo: true;
    hints: [
        { key: "↑↓", pad: PadButton.move, text: @tr("Select") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Open") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
    // (The parts assemble in turn as the menu arrives: the three words, what is under them, the reel.)
    Arrive {
        order: 0;
        MenuItem {
            x: 0;
            y: root.items-top;
            width: root.column;
            nav: "play";
            text: @tr("PLAY");
            big: true;
        }
    }

    Arrive {
        order: 1;
        MenuItem {
            x: 0;
            y: root.items-top + root.item + 8px;
            width: root.column;
            nav: "practice";
            text: @tr("PRACTICE");
            big: true;
        }
    }

    Arrive {
        order: 2;
        MenuItem {
            x: 0;
            y: root.items-top + 2 * (root.item + 8px);
            width: root.column;
            nav: "replays";
            text: @tr("REPLAYS");
            big: true;
        }
    }

    Arrive {
        order: 3;
        Rule {
            x: 0;
            y: root.items-top + root.items-height + 16px;
            width: root.column;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        settings := MinorItem {
            x: Theme.phone ? 8px : 16px;
            y: root.items-top + root.items-height + 35px;
            nav: "settings";
            text: @tr("Settings");
        }

        about := MinorItem {
            x: settings.x + settings.width + 16px;
            y: settings.y;
            nav: "about";
            text: @tr("About");
        }

        MinorItem {
            x: about.x + about.width + 16px;
            y: settings.y;
            nav: "exit";
            text: @tr("Exit");
        }
    }

    // The reel. (`parent` here is the screen's root, where this is written; the page's body is where it is put.)
    // Each battle of the reel fades in.
    fade := Tween {
        seq: MenuView.reel-seq;
        duration: Theme.settle;
    }

    Arrive {
        order: 2;
        from-x: 24px;
        Rectangle {
            opacity: fade.t;
            Picture {
                x: root.body-width - root.reel-width;
                y: root.reel-top;
                width: root.reel-width;
                height: root.reel-height;
                ground: Theme.inset;
            }
        }

        Rectangle {
            x: root.body-width - root.reel-width + 12px;
            y: root.reel-top + root.reel-height - 12px - self.height;
            width: demo.preferred-width + 16px;
            height: 22px;
            visible: MenuView.playing;
            background: Theme.shade;
            demo := Text {
                text: @tr("DEMO");
                color: Theme.text;
                font-family: Theme.display;
                font-size: 11px;
                font-weight: Theme.display-bold;
                letter-spacing: Theme.label-tracking;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
