// Loading (docs/design/app-ui.md §6): the logo and one bar while the selected game loads, as the app starts and
// whenever the player steps to a game that isn't ready yet; before that, while its pack is extracted from the
// Legacy Collection, the bar is the extraction's. The bar has one width and the percentage fixed-width digits, so
// nothing moves as it fills.

import { Theme } from "../theme.slint";
import { Shell, Errors, ErrorKind } from "../shell.slint";
import { Label, Mono, Bar, Note, Button, ButtonKind } from "../widgets.slint";
import { Tween } from "../motion.slint";

export component LoadingScreen inherits Rectangle {
    property <length> column: min(480px, self.width - 2 * Theme.margin);
    property <length> top: (self.height - 158px) / 2;
    // No game, and the Legacy Collection not found: its error's line, and the way to its folder.
    property <bool> wants-folder: Shell.no-games && Shell.extracts;
    // The logo settles into place as the app starts.
    arrive := Tween {
        duration: Theme.set-piece;
    }

    Text {
        y: root.top + (1 - arrive.t) * 10px;
        height: 90px;
        opacity: arrive.t;
        text: "nettai";
        color: Theme.text;
        font-family: "Chakra Petch";
        font-size: Theme.phone ? 56px : 72px;
        font-weight: 700;
        letter-spacing: 2.9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Bar {
        y: root.top + 122px;
        width: root.column;
        visible: !Shell.no-games;
        value: Shell.loading-progress;
    }

    Label {
        x: (parent.width - root.column) / 2;
        y: root.top + 142px;
        width: root.column - 56px;
        height: 16px;
        visible: !Shell.no-games;
        text: Shell.extracting ? @tr("EXTRACTING {}", Shell.game) : @tr("LOADING {}", Shell.game);
    }

    Mono {
        x: (parent.width + root.column) / 2 - 48px;
        y: root.top + 142px;
        width: 48px;
        height: 16px;
        visible: !Shell.no-games;
        text: "\{round(Shell.loading-progress * 100)}%";
        horizontal-alignment: right;
    }

    // No game has a pack: what to do about it. With the app's own packs, the Legacy Collection is what is missing
    // (the error's own line: three lines on a phone in Japanese, down to the button's top less 4). Else the packs
    // folder named (`$NETTAI_PACKS`), which starts a line of its own and breaks where it must.
    Note {
        y: root.top + 116px;
        width: root.column;
        height: root.wants-folder ? 64px : 88px;
        vertical-alignment: TextVerticalAlignment.top;
        wrap: root.wants-folder ? word-wrap : char-wrap;
        visible: Shell.no-games;
        text: root.wants-folder ? Errors.line(ErrorKind.no-legacy-collection, "") : @tr("No game data was found. Put a game's pack in {}.", "\n" + Shell.packs-folder);
        horizontal-alignment: center;
    }

    Button {
        x: (parent.width - self.width) / 2;
        y: root.top + 184px;
        visible: root.wants-folder;
        enabled: root.wants-folder;
        nav: "source.choose";
        kind: ButtonKind.main;
        text: Errors.choose-folder();
    }
}
