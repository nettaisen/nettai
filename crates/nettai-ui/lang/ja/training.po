# Japanese: Training (ui/screens/training.slint).
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

# ---- The entry ----

msgid "Your build"
msgstr "あなたのビルド"

msgid "Dummy's build"
msgstr "ダミーのビルド"

msgid "Set up the dummy from the menu once you're in."
msgstr "ダミーの設定は、開始後にメニューからできます。"

msgid "START TRAINING"
msgstr "トレーニング開始"

msgid "CREATE A BUILD"
msgstr "ビルドを作る"

msgid "ARENA PREVIEW"
msgstr "アリーナ プレビュー"

msgid "Change"
msgstr "変更"

msgid "Open list"
msgstr "一覧を開く"

# Why training can't start: the reserved line. {} is the rule the build breaks.
msgid "Your build can't be used."
msgstr "あなたのビルドは使えません。"

msgid "The dummy's build can't be used."
msgstr "ダミーのビルドは使えません。"

msgid "Your build can't be used: {}."
msgstr "あなたのビルドは使えません: {}。"

msgid "The dummy's build can't be used: {}."
msgstr "ダミーのビルドは使えません: {}。"

# ---- Before the battle, and in it ----

msgid "YOU"
msgstr "あなた"

msgid "DUMMY"
msgstr "ダミー"

# Beside MENU on a phone: {} is the round's number.
msgid "Training · Round {}"
msgstr "トレーニング · ラウンド{}"

# ---- The training menu ----

# Under the menu's title: the two builds' names.
msgid "{} vs {}"
msgstr "{} vs {}"

msgid "BATTLE"
msgstr "バトル"

msgid "DISPLAY"
msgstr "表示"

msgid "Action"
msgstr "行動"

msgid "Stands still"
msgstr "動かない"

msgid "Moves around"
msgstr "動き回る"

msgid "Attacks at random"
msgstr "ランダムに攻撃"

msgid "Plays your recording"
msgstr "記録を再生"

# The dummy is played on a second connected gamepad.
msgid "A second pad"
msgstr "2つ目のパッド"

msgid "Custom screen"
msgstr "カスタム画面"

msgid "Picks no chips"
msgstr "チップを選ばない"

msgid "Picks the first it can"
msgstr "最初のチップを選ぶ"

# The dummy's recording: none, or how long it is ({} is its seconds, to a tenth). Choosing the row records one.
msgid "Recording"
msgstr "記録"

msgid "None"
msgstr "なし"

msgid "{} s"
msgstr "{}秒"

# Over the battle while the player drives the dummy to record it.
msgid "RECORDING"
msgstr "記録中"

# Battle: a side's HP stays as it goes, or comes back full once a hit is over.
msgid "Your HP"
msgstr "あなたのHP"

msgid "Dummy's HP"
msgstr "ダミーのHP"

msgid "Normal"
msgstr "通常"

msgid "Refills"
msgstr "回復する"

msgid "Custom gauge"
msgstr "カスタムゲージ"

msgid "Always full"
msgstr "常に満タン"

# The order the custom screen deals the folder in: shuffled, or from the folder's top.
msgid "Chip draw"
msgstr "チップの配り方"

msgid "Shuffled"
msgstr "シャッフル"

msgid "Folder order"
msgstr "フォルダ順"

msgid "Input display"
msgstr "入力表示"

msgid "Off"
msgstr "オフ"

msgid "On"
msgstr "オン"

msgid "RESUME"
msgstr "再開"

msgid "RESTART"
msgstr "最初から"

msgid "CHANGE BUILDS"
msgstr "ビルドを変える"

msgid "QUIT TO MENU"
msgstr "メニューにもどる"
