# ---- The practice menu's rows ----

# The DUMMY group's: the dummy's build, one of the game's builds.
msgid "Dummy's build"
msgstr "ダミーの構築"

# The STAGE group's: where each round is fought. Their choices are the content's arenas and backgrounds, after
# Random (each round's picked from the seed).
msgid "Arena"
msgstr "アリーナ"

msgid "Background"
msgstr "背景"

msgid "Random"
msgstr "ランダム"

# ---- Before the battle, and in it ----

msgid "Dummy"
msgstr "ダミー"

# Beside MENU on a phone: {} is the round's number.
msgid "Practice · Round {}"
msgstr "練習 · ラウンド{}"

# ---- The practice menu ----

# Under the menu's title: the two builds' names.
msgid "{} vs {}"
msgstr "{} vs {}"

# The menu's groups: where the battle is fought (the arena, the background, the music), and the battle's options.
msgid "Stage"
msgstr "ステージ"

msgid "Options"
msgstr "オプション"

msgid "Action"
msgstr "行動"

msgid "Stands still"
msgstr "動かない"

msgid "Moves around"
msgstr "動き回る"

# The dummy fights as a player would, as well as its Level lets it.
msgid "Fights"
msgstr "戦う"

# The dummy is played on a second connected gamepad.
msgid "A second pad"
msgstr "2つ目のパッド"

# How well the dummy fights: a row under the Action while it is Fights.
msgid "Level"
msgstr "強さ"

msgctxt "level"
msgid "Easy"
msgstr "よわい"

msgctxt "level"
msgid "Normal"
msgstr "ふつう"

msgctxt "level"
msgid "Hard"
msgstr "つよい"

# Battle: a side's HP stays as it goes, or comes back full once a hit is over.
msgid "Your HP"
msgstr "あなたのHP"

msgid "Dummy's HP"
msgstr "ダミーのHP"

msgid "Normal"
msgstr "通常"

msgid "Refills"
msgstr "回復する"

# Battle: each side's navi held in one of the game's emotions (their words the content's), or as the game goes
# (Normal, the HP rows' word).
msgid "Your emotion"
msgstr "あなたの感情"

msgid "Dummy's emotion"
msgstr "ダミーの感情"

msgid "Custom gauge"
msgstr "カスタムゲージ"

msgid "Always full"
msgstr "常に満タン"

# The order the custom screen deals the folder in: shuffled, or from the folder's top.
msgid "Chip draw"
msgstr "チップの配り方"

msgid "Shuffled"
msgstr "シャッフル"

msgid "Folder order"
msgstr "フォルダ順"

msgid "Input display"
msgstr "入力表示"

msgid "Off"
msgstr "オフ"

msgid "On"
msgstr "オン"

msgid "Resume"
msgstr "再開"

msgid "Restart"
msgstr "最初から"

# Ends the session: back to Practice's entry.
msgid "Exit"
msgstr "終了"

# ---- Over the battle ----

# In a corner over the battle, beside a count of chips ("34/58"): the dummy that fights is getting ready, its
# chips being looked at before it can play (a few seconds, the first time a folder's chips are met).
msgid "Getting ready"
msgstr "準備中"
