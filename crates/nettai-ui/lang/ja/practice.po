msgstr "アリーナ プレビュー"

msgid "Change"
msgstr "変更"

msgid "Open list"
msgstr "一覧を開く"

# Why training can't start: the reserved line. {} is the rule the build breaks.
msgid "Your build can't be used."
msgstr "あなたのビルドは使えません。"

