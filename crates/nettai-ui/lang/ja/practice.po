msgstr "ダミーのビルドは使えません: {}。"

# ---- Before the battle, and in it ----

msgid "YOU"
msgstr "あなた"

msgid "DUMMY"
msgstr "ダミー"

# Beside MENU on a phone: {} is the round's number.
msgid "Training · Round {}"
msgstr "トレーニング · ラウンド{}"

