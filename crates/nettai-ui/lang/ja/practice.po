# ---- The entry ----

msgid "Your build"
msgstr "あなたの構築"

msgid "Dummy's build"
msgstr "ダミーの構築"

# The entry's rows (and the menu's Battle rows): where each round is fought. Their choices are the content's
# arenas and backgrounds, after Random (each round's picked from the seed).
msgid "Arena"
msgstr "アリーナ"

msgid "Background"
msgstr "背景"

msgid "Random"
msgstr "ランダム"

msgid "Set up the dummy from the menu once you're in."
msgstr "ダミーの設定は、開始後にメニューからできます。"

msgid "START PRACTICE"
msgstr "練習開始"

msgid "CREATE A BUILD"
msgstr "構築を作る"

msgid "ARENA PREVIEW"
msgstr "アリーナ プレビュー"

msgid "Change"
msgstr "変更"

msgid "Open list"
msgstr "一覧を開く"

# A hint: the build opened in Builds' editor (the dummy's, where the focus is on its row or its EDIT).
msgid "Edit build"
msgstr "構築を編集"

# Why practice can't start: the reserved line. {} is the rule the build breaks.
msgid "Your build can't be used."
msgstr "あなたの構築は使えません。"

msgid "The dummy's build can't be used."
msgstr "ダミーの構築は使えません。"

msgid "Your build can't be used: {}."
msgstr "あなたの構築は使えません: {}。"

msgid "The dummy's build can't be used: {}."
msgstr "ダミーの構築は使えません: {}。"

# ---- Before the battle, and in it ----

msgid "YOU"
msgstr "あなた"

msgid "DUMMY"
msgstr "ダミー"

# Beside MENU on a phone: {} is the round's number.
msgid "Practice · Round {}"
msgstr "練習 · ラウンド{}"

# ---- The practice menu ----

# Under the menu's title: the two builds' names.
msgid "{} vs {}"
msgstr "{} vs {}"

msgid "BATTLE"
msgstr "バトル"

msgid "DISPLAY"
msgstr "表示"

msgid "Action"
msgstr "行動"

msgid "Stands still"
msgstr "動かない"

msgid "Moves around"
msgstr "動き回る"

# The dummy fights as a player would, as well as its Level lets it.
msgid "Fights"
msgstr "戦う"

# The dummy is played on a second connected gamepad.
msgid "A second pad"
msgstr "2つ目のパッド"

# How well the dummy fights: a row under the Action while it is Fights.
msgid "Level"
msgstr "強さ"

msgctxt "level"
msgid "Easy"
msgstr "よわい"

msgctxt "level"
msgid "Normal"
msgstr "ふつう"

msgctxt "level"
msgid "Hard"
msgstr "つよい"

# Battle: a side's HP stays as it goes, or comes back full once a hit is over.
msgid "Your HP"
msgstr "あなたのHP"

msgid "Dummy's HP"
msgstr "ダミーのHP"

msgid "Normal"
msgstr "通常"

msgid "Refills"
msgstr "回復する"

msgid "Custom gauge"
msgstr "カスタムゲージ"

msgid "Always full"
msgstr "常に満タン"

# The order the custom screen deals the folder in: shuffled, or from the folder's top.
msgid "Chip draw"
msgstr "チップの配り方"

msgid "Shuffled"
msgstr "シャッフル"

msgid "Folder order"
msgstr "フォルダ順"

msgid "Input display"
msgstr "入力表示"

msgid "Off"
msgstr "オフ"

msgid "On"
msgstr "オン"

msgid "RESUME"
msgstr "再開"

msgid "RESTART"
msgstr "最初から"

msgid "CHANGE BUILDS"
msgstr "構築を変える"

msgid "QUIT TO MENU"
msgstr "メニューにもどる"
