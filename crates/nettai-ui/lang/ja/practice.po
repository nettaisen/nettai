msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"

# ---- The practice menu's rows ----

# The DUMMY group's: the dummy's build, one of the game's builds.
msgid "Dummy's build"
msgstr "ダミーの構築"

# The STAGE group's: where each round is fought. Their choices are the content's arenas and backgrounds, after
# Random (each round's picked from the seed).
msgid "Arena"
msgstr "アリーナ"

msgid "Background"
msgstr "背景"

msgid "Random"
msgstr "ランダム"

# ---- Before the battle, and in it ----

msgid "Dummy"
msgstr "ダミー"

# Beside MENU on a phone: {} is the round's number.
msgid "Practice · Round {}"
msgstr "練習 · ラウンド{}"

# ---- The practice menu ----

# Under the menu's title: the two builds' names.
msgid "{} vs {}"
msgstr "{} vs {}"

# The menu's groups: where the battle is fought (the arena, the background, the music), and the battle's options.
msgid "Stage"
msgstr "ステージ"

msgid "Options"
msgstr "オプション"

msgid "Action"
msgstr "行動"

msgid "Stands still"
msgstr "動かない"

msgid "Moves around"
msgstr "動き回る"

# The dummy is played on a second connected gamepad.
msgid "A second pad"
msgstr "2つ目のパッド"

# Battle: a side's HP stays as it goes, or comes back full once a hit is over.
msgid "Your HP"
msgstr "あなたのHP"

msgid "Dummy's HP"
msgstr "ダミーのHP"

msgid "Normal"
msgstr "通常"

msgid "Refills"
msgstr "回復する"

msgid "Custom gauge"
msgstr "カスタムゲージ"

msgid "Always full"
msgstr "常に満タン"

# The order the custom screen deals the folder in: shuffled, or from the folder's top.
msgid "Chip draw"
msgstr "チップの配り方"

msgid "Shuffled"
msgstr "シャッフル"

msgid "Folder order"
msgstr "フォルダ順"

msgid "Input display"
msgstr "入力表示"

msgid "Off"
msgstr "オフ"

msgid "On"
msgstr "オン"

msgid "Resume"
msgstr "再開"

msgid "Restart"
msgstr "最初から"

# Ends the session: back to Practice's entry.
msgid "Exit"
msgstr "終了"
