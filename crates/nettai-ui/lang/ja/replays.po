msgid "Search by opponent"
msgstr "対戦相手で検索"

# A row's opponent.
msgid "vs {}"
msgstr "vs {}"

# The footer: how many replays the game has. (Both forms are given: the catalogs are merged under one header.)
msgid "{n} replay"
msgid_plural "{n} replays"
msgstr[0] "リプレイ {n} 件"
msgstr[1] "リプレイ {n} 件"

msgid "No replays yet. Every online match is recorded."
msgstr "リプレイはまだありません。オンライン対戦はすべて記録されます。"

msgid "No replays found."
msgstr "リプレイが見つかりません。"

msgid "Watch"
msgstr "再生"

msgid "Export"
msgstr "書き出し"

msgid "Delete"
msgstr "削除"

# ---- The selected replay ----

msgid "Played"
msgstr "対戦日時"

msgid "Result"
msgstr "結果"

msgid "Length"
msgstr "長さ"

msgctxt "verb"
msgid "Export video"
msgstr "動画を書き出す"

msgid "Show file"
msgstr "ファイルを表示"

msgid "Delete replay?"
msgstr "リプレイを削除しますか?"

# ---- The play queue: replays lined up to be watched one after another, each leaving it once watched (its tab,
# WATCH's arrow and a replay's menu, an entry's) ----

msgid "Queue"
msgstr "再生キュー"

msgid "Add to queue"
msgstr "再生キューに追加"

# Put a replay at the queue's start: what plays next.
msgid "Play next"
msgstr "次に再生"

msgid "Watch from here"
msgstr "ここから再生"

msgid "Move up"
msgstr "上へ移動"

msgid "Move down"
msgstr "下へ移動"

msgid "Clear the queue?"
msgstr "再生キューをクリアしますか?"

# A queue entry whose file is gone: its file's name.
msgid "Missing: {}"
msgstr "見つかりません: {}"

# Watch: WATCH's own word (再生); the arrow beside it opens Add to queue and Play next.
msgid "The queue is empty. Add replays to it with the arrow beside Watch."
msgstr "再生キューは空です。「再生」の横の矢印から追加できます。"

# The players of a replay, the one whose console is shown first.
msgid "{} vs {}"
msgstr "{} vs {}"

# A player a replay has no name for: the first, the second.
msgid "P1"
msgstr "1P"

msgid "P2"
msgstr "2P"

