# ---- The viewer ----

msgid "Replay"
msgstr "リプレイ"

msgid "Round {} of {}"
msgstr "ラウンド {}/{}"

msgid "View"
msgstr "視点"

msgid "Play or pause"
msgstr "再生/一時停止"

msgid "Step a frame"
msgstr "コマ送り"

msgid "Previous or next round"
msgstr "前/次のラウンド"

# The viewer's footer: how many rounds the replay has.
msgid "{n} round"
msgid_plural "{n} rounds"
msgstr[0] "{n} ラウンド"
msgstr[1] "{n} ラウンド"

# The transport's ⋯ menu: the side whose console is shown (P1, P2), both builds (Builds), the input display (Input
# display, Practice's), the other side's console small in the picture's corner, the speeds and Export video.
msgid "Other side's picture"
msgstr "相手側の画面"

# The viewer's play queue (the replays lined up in the Queue tab, watched one after another): its popup of the
# entries still to watch after the one watched, with NEXT (Next, 次へ: skip to the next replay) and whether the next
# one starts by itself at the end of one (the words by its switch) at its top, and what is said when there are none.
msgid "Autoplay next"
msgstr "次を自動再生"

msgid "Up next"
msgstr "このあと再生"

msgid "Nothing else is in the queue."
msgstr "再生キューに次のリプレイはありません。"

# ---- The export ----

msgid "Export video"
msgstr "動画の書き出し"

msgid "Size"
msgstr "サイズ"

# The part of the replay exported: the whole match, a round, or the player's own (Custom), from its Start to its
# End, each typed as minutes and seconds or taken from where the viewer is (Now: the playback position).
msgid "Range"
msgstr "範囲"

msgctxt "range"
msgid "Start"
msgstr "開始"

msgctxt "range"
msgid "End"
msgstr "終了"

msgctxt "range"
msgid "Now"
msgstr "現在位置"

# What is wrong with the Start or the End: not a time (m:ss is minutes and seconds); the start not before the end;
# past the replay's end ({}: its length).
msgid "Type a time as m:ss."
msgstr "時間は「分:秒」の形で入力してください。"

msgid "The start must be before the end."
msgstr "開始は終了より前にしてください。"

msgid "The replay ends at {}."
msgstr "リプレイは {} で終わります。"

# The consoles a video shows: the view's alone, or both side by side (the view's at the left, heard).
msgid "Sides"
msgstr "画面"

msgctxt "sides"
msgid "One"
msgstr "片方"

msgctxt "sides"
msgid "Both"
msgstr "両方"

msgid "Save as"
msgstr "保存先"

msgid "Whole match · {}"
msgstr "試合全体 · {}"

msgid "Round {} · {}"
msgstr "ラウンド {} · {}"

msgid "Custom · {}"
msgstr "指定範囲 · {}"

# A round's chapter in an exported video.
msgid "Round {}"
msgstr "ラウンド {}"

msgid "Exporting round {} of {} · {}%"
msgstr "書き出し中 ラウンド {}/{} · {}%"

msgid "Saved."
msgstr "保存しました。"

msgid "Export canceled."
msgstr "書き出しを中止しました。"

msgctxt "verb"
msgid "Export"
msgstr "書き出す"

msgid "Close"
msgstr "閉じる"

