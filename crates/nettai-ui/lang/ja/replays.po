msgstr "{0}{1}日"

msgctxt "date"
msgid "{0} {1}, {2}"
msgstr "{2}年{0}{1}日"

# ---- How a set went: a row's letter with the rounds won and lost, and the same in words ----

msgctxt "score"
msgid "W {}–{}"
msgstr "勝 {}–{}"

msgctxt "score"
msgid "L {}–{}"
msgstr "敗 {}–{}"

