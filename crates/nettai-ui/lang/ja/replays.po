msgid "Jan"
msgstr "1月"

msgid "Feb"
msgstr "2月"

msgid "Mar"
msgstr "3月"

msgid "Apr"
msgstr "4月"

msgid "May"
msgstr "5月"

msgid "Jun"
msgstr "6月"

