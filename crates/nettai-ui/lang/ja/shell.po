# ---- An update of the app: the question at the main menu, and the footer's lines while it downloads ----

msgid "nettai {} is out"
msgstr "nettai {} が公開されました"

msgid "Update now? It downloads while you play, and nettai restarts into it at the main menu."
msgstr "今すぐ更新しますか? プレイ中にダウンロードし、メインメニューで nettai が再起動して更新されます。"

msgid "Later"
msgstr "あとで"

msgid "Update"
msgstr "更新"

msgid "Downloading the update… {}%"
msgstr "更新をダウンロード中… {}%"

msgid "Update ready: nettai restarts into it at the main menu."
msgstr "更新の準備ができました。メインメニューで nettai が再起動します。"

msgid "The update couldn't be downloaded. It's tried again next start."
msgstr "更新をダウンロードできませんでした。次回の起動時にもう一度試します。"
