# ---- Loading ----

msgid "Loading {}"
msgstr "{} を読み込み中"
# A game's pack being extracted from the Legacy Collection: {} is the game, as the header shows it.
msgid "Extracting {}"
msgstr "{} を抽出中"

msgid "Loading"
msgstr "読み込み中"

msgid "No game data was found. Put a game's pack in {}."
msgstr "ゲームデータが見つかりません。{} にゲームのパックを置いてください。"

msgid "VS"
msgstr "VS"

# ---- The battle ----

msgid "Reconnecting {} s"
msgstr "再接続中 {} 秒"

msgid "{} ms"
msgstr "{} ms"

# The link panel the connection's corner opens. The figures in frames (the input delay, a rollback's depth,
# the skew, the lead) are bare numbers.
msgid "Connection"
msgstr "接続状況"

msgid "Round trip"
msgstr "往復時間"

msgid "Jitter"
msgstr "ゆらぎ"

# The share of the other player's packets lost: {} is the number, to a tenth.
msgid "Loss"
msgstr "ロス率"

msgid "{}%"
msgstr "{}%"

msgid "Reconnects"
msgstr "再接続"

# Clock sync's skew: how far this player runs ahead of the other (+) or behind (-), in frames.
msgid "Skew"
msgstr "ずれ"

# This player's inputs the other's haven't matched yet, in frames.
msgid "Lead"
msgstr "先行"

msgid "Rollbacks"
msgstr "巻き戻し回数"

msgid "Last rollback"
msgstr "直近の巻き戻し"

# The deepest rollback of the match, in frames.
msgid "Deepest"
msgstr "最大の巻き戻し"

msgid "Frames waited"
msgstr "待機フレーム"

msgid "Sent"
msgstr "送信"

msgid "Received"
msgstr "受信"

msgid "{} packets · {} KB"
msgstr "{} パケット · {} KB"

