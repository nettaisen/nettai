# Japanese: what every screen shares (the header, the footer, the dialogs, the errors), the loading screens,
# the main menu and the battle's own. A screen's strings are in the file of its name.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ja\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# The language's own name, as Settings lists it.
msgctxt "language"
msgid "English"
msgstr "日本語"

# ---- The main menu ----

msgid "Play"
msgstr "対戦"

msgid "Practice"
msgstr "練習"

msgid "Replays"
msgstr "リプレイ"

msgid "Demo"
msgstr "デモ"

msgid "vs"
msgstr "vs"

# ---- The header and the key hints ----

msgid "Menu"
msgstr "メニュー"

msgid "Select"
msgstr "選択"

msgid "Open"
msgstr "決定"

msgid "Back"
msgstr "もどる"

# A text field's own hints, while it is typed in: Enter finishes it, Esc leaves it as it was.
msgid "Done"
msgstr "確定"

# A setting taken (Enter on it): Left and Right change it.
msgid "Change"
msgstr "変更"

msgid "Cancel"
msgstr "キャンセル"

msgid "Change game"
msgstr "ゲーム切り替え"

# ---- Loading ----

msgid "Loading {}"
msgstr "{} を読み込み中"
# A game's content being downloaded (the app has none of it yet): {} is the game, as the header shows it.
msgid "Downloading {}"
msgstr "{} をダウンロード中"

msgid "Loading"
msgstr "読み込み中"

msgid "VS"
msgstr "VS"

# ---- The battle ----

msgid "Reconnecting {} s"
msgstr "再接続中 {} 秒"

msgid "{} ms"
msgstr "{} ms"

# The link panel the connection's corner opens. The figures in frames (the input delay, a rollback's depth,
# the skew, the lead) are bare numbers.
msgid "Connection"
msgstr "接続状況"

msgid "Round trip"
msgstr "往復時間"

msgid "Jitter"
msgstr "ゆらぎ"

# The share of the other player's packets lost: {} is the number, to a tenth.
msgid "Loss"
msgstr "ロス率"

msgid "{}%"
msgstr "{}%"

msgid "Reconnects"
msgstr "再接続"

# Clock sync's skew: how far this player runs ahead of the other (+) or behind (-), in frames.
msgid "Skew"
msgstr "ずれ"

# This player's inputs the other's haven't matched yet, in frames.
msgid "Lead"
msgstr "先行"

msgid "Rollbacks"
msgstr "巻き戻し回数"

msgid "Last rollback"
msgstr "直近の巻き戻し"

# The deepest rollback of the match, in frames.
msgid "Deepest"
msgstr "最大の巻き戻し"

msgid "Frames waited"
msgstr "待機フレーム"

msgid "Sent"
msgstr "送信"

msgid "Received"
msgstr "受信"

msgid "{} packets · {} KB"
msgstr "{} パケット · {} KB"

