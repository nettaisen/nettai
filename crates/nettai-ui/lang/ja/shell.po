msgstr "メニュー"

msgid "Select"
msgstr "選択"

msgid "Open"
msgstr "決定"

msgid "Back"
msgstr "もどる"

# A text field's own hints, while it is typed in: Enter finishes it, Esc leaves it as it was.
msgid "Done"
msgstr "確定"

