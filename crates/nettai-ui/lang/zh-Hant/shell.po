# Traditional Chinese: what every screen shares (the header, the footer, the dialogs, the errors), the loading screens,
# the main menu and the battle's own. A screen's strings are in the file of its name.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh-Hant\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# The language's own name, as Settings lists it.
msgctxt "language"
msgid "English"
msgstr "繁體中文"

# ---- The main menu ----

msgid "Play"
msgstr "對戰"

msgid "Practice"
msgstr "練習"

msgid "Replays"
msgstr "重播"

msgid "Demo"
msgstr "示範"

msgid "vs"
msgstr "vs"

# ---- The header and the key hints ----

msgid "Menu"
msgstr "選單"

msgid "Select"
msgstr "選擇"

msgid "Open"
msgstr "開啟"

msgid "Back"
msgstr "返回"

# A text field's own hints, while it is typed in: Enter finishes it, Esc leaves it as it was.
msgid "Done"
msgstr "完成"

# A setting taken (Enter on it): Left and Right change it.
msgid "Change"
msgstr "變更"

msgid "Cancel"
msgstr "取消"

msgid "Change game"
msgstr "切換遊戲"

# ---- Loading ----

msgid "Loading {}"
msgstr "正在載入 {}"
# A game's content being downloaded (the app has none of it yet): {} is the game, as the header shows it.
msgid "Downloading {}"
msgstr "正在下載 {}"

msgid "Loading"
msgstr "載入中"

msgid "VS"
msgstr "VS"

# ---- The battle ----

msgid "Reconnecting {} s"
msgstr "重新連線中 {} 秒"

msgid "{} ms"
msgstr "{} ms"

# The link panel the connection's corner opens. The figures in frames (the input delay, a rollback's depth,
# the skew, the lead) are bare numbers.
msgid "Connection"
msgstr "連線狀態"

msgid "Round trip"
msgstr "往返時間"

msgid "Jitter"
msgstr "抖動"

# The share of the other player's packets lost: {} is the number, to a tenth.
msgid "Loss"
msgstr "遺失率"

msgid "{}%"
msgstr "{}%"

msgid "Reconnects"
msgstr "重新連線"

# Clock sync's skew: how far this player runs ahead of the other (+) or behind (-), in frames.
msgid "Skew"
msgstr "偏差"

# This player's inputs the other's haven't matched yet, in frames.
msgid "Lead"
msgstr "領先"

msgid "Rollbacks"
msgstr "回溯次數"

msgid "Last rollback"
msgstr "上次回溯"

# The deepest rollback of the match, in frames.
msgid "Deepest"
msgstr "最深回溯"

msgid "Frames waited"
msgstr "等待影格"

msgid "Sent"
msgstr "傳送"

msgid "Received"
msgstr "接收"

msgid "{} packets · {} KB"
msgstr "{} 個封包 · {} KB"

