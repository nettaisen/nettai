# ---- The list ----

msgid "Search by opponent"
msgstr "依對手搜尋"

# A row's opponent.
msgid "vs {}"
msgstr "vs {}"

# The footer: how many replays the game has. (One form: Chinese has no plural, nplurals=1.)
msgid "{n} replay"
msgid_plural "{n} replays"
msgstr[0] "{n} 個重播"

msgid "No replays yet. Every online match is recorded."
msgstr "還沒有重播。每場線上對戰都會被記錄下來。"

msgid "No replays found."
msgstr "找不到重播。"

msgid "Watch"
msgstr "播放"

msgid "Export"
msgstr "匯出"

msgid "Delete"
msgstr "刪除"

# ---- The selected replay ----

msgid "Played"
msgstr "對戰時間"

msgid "Result"
msgstr "結果"

msgid "Length"
msgstr "長度"

msgctxt "verb"
msgid "Export video"
msgstr "匯出影片"

msgid "Show file"
msgstr "顯示檔案"

msgid "Save replay"
msgstr "儲存重播"

msgid "Delete replay?"
msgstr "要刪除重播嗎？"

# ---- The play queue: replays lined up to be watched one after another, each leaving it once watched (its tab,
# WATCH's arrow and a replay's menu, an entry's) ----

msgid "Queue"
msgstr "播放佇列"

msgid "Add to queue"
msgstr "加入播放佇列"

# Put a replay at the queue's start: what plays next.
msgid "Play next"
msgstr "下一個播放"

msgid "Watch from here"
msgstr "從這裡播放"

msgid "Move up"
msgstr "上移"

msgid "Move down"
msgstr "下移"

msgid "Clear the queue?"
msgstr "要清空播放佇列嗎？"

# A queue entry whose file is gone: its file's name.
msgid "Missing: {}"
msgstr "找不到：{}"

# Watch: WATCH's own word (播放); the arrow beside it opens Add to queue and Play next.
msgid "The queue is empty. Add replays to it with the arrow beside Watch."
msgstr "播放佇列是空的。可用「播放」旁的箭頭加入重播。"

# The players of a replay, the one whose console is shown first.
msgid "{} vs {}"
msgstr "{} vs {}"

# A player a replay has no name for: the first, the second.
msgid "P1"
msgstr "P1"

msgid "P2"
msgstr "P2"

