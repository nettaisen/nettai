msgid "From a save file…"
msgstr "從存檔建立…"

# The band under the builds: HOST, JOIN's field (an invite's code) and JOIN, and DIRECT CONNECT.

msgid "Host"
msgstr "主持"

msgid "Join"
msgstr "加入"

msgid "Direct connect"
msgstr "直接連線"

