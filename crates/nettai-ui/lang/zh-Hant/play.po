# ---- The builds, the chosen build, and what is done with it ----

msgid "+ New build"
msgstr "+ 新增配置"

msgctxt "title"
msgid "New build"
msgstr "新增配置"

msgid "Edit"
msgstr "編輯"

msgid "Duplicate"
msgstr "複製"

msgid "Delete"
msgstr "刪除"

msgid "Delete {}?"
msgstr "要刪除「{}」嗎？"

msgid "Save files"
msgstr "存檔"

# A new build, and a build's new name.

msgid "New build"
msgstr "新配置"

# After what a new build of a version starts with, in the game's own words ("Starts with the version's Crosses and
# Beast Out.").
msgid "{} They can be changed later in the editor."
msgstr "{}之後可在編輯器中變更。"

msgid "Create build"
msgstr "建立配置"

