msgid "Ruleset"
msgstr "規則"

msgctxt "ruleset"
msgid "View"
msgstr "查看"

msgid "Leave the lobby?"
msgstr "要離開大廳嗎？"

msgid "Open setups"
msgstr "公開配置"

