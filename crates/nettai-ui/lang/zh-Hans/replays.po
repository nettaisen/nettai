# ---- The viewer ----

msgid "Replay"
msgstr "录像"

msgid "Round {} of {}"
msgstr "第 {}/{} 回合"

msgid "Player"
msgstr "玩家"

msgid "Play or pause"
msgstr "播放/暂停"

msgid "Step a frame"
msgstr "逐帧播放"

# The viewer's Left and Right: five seconds back or ahead (Shift: one).
msgid "Seek"
msgstr "快退/快进"

msgid "Previous or next round"
msgstr "上/下一回合"

# The viewer's footer: how many rounds the replay has.
msgid "{n} round"
msgid_plural "{n} rounds"
msgstr[0] "{n} 回合"

# The transport's ⋯ menu: the side whose console is shown (P1, P2), both builds (Builds), the input display (Input
# display, Practice's), the other side's console small in the picture's corner, the playback speed (its row says the
# speed set, ½× to 4×, and opens the four) and Export video.
msgid "Other side's picture"
msgstr "对方画面"

msgid "Playback speed"
msgstr "播放速度"

# The viewer's play queue (the replays lined up in the Queue tab, watched one after another): its popup of the
# entries still to watch after the one watched, with NEXT (Next, 下一个: skip to the next replay) and whether the next
# one starts by itself at the end of one (the words by its switch) at its top, and what is said when there are none.
msgid "Autoplay next"
msgstr "自动播放下一个"

msgid "Up next"
msgstr "即将播放"

msgid "Nothing else is in the queue."
msgstr "播放队列中没有其他录像。"

# ---- The export mode ----

# The viewer's export mode: the part of the replay exported is between two handles on the bar (滑块), which the
# pointer drags; the buttons, and the brackets (the footer's hint, "Set start or end"), set the range's start or its
# end where the replay is shown (the playback position); the Range's list (the whole match, a round, Custom: the player's own) is
# under the same words as before. The line under the options says what to do while nothing is exporting.
msgid "Set start here"
msgstr "设为起点"

msgid "Set end here"
msgstr "设为终点"

msgid "Set start or end"
msgstr "设置起点/终点"

msgid "Drag the handles on the bar to choose the part to export."
msgstr "拖动进度条两端的滑块，选择要导出的片段。"

msgid "Size"
msgstr "尺寸"

# The consoles a video shows: the view's alone, both on one screen (the view's at the left; also the viewer's
# side menu's third), or both side by side (the view's at the left, heard).
msgid "Sides"
msgstr "画面"

