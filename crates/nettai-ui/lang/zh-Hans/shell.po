# Simplified Chinese: what every screen shares (the header, the footer, the dialogs, the errors), the loading screens,
# the main menu and the battle's own. A screen's strings are in the file of its name.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh-Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# The language's own name, as Settings lists it.
msgctxt "language"
msgid "English"
msgstr "简体中文"

# ---- The main menu ----

msgid "Play"
msgstr "对战"

msgid "Practice"
msgstr "练习"

msgid "Replays"
msgstr "录像"

msgid "Demo"
msgstr "演示"

msgid "vs"
msgstr "vs"

# ---- The header and the key hints ----

msgid "Menu"
msgstr "菜单"

msgid "Select"
msgstr "选择"

msgid "Open"
msgstr "确定"

msgid "Back"
msgstr "返回"

# A text field's own hints, while it is typed in: Enter finishes it, Esc leaves it as it was.
msgid "Done"
msgstr "完成"

# A setting taken (Enter on it): Left and Right change it.
msgid "Change"
msgstr "更改"

msgid "Cancel"
msgstr "取消"

msgid "Change game"
msgstr "切换游戏"

# ---- Loading ----

msgid "Loading {}"
msgstr "正在加载 {}"
# A game's content being downloaded (the app has none of it yet): {} is the game, as the header shows it.
msgid "Downloading {}"
msgstr "正在下载 {}"

msgid "Loading"
msgstr "加载中"

msgid "VS"
msgstr "VS"

# ---- The battle ----

msgid "Reconnecting {} s"
msgstr "正在重新连接 {} 秒"

msgid "{} ms"
msgstr "{} ms"

# The link panel the connection's corner opens. The figures in frames (the input delay, a rollback's depth,
# the skew, the lead) are bare numbers.
msgid "Connection"
msgstr "连接状况"

msgid "Round trip"
msgstr "往返时间"

msgid "Jitter"
msgstr "抖动"

# The share of the other player's packets lost: {} is the number, to a tenth.
msgid "Loss"
msgstr "丢包率"

msgid "{}%"
msgstr "{}%"

msgid "Reconnects"
msgstr "重连次数"

# Clock sync's skew: how far this player runs ahead of the other (+) or behind (-), in frames.
msgid "Skew"
msgstr "时钟偏差"

# This player's inputs the other's haven't matched yet, in frames.
msgid "Lead"
msgstr "领先"

msgid "Rollbacks"
msgstr "回滚次数"

msgid "Last rollback"
msgstr "上次回滚"

# The deepest rollback of the match, in frames.
msgid "Deepest"
msgstr "最深回滚"

msgid "Frames waited"
msgstr "等待帧数"

msgid "Sent"
msgstr "发送"

msgid "Received"
msgstr "接收"

msgid "{} packets · {} KB"
msgstr "{} 个数据包 · {} KB"

