msgid "Invite code"
msgstr "邀请码"

msgid "Connecting…"
msgstr "连接中…"

msgid "Choose"
msgstr "选择"

# ---- A direct connection ----

msgid "Direct connection"
msgstr "直接连接"

msgid "Copy"
msgstr "复制"

