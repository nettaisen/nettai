msgstr "你的地址"

msgid "Copy code"
msgstr "复制邀请码"

msgid "Copy address"
msgstr "复制地址"

msgid "Stop practice"
msgstr "停止练习"

msgid "Cancel invite"
msgstr "取消邀请"

msgid "Stop hosting"
msgstr "关闭房间"

msgid "Waiting for opponent"
msgstr "等待对手"

msgid "The lobby opens when they join."
msgstr "对手加入后即进入房间。"

