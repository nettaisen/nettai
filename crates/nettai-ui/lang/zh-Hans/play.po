# ---- The builds, the chosen build, and what is done with it ----

msgid "+ New build"
msgstr "+ 新建构筑"

msgctxt "title"
msgid "New build"
msgstr "新建构筑"

msgid "Edit"
msgstr "编辑"

msgid "Duplicate"
msgstr "复制"

msgid "Delete"
msgstr "删除"

msgid "Delete {}?"
msgstr "删除{}？"

msgid "Save files"
msgstr "存档文件"

# A new build, and a build's new name.

msgid "New build"
msgstr "新构筑"

# After what a new build of a version starts with, in the game's own words ("Starts with the version's Crosses and
# Beast Out.").
msgid "{} They can be changed later in the editor."
msgstr "{}之后可在编辑器中更改。"

msgid "Create build"
msgstr "创建构筑"

# The NEW BUILD dialog's other way to start one: a save file chosen in the system's dialog.
msgid "From a save file…"
msgstr "从存档文件导入…"

# The band under the builds: HOST, JOIN's field (an invite's code) and JOIN, and DIRECT CONNECT.

msgid "Host"
msgstr "创建房间"

msgid "Join"
msgstr "加入"

msgid "Direct connect"
msgstr "直接连接"

