msgid "Fight"
msgstr "战斗"

# ---- The lobby ----

msgid "Lobby"
msgstr "房间"

msgid "You"
msgstr "你"

msgid "Opponent"
msgstr "对手"

msgid "Ready"
msgstr "准备就绪"

msgid "Not ready"
msgstr "未准备"

msgid "First to"
msgstr "先胜"

msgctxt "first to"
msgid "{}"
msgstr "{} 回合"

# The match's ruleset (docs/design/app-ui.md §2.59), and the joiner's button that opens it to read.
msgid "Ruleset"
msgstr "规则"

msgctxt "ruleset"
msgid "View"
msgstr "查看"

msgid "Leave the lobby?"
msgstr "离开房间？"

msgid "Open setups"
msgstr "公开构筑"

