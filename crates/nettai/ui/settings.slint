// Settings, as Tango's: the sections in a sidebar (general, graphics,
// audio, the controls, about), the chosen one's rows beside it.

import { Theme, NavAction, UiSound } from "theme.slint";
import { Slant, Label, Hints, Hint, OptionRow, Field, Glyph, Input } from "widgets.slint";

// A section's name, chosen or not.
component SectionChip {
    in property <string> text;
    in property <bool> chosen;
    in property <bool> in-pane;
    callback clicked();
    Slant {
        lean: 10px;
        color: root.chosen ? (root.in-pane ? Theme.raised : Theme.cyan) : Theme.panel.with-alpha(0.55);
        animate color { duration: Theme.quick; }
    }

    Text {
        x: Theme.compact ? 10px : 22px;
        width: parent.width - 2 * self.x;
        text: root.text;
        color: root.chosen && !root.in-pane ? Theme.ink : root.chosen ? white : Theme.text-dim;
        font-size: Theme.compact ? 10px : 14px;
        font-weight: Theme.black;
        letter-spacing: (Theme.compact ? 0.5px : 1.5px) * Theme.tracking;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The sections, down the side (across the top on a phone held upright).
component Sections {
    in property <int> section;
    in property <bool> in-pane;
    in property <bool> across;
    callback choose(int);
    property <[string]> names: [@tr("section" => "GENERAL"), @tr("section" => "GRAPHICS"), @tr("section" => "AUDIO"), @tr("section" => "CONTROLS"), @tr("section" => "ABOUT")];

    if !root.across: VerticalLayout {
        spacing: 6px;
        alignment: start;
        for s[i] in root.names: SectionChip {
            height: Theme.compact ? 40px : 48px;
            text: s;
            chosen: i == root.section;
            in-pane: root.in-pane;
            clicked => {
                root.choose(i);
            }
        }
    }
    if root.across: HorizontalLayout {
        spacing: 4px;
        for s[i] in root.names: SectionChip {
            horizontal-stretch: 1;
            text: s;
            chosen: i == root.section;
            in-pane: root.in-pane;
            clicked => {
                root.choose(i);
            }
        }
    }
}

export component SettingsScreen {
    // The language's own name.
    in property <string> language;
    in property <int> volume;
    in property <bool> menu-sounds;
    // The battle's text: in the vector font, crisp, or the game's own.
    in property <bool> crisp-text;
    // The picture at the display's own density.
    in property <bool> sharp;
    in-out property <string> name;
    // About: the version, and where things are kept (a line each).
    in property <string> version;
    in property <[string]> about;
    // The section shown: 0 general, 1 graphics, 2 audio, 3 the controls, 4
    // about; whether its rows have the keys (else the sidebar has them),
    // and the row.
    in-out property <int> section;
    in-out property <bool> in-pane;
    in-out property <int> cursor;
    // Each section's rows: what `step` steps (0 the language, 1 the volume,
    // 2 the menu sounds, 3 the battle's text, 4 the picture; 5 the name's
    // field).
    property <[[int]]> rows: [[5, 0], [3, 4], [1, 2], [], []];
    property <[int]> shown-rows: root.rows[root.section];

    callback step(int, int);
    callback set-name(string);
    // Up from the first section, or back from it: the top bar.
    callback top();
    callback sound(UiSound);

    public function nav(a: NavAction) {
        if !root.in-pane {
            if a == NavAction.back || (a == NavAction.up && root.section == 0) {
                if a == NavAction.back {
                    root.sound(UiSound.back);
                }
                root.top();
            } else if a == NavAction.up || a == NavAction.down {
                root.section = max(0, min(4, root.section + (a == NavAction.up ? -1 : 1)));
                root.cursor = 0;
                root.sound(UiSound.cursor);
            } else if (a == NavAction.right || a == NavAction.confirm) && root.shown-rows.length > 0 {
                root.in-pane = true;
                root.cursor = 0;
                root.sound(UiSound.cursor);
                root.follow();
            }
            return;
        }
        if a == NavAction.back {
            if name-field.focused-input {
                name-field.leave();
                return;
            }
            root.in-pane = false;
            root.sound(UiSound.back);
            root.follow();
        } else if a == NavAction.up || a == NavAction.down {
            root.cursor = max(0, min(root.shown-rows.length - 1, root.cursor + (a == NavAction.up ? -1 : 1)));
            root.sound(UiSound.cursor);
            root.follow();
        } else if (a == NavAction.left || a == NavAction.right) && root.focused-row() != 5 {
            root.sound(UiSound.cursor);
            root.step(root.focused-row(), a == NavAction.left ? -1 : 1);
        } else if a == NavAction.confirm {
            if root.focused-row() == 5 {
                root.follow();
            } else {
                root.sound(UiSound.cursor);
                root.step(root.focused-row(), 1);
            }
        }
    }

    pure function focused-row() -> int {
        root.shown-rows.length > root.cursor ? root.shown-rows[root.cursor] : -1
    }

    function follow() {
        if root.in-pane && root.focused-row() == 5 {
            name-field.edit();
        } else {
            name-field.leave();
        }
    }

    function point-section(s: int) {
        if root.section != s || root.in-pane {
            root.section = s;
            root.in-pane = false;
            root.cursor = 0;
            root.sound(UiSound.cursor);
            root.follow();
        }
    }

    function point-row(i: int) {
        if !root.in-pane || root.cursor != i {
            root.in-pane = true;
            root.cursor = i;
            root.sound(UiSound.cursor);
            root.follow();
        }
    }

    VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: Theme.gap;
        spacing: Theme.gap;

        if Theme.portrait: Sections {
            height: 36px;
            across: true;
            section: root.section;
            in-pane: root.in-pane;
            choose(i) => {
                root.point-section(i);
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            if !Theme.portrait: Sections {
                width: Theme.compact ? 104px : 200px;
                section: root.section;
                in-pane: root.in-pane;
                choose(i) => {
                    root.point-section(i);
                }
            }

            // The section's rows.
            Rectangle {
                horizontal-stretch: 1;
                Slant {
                    lean: 22px;
                    color: Theme.panel.with-alpha(0.4);
                    stroke: Theme.line;
                    stroke-width: 1px;
                }

                VerticalLayout {
                    padding: Theme.compact ? 12px : 24px;
                    padding-left: Theme.compact ? 18px : 36px;
                    padding-right: Theme.compact ? 18px : 36px;
                    spacing: 10px;
                    alignment: start;

                    // General: your name, the language.
                    name-field := Field {
                        visible: root.section == 0;
                        height: root.section == 0 ? (Theme.compact ? 30px : 36px) + 34px : 0px;
                        text-label: @tr("YOUR NAME");
                        placeholder: @tr("Type your name");
                        text <=> root.name;
                        focused: root.in-pane && root.focused-row() == 5;
                        edited(t) => {
                            root.set-name(t);
                        }
                        hover => {
                            if root.section == 0 {
                                root.point-row(0);
                            }
                        }
                        done => {
                            name-field.leave();
                        }
                    }

                    for r[i] in root.shown-rows: OptionRow {
                        visible: r != 5;
                        height: r == 5 ? 0px : (Theme.compact ? 56px : 64px);
                        text: r == 0 ? @tr("LANGUAGE") : r == 1 ? @tr("VOLUME") : r == 2 ? @tr("MENU SOUNDS") : r == 3 ? @tr("BATTLE TEXT") : @tr("PICTURE");
                        value: r == 0 ? root.language : r == 1 ? (root.volume == 0 ? @tr("Off") : "" + root.volume) : r == 2 ? (root.menu-sounds ? @tr("On") : @tr("Off")) : r == 3 ? (root.crisp-text ? @tr("Crisp") : @tr("Original")) : (root.sharp ? @tr("Display's pixels") : @tr("Window's pixels"));
                        note: r == 0 ? @tr("The menus, and the battle's names and words") : r == 1 ? @tr("The battle's and the menus' sound") : r == 2 ? @tr("The game's own cursor sounds") : r == 3 ? (root.crisp-text ? @tr("Names and messages drawn at the window's resolution") : @tr("The game's own lettering")) : @tr("Text sharper at the display's own density, at a cost");
                        value-width: Theme.compact ? 120px : 200px;
                        focused: root.in-pane && root.cursor == i;
                        step(d) => {
                            root.point-row(i);
                            root.nav(d < 0 ? NavAction.left : NavAction.right);
                        }
                        activate => {
                            root.point-row(i);
                            root.nav(NavAction.confirm);
                        }
                    }

                    // The controls.
                    if root.section == 3: VerticalLayout {
                        spacing: 9px;
                        Label {
                            text: @tr("CONTROLS");
                        }

                        for c in [
                            { what: @tr("Move"), key: "← ↑ → ↓", button: "✚" },
                            { what: @tr("A: chips, pick"), key: "Z", button: "A" },
                            { what: @tr("B: buster (hold to charge), take back"), key: "X", button: "X" },
                            { what: @tr("L and R"), key: "A / S", button: "LB / RB" },
                            { what: @tr("START: to OK"), key: "Enter", button: "≡" },
                            { what: @tr("SELECT"), key: "Backspace", button: "⧉" },
                            { what: @tr("Pause"), key: "Esc", button: "⌂" },
                            { what: @tr("Training: start over"), key: "R", button: "Y" },
                        ]: HorizontalLayout {
                            spacing: 14px;
                            height: 26px;
                            Text {
                                text: c.what;
                                color: Theme.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Glyph {
                                key: c.key;
                                button: c.button;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    // About: the version, where things are kept.
                    if root.section == 4: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "nettai " + root.version;
                            color: white;
                            font-size: Theme.title-size;
                            font-weight: Theme.black;
                        }

                        for l in root.about: Text {
                            text: l;
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Hints {
            visible: !Theme.portrait;
            hints: [
                { key: "↑↓", button: "✚", text: @tr("Choose") },
                { key: "←→", button: "✚", text: @tr("Change") },
                { key: "Enter", button: "A", text: @tr("Confirm") },
                { key: "Esc", button: "B", text: @tr("Back") },
            ];
        }
    }
}
