// Training: you against the computer, offline, in Play's shape. The selector
// strip chooses the game and your build; the options the match (a random
// one, or a match file's), your opponent's build, what it does and how long
// the set is; the preview who fights where; the band at the foot FIGHT.

import { Theme, NavAction, UiSound } from "theme.slint";
import { Slant, Label, Hints, Hint, Button, OptionRow, Versus, Input } from "widgets.slint";
import { Strip, Band, GameState, GameCard } from "shell.slint";

// What the opponent does, as the window words it (the order of
// `nettai_frontend::driver::Opponent::ALL`).
export global TrainingText {
    pure public function opponent(i: int) -> string {
        if i == 1 {
            return @tr("opponent" => "Dummy");
        } else if i == 2 {
            return @tr("opponent" => "Mover");
        } else if i == 3 {
            return @tr("opponent" => "Masher");
        }
        @tr("Stand-in")
    }

    pure public function about(i: int) -> string {
        if i == 1 {
            return @tr("Stands still and picks no chip");
        } else if i == 2 {
            return @tr("Moves about at random, never attacks");
        } else if i == 3 {
            return @tr("Moves, shoots and uses its chips at random");
        }
        @tr("Stands still and picks its first chip")
    }
}

export struct RoundCard {
    // The arena, drawn as the round opens, if it could be.
    picture: image,
    stage: string,
    background: string,
}

export struct MatchPreview {
    ready: bool,
    left: string,
    left-sub: string,
    right: string,
    right-sub: string,
    rounds: [RoundCard],
    seed: string,
    // Why this match can't be played (the checks' words).
    problem: string,
}

// The preview: who fights, and where each round is fought. Its panel fills
// its place whatever it holds.
component Preview {
    in property <MatchPreview> preview;
    in property <bool> chosen;
    // What the opponent does.
    in property <int> behavior;
    // The arenas are drawn (not on a phone held upright: the choices and
    // FIGHT take its height).
    in property <bool> arenas: true;
    // (`room`: the width it is given, from outside the layout.)
    in property <length> room;
    // The arenas' pictures, each a whole multiple of the display's pixels
    // (as the battle is drawn): three in a row, or two (and the third
    // under them) when two are drawn larger and three would be at one.
    property <length> inside: root.room - 2 * (Theme.compact ? 24px : 40px);
    property <int> by-three: floor((root.inside - 2 * Theme.gap) / 3 / 240phx);
    property <int> by-two: floor((root.inside - Theme.gap) / 2 / 240phx);
    // (Two rows of two only where the window has the height for them.)
    property <bool> two-fit: 2 * (root.by-two * 160phx + 44px + Theme.gap) + 300px <= Theme.window-height - 200px;
    property <int> columns: root.by-three >= 1 && (root.by-three >= root.by-two || !root.two-fit) ? 3 : root.by-two >= 1 ? 2 : 1;
    property <length> thumb: max(1, root.columns == 3 ? root.by-three : root.columns == 2 ? root.by-two : floor(root.inside / 240phx)) * 240phx;
    property <length> card-height: root.thumb * 2 / 3 + 44px;

    VerticalLayout {
        alignment: stretch;
        Rectangle {
            vertical-stretch: 1;
            Slant {
                lean: 26px;
                color: Theme.panel.with-alpha(0.55);
                stroke: Theme.line;
                stroke-width: 1px;
            }

            inner := VerticalLayout {
                alignment: start;
                padding: Theme.gap * 1.5;
                padding-left: Theme.compact ? 24px : 40px;
                padding-right: Theme.compact ? 24px : 40px;
                spacing: Theme.gap;
                // (As tall as the versus that takes its place.)
                if !root.chosen: Text {
                    text: @tr("Choose a game");
                    color: Theme.text-faint;
                    font-size: Theme.title-size;
                    font-weight: Theme.bold;
                    horizontal-alignment: center;
                    height: 96px;
                    vertical-alignment: center;
                }
                if root.chosen: Versus {
                    left-name: root.preview.left;
                    left-sub: @tr("YOU");
                    right-name: root.preview.right;
                    right-sub: TrainingText.opponent(root.behavior).to-uppercase();
                }

                // (Its line kept, empty or not.)
                Text {
                    height: 36px;
                    text: root.chosen ? root.preview.problem : "";
                    color: Theme.warn;
                    wrap: word-wrap;
                    overflow: elide;
                    font-size: 13px;
                }

                if root.chosen && root.arenas: Label {
                    text: @tr("THE ARENAS");
                }

                if root.chosen && root.arenas: Rectangle {
                    height: ceil(root.preview.rounds.length / root.columns) * (root.card-height + Theme.gap);
                    for r[i] in root.preview.rounds: VerticalLayout {
                        x: mod(i, root.columns) * (root.thumb + Theme.gap);
                        y: floor(i / root.columns) * (root.card-height + Theme.gap);
                        height: root.card-height;
                        spacing: 6px;
                        alignment: start;
                        width: root.thumb;
                        Rectangle {
                            height: root.thumb * 2 / 3;
                            background: Theme.ink;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: r.picture;
                                image-fit: fill;
                                image-rendering: pixelated;
                            }

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: badge.preferred-width + 14px;
                                height: 18px;
                                background: Theme.ink.with-alpha(0.85);
                                badge := Text {
                                    text: @tr("ROUND {0}", i + 1);
                                    color: Theme.cyan;
                                    font-size: 10px;
                                    font-weight: Theme.black;
                                }
                            }
                        }

                        Text {
                            text: r.background;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: Theme.bold;
                            overflow: elide;
                        }

                        Text {
                            text: r.stage;
                            color: Theme.text-faint;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component TrainingScreen {
    // The selection: the game and your build, what the strip says of each.
    in property <string> game;
    in property <GameState> game-state;
    in property <string> build;
    in property <int> build-index;
    in property <string> build-navi;
    in property <bool> can-act;
    // A game is chosen and ready.
    in property <bool> chosen;
    // The match: 0 random, then each match file of the game.
    in property <[string]> sources;
    in-out property <int> source;
    // The opponent's side: 0 a random one (or the match file's), then each
    // build of the game.
    in property <[string]> opponents;
    in-out property <int> opponent;
    // What the opponent does (`TrainingText`), and whether the set goes on
    // round after round; the match's rounds.
    in-out property <int> behavior;
    in-out property <bool> endless;
    in property <int> rounds;
    in property <MatchPreview> preview;
    // The row focused: 0 the game, 1 your build, 2 the build's action, 3
    // the match, 4 the opponent's build, 5 what it does, 6 the rounds, 7
    // FIGHT.
    in-out property <int> cursor;
    // The tab has the keys (not the top bar): its focus shows.
    in property <bool> keys: true;
    property <bool> can-fight: root.chosen && root.preview.ready && root.preview.problem == "";

    callback step(int, int);
    callback act();
    callback choose-source(int);
    callback choose-opponent(int);
    callback choose-behavior(int);
    callback choose-endless(bool);
    callback reroll();
    callback fight();
    // Up from the first row, or back: the top bar.
    callback top();
    callback sound(UiSound);

    public function nav(a: NavAction) {
        if a == NavAction.back {
            root.sound(UiSound.back);
            root.top();
        } else if a == NavAction.up && root.cursor == 0 {
            root.top();
        } else if a == NavAction.up || a == NavAction.down {
            root.cursor = max(0, min(7, root.cursor + (a == NavAction.up ? -1 : 1)));
            root.sound(UiSound.cursor);
        } else if (a == NavAction.left || a == NavAction.right || a == NavAction.previous || a == NavAction.next) && root.cursor != 2 && root.cursor != 7 {
            root.sound(UiSound.cursor);
            root.step-row(root.cursor, a == NavAction.left || a == NavAction.previous ? -1 : 1);
        } else if a == NavAction.confirm {
            if root.cursor == 2 {
                if root.can-act {
                    root.sound(UiSound.pick);
                    root.act();
                } else {
                    root.sound(UiSound.refused);
                }
            } else if root.cursor == 3 && root.source == 0 {
                root.sound(UiSound.pick);
                root.reroll();
            } else if root.cursor == 7 {
                if root.can-fight {
                    root.sound(UiSound.pick);
                    root.fight();
                } else {
                    root.sound(UiSound.refused);
                }
            } else {
                root.sound(UiSound.cursor);
                root.step-row(root.cursor, 1);
            }
        }
    }

    // Row `row`'s value a step on (`d`: -1 or 1).
    function step-row(row: int, d: int) {
        if row <= 1 {
            root.step(row, d);
        } else if row == 3 {
            root.choose-source(mod(root.source + d + root.sources.length, max(1, root.sources.length)));
        } else if row == 4 {
            root.choose-opponent(mod(root.opponent + d + root.opponents.length, max(1, root.opponents.length)));
        } else if row == 5 {
            root.choose-behavior(mod(root.behavior + d + 4, 4));
        } else if row == 6 {
            root.choose-endless(!root.endless);
        }
    }

    function point(row: int) {
        if root.cursor != row {
            root.cursor = row;
            root.sound(UiSound.cursor);
        }
    }

    VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: Theme.gap;
        spacing: Theme.gap;

        Strip {
            game: root.game;
            game-state: root.game-state;
            build: root.build;
            build-index: root.build-index;
            build-navi: root.build-navi;
            can-act: root.can-act;
            cursor: root.keys && root.cursor <= 2 ? root.cursor : -1;
            point(r) => {
                root.point(r);
            }
            step(r, d) => {
                root.sound(UiSound.cursor);
                root.step(r, d);
            }
            act => {
                root.nav(NavAction.confirm);
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 0.67;
                spacing: Theme.gap * 0.5;
                alignment: start;
                for row in [3, 4, 5, 6]: OptionRow {
                    height: Theme.compact ? 50px : 60px;
                    text: row == 3 ? @tr("MATCH") : row == 4 ? @tr("OPPONENT") : row == 5 ? @tr("IT DOES") : @tr("ROUNDS");
                    value: row == 3 ? (root.sources.length > 0 ? root.sources[root.source] : "—")
                        : row == 4 ? (root.opponents.length > 0 ? root.opponents[root.opponent] : "—")
                        : row == 5 ? TrainingText.opponent(root.behavior).to-uppercase()
                        : root.endless ? @tr("rounds" => "ENDLESS") : @tr("rounds" => "BEST OF {0}", root.rounds);
                    note: row == 3 ? (root.source == 0 ? @tr("Seed {0} · confirm for another", root.preview.seed) : @tr("A match file from the matches folder"))
                        : row == 4 ? (root.opponent > 0 ? @tr("One of your builds, in the opponent's place") : root.source == 0 ? @tr("A random side, from the seed") : @tr("The other side as the match file states it"))
                        : row == 5 ? TrainingText.about(root.behavior)
                        : root.endless ? @tr("99 rounds, the most a set has: first to 50 wins") : @tr("A set as the match lists it");
                    value-width: Theme.compact ? 120px : 170px;
                    focused: root.keys && root.cursor == row;
                    enabled: root.chosen;
                    step(d) => {
                        root.point(row);
                        root.nav(d < 0 ? NavAction.left : NavAction.right);
                    }
                    activate => {
                        root.point(row);
                        root.nav(NavAction.confirm);
                    }
                }
            }

            if !Theme.portrait: Preview {
                horizontal-stretch: 1;
                room: (Theme.window-width - 2 * Theme.gutter - Theme.gap) * 0.6;
                preview: root.preview;
                chosen: root.chosen;
                behavior: root.behavior;
            }
        }

        if Theme.portrait: Versus {
            left-name: root.preview.left;
            left-sub: @tr("YOU");
            right-name: root.preview.right;
            right-sub: TrainingText.opponent(root.behavior).to-uppercase();
        }

        Band {
            HorizontalLayout {
                padding-left: Theme.compact ? 10px : 24px;
                padding-right: Theme.compact ? 10px : 24px;
                spacing: Theme.compact ? 8px : 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Label {
                        text: @tr("AGAINST THE COMPUTER · EVERY SET RECORDED");
                    }

                    Text {
                        text: root.chosen ? @tr("In the battle, R starts over: the same set again") : @tr("Choose a game");
                        color: Theme.text-dim;
                        font-size: 13px;
                        overflow: elide;
                    }
                }

                Button {
                    width: Theme.compact ? 120px : 220px;
                    y: (parent.height - self.height) / 2;
                    text: @tr("FIGHT");
                    primary: true;
                    enabled: root.can-fight;
                    focused: root.keys && root.cursor == 7;
                    activate => {
                        root.point(7);
                        root.nav(NavAction.confirm);
                    }
                    hover => {
                        if root.can-fight {
                            root.point(7);
                        }
                    }
                }
            }
        }

        Hints {
            visible: !Theme.portrait;
            hints: [
                { key: "↑↓", button: "✚", text: @tr("Choose") },
                { key: "←→", button: "✚", text: @tr("Change") },
                { key: "Enter", button: "A", text: @tr("Confirm") },
                { key: "Esc", button: "B", text: @tr("Tabs") },
            ];
        }
    }
}
