// Training: you against the computer, offline. Choose the game and the
// match (a random one, or a match file's), your build and your opponent's,
// what the opponent does and how long the set is; see who fights where, and
// fight.

import { Theme, NavAction, UiSound } from "theme.slint";
import { Slant, Label, Heading, Hints, Hint, Button, OptionRow, Versus, Input } from "widgets.slint";

export enum GameState {
    // No asset pack of it is found.
    no-pack,
    loading,
    ready,
    failed,
}

// What the opponent does, as the window words it (the order of
// `nettai_frontend::driver::Opponent::ALL`).
export global TrainingText {
    pure public function opponent(i: int) -> string {
        if i == 1 {
            return @tr("opponent" => "Dummy");
        } else if i == 2 {
            return @tr("opponent" => "Mover");
        } else if i == 3 {
            return @tr("opponent" => "Masher");
        }
        @tr("Stand-in")
    }

    pure public function about(i: int) -> string {
        if i == 1 {
            return @tr("Stands still and picks no chip");
        } else if i == 2 {
            return @tr("Moves about at random, never attacks");
        } else if i == 3 {
            return @tr("Moves, shoots and uses its chips at random");
        }
        @tr("Stands still and picks its first chip")
    }
}

export struct GameCard {
    id: string,
    // Its short name (EXE6), and the larger number on its card.
    name: string,
    number: string,
    state: GameState,
    // Why it can't be played, in the library's words (a command to run).
    detail: string,
}

export struct RoundCard {
    // The arena, drawn as the round opens, if it could be.
    picture: image,
    stage: string,
    background: string,
}

export struct MatchPreview {
    ready: bool,
    left: string,
    left-sub: string,
    right: string,
    right-sub: string,
    rounds: [RoundCard],
    seed: string,
    // Why this match can't be played (the checks' words).
    problem: string,
}

component GameTile {
    in property <GameCard> card;
    in property <bool> chosen;
    in property <bool> focused;
    callback activate();
    callback hover();
    property <bool> playable: root.card.state == GameState.ready;

    Slant {
        lean: 22px;
        color: root.chosen ? @linear-gradient(135deg, Theme.cyan-deep 0%, Theme.panel 75%) : root.focused ? Theme.raised : Theme.panel.with-alpha(0.7);
        stroke: root.chosen ? Theme.cyan : root.focused ? Theme.line-bright : Theme.line;
        stroke-width: root.chosen || root.focused ? 2px : 1px;
    }

    // The game's number, large and faint behind its name.
    Text {
        x: parent.width - self.preferred-width - 30px;
        y: (parent.height - self.preferred-height) / 2;
        text: root.card.number;
        color: root.chosen ? Theme.cyan.with-alpha(0.32) : Theme.line-bright.with-alpha(0.5);
        font-size: parent.height * 0.95;
        font-weight: Theme.black;
    }

    VerticalLayout {
        x: 34px;
        width: parent.width - 60px;
        alignment: center;
        spacing: 4px;
        Text {
            text: root.card.name;
            color: root.playable ? white : Theme.text-dim;
            font-size: Theme.heading * 0.8;
            font-weight: Theme.black;
            font-italic: true;
        }

        Label {
            text: root.card.state == GameState.ready ? (root.chosen ? @tr("CHOSEN") : @tr("READY")) : root.card.state == GameState.loading ? @tr("LOADING…") : root.card.state == GameState.no-pack ? @tr("NO ASSET PACK") : @tr("CAN'T LOAD");
            color: root.card.state == GameState.ready ? (root.chosen ? Theme.cyan : Theme.ready) : root.card.state == GameState.loading ? Theme.text-dim : Theme.warn;
        }
    }

    TouchArea {
        clicked => {
            root.activate();
        }
        changed has-hover => {
            if self.has-hover {
                root.hover();
            }
        }
    }
}

// The choices: the game, the match, both builds, what the opponent does and
// the rounds.
component Choices {
    in property <[GameCard]> games;
    in property <int> game;
    in property <[string]> sources;
    in property <[string]> builds;
    in property <int> build;
    in property <[string]> opponents;
    in property <int> opponent;
    in property <int> behavior;
    in property <bool> endless;
    in property <int> rounds;
    in property <int> source;
    in property <string> seed;
    in property <int> cursor;
    in property <int> game-cursor;
    // Focus row `r` (and card `card`), with a cursor sound if it moved.
    callback point(int, int);
    callback nav(NavAction);

    VerticalLayout {
        spacing: Theme.gap * 0.5;
        alignment: start;
        Label {
            text: @tr("GAME");
            color: root.cursor == 0 ? Theme.cyan : Theme.text-dim;
        }

        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.compact ? 84px : 112px;
            for g[i] in root.games: GameTile {
                card: g;
                chosen: root.game == i;
                focused: root.cursor == 0 && root.game-cursor == i;
                activate => {
                    root.point(0, i);
                    root.nav(NavAction.confirm);
                }
                hover => {
                    root.point(0, i);
                }
            }
        }

        if root.games.length > 0 && root.games[root.game-cursor].detail != "" && root.cursor == 0: Text {
            text: root.games[root.game-cursor].detail;
            color: Theme.warn;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.games.length == 0: Text {
            text: @tr("No games found: the content folder or the packs folder is missing.");
            color: Theme.warn;
            wrap: word-wrap;
        }

        Rectangle {
            height: 4px;
        }

        for row in [1, 2, 3, 4, 5]: OptionRow {
            height: Theme.compact ? 48px : 56px;
            text: row == 1 ? @tr("MATCH") : row == 2 ? @tr("YOUR BUILD") : row == 3 ? @tr("OPPONENT") : row == 4 ? @tr("IT DOES") : @tr("ROUNDS");
            value: row == 1 ? (root.sources.length > 0 ? root.sources[root.source] : "—")
                : row == 2 ? (root.builds.length > 0 ? root.builds[root.build] : "—")
                : row == 3 ? (root.opponents.length > 0 ? root.opponents[root.opponent] : "—")
                : row == 4 ? TrainingText.opponent(root.behavior).to-uppercase()
                : root.endless ? @tr("rounds" => "ENDLESS") : @tr("rounds" => "BEST OF {0}", root.rounds);
            note: row == 1 ? (root.source == 0 ? @tr("Seed {0} · confirm for another", root.seed) : @tr("A match file from the matches folder"))
                : row == 2 ? (root.build > 0 ? @tr("One of your builds, in place of your side") : root.source == 0 ? @tr("A random side, from the seed") : @tr("Your side as the match file states it"))
                : row == 3 ? (root.opponent > 0 ? @tr("One of your builds, in the opponent's place") : root.source == 0 ? @tr("A random side, from the seed") : @tr("The other side as the match file states it"))
                : row == 4 ? TrainingText.about(root.behavior)
                : root.endless ? @tr("99 rounds, the most a set has: first to 50 wins") : @tr("A set as the match lists it");
            focused: root.cursor == row;
            enabled: root.game >= 0;
            step(d) => {
                root.point(row, root.game-cursor);
                root.nav(d < 0 ? NavAction.left : NavAction.right);
            }
            activate => {
                root.point(row, root.game-cursor);
                root.nav(row == 1 ? NavAction.confirm : NavAction.right);
            }
            hover => {
                if root.game >= 0 {
                    root.point(row, root.game-cursor);
                }
            }
        }
    }
}

// FIGHT.
component Fight {
    in property <int> cursor;
    in property <int> game-cursor;
    in property <bool> can-fight;
    callback point(int, int);
    callback nav(NavAction);

    HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("FIGHT");
            primary: true;
            enabled: root.can-fight;
            focused: root.cursor == 6;
            width: 260px;
            activate => {
                root.point(6, root.game-cursor);
                root.nav(NavAction.confirm);
            }
            hover => {
                if root.can-fight {
                    root.point(6, root.game-cursor);
                }
            }
        }
    }
}

// The preview: who fights, and where each round is fought. Its panel is as
// tall as what it holds.
component Preview {
    in property <MatchPreview> preview;
    in property <bool> chosen;
    // What the opponent does.
    in property <int> behavior;
    // The arenas are drawn (not on a phone held upright: the choices and
    // FIGHT take its height).
    in property <bool> arenas: true;
    // (`room`: the width it is given, from outside the layout.)
    in property <length> room;
    // The arenas' pictures, each a whole multiple of the display's pixels
    // (as the battle is drawn): three in a row, or two (and the third
    // under them) when two are drawn larger and three would be at one.
    property <length> inside: root.room - 2 * (Theme.compact ? 24px : 40px);
    property <int> by-three: floor((root.inside - 2 * Theme.gap) / 3 / 240phx);
    property <int> by-two: floor((root.inside - Theme.gap) / 2 / 240phx);
    // (Two rows of two only where the window has the height for them.)
    property <bool> two-fit: 2 * (root.by-two * 160phx + 44px + Theme.gap) + 300px <= Theme.window-height - 200px;
    property <int> columns: root.by-three >= 1 && (root.by-three >= root.by-two || !root.two-fit) ? 3 : root.by-two >= 1 ? 2 : 1;
    property <length> thumb: max(1, root.columns == 3 ? root.by-three : root.columns == 2 ? root.by-two : floor(root.inside / 240phx)) * 240phx;
    property <length> card-height: root.thumb * 2 / 3 + 44px;

    VerticalLayout {
        alignment: start;
        Rectangle {
            height: inner.preferred-height;
            Slant {
                lean: 26px;
                color: Theme.panel.with-alpha(0.55);
                stroke: Theme.line;
                stroke-width: 1px;
            }

            inner := VerticalLayout {
                padding: Theme.gap * 1.5;
                padding-left: Theme.compact ? 24px : 40px;
                padding-right: Theme.compact ? 24px : 40px;
                spacing: Theme.gap;
                if !root.chosen: Text {
                    text: @tr("Choose a game");
                    color: Theme.text-faint;
                    font-size: Theme.title-size;
                    font-weight: Theme.bold;
                    horizontal-alignment: center;
                    height: 160px;
                    vertical-alignment: center;
                }
                if root.chosen: Versus {
                    left-name: root.preview.left;
                    left-sub: @tr("YOU");
                    right-name: root.preview.right;
                    right-sub: TrainingText.opponent(root.behavior).to-uppercase();
                }

                if root.chosen && root.preview.problem != "": Text {
                    text: root.preview.problem;
                    color: Theme.warn;
                    wrap: word-wrap;
                    font-size: 13px;
                }

                if root.chosen && root.arenas: Label {
                    text: @tr("THE ARENAS");
                }

                if root.chosen && root.arenas: Rectangle {
                    height: ceil(root.preview.rounds.length / root.columns) * (root.card-height + Theme.gap);
                    for r[i] in root.preview.rounds: VerticalLayout {
                        x: mod(i, root.columns) * (root.thumb + Theme.gap);
                        y: floor(i / root.columns) * (root.card-height + Theme.gap);
                        height: root.card-height;
                        spacing: 6px;
                        alignment: start;
                        width: root.thumb;
                        Rectangle {
                            height: root.thumb * 2 / 3;
                            background: Theme.ink;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: r.picture;
                                image-fit: fill;
                                image-rendering: pixelated;
                            }

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: badge.preferred-width + 14px;
                                height: 18px;
                                background: Theme.ink.with-alpha(0.85);
                                badge := Text {
                                    text: @tr("ROUND {0}", i + 1);
                                    color: Theme.cyan;
                                    font-size: 10px;
                                    font-weight: Theme.black;
                                }
                            }
                        }

                        Text {
                            text: r.background;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: Theme.bold;
                            overflow: elide;
                        }

                        Text {
                            text: r.stage;
                            color: Theme.text-faint;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component TrainingScreen {
    in property <[GameCard]> games;
    // The game chosen (none yet: -1; the player chooses, nothing is assumed).
    in-out property <int> game: -1;
    // The match: 0 random, then each match file of the game.
    in property <[string]> sources;
    in-out property <int> source;
    // Your side: 0 a random one (or the match file's), then each build of the game.
    in property <[string]> builds;
    in-out property <int> build;
    // The opponent's side, the same way.
    in property <[string]> opponents;
    in-out property <int> opponent;
    // What the opponent does (`TrainingText`), and whether the set goes on
    // round after round; the match's rounds.
    in-out property <int> behavior;
    in-out property <bool> endless;
    in property <int> rounds;
    in property <MatchPreview> preview;
    // The row focused: 0 the games, 1 the match, 2 your build, 3 the
    // opponent's, 4 what it does, 5 the rounds, 6 FIGHT.
    in-out property <int> cursor;
    // The game card focused on the first row.
    in-out property <int> game-cursor;
    property <bool> portrait: Theme.portrait;
    property <bool> can-fight: root.game >= 0 && root.preview.ready && root.preview.problem == "";

    callback choose-game(int);
    callback choose-source(int);
    callback choose-build(int);
    callback choose-opponent(int);
    callback choose-behavior(int);
    callback choose-endless(bool);
    callback reroll();
    callback fight();
    callback back();
    callback sound(UiSound);

    public function nav(a: NavAction) {
        if a == NavAction.back {
            root.sound(UiSound.back);
            root.back();
        } else if a == NavAction.up {
            if root.cursor > 0 {
                root.cursor -= 1;
                root.sound(UiSound.cursor);
            }
        } else if a == NavAction.down {
            if root.cursor < 6 && root.game >= 0 {
                root.cursor += 1;
                root.sound(UiSound.cursor);
            }
        } else if root.cursor == 0 && (a == NavAction.left || a == NavAction.right) {
            root.game-cursor = mod(root.game-cursor + (a == NavAction.left ? root.games.length - 1 : 1), max(1, root.games.length));
            root.sound(UiSound.cursor);
        } else if root.cursor == 0 && a == NavAction.confirm {
            if root.games.length > 0 && root.games[root.game-cursor].state == GameState.ready {
                root.sound(UiSound.pick);
                root.choose-game(root.game-cursor);
                root.cursor = 1;
            } else {
                root.sound(UiSound.refused);
            }
        } else if root.cursor >= 1 && root.cursor <= 5 && (a == NavAction.left || a == NavAction.right || a == NavAction.previous || a == NavAction.next) {
            root.sound(UiSound.cursor);
            root.step(root.cursor, a == NavAction.left || a == NavAction.previous ? -1 : 1);
        } else if root.cursor == 1 && a == NavAction.confirm && root.source == 0 {
            root.sound(UiSound.pick);
            root.reroll();
        } else if root.cursor >= 1 && root.cursor <= 5 && a == NavAction.confirm {
            root.cursor += 1;
            root.sound(UiSound.cursor);
        } else if root.cursor == 6 && a == NavAction.confirm {
            if root.can-fight {
                root.sound(UiSound.pick);
                root.fight();
            } else {
                root.sound(UiSound.refused);
            }
        }
    }

    // Row `row`'s value a step on (`d`: -1 or 1).
    function step(row: int, d: int) {
        if row == 1 {
            root.choose-source(mod(root.source + d + root.sources.length, max(1, root.sources.length)));
        } else if row == 2 {
            root.choose-build(mod(root.build + d + root.builds.length, max(1, root.builds.length)));
        } else if row == 3 {
            root.choose-opponent(mod(root.opponent + d + root.opponents.length, max(1, root.opponents.length)));
        } else if row == 4 {
            root.choose-behavior(mod(root.behavior + d + 4, 4));
        } else if row == 5 {
            root.choose-endless(!root.endless);
        }
    }

    function point(row: int, card: int) {
        if root.cursor != row || (row == 0 && root.game-cursor != card) {
            root.cursor = row;
            root.game-cursor = card;
            root.sound(UiSound.cursor);
        }
    }

    VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: Theme.gutter * 0.6;
        spacing: Theme.gap;

        Heading {
            text: @tr("heading" => "TRAINING");
            sub: @tr("OFFLINE · AGAINST THE COMPUTER");
            back => {
                root.nav(NavAction.back);
            }
        }

        // Side by side, or one over the other on a phone held upright (its
        // FIGHT at the foot, under the thumb).
        if !root.portrait: HorizontalLayout {
            spacing: Theme.gap * 2;
            vertical-stretch: 1;
            VerticalLayout {
                width: (Theme.window-width - 2 * Theme.gutter - Theme.gap * 2) * 0.42;
                spacing: Theme.gap * 2;
                Choices {
                    vertical-stretch: 0;
                    games: root.games;
                    game: root.game;
                    sources: root.sources;
                    source: root.source;
                    builds: root.builds;
                    build: root.build;
                    opponents: root.opponents;
                    opponent: root.opponent;
                    behavior: root.behavior;
                    endless: root.endless;
                    rounds: root.rounds;
                    seed: root.preview.seed;
                    cursor: root.cursor;
                    game-cursor: root.game-cursor;
                    point(r, c) => {
                        root.point(r, c);
                    }
                    nav(a) => {
                        root.nav(a);
                    }
                }

                Fight {
                    vertical-stretch: 0;
                    cursor: root.cursor;
                    game-cursor: root.game-cursor;
                    can-fight: root.can-fight;
                    point(r, c) => {
                        root.point(r, c);
                    }
                    nav(a) => {
                        root.nav(a);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }

            Preview {
                horizontal-stretch: 1;
                room: (Theme.window-width - 2 * Theme.gutter - Theme.gap * 2) * 0.58;
                preview: root.preview;
                chosen: root.game >= 0;
                behavior: root.behavior;
            }
        }
        if root.portrait: VerticalLayout {
            spacing: Theme.gap * 1.5;
            vertical-stretch: 1;
            Choices {
                games: root.games;
                game: root.game;
                sources: root.sources;
                source: root.source;
                builds: root.builds;
                build: root.build;
                opponents: root.opponents;
                opponent: root.opponent;
                behavior: root.behavior;
                endless: root.endless;
                rounds: root.rounds;
                seed: root.preview.seed;
                cursor: root.cursor;
                game-cursor: root.game-cursor;
                point(r, c) => {
                    root.point(r, c);
                }
                nav(a) => {
                    root.nav(a);
                }
            }

            Preview {
                room: Theme.window-width - 2 * Theme.gutter;
                preview: root.preview;
                chosen: root.game >= 0;
                behavior: root.behavior;
                arenas: false;
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Fight {
                cursor: root.cursor;
                game-cursor: root.game-cursor;
                can-fight: root.can-fight;
                point(r, c) => {
                    root.point(r, c);
                }
                nav(a) => {
                    root.nav(a);
                }
            }

            Rectangle {
                height: Theme.gap;
            }
        }

        Hints {
            visible: !root.portrait;
            hints: [
                { key: "↑↓", button: "✚", text: @tr("Choose") },
                { key: "←→", button: "✚", text: @tr("Change") },
                { key: "Enter", button: "A", text: @tr("Confirm") },
                { key: "Esc", button: "B", text: @tr("Back") },
            ];
        }
    }
}
