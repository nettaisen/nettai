// The app's window: every screen, the backdrop behind them, the wipe between
// them, and the keys that navigate them.

import { Theme, NavAction, Screen, UiSound } from "theme.slint";
import { Backdrop, Input, Slant } from "widgets.slint";
import { Format } from "format.slint";
import { TitleScreen } from "title.slint";
import { BattleScreen, BattleKind, Side, Playback, Connection } from "battle.slint";
import { PlayScreen, GameCard, GameState, MatchPreview, RoundCard } from "play.slint";
import { LobbyScreen, LinkState, Peer } from "lobby.slint";
import { ReplaysScreen, ReplayRow, ReplayCheck } from "replays.slint";
import { SettingsScreen } from "settings.slint";
import { BuildsScreen, BuildCard } from "builds.slint";
import { BuildScreen, BuildTab, TabKind, BuildAction, ActionButton, RowKind, FactRow, EntryRow, PickRow, CheckTile, FilterChip, Detail, StatRow, GridCell, GridPart, LeftKind, RightKind } from "build.slint";

// The strings the host shows that it doesn't take from the content: here,
// so they come from the same catalog as the rest.
export global Strings {
    pure public function random() -> string {
        @tr("match" => "Random")
    }

    pure public function stand-in() -> string {
        @tr("Stand-in")
    }

    // Your side as a match file states it.
    pure public function from-the-match() -> string {
        @tr("build" => "The match's")
    }

    // The language's name, in itself (its catalog's translation of
    // "English"; the build reads it for the list of languages).
    pure public function language-name() -> string {
        @tr("language" => "English")
    }
}

export { Theme, NavAction, Screen, UiSound, Input, Format, BattleKind, Side, Playback, Connection, GameCard, GameState, MatchPreview, RoundCard, LinkState, Peer, ReplayRow, ReplayCheck }
export { BuildCard, BuildTab, TabKind, BuildAction, ActionButton, RowKind, FactRow, EntryRow, PickRow, CheckTile, FilterChip, Detail, StatRow, GridCell, GridPart, LeftKind, RightKind }

export component AppWindow inherits Window {
    title: "nettai";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 480px;
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.ink;
    default-font-family: Theme.family;
    default-font-size: Theme.body;

    in-out property <Screen> screen: Screen.title;
    // The wipe between two screens, 0 to 1 (the screen changes halfway).
    in property <float> wipe;
    // The picture the host presents (the battle's, or the title's demo),
    // and its scale.
    in property <image> picture;
    in property <int> scale;
    // Where the picture goes, for the host to present for.
    out property <length> picture-area-width: root.screen == Screen.battle ? battle.stage-width : title.monitor-width;
    out property <length> picture-area-height: root.screen == Screen.battle ? battle.stage-height : title.monitor-height;
    // While the battle has the keys, the window passes none to the menus.
    in property <bool> playing;

    in property <string> version;
    in property <string> monitor-game;

    // The screens' requests, for the host.
    callback go(Screen);
    callback quit();
    callback sound(UiSound);

    callback play-game(int);
    callback play-source(int);
    callback play-reroll();
    callback play-fight();
    callback play-build(int);

    callback battle-resume();
    callback battle-restart();
    callback battle-quit();
    callback battle-rematch();
    callback battle-touch(int, bool);

    callback lobby-mode(int);
    callback lobby-code(string);
    callback lobby-game(int);
    callback lobby-build(int);
    callback lobby-code-done();
    callback lobby-ready();
    callback lobby-copy();

    callback replays-watch(int, int);

    callback settings-step(int, int);
    callback set-name(string);

    // The builds' and the creator's: their navigation is the app's.
    callback builds-nav(NavAction);
    callback builds-game(int);
    callback builds-point(int);
    callback builds-activate(int);
    callback build-nav(NavAction);
    callback build-tab(int);
    callback build-point(int, int, int);
    callback build-act(int, int, int);
    callback build-step(int, int);
    callback build-action(int);
    callback build-strip(int);
    callback build-filter(int);
    callback build-grid-hover(int, int);
    callback build-grid-press(int, int, bool);
    callback build-grid-wheel(bool);
    callback build-edited(string);
    callback build-edit-done(string);

    // A navigation action from the host (a gamepad's).
    public function nav(a: NavAction) {
        if root.wipe > 0 && root.wipe < 1 {
            return;
        }
        if root.screen == Screen.title {
            title.nav(a);
        } else if root.screen == Screen.battle {
            battle.nav(a);
        } else if root.screen == Screen.play {
            play.nav(a);
        } else if root.screen == Screen.lobby {
            lobby.nav(a);
        } else if root.screen == Screen.replays {
            replays.nav(a);
        } else if root.screen == Screen.settings {
            settings.nav(a);
        } else if root.screen == Screen.builds {
            root.builds-nav(a);
        } else if root.screen == Screen.build {
            root.build-nav(a);
        }
    }

    // A small window (a phone's) is drawn smaller.
    property <bool> compact: root.width < 760px || root.height < 560px;
    property <bool> portrait: root.height > root.width;
    changed compact => {
        Theme.compact = self.compact;
    }
    changed portrait => {
        Theme.portrait = self.portrait;
    }
    changed width => {
        Theme.window-width = self.width;
    }
    changed height => {
        Theme.window-height = self.height;
    }
    init => {
        Theme.compact = self.compact;
        Theme.portrait = self.portrait;
        Theme.window-width = self.width;
        Theme.window-height = self.height;
    }

    Backdrop {
        calm: root.screen == Screen.battle ? 1 : 0;
        animate calm { duration: Theme.slow; }
    }

    keys := FocusScope {
        // A text field has the keyboard: up, down and Esc still leave it
        // (the IME has the keys it is composing with before this).
        capture-key-pressed(event) => {
            if !Input.editing {
                return reject;
            }
            if event.text == Key.UpArrow {
                root.nav(NavAction.up);
            } else if event.text == Key.DownArrow || event.text == Key.Tab {
                root.nav(NavAction.down);
            } else if event.text == Key.Backtab {
                root.nav(NavAction.up);
            } else if event.text == Key.Escape {
                root.nav(NavAction.back);
            } else {
                return reject;
            }
            accept
        }
        key-pressed(event) => {
            if root.playing {
                return reject;
            }
            Input.pad = false;
            if event.text == Key.UpArrow {
                root.nav(NavAction.up);
            } else if event.text == Key.DownArrow {
                root.nav(NavAction.down);
            } else if event.text == Key.LeftArrow {
                root.nav(NavAction.left);
            } else if event.text == Key.RightArrow {
                root.nav(NavAction.right);
            } else if event.text == Key.Return || event.text == " " || event.text == "z" || event.text == "Z" {
                root.nav(NavAction.confirm);
            } else if event.text == Key.Escape || event.text == Key.Backspace || event.text == "x" || event.text == "X" {
                root.nav(NavAction.back);
            } else if event.text == "a" || event.text == "A" || event.text == Key.PageUp {
                root.nav(NavAction.previous);
            } else if event.text == "s" || event.text == "S" || event.text == Key.PageDown {
                root.nav(NavAction.next);
            } else if event.text == "c" || event.text == "C" {
                root.nav(NavAction.alternate);
            } else if event.text == Key.Delete {
                root.nav(NavAction.remove);
            } else if event.text == Key.Tab {
                // (The next item; Slint's own focus would move into a
                // screen not shown.)
                root.nav(NavAction.down);
            } else if event.text == Key.Backtab {
                root.nav(NavAction.up);
            } else {
                return reject;
            }
            accept
        }

        title := TitleScreen {
            visible: root.screen == Screen.title;
            width: root.width;
            height: root.height;
            picture: root.picture;
            scale: root.scale;
            version: root.version;
            monitor-game: root.monitor-game;
            activate(i) => {
                if i == 0 {
                    root.go(Screen.play);
                } else if i == 1 {
                    root.go(Screen.builds);
                } else if i == 2 {
                    root.go(Screen.lobby);
                } else if i == 3 {
                    root.go(Screen.replays);
                } else if i == 4 {
                    root.go(Screen.settings);
                } else {
                    root.quit();
                }
            }
            sound(s) => {
                root.sound(s);
            }
        }

        play := PlayScreen {
            visible: root.screen == Screen.play;
            width: root.width;
            height: root.height;
            back => {
                root.go(Screen.title);
            }
            choose-game(i) => {
                root.play-game(i);
            }
            choose-source(i) => {
                root.play-source(i);
            }
            reroll => {
                root.play-reroll();
            }
            choose-build(b) => {
                root.play-build(b);
            }
            fight => {
                root.play-fight();
            }
            sound(s) => {
                root.sound(s);
            }
        }

        lobby := LobbyScreen {
            visible: root.screen == Screen.lobby;
            name <=> root.name;
            width: root.width;
            height: root.height;
            back => {
                root.go(Screen.title);
            }
            set-mode(m) => {
                root.lobby-mode(m);
            }
            set-code(c) => {
                root.lobby-code(c);
            }
            set-name(n) => {
                root.set-name(n);
            }
            set-game(g) => {
                root.lobby-game(g);
            }
            set-build(b) => {
                root.lobby-build(b);
            }
            code-done => {
                root.lobby-code-done();
            }
            ready => {
                root.lobby-ready();
            }
            copy-code => {
                root.lobby-copy();
            }
            sound(s) => {
                root.sound(s);
            }
        }

        replays := ReplaysScreen {
            visible: root.screen == Screen.replays;
            width: root.width;
            height: root.height;
            back => {
                root.go(Screen.title);
            }
            watch(i, side) => {
                root.replays-watch(i, side);
            }
            sound(s) => {
                root.sound(s);
            }
        }

        settings := SettingsScreen {
            visible: root.screen == Screen.settings;
            name <=> root.name;
            width: root.width;
            height: root.height;
            back => {
                root.go(Screen.title);
            }
            step(row, by) => {
                root.settings-step(row, by);
            }
            set-name(n) => {
                root.set-name(n);
            }
            sound(s) => {
                root.sound(s);
            }
        }

        builds := BuildsScreen {
            visible: root.screen == Screen.builds;
            width: root.width;
            height: root.height;
            nav(a) => {
                root.nav(a);
            }
            choose-game(i) => {
                root.builds-game(i);
            }
            point(i) => {
                root.builds-point(i);
            }
            activate(i) => {
                root.builds-activate(i);
            }
        }

        build := BuildScreen {
            visible: root.screen == Screen.build;
            width: root.width;
            height: root.height;
            nav(a) => {
                root.nav(a);
            }
            choose-tab(i) => {
                root.build-tab(i);
            }
            point(pane, i, o) => {
                root.build-point(pane, i, o);
            }
            act(pane, i, o) => {
                root.build-act(pane, i, o);
            }
            step(i, by) => {
                root.build-step(i, by);
            }
            do-action(i) => {
                root.build-action(i);
            }
            do-strip(i) => {
                root.build-strip(i);
            }
            do-filter(i) => {
                root.build-filter(i);
            }
            grid-hover(x, y) => {
                root.build-grid-hover(x, y);
            }
            grid-press(x, y, right) => {
                root.build-grid-press(x, y, right);
            }
            grid-wheel(up) => {
                root.build-grid-wheel(up);
            }
            edited(t) => {
                root.build-edited(t);
            }
            edit-done(t) => {
                root.build-edit-done(t);
            }
        }

        battle := BattleScreen {
            visible: root.screen == Screen.battle;
            width: root.width;
            height: root.height;
            picture: root.picture;
            scale: root.scale;
            resume => {
                root.battle-resume();
            }
            restart => {
                root.battle-restart();
            }
            quit => {
                root.battle-quit();
            }
            rematch => {
                root.battle-rematch();
            }
            sound(s) => {
                root.sound(s);
            }
            touch(b, d) => {
                root.battle-touch(b, d);
            }
        }
    }

    // The wipe: a slanted band of the players' colors sweeping across.
    if root.wipe > 0 && root.wipe < 1: Rectangle {
        property <length> band: root.width * 1.6;
        Slant {
            x: (1.05 - root.wipe * 2.9) * root.width;
            width: band;
            lean: root.height * 0.35;
            color: Theme.ink;
        }

        Slant {
            x: (1.05 - root.wipe * 2.9) * root.width - 18px;
            width: 36px + root.height * 0.35;
            lean: root.height * 0.35;
            color: Theme.cyan;
        }

        Slant {
            x: (1.05 - root.wipe * 2.9) * root.width + band - root.height * 0.35 - 18px;
            width: 36px + root.height * 0.35;
            lean: root.height * 0.35;
            color: Theme.magenta;
        }
    }

    // What the screens show, from the host.
    in property <BattleKind> battle-kind <=> battle.kind;
    in property <Side> battle-left <=> battle.left-side;
    in property <Side> battle-right <=> battle.right-side;
    in property <[int]> battle-left-pips <=> battle.left-pips;
    in property <[int]> battle-right-pips <=> battle.right-pips;
    in property <Playback> battle-playback <=> battle.playback;
    in property <Connection> battle-connection <=> battle.connection;
    in property <bool> battle-paused <=> battle.paused;
    in property <int> battle-result <=> battle.result;
    in property <string> battle-stopped <=> battle.stopped;
    in property <string> battle-recorded <=> battle.recorded;
    in-out property <int> battle-cursor <=> battle.cursor;
    in-out property <bool> title-started <=> title.started;
    in-out property <int> title-cursor <=> title.cursor;
    in property <[GameCard]> games <=> play.games;
    in-out property <int> play-chosen <=> play.game;
    in property <[string]> play-sources <=> play.sources;
    in-out property <int> play-source-index <=> play.source;
    in property <MatchPreview> play-preview <=> play.preview;
    in-out property <int> play-cursor <=> play.cursor;
    in-out property <int> lobby-mode-index <=> lobby.mode;
    in property <string> lobby-code-text <=> lobby.code;
    in property <[string]> lobby-games <=> lobby.games;
    in-out property <int> lobby-game-index <=> lobby.game;
    in property <[string]> lobby-builds <=> lobby.builds;
    in-out property <int> lobby-build-index <=> lobby.build;
    in property <string> lobby-direct-address <=> lobby.direct-address;
    in property <[string]> play-builds <=> play.builds;
    in-out property <int> play-build-index <=> play.build;
    in property <Peer> lobby-me <=> lobby.me;
    in property <Peer> lobby-them <=> lobby.them;
    in property <LinkState> lobby-link <=> lobby.link;
    in property <string> lobby-problem <=> lobby.problem;
    in property <string> lobby-server <=> lobby.server;
    in-out property <int> lobby-cursor <=> lobby.cursor;
    in property <[ReplayRow]> replay-rows <=> replays.rows;
    in-out property <int> replays-cursor <=> replays.cursor;
    in-out property <int> replays-side <=> replays.side;
    in property <string> replays-folder <=> replays.folder;
    in-out property <string> name;
    in property <string> settings-language <=> settings.language;
    in property <int> settings-volume <=> settings.volume;
    in property <bool> settings-menu-sounds <=> settings.menu-sounds;
    in property <bool> settings-crisp-text <=> settings.crisp-text;
    in property <bool> settings-sharp <=> settings.sharp;
    in-out property <int> settings-cursor <=> settings.cursor;
    in property <[string]> builds-games <=> builds.games;
    in property <int> builds-game-index <=> builds.game;
    in property <[BuildCard]> builds-cards <=> builds.cards;
    in property <int> builds-cursor <=> builds.cursor;
    in property <string> builds-status <=> builds.status;
    in property <string> builds-folder <=> builds.folder;
    in property <bool> builds-imports <=> builds.imports;
    in property <string> build-name <=> build.name;
    in property <string> build-game <=> build.game;
    in property <int> build-problem-count <=> build.problem-count;
    in property <[BuildTab]> build-tabs <=> build.tabs;
    in property <int> build-tab-index <=> build.tab;
    in property <LeftKind> build-left <=> build.left-kind;
    in property <RightKind> build-right <=> build.right-kind;
    in property <int> build-pane <=> build.pane;
    in property <int> build-cursor <=> build.cursor;
    in property <int> build-pick <=> build.pick;
    in property <int> build-option <=> build.option;
    in property <[FactRow]> build-rows <=> build.rows;
    in property <[EntryRow]> build-entries <=> build.entries;
    in property <[CheckTile]> build-tiles <=> build.tiles;
    in property <[PickRow]> build-picks <=> build.picks;
    in property <[ActionButton]> build-actions <=> build.actions;
    in property <[ActionButton]> build-strip-buttons <=> build.strip;
    in property <[FilterChip]> build-filters <=> build.filters;
    in property <[string]> build-notes <=> build.notes;
    in property <[StatRow]> build-counts <=> build.counts;
    in property <string> build-pick-hint <=> build.pick-hint;
    in property <Detail> build-detail <=> build.detail;
    in property <image> build-face <=> build.face;
    in property <string> build-navi <=> build.navi;
    in property <[StatRow]> build-stats <=> build.stats;
    in property <string> build-stopped <=> build.stopped;
    in property <[string]> build-problems <=> build.problems;
    in property <int> build-board-n <=> build.board-n;
    in property <string> build-board-size <=> build.board-size;
    in property <[GridCell]> build-cells <=> build.cells;
    in property <[GridPart]> build-parts <=> build.parts;
    in property <[GridCell]> build-ghost <=> build.ghost;
    in property <bool> build-ghost-fits <=> build.ghost-fits;
    in property <color> build-ghost-color <=> build.ghost-color;
    in property <int> build-cell-x <=> build.cell-x;
    in property <int> build-cell-y <=> build.cell-y;
    in property <int> build-hovered <=> build.hovered;
    in property <bool> build-holding <=> build.holding;
    in property <bool> build-compresses <=> build.compresses;
    in property <string> build-status <=> build.status;
    in property <bool> build-editing <=> build.editing;
    in property <string> build-edit-label <=> build.edit-label;
    in property <string> build-edit-hint <=> build.edit-hint;
    in-out property <string> build-edit-text <=> build.edit-text;
    out property <int> build-tile-columns: build.tile-columns;

    public function focus-keys() {
        keys.focus();
    }

    public function build-edit-focus() {
        build.edit-focus();
    }

    public function build-edit-leave() {
        build.edit-leave();
    }
}
