return {
    -- A push reads the first of bits 2 to 5 of the hits' final modifier, toward the navi's front; the 0x80 bit picks the
    -- last five rows (`sub_800E548`). An obstacle's push reads the same bits from its own rows (`sub_800F598`,
    -- `byte_800F604`), turned toward the pusher; with none set it reads past them, from the BIOS. A push with 0x40 is
    -- a drag (`sub_801AEB0`), and an obstacle's push (`sub_801AD9E`).
    push_reading = {
        reads = "final",
        bits = 4,
        drag_bit = 0x40,
        shift = { bit = 0x80, rows = 5 },
        obstacle_rows = {
            { dx = -1, dy = 0, panels = 6 },
            { dx = 1, dy = 0, panels = 6 },
            { dx = -1, dy = 0, panels = 1 },
            { dx = 1, dy = 0, panels = 1 },
        },
    },
    -- The hit test (`sub_3007218`), where games differ: a FloatShoe body (flag 0x20) meets only collision types
    -- with the 0x80 self bit; the flag 0x80000000 is a bubble, on which an elec hit counts once more (no body
    -- dives under a sea), and elec reaches a submerged body no more than another element; a guard breaks to types
    -- with 0x2 (0x1002 for a type with 0x4000); an untouchable body is hit by none, guarding or not.
    hit_test = {
        float_shoe_needs_self_bit = true,
        bubbled_as_submerged = false,
        elec_reaches_submerged = false,
        guard_breaks_to = 0x0002,
        guard_before_untouchable = false,
        guard_marks_direction = true,
    },
    -- A move's direction in the collision record (`sub_800E994`, `object_updateCollisionPanels`): up, down, back
    -- or forward by the side, other for a move of two panels or more right or down.
    move_direction = "by_side",
    -- A pulled obstacle's slide stays out of the puller's area (`byte_8017F24`).
    obstacle_slide_bounds = true,
    -- A slide and a drag go 10 pixels a tick across and 6 in depth (`sub_8016730`, `sub_80178D4`).
    slide_speed = { x = 0xA_0000, y = 0x6_0000 },
    -- What a navi wears restarts after an animation change, a flinch or a drag with a step at once (`sub_80C44D2`).
    overlay_restart = "step",
    -- The counter a stance's caught hit starts runs from the next tick (`sub_80105F2`).
    stance_counter = "next_tick",
    -- The counter a trap's catch starts runs its first step at once (`sub_801056A`).
    trap_counter = "at_once",
    -- A deleted player's object lets go of its reservations and collision data and counts one actor fewer, then stays
    -- in its slot (`sub_8016C4E`).
    dead_player = "kept",
    -- An attack's end hands its lockout on: a chip's to the chip lockout, the B+Back special's to its cooldown
    -- (`sub_801171C`).
    attack_end_lockout = "by_kind",
    -- What the ends of a navi's actions clear of its requests besides the attacks' six: the mode-9 A press, at an
    -- attack's end (`sub_801171C`: 0x1000003F) and a paralysis's, a freeze's or a bubble's; at a flinch's and a
    -- drag's (0x1000043F) the anti-sword trigger too.
    request_clears = {
        attack = { "mode9_a" },
        paralysis = { "mode9_a" },
        flinch = { "anti_sword_triggered", "mode9_a" },
        drag = { "anti_sword_triggered", "mode9_a" },
    },
    push = {
        { dx = 1, dy = 0, panels = 6 },
        { dx = -1, dy = 0, panels = 6 },
        { dx = 1, dy = 0, panels = 1 },
        { dx = -1, dy = 0, panels = 1 },
        { dx = 0, dy = 0, panels = 0 },
        { dx = 0, dy = -1, panels = 6 },
        { dx = 0, dy = 1, panels = 6 },
        { dx = 0, dy = -1, panels = 1 },
        { dx = 0, dy = 1, panels = 1 },
        { dx = 0, dy = 0, panels = 0 },
    },
    -- The slide a move's end on ice starts (`sub_801A3DA`), by the direction of the move (`byte_800E4E8`): none, up,
    -- down, back, forward, other.
    slide_rows = {
        { dx = 0, dy = 0, panels = 0 },
        { dx = 0, dy = -1, panels = 1 },
        { dx = 0, dy = 1, panels = 1 },
        { dx = -1, dy = 0, panels = 1 },
