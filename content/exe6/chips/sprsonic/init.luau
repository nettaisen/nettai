--!strict
-- sprsonic: the chip's record and its use.
-- Generated by gen-content from the ROM; people own it now.

local lockon = require("../rules/lockon")
local parts = require("../lib/swords/parts")
local regions = require("@exelib/regions")
local slashes = require("../navis/megaman/forms/slashcross/slashes")
local sonic = require("./sonicbom/action")

-- Its charged slash in SlashCross: WideSwrd's, over a column.
local CHARGED = slashes.slash {
    wave = slashes.wave { region = regions.wide, sprite = asset.sprite("sword-slash"), anim = 0 },
    blade = parts.blade,
    sound = parts.swing,
    lockon = lockon.widesht,
}

-- Its boom goes through (hit modifier 1). Charged in SlashCross it becomes
-- the charged slash its record's bytes read as (subtype 1, first parameter
-- 1): WideSwrd's after a dash.
local ACTION = sonic.action("sprsonic/action", { hit_mod = 1, pierces = true }, { charged = CHARGED, step = true })

local chip: Chip = {
    codes = { "E", "L", "S", "*" },
    element = "null",
    family = "sword",
    class = "special",
    rarity = 0,
    mb = 8,
    damage = 80,
    hit_param = 30,
    lockout = 0,
    flags = { "has_damage", "library" },
    beast = { rush = false, lockon = lockon.sprsonic },
    slot_in_limit = 1,
    action = ACTION,
}

return { sprsonic = chip }
