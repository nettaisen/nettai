--!strict
-- crossdiv: the chip's record and its use: Colonel (../colonel/navi)
-- strikes CrossDiv's cross.
-- Generated by gen-content from the ROM; people own it now.

local colonel = require("./colonel/navi")
local navi_chips = require("../lib/navi_chips/chip")
local regions = require("@exelib/regions")

-- What it looks for (`byte_80B84E4`: an enemy navi's body).
local ENEMY_NAVI = { [0] = 0x0400_0000, 0x0800_0000 }

-- Its two effects (0x36, 0x37).
local CROSS = {
    new.effect { sprite = asset.sprite("colonel-effect"), anim = 1, palette = 0 },
    new.effect { sprite = asset.sprite("colonel-effect"), anim = 2, palette = 0 },
}

-- `sub_80B84A4`: its panel: the first ahead in Colonel's row holding an
-- enemy navi, or three columns ahead.
local function enemy_panel(me: Object): number
    local want = ENEMY_NAVI[me.alliance]
    local x = me.panel_x + me.facing
    while true do
        if bit32.band(field.flags(x, me.panel_y), want) ~= 0 then
            return x
        end
        x += me.facing
        if x == 0 or x > 6 then
            return me.panel_x + me.facing * 3
        end
        if x < 0 then
            -- Started left of column 1 facing left (never at his side's
            -- own columns): the game loops forever.
            error("CrossDiv's search (sub_80B84A4) never ends")
        end
    end
end

-- `sub_80B8564`: its strike, a cross on the enemy's panel (an X, then its
-- center again), its two effects 12 pixels up, a 40-tick flash.
local CROSS_DIVIDE = colonel.strike(function(me: Object)
    if colonel.at_back(me) then
        return
    end
    local x, y = enemy_panel(me), me.panel_y
    colonel.hit(me, x, y, regions.x)
    colonel.hit(me, x, y, regions.single)
    local cx, cy = field.center(x, y)
    local pos = Vec3.new(cx, cy, 0xC_0000)
    battle.effect(pos, CROSS[1], me.alliance)
    battle.effect(pos, CROSS[2], me.alliance)
    battle.palette_flash(0, 0x28, true, false)
end)

local chip: Chip = {
    codes = { "D" },
    element = "null",
    family = "sword",
    class = "giga",
    rarity = 4,
    mb = 93,
    damage = 250,
    hit_param = 148,
    lockout = 0,
    flags = { "dimming", "has_damage", "library" },
    extra_flags = { 8, 16 },
    slot_in_limit = 1,
    navi = navi_chips.make {
        id = "crossdiv/controller",
        summon = colonel.summon { palette = 0, strike = CROSS_DIVIDE },
    },
}

return { crossdiv = chip }
