--!strict
-- sonicbom: the chip's record and its use.
-- Generated by gen-content from the ROM; people own it now.

local lockon = require("../rules/lockon")
local parts = require("../lib/swords/parts")
local regions = require("@exelib/regions")
local slashes = require("../navis/megaman/forms/slashcross/slashes")
local sonic = require("@self/action")

-- Its charged slash in SlashCross: the plain sword's, over the panel ahead.
local CHARGED = slashes.slash {
    wave = slashes.wave { region = regions.single, sprite = asset.sprite("sword-slash"), anim = 2 },
    blade = parts.blade,
    sound = parts.swing,
    lockon = lockon.thunder,
}

-- Its boom staggers (hit modifier 3). Charged in SlashCross it becomes the
-- charged slash its record's bytes read as (subtype 0, first parameter 3):
-- the plain slash after a dash.
local ACTION = sonic.action("sonicbom/action", { hit_mod = 3, pierces = false }, { charged = CHARGED, step = true })

local chip: Chip = {
    codes = { "E", "L", "S", "*" },
    element = "null",
    family = "sword",
    class = "special",
    rarity = 0,
    mb = 8,
    damage = 80,
    hit_param = 30,
    lockout = 0,
    flags = { "has_damage", "library" },
    beast = { rush = false, lockon = lockon.widesht },
    slot_in_limit = 1,
    action = ACTION,
}

return { sonicbom = chip }
